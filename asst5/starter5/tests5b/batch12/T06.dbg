840#    subu $t0,$v0,10
844#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
848#    subu $t0,$v0,9
852#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
856#    subu $t0,$v0,13
860#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
864#    subu $t0,$v0,12
868#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
872#    j badIntegerFormat # illegal integer char: abort program

876:  nonWhite:
876#    subu $t0,$v0,'-'
880#    li $t4,1 # final multiplier
