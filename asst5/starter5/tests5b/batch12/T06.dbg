.data
3368:strLit_13:
.asciiz "Should not get here.\n"
.align 2
.text
.globl main
0:main:
0#  jal vm_init
4#  li $v0, 10
8#  syscall
12:mth_main_Main:
12#  li $t0, 54
16#  subu $sp, $sp, 8
20#  sw $s5, 4($sp)
24#  sw $t0, 0($sp)
28#  li $t0, 73
32#  subu $sp, $sp, 8
36#  sw $s5, 4($sp)
40#  sw $t0, 0($sp)
44#  la $t0, strLit_13
48#  subu $sp, $sp, 4
52#  sw $t0, ($sp)
56#  subu $sp, $sp, 4
60#  sw $s2, ($sp)
64#  jr $ra
##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
68:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
68#    lw $t0,-8($s2) # get word with hash bits from this
72#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
76#    addu $t0,$t1

80#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
84:mth_equals_Object:
84#    move $t0,$s2 # first pointer (this)
88#    lw $t1,($sp) # second pointer
92#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
93##...subu $at,$t0,$t1
97##...sltiu $t0,$at,1

100#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
104:mth_hashCode_String:
104#    move $t0,$s2 # put this pointer in t0

108#    li $t2,0 # current hash value
112#    lw $t1,-4($t0) # negative of number of characters in string
116#    beq $t1,$zero,done_hashCode_String # if zero length => done
120#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
124#    and $t0,0xfffffffc # adjust for padding
125##...lui $at,65535
129##...ori $at,$at,0xfffc
133##...and $t0,$t0,$at
136#    subu $t1,$t0,$t1 # address at end of string +12
140:loop_hashCode_String:    
140#    sll $t4,$t2,5 # multiply by 32
144#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
148#    lbu $t3,-12($t0) # current character
152#    addu $t2,$t3 # add in current character
156#    addu $t0,1 # go to next character's address
160#    bne $t0,$t1,loop_hashCode_String # loop back if more
164:done_hashCode_String:    

    # push int on stack
164#    move $t0, $t2 # put $t2 in return slot
168#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
172:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
172#    subu $sp,4
176#    sw $ra,($sp)
    
    # get hash value
180#    lw $t2,-12($s2) # vtable address
184#    lw $t0,($t2) # method address
188#    jalr $t0
192#    subu $sp,8 # push result (int in $t0) on stack
196#    sw $s5,4($sp)
200#    sw $t0,($sp)

    # compute print-size of hash value
204#    li $t0, 1
208#    lw $t1, ($sp)
212#    srl $t1,$t1,4
216#    beq $t1,$zero,toString_skip_loop
220:toString_loop_top:
220#    addu $t0,1
224#    srl $t1,$t1,4
228#    bne $t1,$zero,toString_loop_top
232:toString_skip_loop:
232#    subu $sp,8
236#    sw $s5,4($sp)
240#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
244#    lw $t2,-12($s2) # vtable address
248#    move $t0,$t2
252:toString_checkTagBit:
252#    subu $t0,1
256#    lb $t1,($t0)
260#    and $t1,0x80
261##...lui $at,0
265##...ori $at,$at,0x80
269##...and $t1,$t1,$at
272#    beq $t1,$zero,toString_checkTagBit
276#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
280#    subu $sp,8
284#    sw $t1,($sp)
288#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
292#    move $s7,$zero # -4 offset header word
296#    lw $t4,8($sp) # bytes for hash value
300#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
304#    addu $t4,8
308#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
312#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

316#    li $t0,CLASS_String # store string vtable address into ...
320#    sw $t0,-12($s7) # ... -12 offset in object header
324#    lw $t2,-12($s2) # our object's vtable address
328#    lw $t5,4($sp) # number characters in prefix
332#    lw $t1,12($sp) # number of characters in hashcode
336#    addu $t3,$t1,$t5 # number of characters in string ...
340#    addu $t3,1 # ... including the '@' character
344#    subu $t0,$zero,$t3 # store negated length into ...
348#    sw $t0,-4($s7) # ... -4 offset header word
352#    lw $t0,-8($s7) # get -8 offset header-word
356#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
357##...slt $at,$t0,$zero
361##...beq $at,$zero,380
364#    and $t0,0xff # mask off object's hash value ...
365##...lui $at,0
369##...ori $at,$at,0xff
373##...and $t0,$t0,$at
376#    sw $t0,-8($s7) # ... and store back into -8 header-word
380:skipMask_toString:
380#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
384#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
388#    subu $t4,$t2,$t5
392:toString_copyLoop:    
392#    lb $t3,($t4)
396#    and $t3,0x7f # mask off sign bit (in case first word)
397##...lui $at,0
401##...ori $at,$at,0x7f
405##...and $t3,$t3,$at
408#    sb $t3,-8($t0)
412#    addu $t4,1
416#    addu $t0,1
420#    blt $t4,$t2,toString_copyLoop
421##...slt $at,$t4,$t2
425##...bne $at,$zero,392

    # copy the '@' sign
428#    li $t3,'@'
432#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
436#    addu $t2,$t0,$t1 # address of last byte in string to store +8
440#    lw $t3,20($sp) # hash code to print
444:toString_hashCopyLoop:
444#    and $t4,$t3,0xf
448#    srl $t3,4
452#    lb $t4,hexChars($t4)
456#    sb $t4,-8($t2)
460#    subu $t2,$t2,1
464#    bgt $t2,$t0,toString_hashCopyLoop
465##...slt $at,$t0,$t2
469##...bne $at,$zero,444

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
472#    addu $sp,28
476#    lw $ra,($sp)
480#    addu $sp,4
484#    move $t0, $s7 # return string we created
488#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
492:mth_equals_String:
    
    # quick test for obvious false
492#    lw $t0,($sp) # second parameter
496#    beq $t0,$zero,goEsFalse # go return false if null
500#    lw $t1,-12($t0) # vtable pointer
504#    la $t2,CLASS_String # string vtable pointer
508#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
512#    subu $sp,12
516#    sw $ra,8($sp)
520#    sw $s2,4($sp)
524#    sw $t0,($sp)
528#    jal mth_compareTo_String
532#    lw $s2, 4($sp) #restore this pointer and pop parameters
536#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
540#    seq $t0,$t0,$zero
541##...subu $at,$t0,$zero
545##...sltiu $t0,$at,1

    # pop return address and return $t0
548#    lw $ra,($sp)
552#    addu $sp,4

556#    jr $ra # return
    
560:goEsFalse:
    # put 0 in $t0 and return
560#    li $t0, 0
564#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
568:mth_toString_String:
    #we are a string, so return this.
568#    move $t0, $s2
572#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
576:mth_readLine_Lib:
    
576#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
580#    sw $ra, 4($sp) # save $ra
584#    move $t1,$sp # save "original" sp

588:  doRead:

    # read the character
588#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
592#    subu $t2,$v0,13
596#    bne $t2,$zero,notReturnRL
600#    jal readLogicalChar
604#    subu $t2,$v0,10 # check for newline
608#    beq $t2,$zero,foundNewLine
612#    sw $v0,lastCharRead # push back character into queue
616#    j foundNewLine # go process the line

620:  notReturnRL:

    # at this point, $v0 has our character

620#    subu $t0,$v0,10
624#    beq $t0,$zero,foundNewLine
628#    blt $v0,$zero,foundEof
629##...slt $at,$v0,$zero
633##...bne $at,$zero,648

    # we have a character, so push it onto stack
636#    subu $sp,$sp,4
640#    sw $v0,($sp)

    # loop back up to get next character
644#    j doRead

648:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
648#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
652#    li $s7, 0 # return-value: null
656#    j rlReturn # return

660:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)

