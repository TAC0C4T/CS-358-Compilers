########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3044:instanceOf:
    # get object, go return false if null
3044#    lw $t2,($sp)
3048#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3052#    lw $t2,-12($t2) # vtable address
3056#    sge $t0,$t2,$t0 # are we >= the lower limit?
3057##...slt $t0,$t2,$t0
3061##...xori $t0,$t0,0x1
3064#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3068#    and $t2,$t0,$t1
3072#    sw $t2,($sp)
3076:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3076#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3080:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3080#    li $v0,4 # syscall-code for print-string
3084#    syscall
3088:exit:
    # print termination message
3088#    li $v0,4 # syscall-code for print-string
3092#    la $a0,exitString
3096#    syscall

    # terminate execution
3100#    li $v0,10 #syscall-code for "exit"
3104#    syscall

3108:outOfHeapMemory:
3108#    la $a0,heapMemoryMsg
3112#    j exitError
3116:divByZeroError:
3116#    la $a0,divByZeroMsg
3120#    j exitError
3124:strIndexOutOfBounds:
3124#    la $a0,strIndexOutOfBoundsMsg
3128#    j exitError
3132:arrayIndexOutOfBounds:
3132#    la $a0,arrayIndexOutOfBoundsMsg
3136#    j exitError
3140:arraySizeOutOfBounds:
3140#    la $a0,arraySizeOutOfBoundsMsg
3144#    j exitError
3148:nullPtrException:
3148#    la $a0,nullPtrExceptionMsg
3152#    j exitError
3156:badIntegerFormat:
3156#    la $a0,badIntegerFormatMsg
3160#    j exitError
3164:castException:
3164#    la $a0,castExceptionMsg
3168#    j exitError
############## data section ################
    .data
3392:hexChars:
    .ascii "0123456789abcdef"
    .align 2
3408:cur_seg:
    .word 0

3412:lastCharRead:
    .word -2 # -2 => no buffered character
3416:prevHashConstant:
    .word 0x2785173c
3420:gcCount:
    .word 0

3424:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
3451:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
3474:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
3509:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
3543:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
3576:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
3607:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
3655:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
3676:gcMsg: 
      .asciiz "\nGC!\n"
3682:gcCountMsg: 
      .asciiz "Number of garbage collections: "

3714:nullStr:
    .asciiz "null"
3719:trueString:
    .asciiz "true"
3724:falseString:
    .asciiz "false"
3730:exitString:
    .ascii "Program terminated."
    #### "falls through" here
3749:newlineString:
    .asciiz "\n"
    
    .align 2
3752:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

3756:seg0_start:
    .space 0x100000
1052332:seg0_end:
1052332:seg1_start:
    .space 0x100000
2100908:seg1_end:
