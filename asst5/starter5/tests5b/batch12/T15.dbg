872#    subu $t0,$v0,10
876#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
880#    subu $t0,$v0,9
884#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
888#    subu $t0,$v0,13
892#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
896#    subu $t0,$v0,12
900#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
904#    j badIntegerFormat # illegal integer char: abort program

908:  nonWhite:
908#    subu $t0,$v0,'-'
