957##...sltu $at,$t1,$t2
961##...beq $at,$zero,980

964#    mul $t3,$t3,$t2 # multiply old value by 10
965##...mult $t3,$t2
969##...mflo $t3
972#    addu $t3,$t3,$t1 # add in value of new digit
976#    j digitLoop

980:  doneDigitLoop:
