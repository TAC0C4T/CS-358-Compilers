.data
3384:strLit_8:
.asciiz "We got here\n"
.align 2
3400:strLit_22:
.asciiz " ... should not get here.\n"
.align 2
.text
.globl main
0:main:
0#  jal vm_init
4#  li $v0, 10
8#  syscall
12:mth_main_Main:
12#  li $t0, 0
16#  subu $sp, $sp, 8
20#  sw $s5, 4($sp)
24#  sw $t0, 0($sp)
28#  li $t0, 24
32#  subu $sp, $sp, 8
36#  sw $s5, 4($sp)
40#  sw $t0, 0($sp)
44#  la $t0, strLit_8
48#  subu $sp, $sp, 4
52#  sw $t0, ($sp)
56#  subu $sp, $sp, 4
60#  sw $s2, ($sp)
64#  jal divide
68#  subu $sp, $sp, 4
72#  sw $s2, ($sp)
76#  la $t0, strLit_22
80#  subu $sp, $sp, 4
84#  sw $t0, ($sp)
88#  subu $sp, $sp, 4
92#  sw $s2, ($sp)
96#  jr $ra
##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
100:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
100#    lw $t0,-8($s2) # get word with hash bits from this
104#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
108#    addu $t0,$t1

112#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
116:mth_equals_Object:
116#    move $t0,$s2 # first pointer (this)
120#    lw $t1,($sp) # second pointer
124#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
125##...subu $at,$t0,$t1
129##...sltiu $t0,$at,1

132#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
136:mth_hashCode_String:
136#    move $t0,$s2 # put this pointer in t0

140#    li $t2,0 # current hash value
144#    lw $t1,-4($t0) # negative of number of characters in string
148#    beq $t1,$zero,done_hashCode_String # if zero length => done
152#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
156#    and $t0,0xfffffffc # adjust for padding
157##...lui $at,65535
161##...ori $at,$at,0xfffc
165##...and $t0,$t0,$at
168#    subu $t1,$t0,$t1 # address at end of string +12
172:loop_hashCode_String:    
172#    sll $t4,$t2,5 # multiply by 32
176#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
180#    lbu $t3,-12($t0) # current character
184#    addu $t2,$t3 # add in current character
188#    addu $t0,1 # go to next character's address
192#    bne $t0,$t1,loop_hashCode_String # loop back if more
196:done_hashCode_String:    

    # push int on stack
196#    move $t0, $t2 # put $t2 in return slot
200#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
204:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
204#    subu $sp,4
208#    sw $ra,($sp)
    
    # get hash value
212#    lw $t2,-12($s2) # vtable address
216#    lw $t0,($t2) # method address
220#    jalr $t0
224#    subu $sp,8 # push result (int in $t0) on stack
228#    sw $s5,4($sp)
232#    sw $t0,($sp)

    # compute print-size of hash value
236#    li $t0, 1
240#    lw $t1, ($sp)
244#    srl $t1,$t1,4
248#    beq $t1,$zero,toString_skip_loop
252:toString_loop_top:
252#    addu $t0,1
256#    srl $t1,$t1,4
260#    bne $t1,$zero,toString_loop_top
264:toString_skip_loop:
264#    subu $sp,8
268#    sw $s5,4($sp)
272#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
276#    lw $t2,-12($s2) # vtable address
280#    move $t0,$t2
284:toString_checkTagBit:
284#    subu $t0,1
288#    lb $t1,($t0)
292#    and $t1,0x80
293##...lui $at,0
297##...ori $at,$at,0x80
301##...and $t1,$t1,$at
304#    beq $t1,$zero,toString_checkTagBit
308#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
312#    subu $sp,8
316#    sw $t1,($sp)
320#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
324#    move $s7,$zero # -4 offset header word
328#    lw $t4,8($sp) # bytes for hash value
332#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
336#    addu $t4,8
340#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
344#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

348#    li $t0,CLASS_String # store string vtable address into ...
352#    sw $t0,-12($s7) # ... -12 offset in object header
356#    lw $t2,-12($s2) # our object's vtable address
360#    lw $t5,4($sp) # number characters in prefix
364#    lw $t1,12($sp) # number of characters in hashcode
368#    addu $t3,$t1,$t5 # number of characters in string ...
372#    addu $t3,1 # ... including the '@' character
376#    subu $t0,$zero,$t3 # store negated length into ...
380#    sw $t0,-4($s7) # ... -4 offset header word
384#    lw $t0,-8($s7) # get -8 offset header-word
388#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
389##...slt $at,$t0,$zero
393##...beq $at,$zero,412
396#    and $t0,0xff # mask off object's hash value ...
397##...lui $at,0
401##...ori $at,$at,0xff
405##...and $t0,$t0,$at
408#    sw $t0,-8($s7) # ... and store back into -8 header-word
412:skipMask_toString:
412#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
416#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
420#    subu $t4,$t2,$t5
424:toString_copyLoop:    
424#    lb $t3,($t4)
428#    and $t3,0x7f # mask off sign bit (in case first word)
429##...lui $at,0
433##...ori $at,$at,0x7f
437##...and $t3,$t3,$at
440#    sb $t3,-8($t0)
444#    addu $t4,1
448#    addu $t0,1
452#    blt $t4,$t2,toString_copyLoop
453##...slt $at,$t4,$t2
457##...bne $at,$zero,424

    # copy the '@' sign
460#    li $t3,'@'
464#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
468#    addu $t2,$t0,$t1 # address of last byte in string to store +8
472#    lw $t3,20($sp) # hash code to print
476:toString_hashCopyLoop:
476#    and $t4,$t3,0xf
480#    srl $t3,4
484#    lb $t4,hexChars($t4)
488#    sb $t4,-8($t2)
492#    subu $t2,$t2,1
496#    bgt $t2,$t0,toString_hashCopyLoop
497##...slt $at,$t0,$t2
501##...bne $at,$zero,476

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
504#    addu $sp,28
508#    lw $ra,($sp)
512#    addu $sp,4
516#    move $t0, $s7 # return string we created
520#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
524:mth_equals_String:
    
    # quick test for obvious false
524#    lw $t0,($sp) # second parameter
528#    beq $t0,$zero,goEsFalse # go return false if null
532#    lw $t1,-12($t0) # vtable pointer
536#    la $t2,CLASS_String # string vtable pointer
540#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
544#    subu $sp,12
548#    sw $ra,8($sp)
552#    sw $s2,4($sp)
556#    sw $t0,($sp)
560#    jal mth_compareTo_String
564#    lw $s2, 4($sp) #restore this pointer and pop parameters
568#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
572#    seq $t0,$t0,$zero
573##...subu $at,$t0,$zero
577##...sltiu $t0,$at,1

    # pop return address and return $t0
580#    lw $ra,($sp)
584#    addu $sp,4

588#    jr $ra # return
    
592:goEsFalse:
    # put 0 in $t0 and return
592#    li $t0, 0
596#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
600:mth_toString_String:
    #we are a string, so return this.
600#    move $t0, $s2
604#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
608:mth_readLine_Lib:
    
608#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
612#    sw $ra, 4($sp) # save $ra
616#    move $t1,$sp # save "original" sp

620:  doRead:

    # read the character
620#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
624#    subu $t2,$v0,13
628#    bne $t2,$zero,notReturnRL
632#    jal readLogicalChar
636#    subu $t2,$v0,10 # check for newline
640#    beq $t2,$zero,foundNewLine
644#    sw $v0,lastCharRead # push back character into queue
648#    j foundNewLine # go process the line

652:  notReturnRL:

    # at this point, $v0 has our character

652#    subu $t0,$v0,10
656#    beq $t0,$zero,foundNewLine
660#    blt $v0,$zero,foundEof
661##...slt $at,$v0,$zero
665##...bne $at,$zero,680

    # we have a character, so push it onto stack
668#    subu $sp,$sp,4
672#    sw $v0,($sp)

    # loop back up to get next character
676#    j doRead

680:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
680#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
684#    li $s7, 0 # return-value: null
688#    j rlReturn # return

692:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
