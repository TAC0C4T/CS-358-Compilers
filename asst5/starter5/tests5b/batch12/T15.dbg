########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3076:instanceOf:
    # get object, go return false if null
3076#    lw $t2,($sp)
3080#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3084#    lw $t2,-12($t2) # vtable address
3088#    sge $t0,$t2,$t0 # are we >= the lower limit?
3089##...slt $t0,$t2,$t0
3093##...xori $t0,$t0,0x1
3096#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3100#    and $t2,$t0,$t1
3104#    sw $t2,($sp)
3108:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3108#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3112:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3112#    li $v0,4 # syscall-code for print-string
3116#    syscall
3120:exit:
    # print termination message
3120#    li $v0,4 # syscall-code for print-string
3124#    la $a0,exitString
3128#    syscall

    # terminate execution
3132#    li $v0,10 #syscall-code for "exit"
3136#    syscall

3140:outOfHeapMemory:
3140#    la $a0,heapMemoryMsg
3144#    j exitError
3148:divByZeroError:
3148#    la $a0,divByZeroMsg
3152#    j exitError
3156:strIndexOutOfBounds:
3156#    la $a0,strIndexOutOfBoundsMsg
3160#    j exitError
3164:arrayIndexOutOfBounds:
3164#    la $a0,arrayIndexOutOfBoundsMsg
3168#    j exitError
3172:arraySizeOutOfBounds:
3172#    la $a0,arraySizeOutOfBoundsMsg
3176#    j exitError
3180:nullPtrException:
3180#    la $a0,nullPtrExceptionMsg
3184#    j exitError
3188:badIntegerFormat:
3188#    la $a0,badIntegerFormatMsg
3192#    j exitError
3196:castException:
3196#    la $a0,castExceptionMsg
3200#    j exitError
############## data section ################
    .data
3428:hexChars:
    .ascii "0123456789abcdef"
    .align 2
3444:cur_seg:
    .word 0

3448:lastCharRead:
    .word -2 # -2 => no buffered character
3452:prevHashConstant:
    .word 0x2785173c
3456:gcCount:
    .word 0

3460:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
3487:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
3510:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
3545:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
3579:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
3612:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
3643:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
3691:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
3712:gcMsg: 
      .asciiz "\nGC!\n"
3718:gcCountMsg: 
      .asciiz "Number of garbage collections: "

3750:nullStr:
    .asciiz "null"
3755:trueString:
    .asciiz "true"
3760:falseString:
    .asciiz "false"
3766:exitString:
    .ascii "Program terminated."
    #### "falls through" here
3785:newlineString:
    .asciiz "\n"
    
    .align 2
3788:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

3792:seg0_start:
    .space 0x100000
1052368:seg0_end:
1052368:seg1_start:
    .space 0x100000
2100944:seg1_end:
