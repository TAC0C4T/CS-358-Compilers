1284#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1288#    srl $s6,$s6,2  # data words in object
1292#    move $s7,$zero # object words in object
1296#    jal newObject  # allocate space
    
    # store header words
1300#    la $t0,CLASS_String
1304#    sw $t0,-12($s7)# store class tag (String) into object
1308#    lw $t2,4($sp) # char-count
1312#    sll $t1,$t2,2 # 4 times number of chars
1316#    subu $t2,$zero,$t2 # negative of char-count
1320#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1324#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1328#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1329##...slt $at,$t0,$zero
1333##...beq $at,$zero,1352
1336#    and $t0,0xff # mask off object's hash value ...
1337##...lui $at,0
1341##...ori $at,$at,0xff
1345##...and $t0,$t0,$at
1348#    sw $t0,-8($s7) # ... and store back into -8 header-word
1352:  skipMask_readLine:

1352#    sll $t0,$t0,2 # data bytes in object
1356#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1360#    subu $t0,$t0,$t2 # place to store last character (plus 9)
