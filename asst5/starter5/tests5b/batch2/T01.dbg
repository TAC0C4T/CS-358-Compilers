2520#    move $s7,$zero
2524#    jal newObject

    # get n from string.
2528#    lw $t1,8($sp)

    # store "String" tag into class field
2532#    la $t0,CLASS_String
2536#    sw $t0,-12($s7)
        
    # mask off hash bits, if needed
2540#    lw $t4,-8($s7) # # data words in source string
2544#    bge $t4,$zero,skipMask_intToChar # don't strip hash code if not there
