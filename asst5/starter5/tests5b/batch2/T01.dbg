##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
668:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
668#    lw $t0,-8($s2) # get word with hash bits from this
672#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
676#    addu $t0,$t1

680#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
684:mth_equals_Object:
684#    move $t0,$s2 # first pointer (this)
688#    lw $t1,($sp) # second pointer
692#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
693##...subu $at,$t0,$t1
697##...sltiu $t0,$at,1

700#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
704:mth_hashCode_String:
704#    move $t0,$s2 # put this pointer in t0

708#    li $t2,0 # current hash value
712#    lw $t1,-4($t0) # negative of number of characters in string
716#    beq $t1,$zero,done_hashCode_String # if zero length => done
720#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
724#    and $t0,0xfffffffc # adjust for padding
725##...lui $at,65535
729##...ori $at,$at,0xfffc
733##...and $t0,$t0,$at
736#    subu $t1,$t0,$t1 # address at end of string +12
740:loop_hashCode_String:    
740#    sll $t4,$t2,5 # multiply by 32
744#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
748#    lbu $t3,-12($t0) # current character
752#    addu $t2,$t3 # add in current character
756#    addu $t0,1 # go to next character's address
760#    bne $t0,$t1,loop_hashCode_String # loop back if more
764:done_hashCode_String:    

    # push int on stack
764#    move $t0, $t2 # put $t2 in return slot
768#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
772:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
772#    subu $sp,4
776#    sw $ra,($sp)
    
    # get hash value
780#    lw $t2,-12($s2) # vtable address
784#    lw $t0,($t2) # method address
788#    jalr $t0
792#    subu $sp,8 # push result (int in $t0) on stack
796#    sw $s5,4($sp)
800#    sw $t0,($sp)

    # compute print-size of hash value
804#    li $t0, 1
808#    lw $t1, ($sp)
812#    srl $t1,$t1,4
816#    beq $t1,$zero,toString_skip_loop
820:toString_loop_top:
820#    addu $t0,1
824#    srl $t1,$t1,4
828#    bne $t1,$zero,toString_loop_top
832:toString_skip_loop:
832#    subu $sp,8
836#    sw $s5,4($sp)
840#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
844#    lw $t2,-12($s2) # vtable address
848#    move $t0,$t2
852:toString_checkTagBit:
852#    subu $t0,1
856#    lb $t1,($t0)
860#    and $t1,0x80
861##...lui $at,0
865##...ori $at,$at,0x80
869##...and $t1,$t1,$at
872#    beq $t1,$zero,toString_checkTagBit
876#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
880#    subu $sp,8
884#    sw $t1,($sp)
888#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
892#    move $s7,$zero # -4 offset header word
896#    lw $t4,8($sp) # bytes for hash value
900#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
904#    addu $t4,8
908#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
912#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

916#    li $t0,CLASS_String # store string vtable address into ...
920#    sw $t0,-12($s7) # ... -12 offset in object header
924#    lw $t2,-12($s2) # our object's vtable address
928#    lw $t5,4($sp) # number characters in prefix
932#    lw $t1,12($sp) # number of characters in hashcode
936#    addu $t3,$t1,$t5 # number of characters in string ...
940#    addu $t3,1 # ... including the '@' character
944#    subu $t0,$zero,$t3 # store negated length into ...
948#    sw $t0,-4($s7) # ... -4 offset header word
952#    lw $t0,-8($s7) # get -8 offset header-word
956#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
957##...slt $at,$t0,$zero
961##...beq $at,$zero,980
964#    and $t0,0xff # mask off object's hash value ...
965##...lui $at,0
969##...ori $at,$at,0xff
973##...and $t0,$t0,$at
976#    sw $t0,-8($s7) # ... and store back into -8 header-word
980:skipMask_toString:
980#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
984#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
988#    subu $t4,$t2,$t5
992:toString_copyLoop:    
992#    lb $t3,($t4)
996#    and $t3,0x7f # mask off sign bit (in case first word)
997##...lui $at,0
1001##...ori $at,$at,0x7f
1005##...and $t3,$t3,$at
1008#    sb $t3,-8($t0)
1012#    addu $t4,1
1016#    addu $t0,1
1020#    blt $t4,$t2,toString_copyLoop
1021##...slt $at,$t4,$t2
1025##...bne $at,$zero,992

    # copy the '@' sign
1028#    li $t3,'@'
1032#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
