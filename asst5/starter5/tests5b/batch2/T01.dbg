
    # set up GC tag and char-count on stack
1260#    subu $t0,$t1,$sp # number of chars we read (times 4)
1264#    srl $s6,$t0,2 # number of words on stack with chars
1268#    subu $sp,$sp,4 # push char-count ...
1272#    sw $s6,($sp) # ... onto stack
1276#    addu $t2,$t0,5 # GC tag, incl. for count-word
1280#    sw $t2,($t1) # store GC tag
