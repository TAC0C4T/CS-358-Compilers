
    # set up the forwarding pointer
3472#    sw $zero,-8($t1) # 0 in first header-slot
3476#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
3480#    sw $t8,($t0)

3484:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
3484#    addu $t0,$t0,4
3488#    bltu $t0,$s1,gcNextPointerInObject
3489##...sltu $at,$t0,$s1
3493##...bne $at,$zero,3332

3496:  gcTestIterDone2:
3496#    bltu $t0,$s3,gcHeapCopyLoop
3497##...sltu $at,$t0,$s3
3501##...bne $at,$zero,3216

    ###### end outer loop to copy all non-stack-direct objects ######

3504:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
3504#    lw $s2,($sp)
3508#    addu $sp,$sp,4

    # mark us as having already GC'd
3512#    move $t5,$s5

    # go try and allocate again
3516#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3520:vm_init:

    # mark bottom of stack
3520#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3524#    move $s2,$zero

    #set up the "five" register
3528#    li $s5,5

3532#    la $s3,seg0_start
3536#    la $s4,seg0_end
3537##...lui $s4,16
3541##...addiu $s4,$s4,4320
    
    # return
3544#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3548:divide:
    # get parameters; abort if divisor zero
3548#    lw $t0,($sp)
3552#    lw $t1,8($sp)
3556#    beq $t0,$zero,divByZeroError
    
    # perform division
3560#    div $t1,$t0
3564#    mflo $t0

    # store result, adjust stack and return
3568#    addu $sp,$sp,8 # adjust stack
3572#    sw $t0,($sp) # store result
3576#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3580:remainder:
    # get parameters; abort if divisor zero
3580#    lw $t0,($sp)
3584#    lw $t1,8($sp)
3588#    beq $t0,$zero,divByZeroError
    
    # perform division
3592#    div $t1,$t0
3596#    mfhi $t0

    # store result, adjust stack and return
3600#    addu $sp,$sp,8 # adjust stack
3604#    sw $t0,($sp) # store result
3608#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3612:checkCast:
    # get object, allow immediately if null
3612#    lw $t2,($sp)
3616#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3620#    lw $t2,-12($t2) # vtable address
3624#    bge $t2,$t1,castException
3625##...slt $at,$t2,$t1
3629##...beq $at,$zero,3764
3632#    blt $t2,$t0,castException
3633##...slt $at,$t2,$t0
3637##...bne $at,$zero,3764
    
    # return, leaving object unchanged on stack
3640:  checkCastReturn:    
3640#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3644:instanceOf:
    # get object, go return false if null
3644#    lw $t2,($sp)
3648#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3652#    lw $t2,-12($t2) # vtable address
3656#    sge $t0,$t2,$t0 # are we >= the lower limit?
3657##...slt $t0,$t2,$t0
3661##...xori $t0,$t0,0x1
3664#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3668#    and $t2,$t0,$t1
3672#    sw $t2,($sp)
3676:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3676#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3680:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3680#    li $v0,4 # syscall-code for print-string
3684#    syscall
3688:exit:
    # print termination message
3688#    li $v0,4 # syscall-code for print-string
3692#    la $a0,exitString
3696#    syscall

    # terminate execution
3700#    li $v0,10 #syscall-code for "exit"
3704#    syscall

3708:outOfHeapMemory:
3708#    la $a0,heapMemoryMsg
3712#    j exitError
3716:divByZeroError:
3716#    la $a0,divByZeroMsg
3720#    j exitError
3724:strIndexOutOfBounds:
3724#    la $a0,strIndexOutOfBoundsMsg
3728#    j exitError
3732:arrayIndexOutOfBounds:
3732#    la $a0,arrayIndexOutOfBoundsMsg
3736#    j exitError
3740:arraySizeOutOfBounds:
3740#    la $a0,arraySizeOutOfBoundsMsg
3744#    j exitError
3748:nullPtrException:
3748#    la $a0,nullPtrExceptionMsg
3752#    j exitError
3756:badIntegerFormat:
3756#    la $a0,badIntegerFormatMsg
3760#    j exitError
3764:castException:
3764#    la $a0,castExceptionMsg
3768#    j exitError
############## data section ################
    .data
3956:hexChars:
    .ascii "0123456789abcdef"
    .align 2
3972:cur_seg:
    .word 0

3976:lastCharRead:
    .word -2 # -2 => no buffered character
3980:prevHashConstant:
    .word 0x2785173c
3984:gcCount:
    .word 0

3988:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4015:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4038:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4073:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4107:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4140:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4171:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4219:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4240:gcMsg: 
      .asciiz "\nGC!\n"
4246:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4278:nullStr:
    .asciiz "null"
4283:trueString:
    .asciiz "true"
4288:falseString:
    .asciiz "false"
4294:exitString:
    .ascii "Program terminated."
    #### "falls through" here
4313:newlineString:
    .asciiz "\n"
    
    .align 2
4316:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

4320:seg0_start:
    .space 0x100000
1052896:seg0_end:
1052896:seg1_start:
    .space 0x100000
2101472:seg1_end:
