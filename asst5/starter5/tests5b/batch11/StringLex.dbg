##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2820:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
2820#    lw $t0,-8($s2) # get word with hash bits from this
2824#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
2828#    addu $t0,$t1

2832#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2836:mth_equals_Object:
2836#    move $t0,$s2 # first pointer (this)
2840#    lw $t1,($sp) # second pointer
2844#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
2845##...subu $at,$t0,$t1
2849##...sltiu $t0,$at,1

2852#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2856:mth_hashCode_String:
2856#    move $t0,$s2 # put this pointer in t0

2860#    li $t2,0 # current hash value
2864#    lw $t1,-4($t0) # negative of number of characters in string
2868#    beq $t1,$zero,done_hashCode_String # if zero length => done
2872#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
2876#    and $t0,0xfffffffc # adjust for padding
2877##...lui $at,65535
2881##...ori $at,$at,0xfffc
2885##...and $t0,$t0,$at
2888#    subu $t1,$t0,$t1 # address at end of string +12
2892:loop_hashCode_String:    
2892#    sll $t4,$t2,5 # multiply by 32
2896#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
2900#    lbu $t3,-12($t0) # current character
2904#    addu $t2,$t3 # add in current character
2908#    addu $t0,1 # go to next character's address
2912#    bne $t0,$t1,loop_hashCode_String # loop back if more
2916:done_hashCode_String:    

    # push int on stack
2916#    move $t0, $t2 # put $t2 in return slot
2920#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
2924:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
2924#    subu $sp,4
2928#    sw $ra,($sp)
    
    # get hash value
2932#    lw $t2,-12($s2) # vtable address
2936#    lw $t0,($t2) # method address
2940#    jalr $t0
2944#    subu $sp,8 # push result (int in $t0) on stack
2948#    sw $s5,4($sp)
2952#    sw $t0,($sp)

    # compute print-size of hash value
2956#    li $t0, 1
2960#    lw $t1, ($sp)
2964#    srl $t1,$t1,4
2968#    beq $t1,$zero,toString_skip_loop
2972:toString_loop_top:
2972#    addu $t0,1
2976#    srl $t1,$t1,4
2980#    bne $t1,$zero,toString_loop_top
2984:toString_skip_loop:
2984#    subu $sp,8
2988#    sw $s5,4($sp)
2992#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
2996#    lw $t2,-12($s2) # vtable address
3000#    move $t0,$t2
3004:toString_checkTagBit:
3004#    subu $t0,1
3008#    lb $t1,($t0)
3012#    and $t1,0x80
3013##...lui $at,0
3017##...ori $at,$at,0x80
3021##...and $t1,$t1,$at
3024#    beq $t1,$zero,toString_checkTagBit
3028#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
3032#    subu $sp,8
3036#    sw $t1,($sp)
3040#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
3044#    move $s7,$zero # -4 offset header word
3048#    lw $t4,8($sp) # bytes for hash value
3052#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
3056#    addu $t4,8
3060#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
3064#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

3068#    li $t0,CLASS_String # store string vtable address into ...
3072#    sw $t0,-12($s7) # ... -12 offset in object header
3076#    lw $t2,-12($s2) # our object's vtable address
3080#    lw $t5,4($sp) # number characters in prefix
3084#    lw $t1,12($sp) # number of characters in hashcode
3088#    addu $t3,$t1,$t5 # number of characters in string ...
3092#    addu $t3,1 # ... including the '@' character
3096#    subu $t0,$zero,$t3 # store negated length into ...
3100#    sw $t0,-4($s7) # ... -4 offset header word
3104#    lw $t0,-8($s7) # get -8 offset header-word
3108#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
3109##...slt $at,$t0,$zero
3113##...beq $at,$zero,3132
3116#    and $t0,0xff # mask off object's hash value ...
3117##...lui $at,0
