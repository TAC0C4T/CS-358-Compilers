    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
5584#    lw $s0,($t4)
5588#    lw $t9,-8($t1)
5592#    sw $t9,($t4)
5596#    sw $s0,-8($t1)

    # copy all source bytes to the target
5600:  gCinnerCopy2:
5600#    lw $s0,($t4)
5604#    sw $s0,($s3)
5608#    addu $t4,$t4,4
5612#    addu $s3,$s3,4
5616#    bltu $t4,$t3,gCinnerCopy2
5617##...sltu $at,$t4,$t3
5621##...bne $at,$zero,5600

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
5624#    sw $zero,-8($t1) # 0 in first header-slot
5628#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
5632#    sw $t8,($t0)

5636:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
5636#    addu $t0,$t0,4
5640#    bltu $t0,$s1,gcNextPointerInObject
5641##...sltu $at,$t0,$s1
5645##...bne $at,$zero,5484

5648:  gcTestIterDone2:
5648#    bltu $t0,$s3,gcHeapCopyLoop
5649##...sltu $at,$t0,$s3
5653##...bne $at,$zero,5368

    ###### end outer loop to copy all non-stack-direct objects ######

5656:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
5656#    lw $s2,($sp)
5660#    addu $sp,$sp,4

    # mark us as having already GC'd
5664#    move $t5,$s5

    # go try and allocate again
5668#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
5672:vm_init:

    # mark bottom of stack
5672#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
5676#    move $s2,$zero

    #set up the "five" register
5680#    li $s5,5

5684#    la $s3,seg0_start
5688#    la $s4,seg0_end
5689##...lui $s4,16
5693##...addiu $s4,$s4,6548
    
    # return
5696#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
5700:divide:
    # get parameters; abort if divisor zero
5700#    lw $t0,($sp)
5704#    lw $t1,8($sp)
5708#    beq $t0,$zero,divByZeroError
    
    # perform division
5712#    div $t1,$t0
5716#    mflo $t0

    # store result, adjust stack and return
5720#    addu $sp,$sp,8 # adjust stack
5724#    sw $t0,($sp) # store result
5728#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
5732:remainder:
    # get parameters; abort if divisor zero
5732#    lw $t0,($sp)
5736#    lw $t1,8($sp)
5740#    beq $t0,$zero,divByZeroError
    
    # perform division
5744#    div $t1,$t0
5748#    mfhi $t0

    # store result, adjust stack and return
5752#    addu $sp,$sp,8 # adjust stack
5756#    sw $t0,($sp) # store result
5760#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
5764:checkCast:
    # get object, allow immediately if null
5764#    lw $t2,($sp)
5768#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
5772#    lw $t2,-12($t2) # vtable address
5776#    bge $t2,$t1,castException
5777##...slt $at,$t2,$t1
5781##...beq $at,$zero,5916
5784#    blt $t2,$t0,castException
5785##...slt $at,$t2,$t0
5789##...bne $at,$zero,5916
    
    # return, leaving object unchanged on stack
5792:  checkCastReturn:    
5792#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
5796:instanceOf:
    # get object, go return false if null
5796#    lw $t2,($sp)
5800#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
5804#    lw $t2,-12($t2) # vtable address
5808#    sge $t0,$t2,$t0 # are we >= the lower limit?
5809##...slt $t0,$t2,$t0
5813##...xori $t0,$t0,0x1
5816#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
5820#    and $t2,$t0,$t1
5824#    sw $t2,($sp)
5828:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
5828#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

5832:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
5832#    li $v0,4 # syscall-code for print-string
5836#    syscall
5840:exit:
    # print termination message
5840#    li $v0,4 # syscall-code for print-string
5844#    la $a0,exitString
5848#    syscall

    # terminate execution
5852#    li $v0,10 #syscall-code for "exit"
5856#    syscall

5860:outOfHeapMemory:
5860#    la $a0,heapMemoryMsg
5864#    j exitError
5868:divByZeroError:
5868#    la $a0,divByZeroMsg
5872#    j exitError
5876:strIndexOutOfBounds:
5876#    la $a0,strIndexOutOfBoundsMsg
5880#    j exitError
5884:arrayIndexOutOfBounds:
5884#    la $a0,arrayIndexOutOfBoundsMsg
5888#    j exitError
5892:arraySizeOutOfBounds:
5892#    la $a0,arraySizeOutOfBoundsMsg
5896#    j exitError
5900:nullPtrException:
5900#    la $a0,nullPtrExceptionMsg
5904#    j exitError
5908:badIntegerFormat:
5908#    la $a0,badIntegerFormatMsg
5912#    j exitError
5916:castException:
5916#    la $a0,castExceptionMsg
5920#    j exitError
############## data section ################
    .data
6184:hexChars:
    .ascii "0123456789abcdef"
    .align 2
6200:cur_seg:
    .word 0

6204:lastCharRead:
    .word -2 # -2 => no buffered character
6208:prevHashConstant:
    .word 0x2785173c
6212:gcCount:
    .word 0

6216:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
6243:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
6266:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
6301:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
6335:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
6368:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
6399:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
6447:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
6468:gcMsg: 
      .asciiz "\nGC!\n"
6474:gcCountMsg: 
      .asciiz "Number of garbage collections: "

6506:nullStr:
    .asciiz "null"
6511:trueString:
    .asciiz "true"
6516:falseString:
    .asciiz "false"
6522:exitString:
    .ascii "Program terminated."
    #### "falls through" here
6541:newlineString:
    .asciiz "\n"
    
    .align 2
6544:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

6548:seg0_start:
    .space 0x100000
1055124:seg0_end:
1055124:seg1_start:
    .space 0x100000
2103700:seg1_end:
