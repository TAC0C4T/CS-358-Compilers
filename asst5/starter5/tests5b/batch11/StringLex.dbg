3528#    lw $t2,($sp)
3532#    sb $t2,-9($t0)
3536#    addu $sp,$sp,4
3540#    subu $t0,$t0,1
3544#    bne $sp,$t1,charCopyLoop
3548:  rlReturn:

3548#    lw $ra, 4($sp)
3552#    addu $sp, 8   # pop $ra and pointless word off stack
3556#    move $t0, $s7 # return string we allocated in $s7
3560#    jr $ra
