###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
3328:mth_readLine_Lib:
    
3328#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
3332#    sw $ra, 4($sp) # save $ra
3336#    move $t1,$sp # save "original" sp

3340:  doRead:

    # read the character
3340#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
3344#    subu $t2,$v0,13
3348#    bne $t2,$zero,notReturnRL
3352#    jal readLogicalChar
3356#    subu $t2,$v0,10 # check for newline
3360#    beq $t2,$zero,foundNewLine
3364#    sw $v0,lastCharRead # push back character into queue
3368#    j foundNewLine # go process the line

3372:  notReturnRL:

    # at this point, $v0 has our character

3372#    subu $t0,$v0,10
3376#    beq $t0,$zero,foundNewLine
3380#    blt $v0,$zero,foundEof
3381##...slt $at,$v0,$zero
3385##...bne $at,$zero,3400

    # we have a character, so push it onto stack
3388#    subu $sp,$sp,4
3392#    sw $v0,($sp)

    # loop back up to get next character
3396#    j doRead

3400:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
3400#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
3404#    li $s7, 0 # return-value: null
3408#    j rlReturn # return

3412:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
3412#    subu $t0,$t1,$sp # number of chars we read (times 4)
3416#    srl $s6,$t0,2 # number of words on stack with chars
3420#    subu $sp,$sp,4 # push char-count ...
3424#    sw $s6,($sp) # ... onto stack
3428#    addu $t2,$t0,5 # GC tag, incl. for count-word
3432#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
3436#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
3440#    srl $s6,$s6,2  # data words in object
3444#    move $s7,$zero # object words in object
3448#    jal newObject  # allocate space
    
    # store header words
3452#    la $t0,CLASS_String
3456#    sw $t0,-12($s7)# store class tag (String) into object
3460#    lw $t2,4($sp) # char-count
3464#    sll $t1,$t2,2 # 4 times number of chars
3468#    subu $t2,$zero,$t2 # negative of char-count
3472#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
3476#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
3480#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
3481##...slt $at,$t0,$zero
3485##...beq $at,$zero,3504
3488#    and $t0,0xff # mask off object's hash value ...
3489##...lui $at,0
3493##...ori $at,$at,0xff
3497##...and $t0,$t0,$at
3500#    sw $t0,-8($s7) # ... and store back into -8 header-word
3504:  skipMask_readLine:

3504#    sll $t0,$t0,2 # data bytes in object
3508#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
3512#    subu $t0,$t0,$t2 # place to store last character (plus 9)
3516#    addu $sp,$sp,8 # pop redundant object-pointer and count
3520#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character
