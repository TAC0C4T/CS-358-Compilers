##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1892:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
1892#    lw $t0,-8($s2) # get word with hash bits from this
1896#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
1900#    addu $t0,$t1

1904#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1908:mth_equals_Object:
1908#    move $t0,$s2 # first pointer (this)
1912#    lw $t1,($sp) # second pointer
1916#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
1917##...subu $at,$t0,$t1
1921##...sltiu $t0,$at,1

1924#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1928:mth_hashCode_String:
1928#    move $t0,$s2 # put this pointer in t0

1932#    li $t2,0 # current hash value
1936#    lw $t1,-4($t0) # negative of number of characters in string
1940#    beq $t1,$zero,done_hashCode_String # if zero length => done
1944#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
1948#    and $t0,0xfffffffc # adjust for padding
1949##...lui $at,65535
1953##...ori $at,$at,0xfffc
1957##...and $t0,$t0,$at
1960#    subu $t1,$t0,$t1 # address at end of string +12
1964:loop_hashCode_String:    
1964#    sll $t4,$t2,5 # multiply by 32
1968#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
1972#    lbu $t3,-12($t0) # current character
1976#    addu $t2,$t3 # add in current character
1980#    addu $t0,1 # go to next character's address
1984#    bne $t0,$t1,loop_hashCode_String # loop back if more
1988:done_hashCode_String:    

    # push int on stack
1988#    move $t0, $t2 # put $t2 in return slot
1992#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1996:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1996#    subu $sp,4
2000#    sw $ra,($sp)
    
    # get hash value
2004#    lw $t2,-12($s2) # vtable address
2008#    lw $t0,($t2) # method address
2012#    jalr $t0
2016#    subu $sp,8 # push result (int in $t0) on stack
2020#    sw $s5,4($sp)
2024#    sw $t0,($sp)

    # compute print-size of hash value
2028#    li $t0, 1
2032#    lw $t1, ($sp)
2036#    srl $t1,$t1,4
2040#    beq $t1,$zero,toString_skip_loop
2044:toString_loop_top:
2044#    addu $t0,1
2048#    srl $t1,$t1,4
2052#    bne $t1,$zero,toString_loop_top
2056:toString_skip_loop:
2056#    subu $sp,8
2060#    sw $s5,4($sp)
2064#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
2068#    lw $t2,-12($s2) # vtable address
2072#    move $t0,$t2
2076:toString_checkTagBit:
2076#    subu $t0,1
2080#    lb $t1,($t0)
2084#    and $t1,0x80
2085##...lui $at,0
2089##...ori $at,$at,0x80
2093##...and $t1,$t1,$at
2096#    beq $t1,$zero,toString_checkTagBit
2100#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
2104#    subu $sp,8
2108#    sw $t1,($sp)
2112#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
2116#    move $s7,$zero # -4 offset header word
2120#    lw $t4,8($sp) # bytes for hash value
2124#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
2128#    addu $t4,8
2132#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
2136#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

2140#    li $t0,CLASS_String # store string vtable address into ...
2144#    sw $t0,-12($s7) # ... -12 offset in object header
2148#    lw $t2,-12($s2) # our object's vtable address
2152#    lw $t5,4($sp) # number characters in prefix
2156#    lw $t1,12($sp) # number of characters in hashcode
2160#    addu $t3,$t1,$t5 # number of characters in string ...
2164#    addu $t3,1 # ... including the '@' character
2168#    subu $t0,$zero,$t3 # store negated length into ...
2172#    sw $t0,-4($s7) # ... -4 offset header word
2176#    lw $t0,-8($s7) # get -8 offset header-word
2180#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
2181##...slt $at,$t0,$zero
2185##...beq $at,$zero,2204
2188#    and $t0,0xff # mask off object's hash value ...
2189##...lui $at,0
2193##...ori $at,$at,0xff
2197##...and $t0,$t0,$at
2200#    sw $t0,-8($s7) # ... and store back into -8 header-word
2204:skipMask_toString:
2204#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
2208#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
2212#    subu $t4,$t2,$t5
2216:toString_copyLoop:    
2216#    lb $t3,($t4)
2220#    and $t3,0x7f # mask off sign bit (in case first word)
2221##...lui $at,0
2225##...ori $at,$at,0x7f
2229##...and $t3,$t3,$at
2232#    sb $t3,-8($t0)
2236#    addu $t4,1
2240#    addu $t0,1
2244#    blt $t4,$t2,toString_copyLoop
2245##...slt $at,$t4,$t2
2249##...bne $at,$zero,2216

    # copy the '@' sign
2252#    li $t3,'@'
2256#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
2260#    addu $t2,$t0,$t1 # address of last byte in string to store +8
2264#    lw $t3,20($sp) # hash code to print
2268:toString_hashCopyLoop:
2268#    and $t4,$t3,0xf
2272#    srl $t3,4
2276#    lb $t4,hexChars($t4)
2280#    sb $t4,-8($t2)
2284#    subu $t2,$t2,1
2288#    bgt $t2,$t0,toString_hashCopyLoop
2289##...slt $at,$t0,$t2
2293##...bne $at,$zero,2268

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
2296#    addu $sp,28
2300#    lw $ra,($sp)
2304#    addu $sp,4
2308#    move $t0, $s7 # return string we created
2312#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
2316:mth_equals_String:
    
    # quick test for obvious false
2316#    lw $t0,($sp) # second parameter
2320#    beq $t0,$zero,goEsFalse # go return false if null
2324#    lw $t1,-12($t0) # vtable pointer
2328#    la $t2,CLASS_String # string vtable pointer
2332#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
2336#    subu $sp,12
2340#    sw $ra,8($sp)
2344#    sw $s2,4($sp)
2348#    sw $t0,($sp)
2352#    jal mth_compareTo_String
2356#    lw $s2, 4($sp) #restore this pointer and pop parameters
2360#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
2364#    seq $t0,$t0,$zero
2365##...subu $at,$t0,$zero
2369##...sltiu $t0,$at,1

    # pop return address and return $t0
2372#    lw $ra,($sp)
2376#    addu $sp,4

2380#    jr $ra # return
    
2384:goEsFalse:
    # put 0 in $t0 and return
2384#    li $t0, 0
2388#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
2392:mth_toString_String:
    #we are a string, so return this.
2392#    move $t0, $s2
2396#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
2400:mth_readLine_Lib:
    
2400#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
2404#    sw $ra, 4($sp) # save $ra
2408#    move $t1,$sp # save "original" sp

2412:  doRead:

    # read the character
2412#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
2416#    subu $t2,$v0,13
2420#    bne $t2,$zero,notReturnRL
2424#    jal readLogicalChar
2428#    subu $t2,$v0,10 # check for newline
2432#    beq $t2,$zero,foundNewLine
2436#    sw $v0,lastCharRead # push back character into queue
2440#    j foundNewLine # go process the line

2444:  notReturnRL:

    # at this point, $v0 has our character

2444#    subu $t0,$v0,10
2448#    beq $t0,$zero,foundNewLine
2452#    blt $v0,$zero,foundEof
2453##...slt $at,$v0,$zero
2457##...bne $at,$zero,2472

    # we have a character, so push it onto stack
2460#    subu $sp,$sp,4
2464#    sw $v0,($sp)

    # loop back up to get next character
2468#    j doRead

2472:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
2472#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
2476#    li $s7, 0 # return-value: null
2480#    j rlReturn # return

2484:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
2484#    subu $t0,$t1,$sp # number of chars we read (times 4)
2488#    srl $s6,$t0,2 # number of words on stack with chars
2492#    subu $sp,$sp,4 # push char-count ...
2496#    sw $s6,($sp) # ... onto stack
2500#    addu $t2,$t0,5 # GC tag, incl. for count-word
