########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4744:vm_init:

    # mark bottom of stack
4744#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4748#    move $s2,$zero

    #set up the "five" register
4752#    li $s5,5

4756#    la $s3,seg0_start
4760#    la $s4,seg0_end
4761##...lui $s4,16
4765##...addiu $s4,$s4,5604
    
    # return
4768#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4772:divide:
    # get parameters; abort if divisor zero
4772#    lw $t0,($sp)
4776#    lw $t1,8($sp)
4780#    beq $t0,$zero,divByZeroError
    
    # perform division
4784#    div $t1,$t0
4788#    mflo $t0

    # store result, adjust stack and return
4792#    addu $sp,$sp,8 # adjust stack
4796#    sw $t0,($sp) # store result
4800#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4804:remainder:
    # get parameters; abort if divisor zero
4804#    lw $t0,($sp)
4808#    lw $t1,8($sp)
4812#    beq $t0,$zero,divByZeroError
    
    # perform division
4816#    div $t1,$t0
4820#    mfhi $t0

    # store result, adjust stack and return
4824#    addu $sp,$sp,8 # adjust stack
4828#    sw $t0,($sp) # store result
4832#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4836:checkCast:
    # get object, allow immediately if null
4836#    lw $t2,($sp)
4840#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4844#    lw $t2,-12($t2) # vtable address
4848#    bge $t2,$t1,castException
4849##...slt $at,$t2,$t1
4853##...beq $at,$zero,4988
4856#    blt $t2,$t0,castException
4857##...slt $at,$t2,$t0
4861##...bne $at,$zero,4988
    
    # return, leaving object unchanged on stack
4864:  checkCastReturn:    
4864#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4868:instanceOf:
    # get object, go return false if null
4868#    lw $t2,($sp)
4872#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4876#    lw $t2,-12($t2) # vtable address
4880#    sge $t0,$t2,$t0 # are we >= the lower limit?
4881##...slt $t0,$t2,$t0
4885##...xori $t0,$t0,0x1
4888#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4892#    and $t2,$t0,$t1
4896#    sw $t2,($sp)
4900:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4900#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4904:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4904#    li $v0,4 # syscall-code for print-string
4908#    syscall
4912:exit:
    # print termination message
4912#    li $v0,4 # syscall-code for print-string
4916#    la $a0,exitString
4920#    syscall

    # terminate execution
4924#    li $v0,10 #syscall-code for "exit"
4928#    syscall

4932:outOfHeapMemory:
4932#    la $a0,heapMemoryMsg
4936#    j exitError
4940:divByZeroError:
4940#    la $a0,divByZeroMsg
4944#    j exitError
4948:strIndexOutOfBounds:
4948#    la $a0,strIndexOutOfBoundsMsg
4952#    j exitError
4956:arrayIndexOutOfBounds:
4956#    la $a0,arrayIndexOutOfBoundsMsg
4960#    j exitError
4964:arraySizeOutOfBounds:
4964#    la $a0,arraySizeOutOfBoundsMsg
4968#    j exitError
4972:nullPtrException:
4972#    la $a0,nullPtrExceptionMsg
4976#    j exitError
4980:badIntegerFormat:
4980#    la $a0,badIntegerFormatMsg
4984#    j exitError
4988:castException:
4988#    la $a0,castExceptionMsg
4992#    j exitError
############## data section ################
    .data
5240:hexChars:
    .ascii "0123456789abcdef"
    .align 2
5256:cur_seg:
    .word 0

5260:lastCharRead:
    .word -2 # -2 => no buffered character
5264:prevHashConstant:
    .word 0x2785173c
5268:gcCount:
    .word 0

5272:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
5299:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
5322:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
5357:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
5391:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
5424:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
5455:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
5503:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
5524:gcMsg: 
      .asciiz "\nGC!\n"
5530:gcCountMsg: 
      .asciiz "Number of garbage collections: "

5562:nullStr:
    .asciiz "null"
5567:trueString:
    .asciiz "true"
5572:falseString:
    .asciiz "false"
5578:exitString:
    .ascii "Program terminated."
    #### "falls through" here
5597:newlineString:
    .asciiz "\n"
    
    .align 2
5600:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

5604:seg0_start:
    .space 0x100000
1054180:seg0_end:
1054180:seg1_start:
    .space 0x100000
2102756:seg1_end:
