
    # determine if we have enough memory available
3980#    addu $t0,$s6,$s7
3984#    sll $t0,$t0,2
3988#    addu $t0,$t0,8 # amount of memory needed
3992#    addu $t1,$t0,$s3
3996#    bgtu $t1,$s4,doGC
