2664#    subu $t0,$v0,10
2668#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
2672#    subu $t0,$v0,9
2676#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
2680#    subu $t0,$v0,13
2684#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
2688#    subu $t0,$v0,12
