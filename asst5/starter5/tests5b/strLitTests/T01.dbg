2277##...addiu $at,$at,-28718
2281##...addu $t1,$at,$t1
2284#    sw $t1,prevHashConstant # update hash constant
2288#    or $t1,0x80000000 # set top bit
2289##...lui $at,32768
2293##...or $t1,$at,$t1
2296#    and $t1,0xffffff00 # clear low bit
2297##...lui $at,65535
2301##...ori $at,$at,0xff00
2305##...and $t1,$t1,$at
2308#    or $s6,$t1
2312:firstHeaderLarge:
2312#    sw $s6,-8($t0) # store header-1 value
2316#    lw $zero,-8($t0)

    # store second header-value
2320#    sw $s7,-4($t0)   # second header-word
2324#    lw $zero,-4($t0)
    
    # put return-value into $s7 and also push it onto top of stack
2328#    move $s7,$t0
2332#    subu $sp,$sp,4
2336#    sw $t0,($sp)
