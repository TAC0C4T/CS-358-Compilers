    # end-limit of the new segment, respectively,
    # Also, update cur_seg to refer to the other segment
2368#    lw $t0,cur_seg
2372#    move $t7,$s4
2376#    la $t6,seg1_start
2377##...lui $t6,16
2381##...addiu $t6,$t6,3804
2384#    la $s3,seg0_start
2388#    la $s4,seg0_end
2389##...lui $s4,16
2393##...addiu $s4,$s4,3804
2396#    sw $zero,cur_seg
2400#    bne $t0,$zero,skipGc1
2404#    la $t6,seg0_start
2408#    la $s3,seg1_start
2409##...lui $s3,16
2413##...addiu $s3,$s3,3804
