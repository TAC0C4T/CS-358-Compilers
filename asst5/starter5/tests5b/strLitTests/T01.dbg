3076#    blt $t2,$t0,castException
3077##...slt $at,$t2,$t0
3081##...bne $at,$zero,3208
    
    # return, leaving object unchanged on stack
3084:  checkCastReturn:    
3084#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3088:instanceOf:
    # get object, go return false if null
3088#    lw $t2,($sp)
3092#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3096#    lw $t2,-12($t2) # vtable address
3100#    sge $t0,$t2,$t0 # are we >= the lower limit?
3101##...slt $t0,$t2,$t0
3105##...xori $t0,$t0,0x1
3108#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3112#    and $t2,$t0,$t1
3116#    sw $t2,($sp)
3120:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3120#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3124:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3124#    li $v0,4 # syscall-code for print-string
3128#    syscall
3132:exit:
    # print termination message
3132#    li $v0,4 # syscall-code for print-string
3136#    la $a0,exitString
3140#    syscall

    # terminate execution
3144#    li $v0,10 #syscall-code for "exit"
3148#    syscall

3152:outOfHeapMemory:
3152#    la $a0,heapMemoryMsg
3156#    j exitError
3160:divByZeroError:
3160#    la $a0,divByZeroMsg
3164#    j exitError
3168:strIndexOutOfBounds:
3168#    la $a0,strIndexOutOfBoundsMsg
3172#    j exitError
3176:arrayIndexOutOfBounds:
3176#    la $a0,arrayIndexOutOfBoundsMsg
3180#    j exitError
3184:arraySizeOutOfBounds:
3184#    la $a0,arraySizeOutOfBoundsMsg
3188#    j exitError
3192:nullPtrException:
3192#    la $a0,nullPtrExceptionMsg
3196#    j exitError
3200:badIntegerFormat:
3200#    la $a0,badIntegerFormatMsg
3204#    j exitError
3208:castException:
3208#    la $a0,castExceptionMsg
3212#    j exitError
############## data section ################
    .data
3440:hexChars:
    .ascii "0123456789abcdef"
    .align 2
3456:cur_seg:
    .word 0

3460:lastCharRead:
    .word -2 # -2 => no buffered character
3464:prevHashConstant:
    .word 0x2785173c
3468:gcCount:
    .word 0

3472:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
3499:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
3522:strIndexOutOfBoundsMsg:
