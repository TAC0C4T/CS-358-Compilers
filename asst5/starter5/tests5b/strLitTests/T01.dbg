.data
3436:strLit_3:
.asciiz "abc"
.align 2
.text
.globl main
0:main:
0#  jal vm_init
4#  li $v0, 10
8#  syscall
12:mth_setX_A:
12#  la $t0, strLit_3
16#  subu $sp, $sp, 4
20#  sw $t0, ($sp)
24#  jr $ra
28:mth_setX_B:
28#  la $t0, strLit_3
32#  subu $sp, $sp, 4
36#  sw $t0, ($sp)
40#  jr $ra
44:mth_main_Main:
44#  lw $t0, 0($t0)
48#  subu $sp, $sp, 4
52#  sw $t0, ($sp)
56#  lw $t0, 0($t0)
60#  subu $sp, $sp, 4
64#  sw $t0, ($sp)
68#  lw $t2, ($sp)
72#  addu $sp, $sp, 4
76#  lw $t1, ($sp)
80#  addu $sp, $sp, 4
84#  seq $t0, $t1, $t2
85##...subu $at,$t1,$t2
89##...sltiu $t0,$at,1
92#  subu $sp, $sp, 4
96#  sw $t0, ($sp)
100#  subu $sp, $sp, 4
104#  sw $s2, ($sp)
108#  jr $ra
##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
112:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
112#    lw $t0,-8($s2) # get word with hash bits from this
116#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
120#    addu $t0,$t1

124#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
128:mth_equals_Object:
128#    move $t0,$s2 # first pointer (this)
132#    lw $t1,($sp) # second pointer
136#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
137##...subu $at,$t0,$t1
141##...sltiu $t0,$at,1

144#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
148:mth_hashCode_String:
148#    move $t0,$s2 # put this pointer in t0

152#    li $t2,0 # current hash value
156#    lw $t1,-4($t0) # negative of number of characters in string
160#    beq $t1,$zero,done_hashCode_String # if zero length => done
164#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
168#    and $t0,0xfffffffc # adjust for padding
169##...lui $at,65535
173##...ori $at,$at,0xfffc
177##...and $t0,$t0,$at
180#    subu $t1,$t0,$t1 # address at end of string +12
184:loop_hashCode_String:    
184#    sll $t4,$t2,5 # multiply by 32
188#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
192#    lbu $t3,-12($t0) # current character
196#    addu $t2,$t3 # add in current character
200#    addu $t0,1 # go to next character's address
204#    bne $t0,$t1,loop_hashCode_String # loop back if more
208:done_hashCode_String:    

    # push int on stack
208#    move $t0, $t2 # put $t2 in return slot
212#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
216:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
216#    subu $sp,4
220#    sw $ra,($sp)
    
    # get hash value
224#    lw $t2,-12($s2) # vtable address
228#    lw $t0,($t2) # method address
232#    jalr $t0
236#    subu $sp,8 # push result (int in $t0) on stack
240#    sw $s5,4($sp)
244#    sw $t0,($sp)

    # compute print-size of hash value
248#    li $t0, 1
252#    lw $t1, ($sp)
256#    srl $t1,$t1,4
260#    beq $t1,$zero,toString_skip_loop
264:toString_loop_top:
264#    addu $t0,1
268#    srl $t1,$t1,4
272#    bne $t1,$zero,toString_loop_top
276:toString_skip_loop:
276#    subu $sp,8
280#    sw $s5,4($sp)
284#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
288#    lw $t2,-12($s2) # vtable address
292#    move $t0,$t2
296:toString_checkTagBit:
296#    subu $t0,1
300#    lb $t1,($t0)
304#    and $t1,0x80
305##...lui $at,0
309##...ori $at,$at,0x80
313##...and $t1,$t1,$at
316#    beq $t1,$zero,toString_checkTagBit
320#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
324#    subu $sp,8
328#    sw $t1,($sp)
332#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
336#    move $s7,$zero # -4 offset header word
340#    lw $t4,8($sp) # bytes for hash value
344#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
348#    addu $t4,8
352#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
356#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

360#    li $t0,CLASS_String # store string vtable address into ...
364#    sw $t0,-12($s7) # ... -12 offset in object header
368#    lw $t2,-12($s2) # our object's vtable address
372#    lw $t5,4($sp) # number characters in prefix
376#    lw $t1,12($sp) # number of characters in hashcode
380#    addu $t3,$t1,$t5 # number of characters in string ...
384#    addu $t3,1 # ... including the '@' character
388#    subu $t0,$zero,$t3 # store negated length into ...
392#    sw $t0,-4($s7) # ... -4 offset header word
396#    lw $t0,-8($s7) # get -8 offset header-word
400#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
401##...slt $at,$t0,$zero
405##...beq $at,$zero,424
408#    and $t0,0xff # mask off object's hash value ...
409##...lui $at,0
413##...ori $at,$at,0xff
417##...and $t0,$t0,$at
420#    sw $t0,-8($s7) # ... and store back into -8 header-word
424:skipMask_toString:
424#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
428#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
432#    subu $t4,$t2,$t5
436:toString_copyLoop:    
436#    lb $t3,($t4)
440#    and $t3,0x7f # mask off sign bit (in case first word)
441##...lui $at,0
445##...ori $at,$at,0x7f
449##...and $t3,$t3,$at
452#    sb $t3,-8($t0)
456#    addu $t4,1
460#    addu $t0,1
464#    blt $t4,$t2,toString_copyLoop
465##...slt $at,$t4,$t2
469##...bne $at,$zero,436

    # copy the '@' sign
472#    li $t3,'@'
476#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
480#    addu $t2,$t0,$t1 # address of last byte in string to store +8
484#    lw $t3,20($sp) # hash code to print
488:toString_hashCopyLoop:
488#    and $t4,$t3,0xf
492#    srl $t3,4
496#    lb $t4,hexChars($t4)
500#    sb $t4,-8($t2)
504#    subu $t2,$t2,1
508#    bgt $t2,$t0,toString_hashCopyLoop
509##...slt $at,$t0,$t2
513##...bne $at,$zero,488

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
516#    addu $sp,28
520#    lw $ra,($sp)
524#    addu $sp,4
528#    move $t0, $s7 # return string we created
532#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
536:mth_equals_String:
    
    # quick test for obvious false
536#    lw $t0,($sp) # second parameter
540#    beq $t0,$zero,goEsFalse # go return false if null
544#    lw $t1,-12($t0) # vtable pointer
548#    la $t2,CLASS_String # string vtable pointer
552#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
556#    subu $sp,12
560#    sw $ra,8($sp)
564#    sw $s2,4($sp)
568#    sw $t0,($sp)
572#    jal mth_compareTo_String
576#    lw $s2, 4($sp) #restore this pointer and pop parameters
580#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
584#    seq $t0,$t0,$zero
585##...subu $at,$t0,$zero
589##...sltiu $t0,$at,1

    # pop return address and return $t0
592#    lw $ra,($sp)
596#    addu $sp,4

600#    jr $ra # return
    
604:goEsFalse:
    # put 0 in $t0 and return
604#    li $t0, 0
608#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
612:mth_toString_String:
    #we are a string, so return this.
612#    move $t0, $s2
616#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
620:mth_readLine_Lib:
    
620#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
624#    sw $ra, 4($sp) # save $ra
628#    move $t1,$sp # save "original" sp

632:  doRead:

    # read the character
632#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
636#    subu $t2,$v0,13
640#    bne $t2,$zero,notReturnRL
644#    jal readLogicalChar
648#    subu $t2,$v0,10 # check for newline
652#    beq $t2,$zero,foundNewLine
