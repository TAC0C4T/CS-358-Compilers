2156#    lw $v0,lastCharRead
2160#    li $t0,-2
2164#    beq $t0,$v0 doReadCh

    # we have our character from the buffer. Wipe out
    # buffer and return
2168#    sw $t0,lastCharRead # store -2 into buffer (i.e. "empty")
2172#    jr $ra # return
    
2176:  doReadCh:
    # we need to actually read a character: read and return
