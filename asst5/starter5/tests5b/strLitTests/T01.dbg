3557:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
3591:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
3624:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
3655:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
3703:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
3724:gcMsg: 
      .asciiz "\nGC!\n"
3730:gcCountMsg: 
      .asciiz "Number of garbage collections: "

3762:nullStr:
    .asciiz "null"
3767:trueString:
    .asciiz "true"
3772:falseString:
    .asciiz "false"
3778:exitString:
    .ascii "Program terminated."
    #### "falls through" here
3797:newlineString:
    .asciiz "\n"
    
    .align 2
3800:stack_bottom:
    .word 0
