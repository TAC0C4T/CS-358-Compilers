########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
2964:vm_init:

    # mark bottom of stack
2964#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
2968#    move $s2,$zero

    #set up the "five" register
2972#    li $s5,5

2976#    la $s3,seg0_start
2980#    la $s4,seg0_end
2981##...lui $s4,16
2985##...addiu $s4,$s4,3804
    
    # return
2988#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
2992:divide:
    # get parameters; abort if divisor zero
2992#    lw $t0,($sp)
2996#    lw $t1,8($sp)
3000#    beq $t0,$zero,divByZeroError
    
    # perform division
3004#    div $t1,$t0
3008#    mflo $t0

    # store result, adjust stack and return
3012#    addu $sp,$sp,8 # adjust stack
3016#    sw $t0,($sp) # store result
3020#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3024:remainder:
    # get parameters; abort if divisor zero
3024#    lw $t0,($sp)
3028#    lw $t1,8($sp)
3032#    beq $t0,$zero,divByZeroError
    
    # perform division
3036#    div $t1,$t0
3040#    mfhi $t0

    # store result, adjust stack and return
3044#    addu $sp,$sp,8 # adjust stack
3048#    sw $t0,($sp) # store result
3052#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
