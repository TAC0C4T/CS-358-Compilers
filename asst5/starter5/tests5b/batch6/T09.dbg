##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
328:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
328#    lw $t0,-8($s2) # get word with hash bits from this
332#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
336#    addu $t0,$t1

340#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
344:mth_equals_Object:
344#    move $t0,$s2 # first pointer (this)
348#    lw $t1,($sp) # second pointer
352#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
353##...subu $at,$t0,$t1
357##...sltiu $t0,$at,1

360#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
364:mth_hashCode_String:
364#    move $t0,$s2 # put this pointer in t0

368#    li $t2,0 # current hash value
372#    lw $t1,-4($t0) # negative of number of characters in string
376#    beq $t1,$zero,done_hashCode_String # if zero length => done
380#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
384#    and $t0,0xfffffffc # adjust for padding
385##...lui $at,65535
389##...ori $at,$at,0xfffc
393##...and $t0,$t0,$at
396#    subu $t1,$t0,$t1 # address at end of string +12
400:loop_hashCode_String:    
400#    sll $t4,$t2,5 # multiply by 32
404#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
408#    lbu $t3,-12($t0) # current character
412#    addu $t2,$t3 # add in current character
416#    addu $t0,1 # go to next character's address
420#    bne $t0,$t1,loop_hashCode_String # loop back if more
424:done_hashCode_String:    

    # push int on stack
424#    move $t0, $t2 # put $t2 in return slot
428#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
432:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
432#    subu $sp,4
436#    sw $ra,($sp)
    
    # get hash value
440#    lw $t2,-12($s2) # vtable address
444#    lw $t0,($t2) # method address
448#    jalr $t0
452#    subu $sp,8 # push result (int in $t0) on stack
456#    sw $s5,4($sp)
460#    sw $t0,($sp)

    # compute print-size of hash value
464#    li $t0, 1
468#    lw $t1, ($sp)
472#    srl $t1,$t1,4
476#    beq $t1,$zero,toString_skip_loop
480:toString_loop_top:
480#    addu $t0,1
484#    srl $t1,$t1,4
488#    bne $t1,$zero,toString_loop_top
492:toString_skip_loop:
492#    subu $sp,8
496#    sw $s5,4($sp)
500#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
504#    lw $t2,-12($s2) # vtable address
508#    move $t0,$t2
512:toString_checkTagBit:
512#    subu $t0,1
516#    lb $t1,($t0)
520#    and $t1,0x80
521##...lui $at,0
525##...ori $at,$at,0x80
529##...and $t1,$t1,$at
532#    beq $t1,$zero,toString_checkTagBit
536#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
540#    subu $sp,8
544#    sw $t1,($sp)
548#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
552#    move $s7,$zero # -4 offset header word
556#    lw $t4,8($sp) # bytes for hash value
560#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
564#    addu $t4,8
568#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
572#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

576#    li $t0,CLASS_String # store string vtable address into ...
580#    sw $t0,-12($s7) # ... -12 offset in object header
584#    lw $t2,-12($s2) # our object's vtable address
588#    lw $t5,4($sp) # number characters in prefix
592#    lw $t1,12($sp) # number of characters in hashcode
596#    addu $t3,$t1,$t5 # number of characters in string ...
600#    addu $t3,1 # ... including the '@' character
604#    subu $t0,$zero,$t3 # store negated length into ...
608#    sw $t0,-4($s7) # ... -4 offset header word
612#    lw $t0,-8($s7) # get -8 offset header-word
616#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
617##...slt $at,$t0,$zero
621##...beq $at,$zero,640
624#    and $t0,0xff # mask off object's hash value ...
625##...lui $at,0
629##...ori $at,$at,0xff
633##...and $t0,$t0,$at
636#    sw $t0,-8($s7) # ... and store back into -8 header-word
640:skipMask_toString:
640#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
644#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
648#    subu $t4,$t2,$t5
652:toString_copyLoop:    
652#    lb $t3,($t4)
656#    and $t3,0x7f # mask off sign bit (in case first word)
657##...lui $at,0
661##...ori $at,$at,0x7f
665##...and $t3,$t3,$at
668#    sb $t3,-8($t0)
672#    addu $t4,1
676#    addu $t0,1
680#    blt $t4,$t2,toString_copyLoop
681##...slt $at,$t4,$t2
685##...bne $at,$zero,652

    # copy the '@' sign
688#    li $t3,'@'
692#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
696#    addu $t2,$t0,$t1 # address of last byte in string to store +8
700#    lw $t3,20($sp) # hash code to print
704:toString_hashCopyLoop:
704#    and $t4,$t3,0xf
708#    srl $t3,4
712#    lb $t4,hexChars($t4)
716#    sb $t4,-8($t2)
720#    subu $t2,$t2,1
724#    bgt $t2,$t0,toString_hashCopyLoop
725##...slt $at,$t0,$t2
729##...bne $at,$zero,704

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
732#    addu $sp,28
736#    lw $ra,($sp)
740#    addu $sp,4
744#    move $t0, $s7 # return string we created
748#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
752:mth_equals_String:
    
    # quick test for obvious false
752#    lw $t0,($sp) # second parameter
