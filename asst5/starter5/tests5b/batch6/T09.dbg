40#  sw $t0, 0($sp)
44#  subu $sp, $sp, 4
48#  sw $s2, ($sp)
52#  lw $t0, -16($t0)
56#  subu $sp, $sp, 4
60#  sw $t0, ($sp)
64#  li $t0, 72
68#  subu $sp, $sp, 8
72#  sw $s5, 4($sp)
76#  sw $t0, 0($sp)
80#  lw $t0, -20($t0)
84#  subu $sp, $sp, 4
