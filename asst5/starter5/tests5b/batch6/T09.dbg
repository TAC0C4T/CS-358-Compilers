1093##...bne $at,$zero,1136
1096#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1100#    subu $t0,$v0,10
1104#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1108#    subu $t0,$v0,9
1112#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1116#    subu $t0,$v0,13
1120#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1124#    subu $t0,$v0,12
1128#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1132#    j badIntegerFormat # illegal integer char: abort program

1136:  nonWhite:
1136#    subu $t0,$v0,'-'
1140#    li $t4,1 # final multiplier
1144#    bne $t0,$zero,helpReadInt # go read
1148#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1152#    jal readLogicalChar

1156:  helpReadInt:
1156#    li $t2,10
1160#    subu $t1,$v0,'0' # convert digit to 0-9 value
1164#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
1165##...sltu $at,$t1,$t2
1169##...beq $at,$zero,3416
1172#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

1176:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

1176#    jal readLogicalChar # read next character
1180#    subu $t1,$v0,'0' # convert digit to 0-9 value
1184#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
1185##...sltu $at,$t1,$t2
1189##...beq $at,$zero,1208

1192#    mul $t3,$t3,$t2 # multiply old value by 10
1193##...mult $t3,$t2
1197##...mflo $t3
1200#    addu $t3,$t3,$t1 # add in value of new digit
1204#    j digitLoop

1208:  doneDigitLoop:

    # "push back" unused character into queue
1208#    sw $v0,lastCharRead
