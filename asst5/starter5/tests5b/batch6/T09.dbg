
    #set up the "five" register
3188#    li $s5,5

3192#    la $s3,seg0_start
3196#    la $s4,seg0_end
3197##...lui $s4,16
3201##...addiu $s4,$s4,4064
    
    # return
3204#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3208:divide:
    # get parameters; abort if divisor zero
3208#    lw $t0,($sp)
3212#    lw $t1,8($sp)
3216#    beq $t0,$zero,divByZeroError
    
    # perform division
3220#    div $t1,$t0
3224#    mflo $t0

    # store result, adjust stack and return
3228#    addu $sp,$sp,8 # adjust stack
3232#    sw $t0,($sp) # store result
3236#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3240:remainder:
    # get parameters; abort if divisor zero
3240#    lw $t0,($sp)
3244#    lw $t1,8($sp)
3248#    beq $t0,$zero,divByZeroError
    
    # perform division
3252#    div $t1,$t0
3256#    mfhi $t0

    # store result, adjust stack and return
3260#    addu $sp,$sp,8 # adjust stack
3264#    sw $t0,($sp) # store result
3268#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3272:checkCast:
    # get object, allow immediately if null
3272#    lw $t2,($sp)
3276#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3280#    lw $t2,-12($t2) # vtable address
3284#    bge $t2,$t1,castException
3285##...slt $at,$t2,$t1
3289##...beq $at,$zero,3424
3292#    blt $t2,$t0,castException
3293##...slt $at,$t2,$t0
3297##...bne $at,$zero,3424
    
    # return, leaving object unchanged on stack
3300:  checkCastReturn:    
3300#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3304:instanceOf:
    # get object, go return false if null
3304#    lw $t2,($sp)
3308#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3312#    lw $t2,-12($t2) # vtable address
3316#    sge $t0,$t2,$t0 # are we >= the lower limit?
3317##...slt $t0,$t2,$t0
3321##...xori $t0,$t0,0x1
3324#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3328#    and $t2,$t0,$t1
3332#    sw $t2,($sp)
3336:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3336#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3340:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3340#    li $v0,4 # syscall-code for print-string
3344#    syscall
3348:exit:
    # print termination message
3348#    li $v0,4 # syscall-code for print-string
3352#    la $a0,exitString
3356#    syscall

    # terminate execution
3360#    li $v0,10 #syscall-code for "exit"
3364#    syscall

3368:outOfHeapMemory:
3368#    la $a0,heapMemoryMsg
3372#    j exitError
3376:divByZeroError:
3376#    la $a0,divByZeroMsg
3380#    j exitError
3384:strIndexOutOfBounds:
3384#    la $a0,strIndexOutOfBoundsMsg
3388#    j exitError
3392:arrayIndexOutOfBounds:
3392#    la $a0,arrayIndexOutOfBoundsMsg
3396#    j exitError
3400:arraySizeOutOfBounds:
3400#    la $a0,arraySizeOutOfBoundsMsg
3404#    j exitError
3408:nullPtrException:
3408#    la $a0,nullPtrExceptionMsg
3412#    j exitError
3416:badIntegerFormat:
3416#    la $a0,badIntegerFormatMsg
3420#    j exitError
3424:castException:
3424#    la $a0,castExceptionMsg
3428#    j exitError
############## data section ################
    .data
3700:hexChars:
    .ascii "0123456789abcdef"
    .align 2
3716:cur_seg:
    .word 0

3720:lastCharRead:
    .word -2 # -2 => no buffered character
3724:prevHashConstant:
    .word 0x2785173c
3728:gcCount:
    .word 0

3732:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
3759:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
3782:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
3817:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
3851:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
3884:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
3915:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
3963:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
3984:gcMsg: 
      .asciiz "\nGC!\n"
3990:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4022:nullStr:
    .asciiz "null"
4027:trueString:
    .asciiz "true"
4032:falseString:
    .asciiz "false"
4038:exitString:
    .ascii "Program terminated."
    #### "falls through" here
4057:newlineString:
    .asciiz "\n"
    
    .align 2
4060:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

4064:seg0_start:
    .space 0x100000
1052640:seg0_end:
1052640:seg1_start:
    .space 0x100000
2101216:seg1_end:
