    # at this point:
    #  $s3 points to beginning of segment, and
    #  $t1 points just past the end

    # zero out the memory
2440#    move $t2,$s3
2444:  zeroObjLoop:
2444#    sw $zero,($s3)
2448#    lw $zero,($s3)

2452#    addu $s3,4
2456#    bltu $s3,$t1,zeroObjLoop
