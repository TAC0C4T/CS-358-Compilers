###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
836:mth_readLine_Lib:
    
836#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
840#    sw $ra, 4($sp) # save $ra
844#    move $t1,$sp # save "original" sp

848:  doRead:

    # read the character
848#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
852#    subu $t2,$v0,13
856#    bne $t2,$zero,notReturnRL
860#    jal readLogicalChar
864#    subu $t2,$v0,10 # check for newline
868#    beq $t2,$zero,foundNewLine
872#    sw $v0,lastCharRead # push back character into queue
876#    j foundNewLine # go process the line

880:  notReturnRL:

    # at this point, $v0 has our character

880#    subu $t0,$v0,10
884#    beq $t0,$zero,foundNewLine
888#    blt $v0,$zero,foundEof
889##...slt $at,$v0,$zero
893##...bne $at,$zero,908

    # we have a character, so push it onto stack
896#    subu $sp,$sp,4
900#    sw $v0,($sp)

    # loop back up to get next character
904#    j doRead

908:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
908#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
912#    li $s7, 0 # return-value: null
916#    j rlReturn # return

920:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
920#    subu $t0,$t1,$sp # number of chars we read (times 4)
924#    srl $s6,$t0,2 # number of words on stack with chars
928#    subu $sp,$sp,4 # push char-count ...
932#    sw $s6,($sp) # ... onto stack
936#    addu $t2,$t0,5 # GC tag, incl. for count-word
940#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
944#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
948#    srl $s6,$s6,2  # data words in object
952#    move $s7,$zero # object words in object
956#    jal newObject  # allocate space
    
    # store header words
960#    la $t0,CLASS_String
964#    sw $t0,-12($s7)# store class tag (String) into object
968#    lw $t2,4($sp) # char-count
972#    sll $t1,$t2,2 # 4 times number of chars
976#    subu $t2,$zero,$t2 # negative of char-count
980#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
984#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
988#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
989##...slt $at,$t0,$zero
993##...beq $at,$zero,1012
996#    and $t0,0xff # mask off object's hash value ...
997##...lui $at,0
1001##...ori $at,$at,0xff
1005##...and $t0,$t0,$at
1008#    sw $t0,-8($s7) # ... and store back into -8 header-word
1012:  skipMask_readLine:

1012#    sll $t0,$t0,2 # data bytes in object
1016#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1020#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1024#    addu $sp,$sp,8 # pop redundant object-pointer and count
1028#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

1032#    beq $sp,$t1,rlReturn
1036:  charCopyLoop:
1036#    lw $t2,($sp)
1040#    sb $t2,-9($t0)
1044#    addu $sp,$sp,4
1048#    subu $t0,$t0,1
1052#    bne $sp,$t1,charCopyLoop
1056:  rlReturn:

1056#    lw $ra, 4($sp)
1060#    addu $sp, 8   # pop $ra and pointless word off stack
1064#    move $t0, $s7 # return string we allocated in $s7
1068#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
