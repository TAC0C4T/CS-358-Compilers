###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1352:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
1352#    lw $t0,-8($s2) # get word with hash bits from this
1356#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
1360#    addu $t0,$t1

1364#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1368:mth_equals_Object:
1368#    move $t0,$s2 # first pointer (this)
1372#    lw $t1,($sp) # second pointer
1376#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
1377##...subu $at,$t0,$t1
1381##...sltiu $t0,$at,1

1384#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1388:mth_hashCode_String:
1388#    move $t0,$s2 # put this pointer in t0

1392#    li $t2,0 # current hash value
1396#    lw $t1,-4($t0) # negative of number of characters in string
1400#    beq $t1,$zero,done_hashCode_String # if zero length => done
1404#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
1408#    and $t0,0xfffffffc # adjust for padding
1409##...lui $at,65535
1413##...ori $at,$at,0xfffc
1417##...and $t0,$t0,$at
1420#    subu $t1,$t0,$t1 # address at end of string +12
1424:loop_hashCode_String:    
1424#    sll $t4,$t2,5 # multiply by 32
1428#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
1432#    lbu $t3,-12($t0) # current character
1436#    addu $t2,$t3 # add in current character
1440#    addu $t0,1 # go to next character's address
1444#    bne $t0,$t1,loop_hashCode_String # loop back if more
1448:done_hashCode_String:    

    # push int on stack
1448#    move $t0, $t2 # put $t2 in return slot
1452#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1456:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1456#    subu $sp,4
1460#    sw $ra,($sp)
    
    # get hash value
1464#    lw $t2,-12($s2) # vtable address
1468#    lw $t0,($t2) # method address
1472#    jalr $t0
1476#    subu $sp,8 # push result (int in $t0) on stack
1480#    sw $s5,4($sp)
1484#    sw $t0,($sp)

    # compute print-size of hash value
1488#    li $t0, 1
1492#    lw $t1, ($sp)
1496#    srl $t1,$t1,4
1500#    beq $t1,$zero,toString_skip_loop
1504:toString_loop_top:
1504#    addu $t0,1
1508#    srl $t1,$t1,4
1512#    bne $t1,$zero,toString_loop_top
1516:toString_skip_loop:
1516#    subu $sp,8
1520#    sw $s5,4($sp)
1524#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1528#    lw $t2,-12($s2) # vtable address
1532#    move $t0,$t2
1536:toString_checkTagBit:
1536#    subu $t0,1
1540#    lb $t1,($t0)
1544#    and $t1,0x80
1545##...lui $at,0
1549##...ori $at,$at,0x80
1553##...and $t1,$t1,$at
1556#    beq $t1,$zero,toString_checkTagBit
1560#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1564#    subu $sp,8
1568#    sw $t1,($sp)
1572#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1576#    move $s7,$zero # -4 offset header word
1580#    lw $t4,8($sp) # bytes for hash value
1584#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1588#    addu $t4,8
1592#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1596#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1600#    li $t0,CLASS_String # store string vtable address into ...
1604#    sw $t0,-12($s7) # ... -12 offset in object header
1608#    lw $t2,-12($s2) # our object's vtable address
1612#    lw $t5,4($sp) # number characters in prefix
1616#    lw $t1,12($sp) # number of characters in hashcode
1620#    addu $t3,$t1,$t5 # number of characters in string ...
1624#    addu $t3,1 # ... including the '@' character
1628#    subu $t0,$zero,$t3 # store negated length into ...
1632#    sw $t0,-4($s7) # ... -4 offset header word
1636#    lw $t0,-8($s7) # get -8 offset header-word
1640#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1641##...slt $at,$t0,$zero
1645##...beq $at,$zero,1664
1648#    and $t0,0xff # mask off object's hash value ...
1649##...lui $at,0
1653##...ori $at,$at,0xff
1657##...and $t0,$t0,$at
1660#    sw $t0,-8($s7) # ... and store back into -8 header-word
1664:skipMask_toString:
1664#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1668#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1672#    subu $t4,$t2,$t5
1676:toString_copyLoop:    
1676#    lb $t3,($t4)
1680#    and $t3,0x7f # mask off sign bit (in case first word)
1681##...lui $at,0
1685##...ori $at,$at,0x7f
1689##...and $t3,$t3,$at
1692#    sb $t3,-8($t0)
1696#    addu $t4,1
1700#    addu $t0,1
1704#    blt $t4,$t2,toString_copyLoop
1705##...slt $at,$t4,$t2
1709##...bne $at,$zero,1676

    # copy the '@' sign
1712#    li $t3,'@'
1716#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1720#    addu $t2,$t0,$t1 # address of last byte in string to store +8
1724#    lw $t3,20($sp) # hash code to print
1728:toString_hashCopyLoop:
1728#    and $t4,$t3,0xf
1732#    srl $t3,4
1736#    lb $t4,hexChars($t4)
1740#    sb $t4,-8($t2)
1744#    subu $t2,$t2,1
1748#    bgt $t2,$t0,toString_hashCopyLoop
1749##...slt $at,$t0,$t2
1753##...bne $at,$zero,1728

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
1756#    addu $sp,28
1760#    lw $ra,($sp)
1764#    addu $sp,4
1768#    move $t0, $s7 # return string we created
1772#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
1776:mth_equals_String:
    
    # quick test for obvious false
1776#    lw $t0,($sp) # second parameter
1780#    beq $t0,$zero,goEsFalse # go return false if null
1784#    lw $t1,-12($t0) # vtable pointer
1788#    la $t2,CLASS_String # string vtable pointer
1792#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
1796#    subu $sp,12
1800#    sw $ra,8($sp)
1804#    sw $s2,4($sp)
1808#    sw $t0,($sp)
1812#    jal mth_compareTo_String
1816#    lw $s2, 4($sp) #restore this pointer and pop parameters
1820#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
1824#    seq $t0,$t0,$zero
1825##...subu $at,$t0,$zero
1829##...sltiu $t0,$at,1

    # pop return address and return $t0
1832#    lw $ra,($sp)
1836#    addu $sp,4

1840#    jr $ra # return
    
1844:goEsFalse:
    # put 0 in $t0 and return
1844#    li $t0, 0
1848#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
1852:mth_toString_String:
    #we are a string, so return this.
1852#    move $t0, $s2
1856#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1860:mth_readLine_Lib:
    
1860#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1864#    sw $ra, 4($sp) # save $ra
1868#    move $t1,$sp # save "original" sp

1872:  doRead:

    # read the character
1872#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1876#    subu $t2,$v0,13
1880#    bne $t2,$zero,notReturnRL
1884#    jal readLogicalChar
1888#    subu $t2,$v0,10 # check for newline
1892#    beq $t2,$zero,foundNewLine
1896#    sw $v0,lastCharRead # push back character into queue
1900#    j foundNewLine # go process the line

1904:  notReturnRL:

    # at this point, $v0 has our character

1904#    subu $t0,$v0,10
1908#    beq $t0,$zero,foundNewLine
1912#    blt $v0,$zero,foundEof
1913##...slt $at,$v0,$zero
1917##...bne $at,$zero,1932

    # we have a character, so push it onto stack
1920#    subu $sp,$sp,4
1924#    sw $v0,($sp)

    # loop back up to get next character
1928#    j doRead

1932:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1932#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1936#    li $s7, 0 # return-value: null
1940#    j rlReturn # return

1944:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1944#    subu $t0,$t1,$sp # number of chars we read (times 4)
1948#    srl $s6,$t0,2 # number of words on stack with chars
1952#    subu $sp,$sp,4 # push char-count ...
1956#    sw $s6,($sp) # ... onto stack
1960#    addu $t2,$t0,5 # GC tag, incl. for count-word
1964#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1968#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1972#    srl $s6,$s6,2  # data words in object
1976#    move $s7,$zero # object words in object
1980#    jal newObject  # allocate space
    
    # store header words
1984#    la $t0,CLASS_String
1988#    sw $t0,-12($s7)# store class tag (String) into object
1992#    lw $t2,4($sp) # char-count
1996#    sll $t1,$t2,2 # 4 times number of chars
2000#    subu $t2,$zero,$t2 # negative of char-count
2004#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
2008#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
2012#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
2013##...slt $at,$t0,$zero
2017##...beq $at,$zero,2036
2020#    and $t0,0xff # mask off object's hash value ...
2021##...lui $at,0
2025##...ori $at,$at,0xff
2029##...and $t0,$t0,$at
2032#    sw $t0,-8($s7) # ... and store back into -8 header-word
2036:  skipMask_readLine:

2036#    sll $t0,$t0,2 # data bytes in object
2040#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
2044#    subu $t0,$t0,$t2 # place to store last character (plus 9)
2048#    addu $sp,$sp,8 # pop redundant object-pointer and count
2052#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

2056#    beq $sp,$t1,rlReturn
2060:  charCopyLoop:
2060#    lw $t2,($sp)
2064#    sb $t2,-9($t0)
2068#    addu $sp,$sp,4
2072#    subu $t0,$t0,1
2076#    bne $sp,$t1,charCopyLoop
2080:  rlReturn:

2080#    lw $ra, 4($sp)
2084#    addu $sp, 8   # pop $ra and pointless word off stack
2088#    move $t0, $s7 # return string we allocated in $s7
2092#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
2096:mth_readInt_Lib:

    # save $ra by pushing onto stack
2096#    subu $sp,$sp,4
2100#    sw $ra,($sp)

2104:  riSkipWhiteLoop:
    # read a character
2104#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
2108#    subu $t0,$v0,32
2112#    bgt $t0,$zero,nonWhite
2113##...slt $at,$zero,$t0
2117##...bne $at,$zero,2160
2120#    beq $t0,$zero,riSkipWhiteLoop # start over if space
2124#    subu $t0,$v0,10
2128#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
2132#    subu $t0,$v0,9
2136#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
2140#    subu $t0,$v0,13
2144#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
2148#    subu $t0,$v0,12
2152#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
2156#    j badIntegerFormat # illegal integer char: abort program

2160:  nonWhite:
2160#    subu $t0,$v0,'-'
2164#    li $t4,1 # final multiplier
2168#    bne $t0,$zero,helpReadInt # go read
2172#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
2176#    jal readLogicalChar

2180:  helpReadInt:
2180#    li $t2,10
2184#    subu $t1,$v0,'0' # convert digit to 0-9 value
2188#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
2189##...sltu $at,$t1,$t2
2193##...beq $at,$zero,4440
2196#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

2200:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

2200#    jal readLogicalChar # read next character
2204#    subu $t1,$v0,'0' # convert digit to 0-9 value
2208#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
2209##...sltu $at,$t1,$t2
2213##...beq $at,$zero,2232

2216#    mul $t3,$t3,$t2 # multiply old value by 10
