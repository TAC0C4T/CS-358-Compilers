    # moving additional objects
    #############################################################

    #########################################################
    # At this point:
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # We want to set things up so that in addition:
    # - $t0 is the "trailing finger", containing the address
    #   of the first slot in target space that we have yet
    #   to process.
    # Then during processing:
    # - $t1 will contain the contents of the heap slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # And when we're actually copying an object:
    # - $t2 will contain pointer to the target object
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - available for use: $s0
    ##########################################################

    # set $t0 to be at the beginning of target-space
3872#    lw $t1,cur_seg
3876#    la $t0,seg0_start
3880#    beq $t1,$zero,gcSkip4
3884#    la $t0,seg1_start
3885##...lui $t0,16
3889##...addiu $t0,$t0,5072


3892:  gcSkip4:

    # if there were no objects put into the heap during stack
    # processing, we're done, so go finish up
3892#    bgeu $t0,$s3,gcFinishUp
3893##...sltu $at,$t0,$s3
3897##...beq $at,$zero,4188

    ###### begin outer loop to copy all non-stack-direct objects ######

3900:  gcHeapCopyLoop:
    # get data count for object; swap header-word with first word
    # of object so that they're back in the right place
3900#    lw $t1,($t0) # (what will be) first header word for current object
3904#    move $t2,$t1 # number data bytes in object (poss. w/hash bits)
3908#    bge $t2,$zero,gcSkip4a # are there hash bits?
3909##...slt $at,$t2,$zero
3913##...beq $at,$zero,3928
3916#    and $t2,0xff # mask off hash bits
3917##...lui $at,0
3921##...ori $at,$at,0xff
3925##...and $t2,$t2,$at
3928:gcSkip4a:    
3928#    sll $t2,$t2,2 # # data bytes
3932#    addu $t2,$t2,8 # to skip header words
3936#    addu $t2,$t0,$t2 # pointer to new object
3940#    lw $t3,-8($t2) # word to swap
3944#    sw $t1,-8($t2) # store header word
3948#    sw $t3,($t0) # restore first word of object

    ################################################
    # at this point:
    # - $t2 contains the pointer to our new object
    ################################################

    # check if we have a data array
3952#    lw $t1,-12($t2) # vtable pointer
3956#    li $t0,dataArrayVTableStart # address of vtable for first data array
3960#    blt $t1,$t0,gcNotDataArray # if data array, no more xforming to do
3961##...slt $at,$t1,$t0
3965##...bne $at,$zero,3984

    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
3968:  skipToNextObj:
3968#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
3972#    sll $t1,$t1,2 # convert to byte-count
3976#    addu $t0,$t2,$t1 # skip over object
3980#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
3984:  gcNotDataArray:
3984#    lw $t3,-4($t2) # # object words (negative treated as zero)
3988#    bge $t3,$zero,gcH2Neg2
3989##...slt $at,$t3,$zero
3993##...beq $at,$zero,4000
3996#    move $t3,$zero
4000:  gcH2Neg2:
4000#    sll $t3,$t3,2 # # object bytes
4004#    move $t0,$t2 # address of first pointer in object
4008#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
4012#    beq $t0,$s1,gcTestIterDone2
    
4016:  gcNextPointerInObject:
    # get pointer from object
4016#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
4020#    bleu $t1,$t6,gcGoNextPointerSlot
4021##...sltu $at,$t6,$t1
4025##...beq $at,$zero,4168
4028#    bgtu $t1,$t7,gcGoNextPointerSlot
4029##...sltu $at,$t7,$t1
4033##...bne $at,$zero,4168

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
4036#    lw $t8,-8($t1) # possible forwarding tag
4040#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
4044#    lw $t8,-4($t1) # forwarding pointer: object's new address
4048#    sw $t8,($t0) # update pointer in object
4052#    j gcGoNextPointerSlot # do next iteration

4056:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
4056#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
4057##...slt $at,$t8,$zero
4061##...beq $at,$zero,4076
4064#    and $t8,0xff # mask off hash bits
4065##...lui $at,0
4069##...ori $at,$at,0xff
4073##...and $t8,$t8,$at

4076:  gcSkip5:
4076#    sll $t8,$t8,2 # bytes in negative-offset portion ...
4080#    addu $t8,$t8,8 # ... add in bytes for header-words
4084#    subu $t4,$t1,$t8 # address of first word of source object
4088#    lw $t3,-4($t1) # # words in positive-offset portion
4092#    bge $t3,$zero,gcNoNeg
4093##...slt $at,$t3,$zero
4097##...beq $at,$zero,4104
4100#    move $t3,$zero # negative treated as zero
4104:  gcNoNeg:
4104#    sll $t3,$t3,2 # bytes in negative-offset portion
4108#    addu $t3,$t3,$t1 # address one word past last word of source

4112#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
4116#    lw $s0,($t4)
4120#    lw $t9,-8($t1)
4124#    sw $t9,($t4)
4128#    sw $s0,-8($t1)

    # copy all source bytes to the target
4132:  gCinnerCopy2:
4132#    lw $s0,($t4)
4136#    sw $s0,($s3)
4140#    addu $t4,$t4,4
4144#    addu $s3,$s3,4
4148#    bltu $t4,$t3,gCinnerCopy2
4149##...sltu $at,$t4,$t3
4153##...bne $at,$zero,4132

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
4156#    sw $zero,-8($t1) # 0 in first header-slot
4160#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
4164#    sw $t8,($t0)

4168:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
4168#    addu $t0,$t0,4
4172#    bltu $t0,$s1,gcNextPointerInObject
4173##...sltu $at,$t0,$s1
4177##...bne $at,$zero,4016

4180:  gcTestIterDone2:
4180#    bltu $t0,$s3,gcHeapCopyLoop
4181##...sltu $at,$t0,$s3
4185##...bne $at,$zero,3900

    ###### end outer loop to copy all non-stack-direct objects ######

4188:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
4188#    lw $s2,($sp)
4192#    addu $sp,$sp,4

    # mark us as having already GC'd
4196#    move $t5,$s5

    # go try and allocate again
4200#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4204:vm_init:

    # mark bottom of stack
4204#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4208#    move $s2,$zero

    #set up the "five" register
4212#    li $s5,5

4216#    la $s3,seg0_start
4220#    la $s4,seg0_end
4221##...lui $s4,16
4225##...addiu $s4,$s4,5072
    
    # return
4228#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4232:divide:
    # get parameters; abort if divisor zero
4232#    lw $t0,($sp)
4236#    lw $t1,8($sp)
4240#    beq $t0,$zero,divByZeroError
    
    # perform division
4244#    div $t1,$t0
4248#    mflo $t0

    # store result, adjust stack and return
4252#    addu $sp,$sp,8 # adjust stack
4256#    sw $t0,($sp) # store result
4260#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4264:remainder:
    # get parameters; abort if divisor zero
4264#    lw $t0,($sp)
4268#    lw $t1,8($sp)
4272#    beq $t0,$zero,divByZeroError
    
    # perform division
4276#    div $t1,$t0
4280#    mfhi $t0

    # store result, adjust stack and return
4284#    addu $sp,$sp,8 # adjust stack
4288#    sw $t0,($sp) # store result
4292#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4296:checkCast:
    # get object, allow immediately if null
4296#    lw $t2,($sp)
4300#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4304#    lw $t2,-12($t2) # vtable address
4308#    bge $t2,$t1,castException
4309##...slt $at,$t2,$t1
4313##...beq $at,$zero,4448
4316#    blt $t2,$t0,castException
4317##...slt $at,$t2,$t0
4321##...bne $at,$zero,4448
    
    # return, leaving object unchanged on stack
4324:  checkCastReturn:    
4324#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4328:instanceOf:
    # get object, go return false if null
4328#    lw $t2,($sp)
4332#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4336#    lw $t2,-12($t2) # vtable address
4340#    sge $t0,$t2,$t0 # are we >= the lower limit?
4341##...slt $t0,$t2,$t0
4345##...xori $t0,$t0,0x1
4348#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4352#    and $t2,$t0,$t1
4356#    sw $t2,($sp)
4360:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4360#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4364:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4364#    li $v0,4 # syscall-code for print-string
4368#    syscall
4372:exit:
    # print termination message
4372#    li $v0,4 # syscall-code for print-string
4376#    la $a0,exitString
4380#    syscall

    # terminate execution
4384#    li $v0,10 #syscall-code for "exit"
4388#    syscall

4392:outOfHeapMemory:
4392#    la $a0,heapMemoryMsg
4396#    j exitError
4400:divByZeroError:
4400#    la $a0,divByZeroMsg
4404#    j exitError
4408:strIndexOutOfBounds:
4408#    la $a0,strIndexOutOfBoundsMsg
4412#    j exitError
4416:arrayIndexOutOfBounds:
4416#    la $a0,arrayIndexOutOfBoundsMsg
4420#    j exitError
4424:arraySizeOutOfBounds:
4424#    la $a0,arraySizeOutOfBoundsMsg
4428#    j exitError
4432:nullPtrException:
4432#    la $a0,nullPtrExceptionMsg
4436#    j exitError
4440:badIntegerFormat:
4440#    la $a0,badIntegerFormatMsg
4444#    j exitError
4448:castException:
4448#    la $a0,castExceptionMsg
4452#    j exitError
############## data section ################
    .data
4708:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4724:cur_seg:
    .word 0

4728:lastCharRead:
    .word -2 # -2 => no buffered character
4732:prevHashConstant:
    .word 0x2785173c
4736:gcCount:
    .word 0

4740:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4767:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4790:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4825:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4859:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4892:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4923:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4971:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4992:gcMsg: 
      .asciiz "\nGC!\n"
4998:gcCountMsg: 
      .asciiz "Number of garbage collections: "

5030:nullStr:
    .asciiz "null"
5035:trueString:
    .asciiz "true"
5040:falseString:
    .asciiz "false"
5046:exitString:
    .ascii "Program terminated."
    #### "falls through" here
5065:newlineString:
    .asciiz "\n"
    
    .align 2
5068:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

5072:seg0_start:
    .space 0x100000
1053648:seg0_end:
1053648:seg1_start:
    .space 0x100000
2102224:seg1_end:
