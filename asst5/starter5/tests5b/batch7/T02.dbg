##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2372:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
2372#    lw $t0,-8($s2) # get word with hash bits from this
2376#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
2380#    addu $t0,$t1

2384#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2388:mth_equals_Object:
2388#    move $t0,$s2 # first pointer (this)
2392#    lw $t1,($sp) # second pointer
2396#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
2397##...subu $at,$t0,$t1
2401##...sltiu $t0,$at,1

2404#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2408:mth_hashCode_String:
2408#    move $t0,$s2 # put this pointer in t0

2412#    li $t2,0 # current hash value
2416#    lw $t1,-4($t0) # negative of number of characters in string
2420#    beq $t1,$zero,done_hashCode_String # if zero length => done
2424#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
2428#    and $t0,0xfffffffc # adjust for padding
2429##...lui $at,65535
2433##...ori $at,$at,0xfffc
2437##...and $t0,$t0,$at
2440#    subu $t1,$t0,$t1 # address at end of string +12
2444:loop_hashCode_String:    
2444#    sll $t4,$t2,5 # multiply by 32
2448#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
2452#    lbu $t3,-12($t0) # current character
2456#    addu $t2,$t3 # add in current character
2460#    addu $t0,1 # go to next character's address
2464#    bne $t0,$t1,loop_hashCode_String # loop back if more
2468:done_hashCode_String:    

    # push int on stack
2468#    move $t0, $t2 # put $t2 in return slot
2472#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
2476:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
2476#    subu $sp,4
2480#    sw $ra,($sp)
    
    # get hash value
2484#    lw $t2,-12($s2) # vtable address
2488#    lw $t0,($t2) # method address
2492#    jalr $t0
2496#    subu $sp,8 # push result (int in $t0) on stack
2500#    sw $s5,4($sp)
2504#    sw $t0,($sp)

    # compute print-size of hash value
2508#    li $t0, 1
2512#    lw $t1, ($sp)
2516#    srl $t1,$t1,4
2520#    beq $t1,$zero,toString_skip_loop
2524:toString_loop_top:
2524#    addu $t0,1
2528#    srl $t1,$t1,4
2532#    bne $t1,$zero,toString_loop_top
2536:toString_skip_loop:
2536#    subu $sp,8
2540#    sw $s5,4($sp)
2544#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
2548#    lw $t2,-12($s2) # vtable address
2552#    move $t0,$t2
2556:toString_checkTagBit:
2556#    subu $t0,1
2560#    lb $t1,($t0)
2564#    and $t1,0x80
2565##...lui $at,0
2569##...ori $at,$at,0x80
2573##...and $t1,$t1,$at
2576#    beq $t1,$zero,toString_checkTagBit
2580#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
2584#    subu $sp,8
2588#    sw $t1,($sp)
2592#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
2596#    move $s7,$zero # -4 offset header word
2600#    lw $t4,8($sp) # bytes for hash value
2604#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
2608#    addu $t4,8
2612#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
2616#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

2620#    li $t0,CLASS_String # store string vtable address into ...
2624#    sw $t0,-12($s7) # ... -12 offset in object header
2628#    lw $t2,-12($s2) # our object's vtable address
2632#    lw $t5,4($sp) # number characters in prefix
2636#    lw $t1,12($sp) # number of characters in hashcode
2640#    addu $t3,$t1,$t5 # number of characters in string ...
2644#    addu $t3,1 # ... including the '@' character
2648#    subu $t0,$zero,$t3 # store negated length into ...
2652#    sw $t0,-4($s7) # ... -4 offset header word
2656#    lw $t0,-8($s7) # get -8 offset header-word
2660#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
2661##...slt $at,$t0,$zero
2665##...beq $at,$zero,2684
2668#    and $t0,0xff # mask off object's hash value ...
2669##...lui $at,0
2673##...ori $at,$at,0xff
2677##...and $t0,$t0,$at
2680#    sw $t0,-8($s7) # ... and store back into -8 header-word
2684:skipMask_toString:
2684#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
2688#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
2692#    subu $t4,$t2,$t5
2696:toString_copyLoop:    
2696#    lb $t3,($t4)
2700#    and $t3,0x7f # mask off sign bit (in case first word)
2701##...lui $at,0
2705##...ori $at,$at,0x7f
2709##...and $t3,$t3,$at
2712#    sb $t3,-8($t0)
2716#    addu $t4,1
2720#    addu $t0,1
2724#    blt $t4,$t2,toString_copyLoop
2725##...slt $at,$t4,$t2
2729##...bne $at,$zero,2696

    # copy the '@' sign
2732#    li $t3,'@'
2736#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
2740#    addu $t2,$t0,$t1 # address of last byte in string to store +8
2744#    lw $t3,20($sp) # hash code to print
2748:toString_hashCopyLoop:
2748#    and $t4,$t3,0xf
2752#    srl $t3,4
2756#    lb $t4,hexChars($t4)
2760#    sb $t4,-8($t2)
2764#    subu $t2,$t2,1
2768#    bgt $t2,$t0,toString_hashCopyLoop
2769##...slt $at,$t0,$t2
2773##...bne $at,$zero,2748

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
2776#    addu $sp,28
2780#    lw $ra,($sp)
2784#    addu $sp,4
2788#    move $t0, $s7 # return string we created
2792#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
2796:mth_equals_String:
    
    # quick test for obvious false
2796#    lw $t0,($sp) # second parameter
2800#    beq $t0,$zero,goEsFalse # go return false if null
