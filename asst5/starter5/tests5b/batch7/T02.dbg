3133##...slt $at,$zero,$t0
3137##...bne $at,$zero,3180
3140#    beq $t0,$zero,riSkipWhiteLoop # start over if space
3144#    subu $t0,$v0,10
3148#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
3152#    subu $t0,$v0,9
3156#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
3160#    subu $t0,$v0,13
3164#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
3168#    subu $t0,$v0,12
3172#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
3176#    j badIntegerFormat # illegal integer char: abort program

3180:  nonWhite:
3180#    subu $t0,$v0,'-'
3184#    li $t4,1 # final multiplier
3188#    bne $t0,$zero,helpReadInt # go read
3192#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
3196#    jal readLogicalChar

3200:  helpReadInt:
3200#    li $t2,10
3204#    subu $t1,$v0,'0' # convert digit to 0-9 value
3208#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
3209##...sltu $at,$t1,$t2
3213##...beq $at,$zero,5460
3216#    move $t3,$t1 #

