    #### and $t2 contains the value 10

3220:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

3220#    jal readLogicalChar # read next character
3224#    subu $t1,$v0,'0' # convert digit to 0-9 value
3228#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
3229##...sltu $at,$t1,$t2
3233##...beq $at,$zero,3252

3236#    mul $t3,$t3,$t2 # multiply old value by 10
3237##...mult $t3,$t2
3241##...mflo $t3
3244#    addu $t3,$t3,$t1 # add in value of new digit
3248#    j digitLoop

3252:  doneDigitLoop:

    # "push back" unused character into queue
3252#    sw $v0,lastCharRead
