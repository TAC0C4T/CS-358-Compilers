########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
5224:vm_init:

    # mark bottom of stack
5224#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
5228#    move $s2,$zero

    #set up the "five" register
5232#    li $s5,5

5236#    la $s3,seg0_start
5240#    la $s4,seg0_end
5241##...lui $s4,16
5245##...addiu $s4,$s4,6068
    
    # return
5248#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
5252:divide:
    # get parameters; abort if divisor zero
5252#    lw $t0,($sp)
5256#    lw $t1,8($sp)
5260#    beq $t0,$zero,divByZeroError
    
    # perform division
5264#    div $t1,$t0
5268#    mflo $t0

    # store result, adjust stack and return
5272#    addu $sp,$sp,8 # adjust stack
5276#    sw $t0,($sp) # store result
5280#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
5284:remainder:
    # get parameters; abort if divisor zero
5284#    lw $t0,($sp)
5288#    lw $t1,8($sp)
5292#    beq $t0,$zero,divByZeroError
    
    # perform division
5296#    div $t1,$t0
5300#    mfhi $t0

    # store result, adjust stack and return
5304#    addu $sp,$sp,8 # adjust stack
5308#    sw $t0,($sp) # store result
5312#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
5316:checkCast:
    # get object, allow immediately if null
5316#    lw $t2,($sp)
5320#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
5324#    lw $t2,-12($t2) # vtable address
5328#    bge $t2,$t1,castException
5329##...slt $at,$t2,$t1
5333##...beq $at,$zero,5468
5336#    blt $t2,$t0,castException
5337##...slt $at,$t2,$t0
5341##...bne $at,$zero,5468
    
    # return, leaving object unchanged on stack
5344:  checkCastReturn:    
5344#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
5348:instanceOf:
    # get object, go return false if null
5348#    lw $t2,($sp)
5352#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
5356#    lw $t2,-12($t2) # vtable address
5360#    sge $t0,$t2,$t0 # are we >= the lower limit?
5361##...slt $t0,$t2,$t0
5365##...xori $t0,$t0,0x1
5368#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
5372#    and $t2,$t0,$t1
5376#    sw $t2,($sp)
5380:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
5380#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

5384:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
5384#    li $v0,4 # syscall-code for print-string
5388#    syscall
5392:exit:
    # print termination message
5392#    li $v0,4 # syscall-code for print-string
5396#    la $a0,exitString
5400#    syscall

    # terminate execution
5404#    li $v0,10 #syscall-code for "exit"
5408#    syscall

5412:outOfHeapMemory:
5412#    la $a0,heapMemoryMsg
5416#    j exitError
5420:divByZeroError:
5420#    la $a0,divByZeroMsg
5424#    j exitError
5428:strIndexOutOfBounds:
5428#    la $a0,strIndexOutOfBoundsMsg
5432#    j exitError
5436:arrayIndexOutOfBounds:
5436#    la $a0,arrayIndexOutOfBoundsMsg
5440#    j exitError
5444:arraySizeOutOfBounds:
5444#    la $a0,arraySizeOutOfBoundsMsg
5448#    j exitError
5452:nullPtrException:
5452#    la $a0,nullPtrExceptionMsg
5456#    j exitError
5460:badIntegerFormat:
5460#    la $a0,badIntegerFormatMsg
5464#    j exitError
5468:castException:
5468#    la $a0,castExceptionMsg
5472#    j exitError
############## data section ################
    .data
5704:hexChars:
    .ascii "0123456789abcdef"
    .align 2
5720:cur_seg:
    .word 0

5724:lastCharRead:
    .word -2 # -2 => no buffered character
5728:prevHashConstant:
    .word 0x2785173c
5732:gcCount:
