    # set up the forwarding pointer
3368#    sw $zero,-8($t1) # 0 in first header-slot
3372#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
3376#    sw $t8,($t0)

3380:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
3380#    addu $t0,$t0,4
3384#    bltu $t0,$s1,gcNextPointerInObject
3385##...sltu $at,$t0,$s1
3389##...bne $at,$zero,3228

3392:  gcTestIterDone2:
3392#    bltu $t0,$s3,gcHeapCopyLoop
3393##...sltu $at,$t0,$s3
3397##...bne $at,$zero,3112

    ###### end outer loop to copy all non-stack-direct objects ######

3400:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
3400#    lw $s2,($sp)
3404#    addu $sp,$sp,4

    # mark us as having already GC'd
3408#    move $t5,$s5

    # go try and allocate again
3412#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3416:vm_init:

    # mark bottom of stack
3416#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3420#    move $s2,$zero

    #set up the "five" register
3424#    li $s5,5

3428#    la $s3,seg0_start
3432#    la $s4,seg0_end
3433##...lui $s4,16
3437##...addiu $s4,$s4,4256
    
    # return
3440#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3444:divide:
    # get parameters; abort if divisor zero
3444#    lw $t0,($sp)
3448#    lw $t1,8($sp)
3452#    beq $t0,$zero,divByZeroError
    
    # perform division
3456#    div $t1,$t0
3460#    mflo $t0

    # store result, adjust stack and return
3464#    addu $sp,$sp,8 # adjust stack
3468#    sw $t0,($sp) # store result
3472#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3476:remainder:
    # get parameters; abort if divisor zero
3476#    lw $t0,($sp)
3480#    lw $t1,8($sp)
3484#    beq $t0,$zero,divByZeroError
    
    # perform division
3488#    div $t1,$t0
3492#    mfhi $t0

    # store result, adjust stack and return
3496#    addu $sp,$sp,8 # adjust stack
3500#    sw $t0,($sp) # store result
3504#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3508:checkCast:
    # get object, allow immediately if null
3508#    lw $t2,($sp)
3512#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3516#    lw $t2,-12($t2) # vtable address
3520#    bge $t2,$t1,castException
3521##...slt $at,$t2,$t1
3525##...beq $at,$zero,3660
3528#    blt $t2,$t0,castException
3529##...slt $at,$t2,$t0
3533##...bne $at,$zero,3660
    
    # return, leaving object unchanged on stack
3536:  checkCastReturn:    
3536#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3540:instanceOf:
    # get object, go return false if null
3540#    lw $t2,($sp)
3544#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3548#    lw $t2,-12($t2) # vtable address
3552#    sge $t0,$t2,$t0 # are we >= the lower limit?
3553##...slt $t0,$t2,$t0
3557##...xori $t0,$t0,0x1
3560#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3564#    and $t2,$t0,$t1
3568#    sw $t2,($sp)
3572:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3572#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3576:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3576#    li $v0,4 # syscall-code for print-string
3580#    syscall
3584:exit:
    # print termination message
3584#    li $v0,4 # syscall-code for print-string
3588#    la $a0,exitString
3592#    syscall

    # terminate execution
3596#    li $v0,10 #syscall-code for "exit"
3600#    syscall

3604:outOfHeapMemory:
3604#    la $a0,heapMemoryMsg
3608#    j exitError
3612:divByZeroError:
3612#    la $a0,divByZeroMsg
3616#    j exitError
3620:strIndexOutOfBounds:
3620#    la $a0,strIndexOutOfBoundsMsg
3624#    j exitError
3628:arrayIndexOutOfBounds:
3628#    la $a0,arrayIndexOutOfBoundsMsg
3632#    j exitError
3636:arraySizeOutOfBounds:
3636#    la $a0,arraySizeOutOfBoundsMsg
3640#    j exitError
3644:nullPtrException:
3644#    la $a0,nullPtrExceptionMsg
3648#    j exitError
3652:badIntegerFormat:
3652#    la $a0,badIntegerFormatMsg
3656#    j exitError
3660:castException:
3660#    la $a0,castExceptionMsg
3664#    j exitError
############## data section ################
    .data
3892:hexChars:
    .ascii "0123456789abcdef"
    .align 2
3908:cur_seg:
    .word 0

3912:lastCharRead:
    .word -2 # -2 => no buffered character
3916:prevHashConstant:
    .word 0x2785173c
3920:gcCount:
    .word 0

3924:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
3951:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
3974:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4009:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4043:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4076:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4107:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4155:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4176:gcMsg: 
      .asciiz "\nGC!\n"
4182:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4214:nullStr:
    .asciiz "null"
4219:trueString:
    .asciiz "true"
4224:falseString:
    .asciiz "false"
4230:exitString:
    .ascii "Program terminated."
    #### "falls through" here
4249:newlineString:
    .asciiz "\n"
    
    .align 2
4252:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

4256:seg0_start:
    .space 0x100000
1052832:seg0_end:
1052832:seg1_start:
    .space 0x100000
2101408:seg1_end:
