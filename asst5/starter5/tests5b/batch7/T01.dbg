##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
564:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
564#    lw $t0,-8($s2) # get word with hash bits from this
568#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
572#    addu $t0,$t1

576#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
580:mth_equals_Object:
580#    move $t0,$s2 # first pointer (this)
584#    lw $t1,($sp) # second pointer
588#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
589##...subu $at,$t0,$t1
593##...sltiu $t0,$at,1

596#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
600:mth_hashCode_String:
600#    move $t0,$s2 # put this pointer in t0

604#    li $t2,0 # current hash value
608#    lw $t1,-4($t0) # negative of number of characters in string
612#    beq $t1,$zero,done_hashCode_String # if zero length => done
616#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
620#    and $t0,0xfffffffc # adjust for padding
621##...lui $at,65535
625##...ori $at,$at,0xfffc
629##...and $t0,$t0,$at
632#    subu $t1,$t0,$t1 # address at end of string +12
636:loop_hashCode_String:    
636#    sll $t4,$t2,5 # multiply by 32
640#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
644#    lbu $t3,-12($t0) # current character
648#    addu $t2,$t3 # add in current character
652#    addu $t0,1 # go to next character's address
656#    bne $t0,$t1,loop_hashCode_String # loop back if more
660:done_hashCode_String:    

    # push int on stack
660#    move $t0, $t2 # put $t2 in return slot
664#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
668:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
668#    subu $sp,4
672#    sw $ra,($sp)
    
    # get hash value
676#    lw $t2,-12($s2) # vtable address
680#    lw $t0,($t2) # method address
684#    jalr $t0
688#    subu $sp,8 # push result (int in $t0) on stack
692#    sw $s5,4($sp)
696#    sw $t0,($sp)

    # compute print-size of hash value
700#    li $t0, 1
704#    lw $t1, ($sp)
708#    srl $t1,$t1,4
712#    beq $t1,$zero,toString_skip_loop
716:toString_loop_top:
716#    addu $t0,1
720#    srl $t1,$t1,4
724#    bne $t1,$zero,toString_loop_top
728:toString_skip_loop:
728#    subu $sp,8
732#    sw $s5,4($sp)
736#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
740#    lw $t2,-12($s2) # vtable address
744#    move $t0,$t2
748:toString_checkTagBit:
748#    subu $t0,1
752#    lb $t1,($t0)
756#    and $t1,0x80
757##...lui $at,0
761##...ori $at,$at,0x80
765##...and $t1,$t1,$at
768#    beq $t1,$zero,toString_checkTagBit
772#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
776#    subu $sp,8
780#    sw $t1,($sp)
784#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
788#    move $s7,$zero # -4 offset header word
792#    lw $t4,8($sp) # bytes for hash value
796#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
800#    addu $t4,8
804#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
808#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

812#    li $t0,CLASS_String # store string vtable address into ...
816#    sw $t0,-12($s7) # ... -12 offset in object header
820#    lw $t2,-12($s2) # our object's vtable address
824#    lw $t5,4($sp) # number characters in prefix
828#    lw $t1,12($sp) # number of characters in hashcode
832#    addu $t3,$t1,$t5 # number of characters in string ...
836#    addu $t3,1 # ... including the '@' character
840#    subu $t0,$zero,$t3 # store negated length into ...
844#    sw $t0,-4($s7) # ... -4 offset header word
848#    lw $t0,-8($s7) # get -8 offset header-word
852#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
853##...slt $at,$t0,$zero
857##...beq $at,$zero,876
860#    and $t0,0xff # mask off object's hash value ...
861##...lui $at,0
865##...ori $at,$at,0xff
869##...and $t0,$t0,$at
872#    sw $t0,-8($s7) # ... and store back into -8 header-word
876:skipMask_toString:
876#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
880#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
884#    subu $t4,$t2,$t5
888:toString_copyLoop:    
888#    lb $t3,($t4)
892#    and $t3,0x7f # mask off sign bit (in case first word)
893##...lui $at,0
897##...ori $at,$at,0x7f
901##...and $t3,$t3,$at
904#    sb $t3,-8($t0)
908#    addu $t4,1
912#    addu $t0,1
916#    blt $t4,$t2,toString_copyLoop
917##...slt $at,$t4,$t2
921##...bne $at,$zero,888

    # copy the '@' sign
924#    li $t3,'@'
928#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
