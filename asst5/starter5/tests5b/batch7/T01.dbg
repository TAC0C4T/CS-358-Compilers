1336#    subu $t0,$v0,10
1340#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1344#    subu $t0,$v0,9
1348#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1352#    subu $t0,$v0,13
1356#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1360#    subu $t0,$v0,12
