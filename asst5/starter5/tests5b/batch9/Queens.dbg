    # greater
3216#    slt $t5,$t4,$t3 # 1 if str2 > str1, else 0
3220#    sll $t5,$t5,1 # 2 if str2 > str1, else 0
3224#    subu $t5,$t5,1 # 1 if str2 > str1, else -1
3228:  cmpHitLimitzz:
3228#    move $t0, $t5 # store return value
3232#    jr $ra # return
