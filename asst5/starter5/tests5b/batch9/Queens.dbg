###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1700:mth_readLine_Lib:
    
1700#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1704#    sw $ra, 4($sp) # save $ra
1708#    move $t1,$sp # save "original" sp

1712:  doRead:

    # read the character
1712#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1716#    subu $t2,$v0,13
1720#    bne $t2,$zero,notReturnRL
1724#    jal readLogicalChar
1728#    subu $t2,$v0,10 # check for newline
1732#    beq $t2,$zero,foundNewLine
1736#    sw $v0,lastCharRead # push back character into queue
1740#    j foundNewLine # go process the line

1744:  notReturnRL:

    # at this point, $v0 has our character

1744#    subu $t0,$v0,10
1748#    beq $t0,$zero,foundNewLine
1752#    blt $v0,$zero,foundEof
1753##...slt $at,$v0,$zero
1757##...bne $at,$zero,1772

    # we have a character, so push it onto stack
1760#    subu $sp,$sp,4
1764#    sw $v0,($sp)

    # loop back up to get next character
1768#    j doRead

1772:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1772#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1776#    li $s7, 0 # return-value: null
1780#    j rlReturn # return

1784:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1784#    subu $t0,$t1,$sp # number of chars we read (times 4)
1788#    srl $s6,$t0,2 # number of words on stack with chars
1792#    subu $sp,$sp,4 # push char-count ...
1796#    sw $s6,($sp) # ... onto stack
1800#    addu $t2,$t0,5 # GC tag, incl. for count-word
1804#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1808#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1812#    srl $s6,$s6,2  # data words in object
1816#    move $s7,$zero # object words in object
1820#    jal newObject  # allocate space
    
    # store header words
1824#    la $t0,CLASS_String
1828#    sw $t0,-12($s7)# store class tag (String) into object
1832#    lw $t2,4($sp) # char-count
1836#    sll $t1,$t2,2 # 4 times number of chars
1840#    subu $t2,$zero,$t2 # negative of char-count
1844#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1848#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1852#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1853##...slt $at,$t0,$zero
1857##...beq $at,$zero,1876
1860#    and $t0,0xff # mask off object's hash value ...
1861##...lui $at,0
1865##...ori $at,$at,0xff
1869##...and $t0,$t0,$at
1872#    sw $t0,-8($s7) # ... and store back into -8 header-word
1876:  skipMask_readLine:

1876#    sll $t0,$t0,2 # data bytes in object
1880#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1884#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1888#    addu $sp,$sp,8 # pop redundant object-pointer and count
1892#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

1896#    beq $sp,$t1,rlReturn
1900:  charCopyLoop:
1900#    lw $t2,($sp)
1904#    sb $t2,-9($t0)
1908#    addu $sp,$sp,4
1912#    subu $t0,$t0,1
1916#    bne $sp,$t1,charCopyLoop
1920:  rlReturn:

1920#    lw $ra, 4($sp)
1924#    addu $sp, 8   # pop $ra and pointless word off stack
1928#    move $t0, $s7 # return string we allocated in $s7
1932#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1936:mth_readInt_Lib:

    # save $ra by pushing onto stack
1936#    subu $sp,$sp,4
1940#    sw $ra,($sp)

1944:  riSkipWhiteLoop:
    # read a character
1944#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
1948#    subu $t0,$v0,32
1952#    bgt $t0,$zero,nonWhite
1953##...slt $at,$zero,$t0
1957##...bne $at,$zero,2000
1960#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1964#    subu $t0,$v0,10
1968#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1972#    subu $t0,$v0,9
1976#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1980#    subu $t0,$v0,13
1984#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1988#    subu $t0,$v0,12
1992#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1996#    j badIntegerFormat # illegal integer char: abort program

2000:  nonWhite:
2000#    subu $t0,$v0,'-'
2004#    li $t4,1 # final multiplier
2008#    bne $t0,$zero,helpReadInt # go read
2012#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
2016#    jal readLogicalChar

2020:  helpReadInt:
2020#    li $t2,10
2024#    subu $t1,$v0,'0' # convert digit to 0-9 value
2028#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
2029##...sltu $at,$t1,$t2
2033##...beq $at,$zero,4280
2036#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

2040:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

2040#    jal readLogicalChar # read next character
2044#    subu $t1,$v0,'0' # convert digit to 0-9 value
2048#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
2049##...sltu $at,$t1,$t2
2053##...beq $at,$zero,2072

2056#    mul $t3,$t3,$t2 # multiply old value by 10
2057##...mult $t3,$t2
2061##...mflo $t3
2064#    addu $t3,$t3,$t1 # add in value of new digit
2068#    j digitLoop

2072:  doneDigitLoop:

    # "push back" unused character into queue
2072#    sw $v0,lastCharRead

    # restore return address
2076#    lw $ra,($sp)
2080#    addu $sp, 4

    # multiply by sign and put return value in $t0
2084#    mult $t3,$t4 # multiply to account for poss. minus sign
2088#    mflo $t3
2092#    move $t0, $t3
    
    # return
2096#    jr $ra

###################################################################
# readChar() - library method (class Lib)
# - reads a single character from standard input
# - returns the integer that is the encoding of the character
# - returns -1 if end of file was encountered
# - parameter:
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
2100:mth_readChar_Lib:

    # save $ra by pushing onto stack
2100#    subu $sp,$sp,4
2104#    sw $ra,($sp)

      # read the character
2108#    jal readLogicalChar

    # restore return address; put value in $t0
    # replacing this-pointer saved return address
2112#    lw $ra,($sp)
2116#    addu $sp, 4
2120#    move $t0, $v0

    # return
2124#    jr $ra

########################################################
# printStr(str) - library method (class Lib)
# - prints string to standard output
# parameters:
#   - ($sp) - the string to print
#   - 4($sp) - old-this-pointer
########################################################
2128:mth_printStr_Lib:
