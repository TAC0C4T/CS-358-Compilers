###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1296:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1296#    subu $sp,4
1300#    sw $ra,($sp)
    
    # get hash value
1304#    lw $t2,-12($s2) # vtable address
1308#    lw $t0,($t2) # method address
1312#    jalr $t0
1316#    subu $sp,8 # push result (int in $t0) on stack
1320#    sw $s5,4($sp)
1324#    sw $t0,($sp)

    # compute print-size of hash value
1328#    li $t0, 1
1332#    lw $t1, ($sp)
1336#    srl $t1,$t1,4
1340#    beq $t1,$zero,toString_skip_loop
1344:toString_loop_top:
1344#    addu $t0,1
1348#    srl $t1,$t1,4
1352#    bne $t1,$zero,toString_loop_top
1356:toString_skip_loop:
1356#    subu $sp,8
1360#    sw $s5,4($sp)
1364#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1368#    lw $t2,-12($s2) # vtable address
1372#    move $t0,$t2
1376:toString_checkTagBit:
1376#    subu $t0,1
1380#    lb $t1,($t0)
1384#    and $t1,0x80
1385##...lui $at,0
1389##...ori $at,$at,0x80
1393##...and $t1,$t1,$at
1396#    beq $t1,$zero,toString_checkTagBit
1400#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1404#    subu $sp,8
1408#    sw $t1,($sp)
1412#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1416#    move $s7,$zero # -4 offset header word
1420#    lw $t4,8($sp) # bytes for hash value
1424#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1428#    addu $t4,8
1432#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1436#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1440#    li $t0,CLASS_String # store string vtable address into ...
1444#    sw $t0,-12($s7) # ... -12 offset in object header
1448#    lw $t2,-12($s2) # our object's vtable address
1452#    lw $t5,4($sp) # number characters in prefix
1456#    lw $t1,12($sp) # number of characters in hashcode
1460#    addu $t3,$t1,$t5 # number of characters in string ...
1464#    addu $t3,1 # ... including the '@' character
1468#    subu $t0,$zero,$t3 # store negated length into ...
1472#    sw $t0,-4($s7) # ... -4 offset header word
1476#    lw $t0,-8($s7) # get -8 offset header-word
1480#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1481##...slt $at,$t0,$zero
1485##...beq $at,$zero,1504
1488#    and $t0,0xff # mask off object's hash value ...
1489##...lui $at,0
1493##...ori $at,$at,0xff
1497##...and $t0,$t0,$at
1500#    sw $t0,-8($s7) # ... and store back into -8 header-word
1504:skipMask_toString:
1504#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1508#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1512#    subu $t4,$t2,$t5
1516:toString_copyLoop:    
1516#    lb $t3,($t4)
1520#    and $t3,0x7f # mask off sign bit (in case first word)
1521##...lui $at,0
1525##...ori $at,$at,0x7f
1529##...and $t3,$t3,$at
1532#    sb $t3,-8($t0)
1536#    addu $t4,1
1540#    addu $t0,1
1544#    blt $t4,$t2,toString_copyLoop
1545##...slt $at,$t4,$t2
1549##...bne $at,$zero,1516

    # copy the '@' sign
1552#    li $t3,'@'
1556#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1560#    addu $t2,$t0,$t1 # address of last byte in string to store +8
1564#    lw $t3,20($sp) # hash code to print
1568:toString_hashCopyLoop:
1568#    and $t4,$t3,0xf
1572#    srl $t3,4
1576#    lb $t4,hexChars($t4)
1580#    sb $t4,-8($t2)
1584#    subu $t2,$t2,1
1588#    bgt $t2,$t0,toString_hashCopyLoop
1589##...slt $at,$t0,$t2
1593##...bne $at,$zero,1568

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
1596#    addu $sp,28
1600#    lw $ra,($sp)
1604#    addu $sp,4
1608#    move $t0, $s7 # return string we created
1612#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
1616:mth_equals_String:
    
    # quick test for obvious false
1616#    lw $t0,($sp) # second parameter
1620#    beq $t0,$zero,goEsFalse # go return false if null
1624#    lw $t1,-12($t0) # vtable pointer
1628#    la $t2,CLASS_String # string vtable pointer
1632#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
1636#    subu $sp,12
1640#    sw $ra,8($sp)
1644#    sw $s2,4($sp)
1648#    sw $t0,($sp)
1652#    jal mth_compareTo_String
1656#    lw $s2, 4($sp) #restore this pointer and pop parameters
1660#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
1664#    seq $t0,$t0,$zero
1665##...subu $at,$t0,$zero
1669##...sltiu $t0,$at,1

    # pop return address and return $t0
1672#    lw $ra,($sp)
1676#    addu $sp,4

1680#    jr $ra # return
    
1684:goEsFalse:
    # put 0 in $t0 and return
1684#    li $t0, 0
1688#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
1692:mth_toString_String:
    #we are a string, so return this.
1692#    move $t0, $s2
1696#    jr $ra
