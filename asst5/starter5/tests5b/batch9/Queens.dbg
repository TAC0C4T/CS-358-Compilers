3812#    sll $t1,$t1,2 # convert to byte-count
3816#    addu $t0,$t2,$t1 # skip over object
3820#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
3824:  gcNotDataArray:
3824#    lw $t3,-4($t2) # # object words (negative treated as zero)
3828#    bge $t3,$zero,gcH2Neg2
3829##...slt $at,$t3,$zero
3833##...beq $at,$zero,3840
3836#    move $t3,$zero
3840:  gcH2Neg2:
3840#    sll $t3,$t3,2 # # object bytes
3844#    move $t0,$t2 # address of first pointer in object
3848#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
3852#    beq $t0,$s1,gcTestIterDone2
    
3856:  gcNextPointerInObject:
    # get pointer from object
3856#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
3860#    bleu $t1,$t6,gcGoNextPointerSlot
3861##...sltu $at,$t6,$t1
3865##...beq $at,$zero,4008
3868#    bgtu $t1,$t7,gcGoNextPointerSlot
3869##...sltu $at,$t7,$t1
3873##...bne $at,$zero,4008

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
3876#    lw $t8,-8($t1) # possible forwarding tag
3880#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
3884#    lw $t8,-4($t1) # forwarding pointer: object's new address
3888#    sw $t8,($t0) # update pointer in object
3892#    j gcGoNextPointerSlot # do next iteration

3896:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
3896#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
3897##...slt $at,$t8,$zero
3901##...beq $at,$zero,3916
3904#    and $t8,0xff # mask off hash bits
3905##...lui $at,0
3909##...ori $at,$at,0xff
3913##...and $t8,$t8,$at

3916:  gcSkip5:
3916#    sll $t8,$t8,2 # bytes in negative-offset portion ...
3920#    addu $t8,$t8,8 # ... add in bytes for header-words
3924#    subu $t4,$t1,$t8 # address of first word of source object
3928#    lw $t3,-4($t1) # # words in positive-offset portion
3932#    bge $t3,$zero,gcNoNeg
3933##...slt $at,$t3,$zero
3937##...beq $at,$zero,3944
3940#    move $t3,$zero # negative treated as zero
3944:  gcNoNeg:
3944#    sll $t3,$t3,2 # bytes in negative-offset portion
3948#    addu $t3,$t3,$t1 # address one word past last word of source

3952#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
3956#    lw $s0,($t4)
3960#    lw $t9,-8($t1)
3964#    sw $t9,($t4)
3968#    sw $s0,-8($t1)

    # copy all source bytes to the target
3972:  gCinnerCopy2:
3972#    lw $s0,($t4)
3976#    sw $s0,($s3)
3980#    addu $t4,$t4,4
3984#    addu $s3,$s3,4
3988#    bltu $t4,$t3,gCinnerCopy2
3989##...sltu $at,$t4,$t3
3993##...bne $at,$zero,3972

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
3996#    sw $zero,-8($t1) # 0 in first header-slot
4000#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
4004#    sw $t8,($t0)

4008:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
4008#    addu $t0,$t0,4
4012#    bltu $t0,$s1,gcNextPointerInObject
4013##...sltu $at,$t0,$s1
4017##...bne $at,$zero,3856

4020:  gcTestIterDone2:
4020#    bltu $t0,$s3,gcHeapCopyLoop
4021##...sltu $at,$t0,$s3
4025##...bne $at,$zero,3740

    ###### end outer loop to copy all non-stack-direct objects ######

4028:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
4028#    lw $s2,($sp)
4032#    addu $sp,$sp,4

    # mark us as having already GC'd
4036#    move $t5,$s5

    # go try and allocate again
4040#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4044:vm_init:

    # mark bottom of stack
4044#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4048#    move $s2,$zero

    #set up the "five" register
4052#    li $s5,5

4056#    la $s3,seg0_start
4060#    la $s4,seg0_end
4061##...lui $s4,16
4065##...addiu $s4,$s4,4844
    
    # return
4068#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4072:divide:
    # get parameters; abort if divisor zero
4072#    lw $t0,($sp)
4076#    lw $t1,8($sp)
4080#    beq $t0,$zero,divByZeroError
    
    # perform division
4084#    div $t1,$t0
4088#    mflo $t0

    # store result, adjust stack and return
4092#    addu $sp,$sp,8 # adjust stack
4096#    sw $t0,($sp) # store result
4100#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4104:remainder:
    # get parameters; abort if divisor zero
4104#    lw $t0,($sp)
4108#    lw $t1,8($sp)
4112#    beq $t0,$zero,divByZeroError
    
    # perform division
4116#    div $t1,$t0
4120#    mfhi $t0

    # store result, adjust stack and return
4124#    addu $sp,$sp,8 # adjust stack
4128#    sw $t0,($sp) # store result
4132#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4136:checkCast:
    # get object, allow immediately if null
4136#    lw $t2,($sp)
4140#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4144#    lw $t2,-12($t2) # vtable address
4148#    bge $t2,$t1,castException
4149##...slt $at,$t2,$t1
4153##...beq $at,$zero,4288
4156#    blt $t2,$t0,castException
4157##...slt $at,$t2,$t0
4161##...bne $at,$zero,4288
    
    # return, leaving object unchanged on stack
4164:  checkCastReturn:    
4164#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4168:instanceOf:
    # get object, go return false if null
4168#    lw $t2,($sp)
4172#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4176#    lw $t2,-12($t2) # vtable address
4180#    sge $t0,$t2,$t0 # are we >= the lower limit?
4181##...slt $t0,$t2,$t0
4185##...xori $t0,$t0,0x1
4188#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4192#    and $t2,$t0,$t1
4196#    sw $t2,($sp)
4200:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4200#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4204:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4204#    li $v0,4 # syscall-code for print-string
4208#    syscall
4212:exit:
    # print termination message
4212#    li $v0,4 # syscall-code for print-string
4216#    la $a0,exitString
4220#    syscall

    # terminate execution
4224#    li $v0,10 #syscall-code for "exit"
4228#    syscall

4232:outOfHeapMemory:
4232#    la $a0,heapMemoryMsg
4236#    j exitError
4240:divByZeroError:
4240#    la $a0,divByZeroMsg
4244#    j exitError
4248:strIndexOutOfBounds:
4248#    la $a0,strIndexOutOfBoundsMsg
4252#    j exitError
4256:arrayIndexOutOfBounds:
4256#    la $a0,arrayIndexOutOfBoundsMsg
4260#    j exitError
4264:arraySizeOutOfBounds:
4264#    la $a0,arraySizeOutOfBoundsMsg
4268#    j exitError
4272:nullPtrException:
4272#    la $a0,nullPtrExceptionMsg
4276#    j exitError
4280:badIntegerFormat:
4280#    la $a0,badIntegerFormatMsg
4284#    j exitError
4288:castException:
4288#    la $a0,castExceptionMsg
4292#    j exitError
############## data section ################
    .data
4480:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4496:cur_seg:
    .word 0

4500:lastCharRead:
    .word -2 # -2 => no buffered character
4504:prevHashConstant:
    .word 0x2785173c
4508:gcCount:
    .word 0

4512:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4539:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4562:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4597:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4631:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4664:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4695:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4743:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4764:gcMsg: 
      .asciiz "\nGC!\n"
4770:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4802:nullStr:
    .asciiz "null"
4807:trueString:
    .asciiz "true"
4812:falseString:
    .asciiz "false"
4818:exitString:
    .ascii "Program terminated."
    #### "falls through" here
4837:newlineString:
    .asciiz "\n"
    
    .align 2
4840:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

4844:seg0_start:
    .space 0x100000
1053420:seg0_end:
1053420:seg1_start:
    .space 0x100000
2101996:seg1_end:
