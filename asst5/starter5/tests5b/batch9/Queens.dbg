2165##...bne $at,$zero,2184
2168#    and $t1,0xff # mask out all but low byte
2169##...lui $at,0
2173##...ori $at,$at,0xff
2177##...and $t1,$t1,$at
2180#    b skipPrintStr2
2184:skipPrintStr1:
2184#    and $t1,0x7ffffff
2185##...lui $at,2047
2189##...ori $at,$at,0xffff
2193##...and $t1,$t1,$at
2196:skipPrintStr2:    
