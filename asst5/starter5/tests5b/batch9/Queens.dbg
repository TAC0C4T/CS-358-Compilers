3248#    sw $t0,lastCharRead # store -2 into buffer (i.e. "empty")
3252#    jr $ra # return
    
3256:  doReadCh:
    # we need to actually read a character: read and return
3256#    li $v0,12 # use system call to read a character
3260#    syscall
3264#    jr $ra # return
