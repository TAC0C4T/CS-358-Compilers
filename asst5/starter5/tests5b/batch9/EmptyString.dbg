2921##...lui $at,32768
2925##...or $t1,$at,$t1
2928#    and $t1,0xffffff00 # clear low bit
2929##...lui $at,65535
2933##...ori $at,$at,0xff00
2937##...and $t1,$t1,$at
2940#    or $s6,$t1
2944:firstHeaderLarge:
2944#    sw $s6,-8($t0) # store header-1 value
