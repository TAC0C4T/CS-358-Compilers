2860#    sw $zero,($s3)
2864#    lw $zero,($s3)

2868#    addu $s3,4
2872#    bltu $s3,$t1,zeroObjLoop
2873##...sltu $at,$s3,$t1
2877##...bne $at,$zero,2860

    # at this point:
    #  $s3 has been updated to point to the next free slot,
    #    which is also the points just past our object
