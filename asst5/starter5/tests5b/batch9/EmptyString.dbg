1216#    seq $t0,$t0,$zero
1217##...subu $at,$t0,$zero
1221##...sltiu $t0,$at,1

    # pop return address and return $t0
1224#    lw $ra,($sp)
1228#    addu $sp,4

1232#    jr $ra # return
    
1236:goEsFalse:
    # put 0 in $t0 and return
1236#    li $t0, 0
1240#    jr $ra # return
