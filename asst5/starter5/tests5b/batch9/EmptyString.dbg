    
    # quick test for obvious false
1168#    lw $t0,($sp) # second parameter
1172#    beq $t0,$zero,goEsFalse # go return false if null
1176#    lw $t1,-12($t0) # vtable pointer
1180#    la $t2,CLASS_String # string vtable pointer
1184#    bne $t1,$t2,goEsFalse # go return false if not a string
