1516#    subu $t0,$v0,10
1520#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1524#    subu $t0,$v0,9
1528#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1532#    subu $t0,$v0,13
1536#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1540#    subu $t0,$v0,12
