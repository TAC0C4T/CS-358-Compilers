#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3400:vm_init:

    # mark bottom of stack
3400#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3404#    move $s2,$zero

    #set up the "five" register
3408#    li $s5,5

3412#    la $s3,seg0_start
3416#    la $s4,seg0_end
3417##...lui $s4,16
3421##...addiu $s4,$s4,4184
    
    # return
3424#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3428:divide:
    # get parameters; abort if divisor zero
3428#    lw $t0,($sp)
3432#    lw $t1,8($sp)
3436#    beq $t0,$zero,divByZeroError
    
    # perform division
3440#    div $t1,$t0
3444#    mflo $t0

    # store result, adjust stack and return
3448#    addu $sp,$sp,8 # adjust stack
3452#    sw $t0,($sp) # store result
3456#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3460:remainder:
    # get parameters; abort if divisor zero
3460#    lw $t0,($sp)
3464#    lw $t1,8($sp)
3468#    beq $t0,$zero,divByZeroError
    
    # perform division
3472#    div $t1,$t0
3476#    mfhi $t0

    # store result, adjust stack and return
3480#    addu $sp,$sp,8 # adjust stack
3484#    sw $t0,($sp) # store result
3488#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3492:checkCast:
    # get object, allow immediately if null
3492#    lw $t2,($sp)
3496#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3500#    lw $t2,-12($t2) # vtable address
3504#    bge $t2,$t1,castException
3505##...slt $at,$t2,$t1
3509##...beq $at,$zero,3644
3512#    blt $t2,$t0,castException
3513##...slt $at,$t2,$t0
3517##...bne $at,$zero,3644
    
    # return, leaving object unchanged on stack
3520:  checkCastReturn:    
3520#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3524:instanceOf:
    # get object, go return false if null
3524#    lw $t2,($sp)
3528#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3532#    lw $t2,-12($t2) # vtable address
3536#    sge $t0,$t2,$t0 # are we >= the lower limit?
3537##...slt $t0,$t2,$t0
3541##...xori $t0,$t0,0x1
3544#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3548#    and $t2,$t0,$t1
3552#    sw $t2,($sp)
3556:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3556#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3560:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3560#    li $v0,4 # syscall-code for print-string
3564#    syscall
3568:exit:
    # print termination message
3568#    li $v0,4 # syscall-code for print-string
3572#    la $a0,exitString
3576#    syscall

    # terminate execution
3580#    li $v0,10 #syscall-code for "exit"
3584#    syscall

3588:outOfHeapMemory:
3588#    la $a0,heapMemoryMsg
3592#    j exitError
3596:divByZeroError:
3596#    la $a0,divByZeroMsg
3600#    j exitError
3604:strIndexOutOfBounds:
3604#    la $a0,strIndexOutOfBoundsMsg
3608#    j exitError
3612:arrayIndexOutOfBounds:
3612#    la $a0,arrayIndexOutOfBoundsMsg
3616#    j exitError
3620:arraySizeOutOfBounds:
3620#    la $a0,arraySizeOutOfBoundsMsg
3624#    j exitError
3628:nullPtrException:
3628#    la $a0,nullPtrExceptionMsg
3632#    j exitError
3636:badIntegerFormat:
3636#    la $a0,badIntegerFormatMsg
3640#    j exitError
3644:castException:
3644#    la $a0,castExceptionMsg
3648#    j exitError
############## data section ################
    .data
3820:hexChars:
    .ascii "0123456789abcdef"
    .align 2
3836:cur_seg:
    .word 0

3840:lastCharRead:
    .word -2 # -2 => no buffered character
3844:prevHashConstant:
    .word 0x2785173c
3848:gcCount:
    .word 0

3852:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
3879:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
3902:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
3937:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
3971:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4004:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4035:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4083:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4104:gcMsg: 
      .asciiz "\nGC!\n"
4110:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4142:nullStr:
    .asciiz "null"
4147:trueString:
    .asciiz "true"
4152:falseString:
    .asciiz "false"
4158:exitString:
    .ascii "Program terminated."
    #### "falls through" here
4177:newlineString:
    .asciiz "\n"
    
    .align 2
4180:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

4184:seg0_start:
    .space 0x100000
1052760:seg0_end:
1052760:seg1_start:
    .space 0x100000
2101336:seg1_end:
