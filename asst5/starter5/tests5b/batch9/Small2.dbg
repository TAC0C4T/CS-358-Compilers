1309##...slt $at,$zero,$t0
1313##...bne $at,$zero,1356
1316#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1320#    subu $t0,$v0,10
1324#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1328#    subu $t0,$v0,9
1332#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1336#    subu $t0,$v0,13
1340#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1344#    subu $t0,$v0,12
1348#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1352#    j badIntegerFormat # illegal integer char: abort program

1356:  nonWhite:
1356#    subu $t0,$v0,'-'
1360#    li $t4,1 # final multiplier
1364#    bne $t0,$zero,helpReadInt # go read
1368#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1372#    jal readLogicalChar

1376:  helpReadInt:
1376#    li $t2,10
1380#    subu $t1,$v0,'0' # convert digit to 0-9 value
1384#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
1385##...sltu $at,$t1,$t2
1389##...beq $at,$zero,3636
1392#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

1396:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

1396#    jal readLogicalChar # read next character
1400#    subu $t1,$v0,'0' # convert digit to 0-9 value
1404#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
1405##...sltu $at,$t1,$t2
1409##...beq $at,$zero,1428

1412#    mul $t3,$t3,$t2 # multiply old value by 10
1413##...mult $t3,$t2
1417##...mflo $t3
1420#    addu $t3,$t3,$t1 # add in value of new digit
1424#    j digitLoop

1428:  doneDigitLoop:

    # "push back" unused character into queue
1428#    sw $v0,lastCharRead

    # restore return address
1432#    lw $ra,($sp)
1436#    addu $sp, 4

