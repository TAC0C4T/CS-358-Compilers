##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
548:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
548#    lw $t0,-8($s2) # get word with hash bits from this
552#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
556#    addu $t0,$t1

560#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
564:mth_equals_Object:
564#    move $t0,$s2 # first pointer (this)
568#    lw $t1,($sp) # second pointer
572#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
573##...subu $at,$t0,$t1
577##...sltiu $t0,$at,1

580#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
584:mth_hashCode_String:
584#    move $t0,$s2 # put this pointer in t0

588#    li $t2,0 # current hash value
592#    lw $t1,-4($t0) # negative of number of characters in string
596#    beq $t1,$zero,done_hashCode_String # if zero length => done
600#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
604#    and $t0,0xfffffffc # adjust for padding
605##...lui $at,65535
609##...ori $at,$at,0xfffc
613##...and $t0,$t0,$at
616#    subu $t1,$t0,$t1 # address at end of string +12
620:loop_hashCode_String:    
620#    sll $t4,$t2,5 # multiply by 32
624#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
628#    lbu $t3,-12($t0) # current character
632#    addu $t2,$t3 # add in current character
636#    addu $t0,1 # go to next character's address
640#    bne $t0,$t1,loop_hashCode_String # loop back if more
644:done_hashCode_String:    

    # push int on stack
644#    move $t0, $t2 # put $t2 in return slot
648#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
652:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
652#    subu $sp,4
656#    sw $ra,($sp)
    
    # get hash value
660#    lw $t2,-12($s2) # vtable address
664#    lw $t0,($t2) # method address
668#    jalr $t0
672#    subu $sp,8 # push result (int in $t0) on stack
676#    sw $s5,4($sp)
680#    sw $t0,($sp)

    # compute print-size of hash value
684#    li $t0, 1
688#    lw $t1, ($sp)
692#    srl $t1,$t1,4
696#    beq $t1,$zero,toString_skip_loop
700:toString_loop_top:
700#    addu $t0,1
704#    srl $t1,$t1,4
708#    bne $t1,$zero,toString_loop_top
712:toString_skip_loop:
712#    subu $sp,8
716#    sw $s5,4($sp)
720#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
724#    lw $t2,-12($s2) # vtable address
728#    move $t0,$t2
732:toString_checkTagBit:
732#    subu $t0,1
736#    lb $t1,($t0)
740#    and $t1,0x80
741##...lui $at,0
745##...ori $at,$at,0x80
749##...and $t1,$t1,$at
752#    beq $t1,$zero,toString_checkTagBit
756#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
760#    subu $sp,8
764#    sw $t1,($sp)
768#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
772#    move $s7,$zero # -4 offset header word
776#    lw $t4,8($sp) # bytes for hash value
780#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
784#    addu $t4,8
788#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
792#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

796#    li $t0,CLASS_String # store string vtable address into ...
800#    sw $t0,-12($s7) # ... -12 offset in object header
804#    lw $t2,-12($s2) # our object's vtable address
808#    lw $t5,4($sp) # number characters in prefix
812#    lw $t1,12($sp) # number of characters in hashcode
816#    addu $t3,$t1,$t5 # number of characters in string ...
820#    addu $t3,1 # ... including the '@' character
824#    subu $t0,$zero,$t3 # store negated length into ...
828#    sw $t0,-4($s7) # ... -4 offset header word
832#    lw $t0,-8($s7) # get -8 offset header-word
836#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
837##...slt $at,$t0,$zero
841##...beq $at,$zero,860
844#    and $t0,0xff # mask off object's hash value ...
845##...lui $at,0
849##...ori $at,$at,0xff
853##...and $t0,$t0,$at
856#    sw $t0,-8($s7) # ... and store back into -8 header-word
860:skipMask_toString:
860#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
864#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
868#    subu $t4,$t2,$t5
872:toString_copyLoop:    
872#    lb $t3,($t4)
876#    and $t3,0x7f # mask off sign bit (in case first word)
877##...lui $at,0
881##...ori $at,$at,0x7f
885##...and $t3,$t3,$at
888#    sb $t3,-8($t0)
892#    addu $t4,1
896#    addu $t0,1
900#    blt $t4,$t2,toString_copyLoop
901##...slt $at,$t4,$t2
905##...bne $at,$zero,872

    # copy the '@' sign
908#    li $t3,'@'
912#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
916#    addu $t2,$t0,$t1 # address of last byte in string to store +8
920#    lw $t3,20($sp) # hash code to print
924:toString_hashCopyLoop:
924#    and $t4,$t3,0xf
928#    srl $t3,4
932#    lb $t4,hexChars($t4)
936#    sb $t4,-8($t2)
940#    subu $t2,$t2,1
944#    bgt $t2,$t0,toString_hashCopyLoop
945##...slt $at,$t0,$t2
949##...bne $at,$zero,924

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
952#    addu $sp,28
956#    lw $ra,($sp)
960#    addu $sp,4
964#    move $t0, $s7 # return string we created
968#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
