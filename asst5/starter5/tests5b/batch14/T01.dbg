644:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
644#    subu $t0,$t1,$sp # number of chars we read (times 4)
648#    srl $s6,$t0,2 # number of words on stack with chars
652#    subu $sp,$sp,4 # push char-count ...
656#    sw $s6,($sp) # ... onto stack
660#    addu $t2,$t0,5 # GC tag, incl. for count-word
664#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
668#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
672#    srl $s6,$s6,2  # data words in object
676#    move $s7,$zero # object words in object
680#    jal newObject  # allocate space
    
    # store header words
684#    la $t0,CLASS_String
688#    sw $t0,-12($s7)# store class tag (String) into object
692#    lw $t2,4($sp) # char-count
696#    sll $t1,$t2,2 # 4 times number of chars
700#    subu $t2,$zero,$t2 # negative of char-count
704#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
708#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
712#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
713##...slt $at,$t0,$zero
717##...beq $at,$zero,736
720#    and $t0,0xff # mask off object's hash value ...
721##...lui $at,0
725##...ori $at,$at,0xff
729##...and $t0,$t0,$at
732#    sw $t0,-8($s7) # ... and store back into -8 header-word
736:  skipMask_readLine:

736#    sll $t0,$t0,2 # data bytes in object
740#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
744#    subu $t0,$t0,$t2 # place to store last character (plus 9)
748#    addu $sp,$sp,8 # pop redundant object-pointer and count
752#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack
