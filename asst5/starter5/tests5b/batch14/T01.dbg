########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
2904:vm_init:

    # mark bottom of stack
2904#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
2908#    move $s2,$zero

    #set up the "five" register
2912#    li $s5,5

2916#    la $s3,seg0_start
2920#    la $s4,seg0_end
2921##...lui $s4,16
2925##...addiu $s4,$s4,3756
    
    # return
2928#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
2932:divide:
    # get parameters; abort if divisor zero
2932#    lw $t0,($sp)
2936#    lw $t1,8($sp)
2940#    beq $t0,$zero,divByZeroError
    
    # perform division
2944#    div $t1,$t0
2948#    mflo $t0

    # store result, adjust stack and return
2952#    addu $sp,$sp,8 # adjust stack
2956#    sw $t0,($sp) # store result
2960#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
2964:remainder:
    # get parameters; abort if divisor zero
2964#    lw $t0,($sp)
2968#    lw $t1,8($sp)
2972#    beq $t0,$zero,divByZeroError
    
    # perform division
2976#    div $t1,$t0
2980#    mfhi $t0

    # store result, adjust stack and return
2984#    addu $sp,$sp,8 # adjust stack
2988#    sw $t0,($sp) # store result
2992#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
2996:checkCast:
    # get object, allow immediately if null
2996#    lw $t2,($sp)
3000#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3004#    lw $t2,-12($t2) # vtable address
3008#    bge $t2,$t1,castException
3009##...slt $at,$t2,$t1
3013##...beq $at,$zero,3148
3016#    blt $t2,$t0,castException
3017##...slt $at,$t2,$t0
3021##...bne $at,$zero,3148
    
    # return, leaving object unchanged on stack
3024:  checkCastReturn:    
3024#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3028:instanceOf:
    # get object, go return false if null
3028#    lw $t2,($sp)
3032#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3036#    lw $t2,-12($t2) # vtable address
3040#    sge $t0,$t2,$t0 # are we >= the lower limit?
3041##...slt $t0,$t2,$t0
3045##...xori $t0,$t0,0x1
3048#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3052#    and $t2,$t0,$t1
3056#    sw $t2,($sp)
3060:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3060#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3064:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3064#    li $v0,4 # syscall-code for print-string
3068#    syscall
3072:exit:
    # print termination message
3072#    li $v0,4 # syscall-code for print-string
3076#    la $a0,exitString
3080#    syscall

    # terminate execution
3084#    li $v0,10 #syscall-code for "exit"
3088#    syscall

3092:outOfHeapMemory:
3092#    la $a0,heapMemoryMsg
3096#    j exitError
3100:divByZeroError:
3100#    la $a0,divByZeroMsg
3104#    j exitError
3108:strIndexOutOfBounds:
3108#    la $a0,strIndexOutOfBoundsMsg
3112#    j exitError
3116:arrayIndexOutOfBounds:
3116#    la $a0,arrayIndexOutOfBoundsMsg
3120#    j exitError
3124:arraySizeOutOfBounds:
3124#    la $a0,arraySizeOutOfBoundsMsg
3128#    j exitError
3132:nullPtrException:
3132#    la $a0,nullPtrExceptionMsg
3136#    j exitError
3140:badIntegerFormat:
3140#    la $a0,badIntegerFormatMsg
3144#    j exitError
3148:castException:
3148#    la $a0,castExceptionMsg
3152#    j exitError
############## data section ################
    .data
3392:hexChars:
    .ascii "0123456789abcdef"
    .align 2
3408:cur_seg:
    .word 0

3412:lastCharRead:
    .word -2 # -2 => no buffered character
3416:prevHashConstant:
    .word 0x2785173c
3420:gcCount:
    .word 0

3424:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
3451:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
3474:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
3509:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
3543:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
3576:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
3607:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
3655:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
3676:gcMsg: 
      .asciiz "\nGC!\n"
3682:gcCountMsg: 
      .asciiz "Number of garbage collections: "

3714:nullStr:
    .asciiz "null"
3719:trueString:
    .asciiz "true"
3724:falseString:
    .asciiz "false"
3730:exitString:
    .ascii "Program terminated."
    #### "falls through" here
3749:newlineString:
    .asciiz "\n"
    
    .align 2
3752:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

3756:seg0_start:
    .space 0x100000
1052332:seg0_end:
1052332:seg1_start:
    .space 0x100000
2100908:seg1_end:
