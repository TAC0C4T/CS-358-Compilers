.data
3368:strLit_48:
.asciiz "Jumbles of Crumbles!\n"
.align 2
.text
.globl main
0:main:
0#  jal vm_init
4#  li $v0, 10
8#  syscall
12:mth_main_Main:
12#  subu $sp, $sp, 4
16#  sw $0, ($sp)
20#  subu $sp, $sp, 4
24#  sw $0, ($sp)
28#  la $t0, strLit_48
32#  subu $sp, $sp, 4
36#  sw $t0, ($sp)
40#  subu $sp, $sp, 4
44#  sw $s2, ($sp)
48#  jr $ra
##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
52:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
52#    lw $t0,-8($s2) # get word with hash bits from this
56#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
60#    addu $t0,$t1

64#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
68:mth_equals_Object:
68#    move $t0,$s2 # first pointer (this)
72#    lw $t1,($sp) # second pointer
76#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
77##...subu $at,$t0,$t1
81##...sltiu $t0,$at,1

84#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
88:mth_hashCode_String:
88#    move $t0,$s2 # put this pointer in t0

92#    li $t2,0 # current hash value
96#    lw $t1,-4($t0) # negative of number of characters in string
100#    beq $t1,$zero,done_hashCode_String # if zero length => done
104#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
108#    and $t0,0xfffffffc # adjust for padding
109##...lui $at,65535
113##...ori $at,$at,0xfffc
117##...and $t0,$t0,$at
120#    subu $t1,$t0,$t1 # address at end of string +12
124:loop_hashCode_String:    
124#    sll $t4,$t2,5 # multiply by 32
128#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
132#    lbu $t3,-12($t0) # current character
136#    addu $t2,$t3 # add in current character
140#    addu $t0,1 # go to next character's address
144#    bne $t0,$t1,loop_hashCode_String # loop back if more
148:done_hashCode_String:    

    # push int on stack
148#    move $t0, $t2 # put $t2 in return slot
152#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
156:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
156#    subu $sp,4
160#    sw $ra,($sp)
    
    # get hash value
164#    lw $t2,-12($s2) # vtable address
168#    lw $t0,($t2) # method address
172#    jalr $t0
176#    subu $sp,8 # push result (int in $t0) on stack
180#    sw $s5,4($sp)
184#    sw $t0,($sp)

    # compute print-size of hash value
188#    li $t0, 1
192#    lw $t1, ($sp)
196#    srl $t1,$t1,4
200#    beq $t1,$zero,toString_skip_loop
204:toString_loop_top:
204#    addu $t0,1
208#    srl $t1,$t1,4
212#    bne $t1,$zero,toString_loop_top
216:toString_skip_loop:
216#    subu $sp,8
220#    sw $s5,4($sp)
224#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
228#    lw $t2,-12($s2) # vtable address
232#    move $t0,$t2
236:toString_checkTagBit:
236#    subu $t0,1
240#    lb $t1,($t0)
244#    and $t1,0x80
245##...lui $at,0
249##...ori $at,$at,0x80
253##...and $t1,$t1,$at
256#    beq $t1,$zero,toString_checkTagBit
260#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
264#    subu $sp,8
268#    sw $t1,($sp)
272#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
276#    move $s7,$zero # -4 offset header word
280#    lw $t4,8($sp) # bytes for hash value
284#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
288#    addu $t4,8
292#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
296#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

300#    li $t0,CLASS_String # store string vtable address into ...
304#    sw $t0,-12($s7) # ... -12 offset in object header
308#    lw $t2,-12($s2) # our object's vtable address
312#    lw $t5,4($sp) # number characters in prefix
316#    lw $t1,12($sp) # number of characters in hashcode
320#    addu $t3,$t1,$t5 # number of characters in string ...
324#    addu $t3,1 # ... including the '@' character
328#    subu $t0,$zero,$t3 # store negated length into ...
332#    sw $t0,-4($s7) # ... -4 offset header word
336#    lw $t0,-8($s7) # get -8 offset header-word
340#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
341##...slt $at,$t0,$zero
345##...beq $at,$zero,364
348#    and $t0,0xff # mask off object's hash value ...
349##...lui $at,0
353##...ori $at,$at,0xff
357##...and $t0,$t0,$at
360#    sw $t0,-8($s7) # ... and store back into -8 header-word
364:skipMask_toString:
364#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
368#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
372#    subu $t4,$t2,$t5
376:toString_copyLoop:    
376#    lb $t3,($t4)
380#    and $t3,0x7f # mask off sign bit (in case first word)
381##...lui $at,0
385##...ori $at,$at,0x7f
389##...and $t3,$t3,$at
392#    sb $t3,-8($t0)
396#    addu $t4,1
400#    addu $t0,1
404#    blt $t4,$t2,toString_copyLoop
405##...slt $at,$t4,$t2
409##...bne $at,$zero,376

    # copy the '@' sign
412#    li $t3,'@'
416#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
420#    addu $t2,$t0,$t1 # address of last byte in string to store +8
424#    lw $t3,20($sp) # hash code to print
428:toString_hashCopyLoop:
428#    and $t4,$t3,0xf
432#    srl $t3,4
436#    lb $t4,hexChars($t4)
440#    sb $t4,-8($t2)
444#    subu $t2,$t2,1
448#    bgt $t2,$t0,toString_hashCopyLoop
449##...slt $at,$t0,$t2
453##...bne $at,$zero,428

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
456#    addu $sp,28
460#    lw $ra,($sp)
464#    addu $sp,4
468#    move $t0, $s7 # return string we created
472#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
476:mth_equals_String:
    
    # quick test for obvious false
476#    lw $t0,($sp) # second parameter
480#    beq $t0,$zero,goEsFalse # go return false if null
484#    lw $t1,-12($t0) # vtable pointer
488#    la $t2,CLASS_String # string vtable pointer
492#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
496#    subu $sp,12
500#    sw $ra,8($sp)
504#    sw $s2,4($sp)
508#    sw $t0,($sp)
512#    jal mth_compareTo_String
516#    lw $s2, 4($sp) #restore this pointer and pop parameters
520#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
524#    seq $t0,$t0,$zero
525##...subu $at,$t0,$zero
529##...sltiu $t0,$at,1

    # pop return address and return $t0
532#    lw $ra,($sp)
536#    addu $sp,4

540#    jr $ra # return
    
544:goEsFalse:
    # put 0 in $t0 and return
544#    li $t0, 0
548#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
552:mth_toString_String:
    #we are a string, so return this.
552#    move $t0, $s2
556#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
560:mth_readLine_Lib:
    
560#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
564#    sw $ra, 4($sp) # save $ra
568#    move $t1,$sp # save "original" sp

572:  doRead:

    # read the character
572#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
576#    subu $t2,$v0,13
580#    bne $t2,$zero,notReturnRL
584#    jal readLogicalChar
588#    subu $t2,$v0,10 # check for newline
592#    beq $t2,$zero,foundNewLine
596#    sw $v0,lastCharRead # push back character into queue
600#    j foundNewLine # go process the line

604:  notReturnRL:

    # at this point, $v0 has our character

604#    subu $t0,$v0,10
608#    beq $t0,$zero,foundNewLine
612#    blt $v0,$zero,foundEof
613##...slt $at,$v0,$zero
617##...bne $at,$zero,632

    # we have a character, so push it onto stack
620#    subu $sp,$sp,4
624#    sw $v0,($sp)

    # loop back up to get next character
628#    j doRead

632:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
632#    bne $t1,$sp foundNewLine

