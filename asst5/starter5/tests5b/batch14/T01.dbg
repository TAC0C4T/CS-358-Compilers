824#    subu $t0,$v0,10
828#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
832#    subu $t0,$v0,9
836#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
840#    subu $t0,$v0,13
844#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
848#    subu $t0,$v0,12
