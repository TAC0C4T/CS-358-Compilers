    # processing, we're done, so go finish up
2592#    bgeu $t0,$s3,gcFinishUp
2593##...sltu $at,$t0,$s3
2597##...beq $at,$zero,2888

    ###### begin outer loop to copy all non-stack-direct objects ######

2600:  gcHeapCopyLoop:
    # get data count for object; swap header-word with first word
    # of object so that they're back in the right place
2600#    lw $t1,($t0) # (what will be) first header word for current object
2604#    move $t2,$t1 # number data bytes in object (poss. w/hash bits)
2608#    bge $t2,$zero,gcSkip4a # are there hash bits?
2609##...slt $at,$t2,$zero
2613##...beq $at,$zero,2628
2616#    and $t2,0xff # mask off hash bits
2617##...lui $at,0
2621##...ori $at,$at,0xff
2625##...and $t2,$t2,$at
2628:gcSkip4a:    
2628#    sll $t2,$t2,2 # # data bytes
2632#    addu $t2,$t2,8 # to skip header words
2636#    addu $t2,$t0,$t2 # pointer to new object
2640#    lw $t3,-8($t2) # word to swap
2644#    sw $t1,-8($t2) # store header word
2648#    sw $t3,($t0) # restore first word of object

    ################################################
    # at this point:
    # - $t2 contains the pointer to our new object
    ################################################

    # check if we have a data array
2652#    lw $t1,-12($t2) # vtable pointer
2656#    li $t0,dataArrayVTableStart # address of vtable for first data array
2660#    blt $t1,$t0,gcNotDataArray # if data array, no more xforming to do
2661##...slt $at,$t1,$t0
2665##...bne $at,$zero,2684

    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
2668:  skipToNextObj:
2668#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
2672#    sll $t1,$t1,2 # convert to byte-count
2676#    addu $t0,$t2,$t1 # skip over object
2680#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
2684:  gcNotDataArray:
2684#    lw $t3,-4($t2) # # object words (negative treated as zero)
2688#    bge $t3,$zero,gcH2Neg2
