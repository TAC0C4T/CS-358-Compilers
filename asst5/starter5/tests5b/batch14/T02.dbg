1233##...slt $at,$zero,$t0
1237##...bne $at,$zero,1280
1240#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1244#    subu $t0,$v0,10
1248#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1252#    subu $t0,$v0,9
1256#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1260#    subu $t0,$v0,13
1264#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1268#    subu $t0,$v0,12
1272#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1276#    j badIntegerFormat # illegal integer char: abort program

1280:  nonWhite:
1280#    subu $t0,$v0,'-'
1284#    li $t4,1 # final multiplier
1288#    bne $t0,$zero,helpReadInt # go read
1292#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1296#    jal readLogicalChar

1300:  helpReadInt:
1300#    li $t2,10
1304#    subu $t1,$v0,'0' # convert digit to 0-9 value
