    #### and $t2 contains the value 10

1320:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

1320#    jal readLogicalChar # read next character
1324#    subu $t1,$v0,'0' # convert digit to 0-9 value
1328#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
1329##...sltu $at,$t1,$t2
1333##...beq $at,$zero,1352

1336#    mul $t3,$t3,$t2 # multiply old value by 10
1337##...mult $t3,$t2
1341##...mflo $t3
1344#    addu $t3,$t3,$t1 # add in value of new digit
1348#    j digitLoop

1352:  doneDigitLoop:

    # "push back" unused character into queue
1352#    sw $v0,lastCharRead
