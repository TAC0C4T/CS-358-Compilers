########################################################
# readLogicalChar (millicode)
#  - logically reads a character from standard input
#  - first checks character buffer, consuming it if possible
#  - return-result:
#    - returns character in $v0
#  - side-effects:
#    - reads a character
#    - clobbers $t0
########################################################
2516:readLogicalChar:

    # check if we already have a character
2516#    lw $v0,lastCharRead
2520#    li $t0,-2
2524#    beq $t0,$v0 doReadCh

    # we have our character from the buffer. Wipe out
    # buffer and return
2528#    sw $t0,lastCharRead # store -2 into buffer (i.e. "empty")
2532#    jr $ra # return
    
2536:  doReadCh:
    # we need to actually read a character: read and return
2536#    li $v0,12 # use system call to read a character
2540#    syscall
2544#    jr $ra # return
