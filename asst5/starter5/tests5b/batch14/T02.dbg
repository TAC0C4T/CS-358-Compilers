#   - $t0 - value that was read
###################################################################
1216:mth_readInt_Lib:

    # save $ra by pushing onto stack
1216#    subu $sp,$sp,4
1220#    sw $ra,($sp)

1224:  riSkipWhiteLoop:
    # read a character
1224#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
1228#    subu $t0,$v0,32
