944#    seq $t0,$t0,$zero
945##...subu $at,$t0,$zero
949##...sltiu $t0,$at,1

    # pop return address and return $t0
952#    lw $ra,($sp)
956#    addu $sp,4

960#    jr $ra # return
    
964:goEsFalse:
    # put 0 in $t0 and return
964#    li $t0, 0
968#    jr $ra # return
