###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
980:mth_readLine_Lib:
    
980#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
984#    sw $ra, 4($sp) # save $ra
988#    move $t1,$sp # save "original" sp

992:  doRead:

    # read the character
992#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
996#    subu $t2,$v0,13
1000#    bne $t2,$zero,notReturnRL
1004#    jal readLogicalChar
1008#    subu $t2,$v0,10 # check for newline
1012#    beq $t2,$zero,foundNewLine
1016#    sw $v0,lastCharRead # push back character into queue
1020#    j foundNewLine # go process the line

1024:  notReturnRL:

    # at this point, $v0 has our character

1024#    subu $t0,$v0,10
1028#    beq $t0,$zero,foundNewLine
1032#    blt $v0,$zero,foundEof
1033##...slt $at,$v0,$zero
1037##...bne $at,$zero,1052

    # we have a character, so push it onto stack
1040#    subu $sp,$sp,4
1044#    sw $v0,($sp)

    # loop back up to get next character
1048#    j doRead

1052:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1052#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1056#    li $s7, 0 # return-value: null
1060#    j rlReturn # return

1064:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1064#    subu $t0,$t1,$sp # number of chars we read (times 4)
1068#    srl $s6,$t0,2 # number of words on stack with chars
1072#    subu $sp,$sp,4 # push char-count ...
1076#    sw $s6,($sp) # ... onto stack
1080#    addu $t2,$t0,5 # GC tag, incl. for count-word
1084#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1088#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1092#    srl $s6,$s6,2  # data words in object
1096#    move $s7,$zero # object words in object
1100#    jal newObject  # allocate space
    
    # store header words
1104#    la $t0,CLASS_String
1108#    sw $t0,-12($s7)# store class tag (String) into object
1112#    lw $t2,4($sp) # char-count
1116#    sll $t1,$t2,2 # 4 times number of chars
1120#    subu $t2,$zero,$t2 # negative of char-count
1124#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1128#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1132#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1133##...slt $at,$t0,$zero
1137##...beq $at,$zero,1156
1140#    and $t0,0xff # mask off object's hash value ...
1141##...lui $at,0
1145##...ori $at,$at,0xff
1149##...and $t0,$t0,$at
1152#    sw $t0,-8($s7) # ... and store back into -8 header-word
1156:  skipMask_readLine:

1156#    sll $t0,$t0,2 # data bytes in object
1160#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1164#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1168#    addu $sp,$sp,8 # pop redundant object-pointer and count
1172#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack
