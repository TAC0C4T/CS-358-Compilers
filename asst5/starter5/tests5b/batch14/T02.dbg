
    # set up the forwarding pointer
3276#    sw $zero,-8($t1) # 0 in first header-slot
3280#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
3284#    sw $t8,($t0)

3288:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
3288#    addu $t0,$t0,4
3292#    bltu $t0,$s1,gcNextPointerInObject
3293##...sltu $at,$t0,$s1
3297##...bne $at,$zero,3136

3300:  gcTestIterDone2:
3300#    bltu $t0,$s3,gcHeapCopyLoop
3301##...sltu $at,$t0,$s3
3305##...bne $at,$zero,3020

    ###### end outer loop to copy all non-stack-direct objects ######

3308:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
3308#    lw $s2,($sp)
3312#    addu $sp,$sp,4

    # mark us as having already GC'd
3316#    move $t5,$s5

    # go try and allocate again
3320#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3324:vm_init:

    # mark bottom of stack
3324#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3328#    move $s2,$zero

    #set up the "five" register
3332#    li $s5,5

3336#    la $s3,seg0_start
3340#    la $s4,seg0_end
3341##...lui $s4,16
3345##...addiu $s4,$s4,4216
    
    # return
3348#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3352:divide:
    # get parameters; abort if divisor zero
3352#    lw $t0,($sp)
3356#    lw $t1,8($sp)
3360#    beq $t0,$zero,divByZeroError
    
    # perform division
3364#    div $t1,$t0
3368#    mflo $t0

    # store result, adjust stack and return
3372#    addu $sp,$sp,8 # adjust stack
3376#    sw $t0,($sp) # store result
3380#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3384:remainder:
    # get parameters; abort if divisor zero
3384#    lw $t0,($sp)
3388#    lw $t1,8($sp)
3392#    beq $t0,$zero,divByZeroError
    
    # perform division
3396#    div $t1,$t0
3400#    mfhi $t0

    # store result, adjust stack and return
3404#    addu $sp,$sp,8 # adjust stack
3408#    sw $t0,($sp) # store result
3412#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3416:checkCast:
    # get object, allow immediately if null
3416#    lw $t2,($sp)
3420#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3424#    lw $t2,-12($t2) # vtable address
3428#    bge $t2,$t1,castException
3429##...slt $at,$t2,$t1
3433##...beq $at,$zero,3568
3436#    blt $t2,$t0,castException
3437##...slt $at,$t2,$t0
3441##...bne $at,$zero,3568
    
    # return, leaving object unchanged on stack
3444:  checkCastReturn:    
3444#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3448:instanceOf:
    # get object, go return false if null
3448#    lw $t2,($sp)
3452#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3456#    lw $t2,-12($t2) # vtable address
3460#    sge $t0,$t2,$t0 # are we >= the lower limit?
3461##...slt $t0,$t2,$t0
3465##...xori $t0,$t0,0x1
3468#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3472#    and $t2,$t0,$t1
3476#    sw $t2,($sp)
3480:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3480#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3484:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3484#    li $v0,4 # syscall-code for print-string
3488#    syscall
3492:exit:
    # print termination message
3492#    li $v0,4 # syscall-code for print-string
3496#    la $a0,exitString
3500#    syscall

    # terminate execution
3504#    li $v0,10 #syscall-code for "exit"
3508#    syscall

3512:outOfHeapMemory:
3512#    la $a0,heapMemoryMsg
3516#    j exitError
3520:divByZeroError:
3520#    la $a0,divByZeroMsg
3524#    j exitError
3528:strIndexOutOfBounds:
3528#    la $a0,strIndexOutOfBoundsMsg
3532#    j exitError
3536:arrayIndexOutOfBounds:
3536#    la $a0,arrayIndexOutOfBoundsMsg
3540#    j exitError
3544:arraySizeOutOfBounds:
3544#    la $a0,arraySizeOutOfBoundsMsg
3548#    j exitError
3552:nullPtrException:
3552#    la $a0,nullPtrExceptionMsg
3556#    j exitError
3560:badIntegerFormat:
3560#    la $a0,badIntegerFormatMsg
3564#    j exitError
3568:castException:
3568#    la $a0,castExceptionMsg
3572#    j exitError
############## data section ################
    .data
3852:hexChars:
    .ascii "0123456789abcdef"
    .align 2
3868:cur_seg:
    .word 0

3872:lastCharRead:
    .word -2 # -2 => no buffered character
3876:prevHashConstant:
    .word 0x2785173c
3880:gcCount:
    .word 0

3884:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
3911:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
3934:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
3969:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4003:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4036:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4067:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4115:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4136:gcMsg: 
      .asciiz "\nGC!\n"
4142:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4174:nullStr:
    .asciiz "null"
4179:trueString:
    .asciiz "true"
4184:falseString:
    .asciiz "false"
4190:exitString:
    .ascii "Program terminated."
    #### "falls through" here
4209:newlineString:
    .asciiz "\n"
    
    .align 2
4212:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

4216:seg0_start:
    .space 0x100000
1052792:seg0_end:
1052792:seg1_start:
    .space 0x100000
2101368:seg1_end:
