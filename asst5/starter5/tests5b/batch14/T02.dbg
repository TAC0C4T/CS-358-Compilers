##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
472:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
472#    lw $t0,-8($s2) # get word with hash bits from this
476#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
480#    addu $t0,$t1

484#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
488:mth_equals_Object:
488#    move $t0,$s2 # first pointer (this)
492#    lw $t1,($sp) # second pointer
496#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
497##...subu $at,$t0,$t1
501##...sltiu $t0,$at,1

504#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
508:mth_hashCode_String:
508#    move $t0,$s2 # put this pointer in t0

512#    li $t2,0 # current hash value
516#    lw $t1,-4($t0) # negative of number of characters in string
520#    beq $t1,$zero,done_hashCode_String # if zero length => done
524#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
528#    and $t0,0xfffffffc # adjust for padding
529##...lui $at,65535
533##...ori $at,$at,0xfffc
537##...and $t0,$t0,$at
540#    subu $t1,$t0,$t1 # address at end of string +12
544:loop_hashCode_String:    
544#    sll $t4,$t2,5 # multiply by 32
548#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
552#    lbu $t3,-12($t0) # current character
556#    addu $t2,$t3 # add in current character
560#    addu $t0,1 # go to next character's address
564#    bne $t0,$t1,loop_hashCode_String # loop back if more
568:done_hashCode_String:    

    # push int on stack
568#    move $t0, $t2 # put $t2 in return slot
572#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
576:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
576#    subu $sp,4
580#    sw $ra,($sp)
    
    # get hash value
584#    lw $t2,-12($s2) # vtable address
588#    lw $t0,($t2) # method address
592#    jalr $t0
596#    subu $sp,8 # push result (int in $t0) on stack
600#    sw $s5,4($sp)
604#    sw $t0,($sp)

    # compute print-size of hash value
608#    li $t0, 1
612#    lw $t1, ($sp)
616#    srl $t1,$t1,4
620#    beq $t1,$zero,toString_skip_loop
624:toString_loop_top:
624#    addu $t0,1
628#    srl $t1,$t1,4
632#    bne $t1,$zero,toString_loop_top
636:toString_skip_loop:
636#    subu $sp,8
640#    sw $s5,4($sp)
644#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
648#    lw $t2,-12($s2) # vtable address
652#    move $t0,$t2
656:toString_checkTagBit:
656#    subu $t0,1
660#    lb $t1,($t0)
664#    and $t1,0x80
665##...lui $at,0
669##...ori $at,$at,0x80
673##...and $t1,$t1,$at
676#    beq $t1,$zero,toString_checkTagBit
680#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
684#    subu $sp,8
688#    sw $t1,($sp)
692#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
696#    move $s7,$zero # -4 offset header word
700#    lw $t4,8($sp) # bytes for hash value
704#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
708#    addu $t4,8
712#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
716#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

720#    li $t0,CLASS_String # store string vtable address into ...
724#    sw $t0,-12($s7) # ... -12 offset in object header
728#    lw $t2,-12($s2) # our object's vtable address
732#    lw $t5,4($sp) # number characters in prefix
736#    lw $t1,12($sp) # number of characters in hashcode
740#    addu $t3,$t1,$t5 # number of characters in string ...
744#    addu $t3,1 # ... including the '@' character
748#    subu $t0,$zero,$t3 # store negated length into ...
752#    sw $t0,-4($s7) # ... -4 offset header word
756#    lw $t0,-8($s7) # get -8 offset header-word
760#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
761##...slt $at,$t0,$zero
765##...beq $at,$zero,784
768#    and $t0,0xff # mask off object's hash value ...
769##...lui $at,0
773##...ori $at,$at,0xff
777##...and $t0,$t0,$at
780#    sw $t0,-8($s7) # ... and store back into -8 header-word
784:skipMask_toString:
784#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
788#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
792#    subu $t4,$t2,$t5
796:toString_copyLoop:    
796#    lb $t3,($t4)
800#    and $t3,0x7f # mask off sign bit (in case first word)
801##...lui $at,0
805##...ori $at,$at,0x7f
809##...and $t3,$t3,$at
812#    sb $t3,-8($t0)
816#    addu $t4,1
820#    addu $t0,1
824#    blt $t4,$t2,toString_copyLoop
825##...slt $at,$t4,$t2
829##...bne $at,$zero,796

    # copy the '@' sign
832#    li $t3,'@'
836#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
840#    addu $t2,$t0,$t1 # address of last byte in string to store +8
844#    lw $t3,20($sp) # hash code to print
848:toString_hashCopyLoop:
