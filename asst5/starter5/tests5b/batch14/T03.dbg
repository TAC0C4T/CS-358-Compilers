1604:  nonWhite:
1604#    subu $t0,$v0,'-'
1608#    li $t4,1 # final multiplier
1612#    bne $t0,$zero,helpReadInt # go read
1616#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
