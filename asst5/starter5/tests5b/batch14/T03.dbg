1085##...slt $at,$t0,$zero
1089##...beq $at,$zero,1108
1092#    and $t0,0xff # mask off object's hash value ...
1093##...lui $at,0
1097##...ori $at,$at,0xff
1101##...and $t0,$t0,$at
1104#    sw $t0,-8($s7) # ... and store back into -8 header-word
1108:skipMask_toString:
1108#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1112#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1116#    subu $t4,$t2,$t5
1120:toString_copyLoop:    
1120#    lb $t3,($t4)
1124#    and $t3,0x7f # mask off sign bit (in case first word)
1125##...lui $at,0
1129##...ori $at,$at,0x7f
