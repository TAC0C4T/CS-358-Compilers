##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
796:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
796#    lw $t0,-8($s2) # get word with hash bits from this
800#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
804#    addu $t0,$t1

808#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
812:mth_equals_Object:
812#    move $t0,$s2 # first pointer (this)
816#    lw $t1,($sp) # second pointer
820#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
821##...subu $at,$t0,$t1
825##...sltiu $t0,$at,1

828#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
832:mth_hashCode_String:
832#    move $t0,$s2 # put this pointer in t0

836#    li $t2,0 # current hash value
840#    lw $t1,-4($t0) # negative of number of characters in string
844#    beq $t1,$zero,done_hashCode_String # if zero length => done
848#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
852#    and $t0,0xfffffffc # adjust for padding
853##...lui $at,65535
857##...ori $at,$at,0xfffc
861##...and $t0,$t0,$at
864#    subu $t1,$t0,$t1 # address at end of string +12
868:loop_hashCode_String:    
868#    sll $t4,$t2,5 # multiply by 32
872#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
876#    lbu $t3,-12($t0) # current character
880#    addu $t2,$t3 # add in current character
884#    addu $t0,1 # go to next character's address
888#    bne $t0,$t1,loop_hashCode_String # loop back if more
892:done_hashCode_String:    

    # push int on stack
892#    move $t0, $t2 # put $t2 in return slot
896#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
900:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
900#    subu $sp,4
904#    sw $ra,($sp)
    
    # get hash value
908#    lw $t2,-12($s2) # vtable address
912#    lw $t0,($t2) # method address
916#    jalr $t0
920#    subu $sp,8 # push result (int in $t0) on stack
924#    sw $s5,4($sp)
928#    sw $t0,($sp)

    # compute print-size of hash value
932#    li $t0, 1
936#    lw $t1, ($sp)
940#    srl $t1,$t1,4
944#    beq $t1,$zero,toString_skip_loop
948:toString_loop_top:
948#    addu $t0,1
952#    srl $t1,$t1,4
956#    bne $t1,$zero,toString_loop_top
960:toString_skip_loop:
960#    subu $sp,8
964#    sw $s5,4($sp)
968#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
972#    lw $t2,-12($s2) # vtable address
976#    move $t0,$t2
980:toString_checkTagBit:
980#    subu $t0,1
984#    lb $t1,($t0)
988#    and $t1,0x80
989##...lui $at,0
993##...ori $at,$at,0x80
997##...and $t1,$t1,$at
1000#    beq $t1,$zero,toString_checkTagBit
1004#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1008#    subu $sp,8
1012#    sw $t1,($sp)
1016#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1020#    move $s7,$zero # -4 offset header word
1024#    lw $t4,8($sp) # bytes for hash value
1028#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1032#    addu $t4,8
1036#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1040#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1044#    li $t0,CLASS_String # store string vtable address into ...
1048#    sw $t0,-12($s7) # ... -12 offset in object header
1052#    lw $t2,-12($s2) # our object's vtable address
1056#    lw $t5,4($sp) # number characters in prefix
1060#    lw $t1,12($sp) # number of characters in hashcode
1064#    addu $t3,$t1,$t5 # number of characters in string ...
1068#    addu $t3,1 # ... including the '@' character
1072#    subu $t0,$zero,$t3 # store negated length into ...
1076#    sw $t0,-4($s7) # ... -4 offset header word
1080#    lw $t0,-8($s7) # get -8 offset header-word
