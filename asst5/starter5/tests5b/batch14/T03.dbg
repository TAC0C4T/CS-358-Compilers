1568#    subu $t0,$v0,10
1572#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1576#    subu $t0,$v0,9
1580#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1584#    subu $t0,$v0,13
1588#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1592#    subu $t0,$v0,12
