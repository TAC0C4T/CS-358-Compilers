3509##...lui $at,0
3513##...ori $at,$at,0xff
3517##...and $t8,$t8,$at

3520:  gcSkip5:
3520#    sll $t8,$t8,2 # bytes in negative-offset portion ...
3524#    addu $t8,$t8,8 # ... add in bytes for header-words
3528#    subu $t4,$t1,$t8 # address of first word of source object
3532#    lw $t3,-4($t1) # # words in positive-offset portion
3536#    bge $t3,$zero,gcNoNeg
3537##...slt $at,$t3,$zero
3541##...beq $at,$zero,3548
3544#    move $t3,$zero # negative treated as zero
3548:  gcNoNeg:
3548#    sll $t3,$t3,2 # bytes in negative-offset portion
3552#    addu $t3,$t3,$t1 # address one word past last word of source

3556#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
3560#    lw $s0,($t4)
3564#    lw $t9,-8($t1)
3568#    sw $t9,($t4)
3572#    sw $s0,-8($t1)

    # copy all source bytes to the target
3576:  gCinnerCopy2:
3576#    lw $s0,($t4)
3580#    sw $s0,($s3)
3584#    addu $t4,$t4,4
3588#    addu $s3,$s3,4
3592#    bltu $t4,$t3,gCinnerCopy2
3593##...sltu $at,$t4,$t3
3597##...bne $at,$zero,3576

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
3600#    sw $zero,-8($t1) # 0 in first header-slot
3604#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
3608#    sw $t8,($t0)

3612:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
3612#    addu $t0,$t0,4
3616#    bltu $t0,$s1,gcNextPointerInObject
3617##...sltu $at,$t0,$s1
3621##...bne $at,$zero,3460

3624:  gcTestIterDone2:
3624#    bltu $t0,$s3,gcHeapCopyLoop
3625##...sltu $at,$t0,$s3
3629##...bne $at,$zero,3344

    ###### end outer loop to copy all non-stack-direct objects ######

3632:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
3632#    lw $s2,($sp)
3636#    addu $sp,$sp,4

    # mark us as having already GC'd
3640#    move $t5,$s5

    # go try and allocate again
3644#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3648:vm_init:

    # mark bottom of stack
3648#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3652#    move $s2,$zero

    #set up the "five" register
3656#    li $s5,5

3660#    la $s3,seg0_start
3664#    la $s4,seg0_end
3665##...lui $s4,16
3669##...addiu $s4,$s4,4500
    
    # return
3672#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3676:divide:
    # get parameters; abort if divisor zero
3676#    lw $t0,($sp)
3680#    lw $t1,8($sp)
3684#    beq $t0,$zero,divByZeroError
    
    # perform division
3688#    div $t1,$t0
3692#    mflo $t0

    # store result, adjust stack and return
3696#    addu $sp,$sp,8 # adjust stack
3700#    sw $t0,($sp) # store result
3704#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3708:remainder:
    # get parameters; abort if divisor zero
3708#    lw $t0,($sp)
3712#    lw $t1,8($sp)
3716#    beq $t0,$zero,divByZeroError
    
    # perform division
3720#    div $t1,$t0
3724#    mfhi $t0

    # store result, adjust stack and return
3728#    addu $sp,$sp,8 # adjust stack
3732#    sw $t0,($sp) # store result
3736#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3740:checkCast:
    # get object, allow immediately if null
3740#    lw $t2,($sp)
3744#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3748#    lw $t2,-12($t2) # vtable address
3752#    bge $t2,$t1,castException
3753##...slt $at,$t2,$t1
3757##...beq $at,$zero,3892
3760#    blt $t2,$t0,castException
3761##...slt $at,$t2,$t0
3765##...bne $at,$zero,3892
    
    # return, leaving object unchanged on stack
3768:  checkCastReturn:    
3768#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3772:instanceOf:
    # get object, go return false if null
3772#    lw $t2,($sp)
3776#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3780#    lw $t2,-12($t2) # vtable address
3784#    sge $t0,$t2,$t0 # are we >= the lower limit?
3785##...slt $t0,$t2,$t0
3789##...xori $t0,$t0,0x1
3792#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3796#    and $t2,$t0,$t1
3800#    sw $t2,($sp)
3804:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3804#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3808:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3808#    li $v0,4 # syscall-code for print-string
3812#    syscall
3816:exit:
    # print termination message
3816#    li $v0,4 # syscall-code for print-string
3820#    la $a0,exitString
3824#    syscall

    # terminate execution
3828#    li $v0,10 #syscall-code for "exit"
3832#    syscall

3836:outOfHeapMemory:
3836#    la $a0,heapMemoryMsg
3840#    j exitError
3844:divByZeroError:
3844#    la $a0,divByZeroMsg
3848#    j exitError
3852:strIndexOutOfBounds:
3852#    la $a0,strIndexOutOfBoundsMsg
3856#    j exitError
3860:arrayIndexOutOfBounds:
3860#    la $a0,arrayIndexOutOfBoundsMsg
3864#    j exitError
3868:arraySizeOutOfBounds:
3868#    la $a0,arraySizeOutOfBoundsMsg
3872#    j exitError
3876:nullPtrException:
3876#    la $a0,nullPtrExceptionMsg
3880#    j exitError
3884:badIntegerFormat:
3884#    la $a0,badIntegerFormatMsg
3888#    j exitError
3892:castException:
3892#    la $a0,castExceptionMsg
3896#    j exitError
############## data section ################
    .data
4136:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4152:cur_seg:
    .word 0

4156:lastCharRead:
    .word -2 # -2 => no buffered character
4160:prevHashConstant:
    .word 0x2785173c
4164:gcCount:
