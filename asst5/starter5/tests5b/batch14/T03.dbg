1268#    seq $t0,$t0,$zero
1269##...subu $at,$t0,$zero
1273##...sltiu $t0,$at,1

    # pop return address and return $t0
1276#    lw $ra,($sp)
1280#    addu $sp,4

1284#    jr $ra # return
    
1288:goEsFalse:
    # put 0 in $t0 and return
1288#    li $t0, 0
1292#    jr $ra # return
