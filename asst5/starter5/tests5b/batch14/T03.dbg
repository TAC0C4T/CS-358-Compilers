###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1304:mth_readLine_Lib:
    
1304#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1308#    sw $ra, 4($sp) # save $ra
1312#    move $t1,$sp # save "original" sp

1316:  doRead:

    # read the character
1316#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1320#    subu $t2,$v0,13
1324#    bne $t2,$zero,notReturnRL
1328#    jal readLogicalChar
1332#    subu $t2,$v0,10 # check for newline
1336#    beq $t2,$zero,foundNewLine
1340#    sw $v0,lastCharRead # push back character into queue
1344#    j foundNewLine # go process the line

1348:  notReturnRL:

    # at this point, $v0 has our character

1348#    subu $t0,$v0,10
1352#    beq $t0,$zero,foundNewLine
1356#    blt $v0,$zero,foundEof
1357##...slt $at,$v0,$zero
1361##...bne $at,$zero,1376

    # we have a character, so push it onto stack
1364#    subu $sp,$sp,4
1368#    sw $v0,($sp)

    # loop back up to get next character
1372#    j doRead

1376:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1376#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1380#    li $s7, 0 # return-value: null
1384#    j rlReturn # return

1388:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1388#    subu $t0,$t1,$sp # number of chars we read (times 4)
1392#    srl $s6,$t0,2 # number of words on stack with chars
1396#    subu $sp,$sp,4 # push char-count ...
1400#    sw $s6,($sp) # ... onto stack
1404#    addu $t2,$t0,5 # GC tag, incl. for count-word
1408#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1412#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1416#    srl $s6,$s6,2  # data words in object
1420#    move $s7,$zero # object words in object
1424#    jal newObject  # allocate space
    
    # store header words
1428#    la $t0,CLASS_String
1432#    sw $t0,-12($s7)# store class tag (String) into object
1436#    lw $t2,4($sp) # char-count
1440#    sll $t1,$t2,2 # 4 times number of chars
1444#    subu $t2,$zero,$t2 # negative of char-count
1448#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1452#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1456#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1457##...slt $at,$t0,$zero
1461##...beq $at,$zero,1480
1464#    and $t0,0xff # mask off object's hash value ...
1465##...lui $at,0
1469##...ori $at,$at,0xff
1473##...and $t0,$t0,$at
1476#    sw $t0,-8($s7) # ... and store back into -8 header-word
1480:  skipMask_readLine:

1480#    sll $t0,$t0,2 # data bytes in object
1484#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1488#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1492#    addu $sp,$sp,8 # pop redundant object-pointer and count
1496#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

1500#    beq $sp,$t1,rlReturn
1504:  charCopyLoop:
1504#    lw $t2,($sp)
1508#    sb $t2,-9($t0)
1512#    addu $sp,$sp,4
1516#    subu $t0,$t0,1
1520#    bne $sp,$t1,charCopyLoop
1524:  rlReturn:

1524#    lw $ra, 4($sp)
1528#    addu $sp, 8   # pop $ra and pointless word off stack
1532#    move $t0, $s7 # return string we allocated in $s7
1536#    jr $ra
