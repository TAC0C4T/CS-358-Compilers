    # buffer and return
2852#    sw $t0,lastCharRead # store -2 into buffer (i.e. "empty")
2856#    jr $ra # return
    
2860:  doReadCh:
    # we need to actually read a character: read and return
2860#    li $v0,12 # use system call to read a character
2864#    syscall
2868#    jr $ra # return
