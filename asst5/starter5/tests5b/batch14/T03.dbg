3092#    la $s3,seg1_start
3093##...lui $s3,16
3097##...addiu $s3,$s3,4500
3100#    la $s4,seg1_end
3101##...lui $s4,32
3105##...addiu $s4,$s4,4500
3108#    sw $s5,cur_seg
