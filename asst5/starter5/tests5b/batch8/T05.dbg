##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
6016:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
6016#    lw $t0,-8($s2) # get word with hash bits from this
6020#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
6024#    addu $t0,$t1

6028#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
6032:mth_equals_Object:
6032#    move $t0,$s2 # first pointer (this)
6036#    lw $t1,($sp) # second pointer
6040#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
6041##...subu $at,$t0,$t1
6045##...sltiu $t0,$at,1

6048#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
6052:mth_hashCode_String:
6052#    move $t0,$s2 # put this pointer in t0

6056#    li $t2,0 # current hash value
6060#    lw $t1,-4($t0) # negative of number of characters in string
6064#    beq $t1,$zero,done_hashCode_String # if zero length => done
6068#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
6072#    and $t0,0xfffffffc # adjust for padding
6073##...lui $at,65535
6077##...ori $at,$at,0xfffc
6081##...and $t0,$t0,$at
6084#    subu $t1,$t0,$t1 # address at end of string +12
6088:loop_hashCode_String:    
6088#    sll $t4,$t2,5 # multiply by 32
6092#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
6096#    lbu $t3,-12($t0) # current character
6100#    addu $t2,$t3 # add in current character
6104#    addu $t0,1 # go to next character's address
6108#    bne $t0,$t1,loop_hashCode_String # loop back if more
6112:done_hashCode_String:    

    # push int on stack
6112#    move $t0, $t2 # put $t2 in return slot
6116#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
6120:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
6120#    subu $sp,4
6124#    sw $ra,($sp)
    
    # get hash value
6128#    lw $t2,-12($s2) # vtable address
6132#    lw $t0,($t2) # method address
6136#    jalr $t0
6140#    subu $sp,8 # push result (int in $t0) on stack
6144#    sw $s5,4($sp)
6148#    sw $t0,($sp)

    # compute print-size of hash value
6152#    li $t0, 1
6156#    lw $t1, ($sp)
6160#    srl $t1,$t1,4
6164#    beq $t1,$zero,toString_skip_loop
6168:toString_loop_top:
6168#    addu $t0,1
6172#    srl $t1,$t1,4
6176#    bne $t1,$zero,toString_loop_top
6180:toString_skip_loop:
6180#    subu $sp,8
6184#    sw $s5,4($sp)
6188#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
6192#    lw $t2,-12($s2) # vtable address
6196#    move $t0,$t2
6200:toString_checkTagBit:
6200#    subu $t0,1
6204#    lb $t1,($t0)
6208#    and $t1,0x80
6209##...lui $at,0
6213##...ori $at,$at,0x80
6217##...and $t1,$t1,$at
6220#    beq $t1,$zero,toString_checkTagBit
6224#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
6228#    subu $sp,8
6232#    sw $t1,($sp)
6236#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
6240#    move $s7,$zero # -4 offset header word
6244#    lw $t4,8($sp) # bytes for hash value
6248#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
6252#    addu $t4,8
6256#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
6260#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

6264#    li $t0,CLASS_String # store string vtable address into ...
6268#    sw $t0,-12($s7) # ... -12 offset in object header
6272#    lw $t2,-12($s2) # our object's vtable address
6276#    lw $t5,4($sp) # number characters in prefix
6280#    lw $t1,12($sp) # number of characters in hashcode
6284#    addu $t3,$t1,$t5 # number of characters in string ...
6288#    addu $t3,1 # ... including the '@' character
6292#    subu $t0,$zero,$t3 # store negated length into ...
6296#    sw $t0,-4($s7) # ... -4 offset header word
6300#    lw $t0,-8($s7) # get -8 offset header-word
6304#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
6305##...slt $at,$t0,$zero
6309##...beq $at,$zero,6328
6312#    and $t0,0xff # mask off object's hash value ...
6313##...lui $at,0
6317##...ori $at,$at,0xff
6321##...and $t0,$t0,$at
6324#    sw $t0,-8($s7) # ... and store back into -8 header-word
6328:skipMask_toString:
6328#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
6332#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
6336#    subu $t4,$t2,$t5
6340:toString_copyLoop:    
6340#    lb $t3,($t4)
6344#    and $t3,0x7f # mask off sign bit (in case first word)
6345##...lui $at,0
6349##...ori $at,$at,0x7f
6353##...and $t3,$t3,$at
6356#    sb $t3,-8($t0)
6360#    addu $t4,1
6364#    addu $t0,1
6368#    blt $t4,$t2,toString_copyLoop
6369##...slt $at,$t4,$t2
6373##...bne $at,$zero,6340

    # copy the '@' sign
6376#    li $t3,'@'
6380#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
6384#    addu $t2,$t0,$t1 # address of last byte in string to store +8
6388#    lw $t3,20($sp) # hash code to print
6392:toString_hashCopyLoop:
6392#    and $t4,$t3,0xf
6396#    srl $t3,4
6400#    lb $t4,hexChars($t4)
6404#    sb $t4,-8($t2)
6408#    subu $t2,$t2,1
6412#    bgt $t2,$t0,toString_hashCopyLoop
6413##...slt $at,$t0,$t2
6417##...bne $at,$zero,6392

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
6420#    addu $sp,28
6424#    lw $ra,($sp)
6428#    addu $sp,4
6432#    move $t0, $s7 # return string we created
6436#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
6440:mth_equals_String:
    
    # quick test for obvious false
6440#    lw $t0,($sp) # second parameter
6444#    beq $t0,$zero,goEsFalse # go return false if null
6448#    lw $t1,-12($t0) # vtable pointer
6452#    la $t2,CLASS_String # string vtable pointer
6456#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
6460#    subu $sp,12
6464#    sw $ra,8($sp)
6468#    sw $s2,4($sp)
6472#    sw $t0,($sp)
6476#    jal mth_compareTo_String
6480#    lw $s2, 4($sp) #restore this pointer and pop parameters
6484#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
