########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
8868:vm_init:

    # mark bottom of stack
8868#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
8872#    move $s2,$zero

    #set up the "five" register
8876#    li $s5,5

8880#    la $s3,seg0_start
8884#    la $s4,seg0_end
8885##...lui $s4,16
8889##...addiu $s4,$s4,9776
    
    # return
8892#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
8896:divide:
    # get parameters; abort if divisor zero
8896#    lw $t0,($sp)
8900#    lw $t1,8($sp)
8904#    beq $t0,$zero,divByZeroError
    
    # perform division
8908#    div $t1,$t0
8912#    mflo $t0

    # store result, adjust stack and return
8916#    addu $sp,$sp,8 # adjust stack
8920#    sw $t0,($sp) # store result
8924#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
8928:remainder:
    # get parameters; abort if divisor zero
8928#    lw $t0,($sp)
8932#    lw $t1,8($sp)
8936#    beq $t0,$zero,divByZeroError
    
    # perform division
8940#    div $t1,$t0
8944#    mfhi $t0

    # store result, adjust stack and return
8948#    addu $sp,$sp,8 # adjust stack
8952#    sw $t0,($sp) # store result
8956#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
8960:checkCast:
    # get object, allow immediately if null
8960#    lw $t2,($sp)
8964#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
8968#    lw $t2,-12($t2) # vtable address
8972#    bge $t2,$t1,castException
8973##...slt $at,$t2,$t1
8977##...beq $at,$zero,9112
8980#    blt $t2,$t0,castException
8981##...slt $at,$t2,$t0
8985##...bne $at,$zero,9112
    
    # return, leaving object unchanged on stack
8988:  checkCastReturn:    
8988#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
8992:instanceOf:
    # get object, go return false if null
8992#    lw $t2,($sp)
8996#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
9000#    lw $t2,-12($t2) # vtable address
9004#    sge $t0,$t2,$t0 # are we >= the lower limit?
9005##...slt $t0,$t2,$t0
9009##...xori $t0,$t0,0x1
9012#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
9016#    and $t2,$t0,$t1
9020#    sw $t2,($sp)
9024:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
9024#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

9028:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
9028#    li $v0,4 # syscall-code for print-string
9032#    syscall
9036:exit:
    # print termination message
9036#    li $v0,4 # syscall-code for print-string
9040#    la $a0,exitString
9044#    syscall

    # terminate execution
9048#    li $v0,10 #syscall-code for "exit"
9052#    syscall

9056:outOfHeapMemory:
9056#    la $a0,heapMemoryMsg
9060#    j exitError
9064:divByZeroError:
9064#    la $a0,divByZeroMsg
9068#    j exitError
9072:strIndexOutOfBounds:
9072#    la $a0,strIndexOutOfBoundsMsg
9076#    j exitError
9080:arrayIndexOutOfBounds:
9080#    la $a0,arrayIndexOutOfBoundsMsg
9084#    j exitError
9088:arraySizeOutOfBounds:
9088#    la $a0,arraySizeOutOfBoundsMsg
9092#    j exitError
9096:nullPtrException:
9096#    la $a0,nullPtrExceptionMsg
9100#    j exitError
9104:badIntegerFormat:
9104#    la $a0,badIntegerFormatMsg
9108#    j exitError
9112:castException:
9112#    la $a0,castExceptionMsg
9116#    j exitError
############## data section ################
    .data
9412:hexChars:
    .ascii "0123456789abcdef"
    .align 2
9428:cur_seg:
    .word 0

9432:lastCharRead:
    .word -2 # -2 => no buffered character
9436:prevHashConstant:
    .word 0x2785173c
9440:gcCount:
    .word 0

9444:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
9471:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
9494:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
9529:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
9563:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
9596:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
9627:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
9675:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
9696:gcMsg: 
      .asciiz "\nGC!\n"
9702:gcCountMsg: 
      .asciiz "Number of garbage collections: "

9734:nullStr:
    .asciiz "null"
9739:trueString:
    .asciiz "true"
9744:falseString:
    .asciiz "false"
9750:exitString:
    .ascii "Program terminated."
    #### "falls through" here
9769:newlineString:
    .asciiz "\n"
    
    .align 2
9772:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

9776:seg0_start:
    .space 0x100000
1058352:seg0_end:
1058352:seg1_start:
