###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
6524:mth_readLine_Lib:
    
6524#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
6528#    sw $ra, 4($sp) # save $ra
6532#    move $t1,$sp # save "original" sp

6536:  doRead:

    # read the character
6536#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
6540#    subu $t2,$v0,13
6544#    bne $t2,$zero,notReturnRL
6548#    jal readLogicalChar
6552#    subu $t2,$v0,10 # check for newline
6556#    beq $t2,$zero,foundNewLine
6560#    sw $v0,lastCharRead # push back character into queue
6564#    j foundNewLine # go process the line

6568:  notReturnRL:

    # at this point, $v0 has our character

6568#    subu $t0,$v0,10
6572#    beq $t0,$zero,foundNewLine
6576#    blt $v0,$zero,foundEof
6577##...slt $at,$v0,$zero
6581##...bne $at,$zero,6596

    # we have a character, so push it onto stack
6584#    subu $sp,$sp,4
6588#    sw $v0,($sp)

    # loop back up to get next character
6592#    j doRead

6596:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
6596#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
6600#    li $s7, 0 # return-value: null
6604#    j rlReturn # return

6608:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
6608#    subu $t0,$t1,$sp # number of chars we read (times 4)
6612#    srl $s6,$t0,2 # number of words on stack with chars
6616#    subu $sp,$sp,4 # push char-count ...
6620#    sw $s6,($sp) # ... onto stack
6624#    addu $t2,$t0,5 # GC tag, incl. for count-word
6628#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
6632#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
6636#    srl $s6,$s6,2  # data words in object
6640#    move $s7,$zero # object words in object
6644#    jal newObject  # allocate space
    
    # store header words
6648#    la $t0,CLASS_String
6652#    sw $t0,-12($s7)# store class tag (String) into object
6656#    lw $t2,4($sp) # char-count
6660#    sll $t1,$t2,2 # 4 times number of chars
6664#    subu $t2,$zero,$t2 # negative of char-count
6668#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
6672#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
6676#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
6677##...slt $at,$t0,$zero
6681##...beq $at,$zero,6700
6684#    and $t0,0xff # mask off object's hash value ...
6685##...lui $at,0
6689##...ori $at,$at,0xff
6693##...and $t0,$t0,$at
6696#    sw $t0,-8($s7) # ... and store back into -8 header-word
6700:  skipMask_readLine:

6700#    sll $t0,$t0,2 # data bytes in object
6704#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
6708#    subu $t0,$t0,$t2 # place to store last character (plus 9)
6712#    addu $sp,$sp,8 # pop redundant object-pointer and count
6716#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

6720#    beq $sp,$t1,rlReturn
6724:  charCopyLoop:
6724#    lw $t2,($sp)
6728#    sb $t2,-9($t0)
6732#    addu $sp,$sp,4
6736#    subu $t0,$t0,1
6740#    bne $sp,$t1,charCopyLoop
6744:  rlReturn:

6744#    lw $ra, 4($sp)
6748#    addu $sp, 8   # pop $ra and pointless word off stack
6752#    move $t0, $s7 # return string we allocated in $s7
6756#    jr $ra

