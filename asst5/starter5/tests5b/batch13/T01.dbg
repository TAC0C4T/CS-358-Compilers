1560#    lw $t2,($sp)
1564#    sb $t2,-9($t0)
1568#    addu $sp,$sp,4
1572#    subu $t0,$t0,1
1576#    bne $sp,$t1,charCopyLoop
1580:  rlReturn:

1580#    lw $ra, 4($sp)
1584#    addu $sp, 8   # pop $ra and pointless word off stack
1588#    move $t0, $s7 # return string we allocated in $s7
1592#    jr $ra
