1709##...sltu $at,$t1,$t2
1713##...beq $at,$zero,1732

1716#    mul $t3,$t3,$t2 # multiply old value by 10
1717##...mult $t3,$t2
1721##...mflo $t3
1724#    addu $t3,$t3,$t1 # add in value of new digit
1728#    j digitLoop
