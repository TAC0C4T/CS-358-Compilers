1613##...slt $at,$zero,$t0
1617##...bne $at,$zero,1660
1620#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1624#    subu $t0,$v0,10
1628#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1632#    subu $t0,$v0,9
1636#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1640#    subu $t0,$v0,13
1644#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1648#    subu $t0,$v0,12
