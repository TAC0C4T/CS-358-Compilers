1656#    j badIntegerFormat # illegal integer char: abort program

1660:  nonWhite:
1660#    subu $t0,$v0,'-'
1664#    li $t4,1 # final multiplier
1668#    bne $t0,$zero,helpReadInt # go read
1672#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1676#    jal readLogicalChar

1680:  helpReadInt:
1680#    li $t2,10
