0:main:
0#  jal vm_init
4#  li $v0, 10
8#  syscall
12:mth_main_Main:
12#  jr $ra
16:mth_main_Vehicle:
16#  li $t0, 0
20#  subu $sp, $sp, 8
24#  sw $s5, 4($sp)
28#  sw $t0, 0($sp)
32#  li $t0, 0
36#  subu $sp, $sp, 8
40#  sw $s5, 4($sp)
44#  sw $t0, 0($sp)
48#  li $t0, 2000
52#  subu $sp, $sp, 8
56#  sw $s5, 4($sp)
60#  sw $t0, 0($sp)
64#  lw $t2, ($sp)
68#  addu $sp, $sp, 4
72#  lw $t1, ($sp)
76#  addu $sp, $sp, 4
80#  slt $t0, $t1, $t2
84#  subu $sp, $sp, 4
88#  sw $t0, ($sp)
92#  subu $sp, $sp, 4
96#  sw $s2, ($sp)
100#  lw $t0, -16($t0)
104#  subu $sp, $sp, 4
108#  sw $t0, ($sp)
112#  li $t0, 13
116#  subu $sp, $sp, 8
120#  sw $s5, 4($sp)
124#  sw $t0, 0($sp)
128#  lw $t2, ($sp)
132#  addu $sp, $sp, 4
136#  lw $t1, ($sp)
140#  addu $sp, $sp, 4
144#  addu $t0, $t1, $t2
148#  subu $sp, $sp, 4
152#  sw $t0, ($sp)
156#  subu $sp, $sp, 4
160#  sw $s2, ($sp)
164#  lw $t0, -16($t0)
168#  subu $sp, $sp, 4
172#  sw $t0, ($sp)
176#  li $t0, 4
180#  subu $sp, $sp, 8
184#  sw $s5, 4($sp)
188#  sw $t0, 0($sp)
192#  lw $t2, ($sp)
196#  addu $sp, $sp, 4
200#  lw $t1, ($sp)
204#  addu $sp, $sp, 4
208#  subu $t0, $t1, $t2
212#  subu $sp, $sp, 4
216#  sw $t0, ($sp)
220#  li $t0, 1
224#  subu $sp, $sp, 8
228#  sw $s5, 4($sp)
232#  sw $t0, 0($sp)
236#  lw $t2, ($sp)
240#  addu $sp, $sp, 4
244#  lw $t1, ($sp)
248#  addu $sp, $sp, 4
252#  addu $t0, $t1, $t2
