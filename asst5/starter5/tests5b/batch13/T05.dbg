##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
296:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
296#    lw $t0,-8($s2) # get word with hash bits from this
300#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
304#    addu $t0,$t1

308#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
312:mth_equals_Object:
312#    move $t0,$s2 # first pointer (this)
316#    lw $t1,($sp) # second pointer
320#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
321##...subu $at,$t0,$t1
325##...sltiu $t0,$at,1

328#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
332:mth_hashCode_String:
332#    move $t0,$s2 # put this pointer in t0

336#    li $t2,0 # current hash value
340#    lw $t1,-4($t0) # negative of number of characters in string
344#    beq $t1,$zero,done_hashCode_String # if zero length => done
348#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
352#    and $t0,0xfffffffc # adjust for padding
353##...lui $at,65535
357##...ori $at,$at,0xfffc
361##...and $t0,$t0,$at
364#    subu $t1,$t0,$t1 # address at end of string +12
368:loop_hashCode_String:    
368#    sll $t4,$t2,5 # multiply by 32
372#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
376#    lbu $t3,-12($t0) # current character
380#    addu $t2,$t3 # add in current character
384#    addu $t0,1 # go to next character's address
388#    bne $t0,$t1,loop_hashCode_String # loop back if more
392:done_hashCode_String:    

    # push int on stack
392#    move $t0, $t2 # put $t2 in return slot
396#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
400:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
400#    subu $sp,4
404#    sw $ra,($sp)
    
    # get hash value
408#    lw $t2,-12($s2) # vtable address
412#    lw $t0,($t2) # method address
416#    jalr $t0
420#    subu $sp,8 # push result (int in $t0) on stack
424#    sw $s5,4($sp)
428#    sw $t0,($sp)

    # compute print-size of hash value
432#    li $t0, 1
436#    lw $t1, ($sp)
440#    srl $t1,$t1,4
444#    beq $t1,$zero,toString_skip_loop
448:toString_loop_top:
448#    addu $t0,1
452#    srl $t1,$t1,4
456#    bne $t1,$zero,toString_loop_top
460:toString_skip_loop:
460#    subu $sp,8
464#    sw $s5,4($sp)
468#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
472#    lw $t2,-12($s2) # vtable address
476#    move $t0,$t2
480:toString_checkTagBit:
480#    subu $t0,1
484#    lb $t1,($t0)
488#    and $t1,0x80
489##...lui $at,0
493##...ori $at,$at,0x80
497##...and $t1,$t1,$at
500#    beq $t1,$zero,toString_checkTagBit
504#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
508#    subu $sp,8
512#    sw $t1,($sp)
516#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
520#    move $s7,$zero # -4 offset header word
524#    lw $t4,8($sp) # bytes for hash value
528#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
532#    addu $t4,8
536#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
540#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

544#    li $t0,CLASS_String # store string vtable address into ...
548#    sw $t0,-12($s7) # ... -12 offset in object header
552#    lw $t2,-12($s2) # our object's vtable address
556#    lw $t5,4($sp) # number characters in prefix
560#    lw $t1,12($sp) # number of characters in hashcode
564#    addu $t3,$t1,$t5 # number of characters in string ...
568#    addu $t3,1 # ... including the '@' character
572#    subu $t0,$zero,$t3 # store negated length into ...
576#    sw $t0,-4($s7) # ... -4 offset header word
580#    lw $t0,-8($s7) # get -8 offset header-word
584#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
585##...slt $at,$t0,$zero
589##...beq $at,$zero,608
592#    and $t0,0xff # mask off object's hash value ...
593##...lui $at,0
597##...ori $at,$at,0xff
601##...and $t0,$t0,$at
604#    sw $t0,-8($s7) # ... and store back into -8 header-word
608:skipMask_toString:
608#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
612#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
616#    subu $t4,$t2,$t5
620:toString_copyLoop:    
620#    lb $t3,($t4)
624#    and $t3,0x7f # mask off sign bit (in case first word)
625##...lui $at,0
629##...ori $at,$at,0x7f
633##...and $t3,$t3,$at
636#    sb $t3,-8($t0)
640#    addu $t4,1
644#    addu $t0,1
648#    blt $t4,$t2,toString_copyLoop
649##...slt $at,$t4,$t2
653##...bne $at,$zero,620

    # copy the '@' sign
656#    li $t3,'@'
660#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
664#    addu $t2,$t0,$t1 # address of last byte in string to store +8
668#    lw $t3,20($sp) # hash code to print
672:toString_hashCopyLoop:
672#    and $t4,$t3,0xf
676#    srl $t3,4
680#    lb $t4,hexChars($t4)
684#    sb $t4,-8($t2)
688#    subu $t2,$t2,1
692#    bgt $t2,$t0,toString_hashCopyLoop
693##...slt $at,$t0,$t2
697##...bne $at,$zero,672

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
700#    addu $sp,28
704#    lw $ra,($sp)
708#    addu $sp,4
712#    move $t0, $s7 # return string we created
716#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
720:mth_equals_String:
    
    # quick test for obvious false
720#    lw $t0,($sp) # second parameter
724#    beq $t0,$zero,goEsFalse # go return false if null
728#    lw $t1,-12($t0) # vtable pointer
732#    la $t2,CLASS_String # string vtable pointer
736#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
740#    subu $sp,12
744#    sw $ra,8($sp)
748#    sw $s2,4($sp)
752#    sw $t0,($sp)
756#    jal mth_compareTo_String
760#    lw $s2, 4($sp) #restore this pointer and pop parameters
764#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
768#    seq $t0,$t0,$zero
769##...subu $at,$t0,$zero
773##...sltiu $t0,$at,1

    # pop return address and return $t0
776#    lw $ra,($sp)
780#    addu $sp,4

784#    jr $ra # return
    
788:goEsFalse:
    # put 0 in $t0 and return
788#    li $t0, 0
792#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
796:mth_toString_String:
    #we are a string, so return this.
