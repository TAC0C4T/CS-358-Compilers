###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
804:mth_readLine_Lib:
    
804#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
808#    sw $ra, 4($sp) # save $ra
812#    move $t1,$sp # save "original" sp

816:  doRead:

    # read the character
816#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
820#    subu $t2,$v0,13
824#    bne $t2,$zero,notReturnRL
828#    jal readLogicalChar
832#    subu $t2,$v0,10 # check for newline
836#    beq $t2,$zero,foundNewLine
840#    sw $v0,lastCharRead # push back character into queue
844#    j foundNewLine # go process the line

848:  notReturnRL:

    # at this point, $v0 has our character

848#    subu $t0,$v0,10
852#    beq $t0,$zero,foundNewLine
856#    blt $v0,$zero,foundEof
857##...slt $at,$v0,$zero
861##...bne $at,$zero,876

    # we have a character, so push it onto stack
864#    subu $sp,$sp,4
868#    sw $v0,($sp)

    # loop back up to get next character
872#    j doRead

876:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
876#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
880#    li $s7, 0 # return-value: null
884#    j rlReturn # return

888:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
888#    subu $t0,$t1,$sp # number of chars we read (times 4)
892#    srl $s6,$t0,2 # number of words on stack with chars
896#    subu $sp,$sp,4 # push char-count ...
900#    sw $s6,($sp) # ... onto stack
904#    addu $t2,$t0,5 # GC tag, incl. for count-word
908#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
912#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
916#    srl $s6,$s6,2  # data words in object
920#    move $s7,$zero # object words in object
924#    jal newObject  # allocate space
    
    # store header words
928#    la $t0,CLASS_String
932#    sw $t0,-12($s7)# store class tag (String) into object
936#    lw $t2,4($sp) # char-count
940#    sll $t1,$t2,2 # 4 times number of chars
944#    subu $t2,$zero,$t2 # negative of char-count
948#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
952#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
956#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
957##...slt $at,$t0,$zero
961##...beq $at,$zero,980
964#    and $t0,0xff # mask off object's hash value ...
965##...lui $at,0
969##...ori $at,$at,0xff
973##...and $t0,$t0,$at
976#    sw $t0,-8($s7) # ... and store back into -8 header-word
980:  skipMask_readLine:

980#    sll $t0,$t0,2 # data bytes in object
984#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
988#    subu $t0,$t0,$t2 # place to store last character (plus 9)
992#    addu $sp,$sp,8 # pop redundant object-pointer and count
996#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

1000#    beq $sp,$t1,rlReturn
1004:  charCopyLoop:
1004#    lw $t2,($sp)
1008#    sb $t2,-9($t0)
1012#    addu $sp,$sp,4
1016#    subu $t0,$t0,1
1020#    bne $sp,$t1,charCopyLoop
1024:  rlReturn:

1024#    lw $ra, 4($sp)
1028#    addu $sp, 8   # pop $ra and pointless word off stack
1032#    move $t0, $s7 # return string we allocated in $s7
1036#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1040:mth_readInt_Lib:

    # save $ra by pushing onto stack
1040#    subu $sp,$sp,4
1044#    sw $ra,($sp)

1048:  riSkipWhiteLoop:
    # read a character
1048#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
1052#    subu $t0,$v0,32
1056#    bgt $t0,$zero,nonWhite
1057##...slt $at,$zero,$t0
1061##...bne $at,$zero,1104
1064#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1068#    subu $t0,$v0,10
1072#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1076#    subu $t0,$v0,9
1080#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1084#    subu $t0,$v0,13
1088#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1092#    subu $t0,$v0,12
1096#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1100#    j badIntegerFormat # illegal integer char: abort program

1104:  nonWhite:
1104#    subu $t0,$v0,'-'
1108#    li $t4,1 # final multiplier
1112#    bne $t0,$zero,helpReadInt # go read
1116#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1120#    jal readLogicalChar

1124:  helpReadInt:
1124#    li $t2,10
1128#    subu $t1,$v0,'0' # convert digit to 0-9 value
1132#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
1133##...sltu $at,$t1,$t2
1137##...beq $at,$zero,3384
1140#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

1144:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

1144#    jal readLogicalChar # read next character
1148#    subu $t1,$v0,'0' # convert digit to 0-9 value
1152#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
1153##...sltu $at,$t1,$t2
1157##...beq $at,$zero,1176

1160#    mul $t3,$t3,$t2 # multiply old value by 10
1161##...mult $t3,$t2
1165##...mflo $t3
1168#    addu $t3,$t3,$t1 # add in value of new digit
1172#    j digitLoop

1176:  doneDigitLoop:

    # "push back" unused character into queue
1176#    sw $v0,lastCharRead

    # restore return address
1180#    lw $ra,($sp)
1184#    addu $sp, 4

    # multiply by sign and put return value in $t0
1188#    mult $t3,$t4 # multiply to account for poss. minus sign
1192#    mflo $t3
1196#    move $t0, $t3
    
    # return
1200#    jr $ra

###################################################################
# readChar() - library method (class Lib)
# - reads a single character from standard input
# - returns the integer that is the encoding of the character
# - returns -1 if end of file was encountered
# - parameter:
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1204:mth_readChar_Lib:

    # save $ra by pushing onto stack
1204#    subu $sp,$sp,4
1208#    sw $ra,($sp)

      # read the character
1212#    jal readLogicalChar

    # restore return address; put value in $t0
    # replacing this-pointer saved return address
1216#    lw $ra,($sp)
1220#    addu $sp, 4
1224#    move $t0, $v0

    # return
1228#    jr $ra

########################################################
# printStr(str) - library method (class Lib)
# - prints string to standard output
# parameters:
#   - ($sp) - the string to print
#   - 4($sp) - old-this-pointer
########################################################
1232:mth_printStr_Lib:
    # check for null, printing "(null)", if so
1232#    lw $t0,($sp)
1236#    bne $t0,$zero,psNotNull

    # print "(null)"
1240#    la $a0,nullStr
1244#    li $v0,4
1248#    syscall
1252#    j donePrintStr
    
1256:  psNotNull:
    ##### we have a non-null string #####
    # this means that:
    # - number of data words in -8($t0):
    #   - if the sign bit is 1, the low 31 bits
    #   - if the sign bit is 0, the low 8 bits
    # - negative of number of characters in string is in -4($t0)
    # - string begins at $t0-8-(#dataWords*4), stored 1 char per byte
1256#    subu $t0,$t0,8
1260#    lw $t1,($t0) # number of data words, but needs modification
1264#    blt $t1,$zero,skipPrintStr1
1265##...slt $at,$t1,$zero
1269##...bne $at,$zero,1288
1272#    and $t1,0xff # mask out all but low byte
1273##...lui $at,0
1277##...ori $at,$at,0xff
1281##...and $t1,$t1,$at
1284#    b skipPrintStr2
1288:skipPrintStr1:
1288#    and $t1,0x7ffffff
1289##...lui $at,2047
1293##...ori $at,$at,0xffff
1297##...and $t1,$t1,$at
1300:skipPrintStr2:    
1300#    sll $t1,$t1,2
1304#    subu $t1,$t0,$t1 # first word in string
1308#    lw $t0,4($t0) # negative of string-length
1312#    subu $t0,$t1,$t0 # byte just beyond last char in string

    # print the chars in the string
1316#    beq $t0,$t1,donePrintStr
1320:  psLoop:
1320#    lb $a0,($t1) # next byte
1324#    li $v0,11 # code for printing char
1328#        syscall # print the char
1332#    addu $t1,$t1,1 # go to next char
1336#    blt $t1,$t0,psLoop
1337##...slt $at,$t1,$t0
1341##...bne $at,$zero,1320

1344:  donePrintStr:
1344#    jr $ra

########################################################
