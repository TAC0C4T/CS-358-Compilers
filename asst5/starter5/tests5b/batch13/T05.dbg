2556#    move $t7,$s4
2560#    la $t6,seg1_start
2561##...lui $t6,16
2565##...addiu $t6,$t6,3972
2568#    la $s3,seg0_start
2572#    la $s4,seg0_end
2573##...lui $s4,16
2577##...addiu $s4,$s4,3972
2580#    sw $zero,cur_seg
2584#    bne $t0,$zero,skipGc1
2588#    la $t6,seg0_start
2592#    la $s3,seg1_start
2593##...lui $s3,16
2597##...addiu $s3,$s3,3972
