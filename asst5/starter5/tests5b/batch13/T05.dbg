2888#    sw $t1,-8($t2) # store header word
2892#    sw $t3,($t0) # restore first word of object

    ################################################
    # at this point:
    # - $t2 contains the pointer to our new object
    ################################################

    # check if we have a data array
2896#    lw $t1,-12($t2) # vtable pointer
2900#    li $t0,dataArrayVTableStart # address of vtable for first data array
