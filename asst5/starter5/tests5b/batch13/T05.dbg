2933##...slt $at,$t3,$zero
2937##...beq $at,$zero,2944
2940#    move $t3,$zero
2944:  gcH2Neg2:
2944#    sll $t3,$t3,2 # # object bytes
2948#    move $t0,$t2 # address of first pointer in object
