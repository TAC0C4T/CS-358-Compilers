########################################################
# str1.concat(str2) - library method (class String)
# (as in Java)
# - parameters:
#   - ($sp) - the second string
#   - 4($sp) - old this pointer
#   - $s2 - the first string (this)
# - returns:
#   - $t0 - pointer to concatenated string
########################################################
1612:mth_concat_String:
    # save $ra by pushing onto stack
1612#    subu $sp,$sp,4
1616#    sw $ra, ($sp)

    # get string pointers and check parameter for null
1620#    lw $t0,4($sp)
1624#    beq $t0,$zero,nullPtrException
1628#    move $t1,$s2
    
    # get lengths of two strings; allocate object whose size
    # is their sum divided by 4 (rounded up) plus 1
1632#    lw $t0,-4($t0) # negative size of second object
1636#    lw $t1,-4($t1) # negative size of first object
1640#    addu $s6,$t0,$t1 # sum of negative sizes
1644#    sra $s6,$s6,2 # negative word-size of char part
1648#    subu $s6,$zero,$s6 # word size of char part
1652#    addu $s6,$s6,1 # data word size, including v-table word
1656#    move $s7,$zero
1660#    jal newObject

    # store String vtable address in vtable address field
1664#    la $t0,CLASS_String
1668#    sw $t0,-12($s7)
        
    # mask off hash bits, if needed
1672#    lw $t4,-8($s7) # # data words in source string
1676#    bge $t4,$zero,skipMask_concat # don't strip hash code if not there
1677##...slt $at,$t4,$zero
1681##...beq $at,$zero,1700
1684#    and $t4,0xff # mask off object's hash value ...
1685##...lui $at,0
1689##...ori $at,$at,0xff
1693##...and $t4,$t4,$at
1696#    sw $t4,-8($s7) # ... and store back into -8 header-word
1700:skipMask_concat:

1700#    move $t9, $s7 # store return string in unused (I hope) t9 register

    #restore $t0, and $t1 after they were potentially blown
    #away by newObject
1704#    move $t1,$s2   # first object
1708#    lw $t0,8($sp) # second object
    
    # get negative sizes; sum and store in new object size-field
1712#    lw $t2,-4($t0) # negative length of second object
1716#    lw $t3,-4($t1) # negative length of first object
1720#    addu $t4,$t2,$t3 # sum of negative lengths
