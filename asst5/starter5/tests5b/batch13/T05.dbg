########################################################
# str.substring(n, k) - library method (class String)
# takes a substring of a string: Java: str.substring(n, k)
# - parameters after pushing RA:
#   - ($sp) - k: one beyond index of last char in subrange
#   - 4($sp) - GC tag
#   - 8($sp) - n: index of first char in subrange
#   - 12($sp) - GC tag
#   - 16($sp) - old this pointer
# - return value:
#  - $t0 - substring
########################################################
1392:mth_substring_String:

    # save $ra by pushing onto stack
1392#    subu $sp,$sp,4
1396#    sw $ra,($sp)

    # get string from this, we probably don't need the null check.
1400#    move $t0,$s2
1404#    beq $t0,$zero,nullPtrException

    # get both indices and string length, and ensure that
    #   0 <= n <= k <= length
1408#    lw $t0,-4($t0) # negative of string length
1412#    subu $t0,$zero,$t0 # string length
1416#    lw $t1,4($sp) # k
1420#    lw $t2,12($sp) # n
1424#    bgt $zero,$t2,strIndexOutOfBounds
1425##...slt $at,$t2,$zero
1429##...bne $at,$zero,3352
1432#    bgt $t2,$t1,strIndexOutOfBounds
1433##...slt $at,$t1,$t2
1437##...bne $at,$zero,3352
1440#    bgt $t1,$t0,strIndexOutOfBounds
1441##...slt $at,$t0,$t1
1445##...bne $at,$zero,3352

    # allocate memory
1448#    subu $s6,$t1,$t2 # # chars in target-string
1452#    addu $s6,$s6,7 # account for extra "class" (4) word + 3 to round up
1456#    srl $s6,$s6,2 # convert bytes-count to word-count
1460#    move $s7,$zero # (no object-bytes in string)
1464#    jal newObject

    # store "String" tag in object-type field
1468#    la $t0,CLASS_String
1472#    sw $t0,-12($s7)
    
    # mask off hash bits, if needed
1476#    lw $t4,-8($s7) # data words in source string
1480#    bge $t4,$zero,skipMask_substring # don't strip hash code if not there
1481##...slt $at,$t4,$zero
1485##...beq $at,$zero,1504
1488#    and $t4,0xff # mask off object's hash value ...
1489##...lui $at,0
1493##...ori $at,$at,0xff
1497##...and $t4,$t4,$at
1500#    sw $t4,-8($s7) # ... and store back into -8 header-word
1504:skipMask_substring:

    # store negative of count (=n-k) into object-length header-word
    # indicies have changed, because newObject is on stack
1504#    lw $t1,8($sp) # k
1508#    lw $t2,16($sp) # n
1512#    subu $t0,$t2,$t1 # value to store
1516#    sw $t0,-4($s7) # store value
    
1520#    move $t3,$s2 # source string pointer
    
    # skip byte-copy loop if length is zero
1524#    beq $zero,$t0,doneSubCopyzz

    # get pointers set up in preparation for copy
1528#    lw $t4,-8($t3) # data words in source string
1532#    sll $t4,$t4,2 # data bytes in source string (incl. padding)
1536#    subu $t3,$t3,$t4 # addr. of first data word of source string (+8)
1540#    addu $t3,$t3,$t2 # addr. of first source data byte to be copied (+8)
1544#    subu $t1,$t3,$t0 # addr. beyond last source data byte to be copied (+8)
1548#    lw $t2,-8($s7)   # data words in target string
1552#    sll $t2,$t2,2    # data bytes in target string
1556#    subu $t2,$s7,$t2 # addr. of first target data byte (+8)
    
    ############################################
    # at this point:
    # - we know that the string has a positive length
    # - $t3 contains 8 + address of the first source-byte
    # - $t1 contains 8 + limit-address of the first source-byte
    # - $t2 contains 8 + address first target byte
    ############################################

    # copy the bytes from source to target
1560:  subCopyLoopzz:
1560#    lb $t4,-8($t3)
1564#    sb $t4,-8($t2)
1568#    addu $t2,$t2,1
1572#    addu $t3,$t3,1
1576#    blt $t3,$t1,subCopyLoopzz
1577##...slt $at,$t3,$t1
1581##...bne $at,$zero,1560
    
1584:  doneSubCopyzz:
    # restore return address, store return value, pop stack
1584#    lw $ra,4($sp) # restore $ra
1588#    addu $sp,$sp,8 # pop ra, and allocated newObject
1592#    move $t0, $s7 # we're returning the string we got back
                  # from newObject
    
    # return
1596#    jr $ra

########################################################
# length() - library method (class String)
# returns length of a string: Java: str.length()
# - parameters:
#   - ($sp) - old this pointer
# - return-value:
#   - $t0 - length of string
########################################################
1600:mth_length_String:

    # the length is the negative of 4($s2)
1600#    lw $t0,-4($s2) # -length
1604#    subu $t0,$zero,$t0
