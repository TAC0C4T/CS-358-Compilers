    # processing, we're done, so go finish up
2836#    bgeu $t0,$s3,gcFinishUp
2837##...sltu $at,$t0,$s3
2841##...beq $at,$zero,3132

    ###### begin outer loop to copy all non-stack-direct objects ######

2844:  gcHeapCopyLoop:
    # get data count for object; swap header-word with first word
    # of object so that they're back in the right place
2844#    lw $t1,($t0) # (what will be) first header word for current object
2848#    move $t2,$t1 # number data bytes in object (poss. w/hash bits)
