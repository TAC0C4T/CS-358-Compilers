    # via the forwarding pointer
2980#    lw $t8,-8($t1) # possible forwarding tag
2984#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
2988#    lw $t8,-4($t1) # forwarding pointer: object's new address
2992#    sw $t8,($t0) # update pointer in object
