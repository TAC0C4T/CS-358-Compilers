##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
368:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
368#    lw $t0,-8($s2) # get word with hash bits from this
372#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
376#    addu $t0,$t1

380#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
384:mth_equals_Object:
384#    move $t0,$s2 # first pointer (this)
388#    lw $t1,($sp) # second pointer
392#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
393##...subu $at,$t0,$t1
397##...sltiu $t0,$at,1

400#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
404:mth_hashCode_String:
404#    move $t0,$s2 # put this pointer in t0

408#    li $t2,0 # current hash value
412#    lw $t1,-4($t0) # negative of number of characters in string
416#    beq $t1,$zero,done_hashCode_String # if zero length => done
420#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
424#    and $t0,0xfffffffc # adjust for padding
425##...lui $at,65535
429##...ori $at,$at,0xfffc
433##...and $t0,$t0,$at
436#    subu $t1,$t0,$t1 # address at end of string +12
440:loop_hashCode_String:    
440#    sll $t4,$t2,5 # multiply by 32
444#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
448#    lbu $t3,-12($t0) # current character
452#    addu $t2,$t3 # add in current character
456#    addu $t0,1 # go to next character's address
460#    bne $t0,$t1,loop_hashCode_String # loop back if more
464:done_hashCode_String:    

    # push int on stack
464#    move $t0, $t2 # put $t2 in return slot
468#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
472:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
472#    subu $sp,4
476#    sw $ra,($sp)
    
    # get hash value
480#    lw $t2,-12($s2) # vtable address
484#    lw $t0,($t2) # method address
488#    jalr $t0
492#    subu $sp,8 # push result (int in $t0) on stack
496#    sw $s5,4($sp)
500#    sw $t0,($sp)

    # compute print-size of hash value
504#    li $t0, 1
508#    lw $t1, ($sp)
512#    srl $t1,$t1,4
516#    beq $t1,$zero,toString_skip_loop
520:toString_loop_top:
520#    addu $t0,1
524#    srl $t1,$t1,4
528#    bne $t1,$zero,toString_loop_top
532:toString_skip_loop:
532#    subu $sp,8
536#    sw $s5,4($sp)
540#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
544#    lw $t2,-12($s2) # vtable address
548#    move $t0,$t2
552:toString_checkTagBit:
552#    subu $t0,1
556#    lb $t1,($t0)
560#    and $t1,0x80
561##...lui $at,0
565##...ori $at,$at,0x80
569##...and $t1,$t1,$at
572#    beq $t1,$zero,toString_checkTagBit
576#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
580#    subu $sp,8
584#    sw $t1,($sp)
588#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
592#    move $s7,$zero # -4 offset header word
596#    lw $t4,8($sp) # bytes for hash value
600#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
604#    addu $t4,8
608#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
612#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

616#    li $t0,CLASS_String # store string vtable address into ...
620#    sw $t0,-12($s7) # ... -12 offset in object header
624#    lw $t2,-12($s2) # our object's vtable address
628#    lw $t5,4($sp) # number characters in prefix
632#    lw $t1,12($sp) # number of characters in hashcode
636#    addu $t3,$t1,$t5 # number of characters in string ...
640#    addu $t3,1 # ... including the '@' character
644#    subu $t0,$zero,$t3 # store negated length into ...
648#    sw $t0,-4($s7) # ... -4 offset header word
652#    lw $t0,-8($s7) # get -8 offset header-word
656#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
657##...slt $at,$t0,$zero
661##...beq $at,$zero,680
664#    and $t0,0xff # mask off object's hash value ...
665##...lui $at,0
669##...ori $at,$at,0xff
673##...and $t0,$t0,$at
676#    sw $t0,-8($s7) # ... and store back into -8 header-word
680:skipMask_toString:
680#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
684#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
688#    subu $t4,$t2,$t5
692:toString_copyLoop:    
692#    lb $t3,($t4)
696#    and $t3,0x7f # mask off sign bit (in case first word)
697##...lui $at,0
701##...ori $at,$at,0x7f
705##...and $t3,$t3,$at
708#    sb $t3,-8($t0)
712#    addu $t4,1
716#    addu $t0,1
720#    blt $t4,$t2,toString_copyLoop
721##...slt $at,$t4,$t2
725##...bne $at,$zero,692

    # copy the '@' sign
728#    li $t3,'@'
732#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
736#    addu $t2,$t0,$t1 # address of last byte in string to store +8
740#    lw $t3,20($sp) # hash code to print
744:toString_hashCopyLoop:
744#    and $t4,$t3,0xf
748#    srl $t3,4
752#    lb $t4,hexChars($t4)
756#    sb $t4,-8($t2)
760#    subu $t2,$t2,1
764#    bgt $t2,$t0,toString_hashCopyLoop
765##...slt $at,$t0,$t2
769##...bne $at,$zero,744

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
772#    addu $sp,28
776#    lw $ra,($sp)
780#    addu $sp,4
784#    move $t0, $s7 # return string we created
788#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
792:mth_equals_String:
    
    # quick test for obvious false
792#    lw $t0,($sp) # second parameter
796#    beq $t0,$zero,goEsFalse # go return false if null
800#    lw $t1,-12($t0) # vtable pointer
