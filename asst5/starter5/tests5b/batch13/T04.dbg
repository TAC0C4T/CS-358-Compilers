###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
876:mth_readLine_Lib:
    
876#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
880#    sw $ra, 4($sp) # save $ra
884#    move $t1,$sp # save "original" sp

888:  doRead:

    # read the character
888#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
892#    subu $t2,$v0,13
896#    bne $t2,$zero,notReturnRL
900#    jal readLogicalChar
904#    subu $t2,$v0,10 # check for newline
908#    beq $t2,$zero,foundNewLine
912#    sw $v0,lastCharRead # push back character into queue
916#    j foundNewLine # go process the line

920:  notReturnRL:

    # at this point, $v0 has our character

920#    subu $t0,$v0,10
924#    beq $t0,$zero,foundNewLine
928#    blt $v0,$zero,foundEof
929##...slt $at,$v0,$zero
933##...bne $at,$zero,948

    # we have a character, so push it onto stack
936#    subu $sp,$sp,4
940#    sw $v0,($sp)

    # loop back up to get next character
944#    j doRead

948:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
948#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
952#    li $s7, 0 # return-value: null
956#    j rlReturn # return

960:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
960#    subu $t0,$t1,$sp # number of chars we read (times 4)
964#    srl $s6,$t0,2 # number of words on stack with chars
968#    subu $sp,$sp,4 # push char-count ...
972#    sw $s6,($sp) # ... onto stack
976#    addu $t2,$t0,5 # GC tag, incl. for count-word
980#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
984#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
988#    srl $s6,$s6,2  # data words in object
992#    move $s7,$zero # object words in object
996#    jal newObject  # allocate space
    
    # store header words
1000#    la $t0,CLASS_String
1004#    sw $t0,-12($s7)# store class tag (String) into object
1008#    lw $t2,4($sp) # char-count
1012#    sll $t1,$t2,2 # 4 times number of chars
1016#    subu $t2,$zero,$t2 # negative of char-count
1020#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1024#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1028#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1029##...slt $at,$t0,$zero
1033##...beq $at,$zero,1052
1036#    and $t0,0xff # mask off object's hash value ...
1037##...lui $at,0
1041##...ori $at,$at,0xff
1045##...and $t0,$t0,$at
1048#    sw $t0,-8($s7) # ... and store back into -8 header-word
1052:  skipMask_readLine:

1052#    sll $t0,$t0,2 # data bytes in object
1056#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1060#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1064#    addu $sp,$sp,8 # pop redundant object-pointer and count
1068#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

1072#    beq $sp,$t1,rlReturn
1076:  charCopyLoop:
1076#    lw $t2,($sp)
1080#    sb $t2,-9($t0)
1084#    addu $sp,$sp,4
1088#    subu $t0,$t0,1
1092#    bne $sp,$t1,charCopyLoop
1096:  rlReturn:

1096#    lw $ra, 4($sp)
1100#    addu $sp, 8   # pop $ra and pointless word off stack
1104#    move $t0, $s7 # return string we allocated in $s7
1108#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1112:mth_readInt_Lib:

    # save $ra by pushing onto stack
1112#    subu $sp,$sp,4
1116#    sw $ra,($sp)

1120:  riSkipWhiteLoop:
    # read a character
1120#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
1124#    subu $t0,$v0,32
1128#    bgt $t0,$zero,nonWhite
1129##...slt $at,$zero,$t0
1133##...bne $at,$zero,1176
1136#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1140#    subu $t0,$v0,10
1144#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1148#    subu $t0,$v0,9
1152#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1156#    subu $t0,$v0,13
1160#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1164#    subu $t0,$v0,12
1168#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1172#    j badIntegerFormat # illegal integer char: abort program

1176:  nonWhite:
1176#    subu $t0,$v0,'-'
1180#    li $t4,1 # final multiplier
1184#    bne $t0,$zero,helpReadInt # go read
1188#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1192#    jal readLogicalChar

1196:  helpReadInt:
1196#    li $t2,10
1200#    subu $t1,$v0,'0' # convert digit to 0-9 value
1204#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
1205##...sltu $at,$t1,$t2
1209##...beq $at,$zero,3456
1212#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

1216:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

1216#    jal readLogicalChar # read next character
1220#    subu $t1,$v0,'0' # convert digit to 0-9 value
1224#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
1225##...sltu $at,$t1,$t2
1229##...beq $at,$zero,1248

1232#    mul $t3,$t3,$t2 # multiply old value by 10
1233##...mult $t3,$t2
1237##...mflo $t3
1240#    addu $t3,$t3,$t1 # add in value of new digit
1244#    j digitLoop

1248:  doneDigitLoop:

    # "push back" unused character into queue
1248#    sw $v0,lastCharRead

    # restore return address
1252#    lw $ra,($sp)
1256#    addu $sp, 4

    # multiply by sign and put return value in $t0
1260#    mult $t3,$t4 # multiply to account for poss. minus sign
1264#    mflo $t3
1268#    move $t0, $t3
    
    # return
1272#    jr $ra
