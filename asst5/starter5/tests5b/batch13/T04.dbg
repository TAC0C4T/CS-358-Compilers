########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3220:vm_init:

    # mark bottom of stack
3220#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3224#    move $s2,$zero

    #set up the "five" register
3228#    li $s5,5

3232#    la $s3,seg0_start
3236#    la $s4,seg0_end
3237##...lui $s4,16
3241##...addiu $s4,$s4,4076
    
    # return
3244#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3248:divide:
    # get parameters; abort if divisor zero
3248#    lw $t0,($sp)
3252#    lw $t1,8($sp)
3256#    beq $t0,$zero,divByZeroError
    
    # perform division
3260#    div $t1,$t0
3264#    mflo $t0

    # store result, adjust stack and return
3268#    addu $sp,$sp,8 # adjust stack
3272#    sw $t0,($sp) # store result
3276#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3280:remainder:
    # get parameters; abort if divisor zero
3280#    lw $t0,($sp)
3284#    lw $t1,8($sp)
3288#    beq $t0,$zero,divByZeroError
    
    # perform division
3292#    div $t1,$t0
3296#    mfhi $t0

    # store result, adjust stack and return
3300#    addu $sp,$sp,8 # adjust stack
3304#    sw $t0,($sp) # store result
3308#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3312:checkCast:
    # get object, allow immediately if null
3312#    lw $t2,($sp)
3316#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3320#    lw $t2,-12($t2) # vtable address
3324#    bge $t2,$t1,castException
3325##...slt $at,$t2,$t1
3329##...beq $at,$zero,3464
3332#    blt $t2,$t0,castException
3333##...slt $at,$t2,$t0
3337##...bne $at,$zero,3464
    
    # return, leaving object unchanged on stack
3340:  checkCastReturn:    
3340#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3344:instanceOf:
    # get object, go return false if null
3344#    lw $t2,($sp)
3348#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3352#    lw $t2,-12($t2) # vtable address
3356#    sge $t0,$t2,$t0 # are we >= the lower limit?
3357##...slt $t0,$t2,$t0
3361##...xori $t0,$t0,0x1
3364#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3368#    and $t2,$t0,$t1
3372#    sw $t2,($sp)
3376:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3376#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3380:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3380#    li $v0,4 # syscall-code for print-string
3384#    syscall
3388:exit:
    # print termination message
3388#    li $v0,4 # syscall-code for print-string
3392#    la $a0,exitString
3396#    syscall

    # terminate execution
3400#    li $v0,10 #syscall-code for "exit"
3404#    syscall

3408:outOfHeapMemory:
3408#    la $a0,heapMemoryMsg
3412#    j exitError
3416:divByZeroError:
3416#    la $a0,divByZeroMsg
3420#    j exitError
3424:strIndexOutOfBounds:
3424#    la $a0,strIndexOutOfBoundsMsg
3428#    j exitError
3432:arrayIndexOutOfBounds:
3432#    la $a0,arrayIndexOutOfBoundsMsg
3436#    j exitError
3440:arraySizeOutOfBounds:
3440#    la $a0,arraySizeOutOfBoundsMsg
3444#    j exitError
3448:nullPtrException:
3448#    la $a0,nullPtrExceptionMsg
3452#    j exitError
3456:badIntegerFormat:
3456#    la $a0,badIntegerFormatMsg
3460#    j exitError
3464:castException:
3464#    la $a0,castExceptionMsg
3468#    j exitError
############## data section ################
    .data
3712:hexChars:
    .ascii "0123456789abcdef"
    .align 2
3728:cur_seg:
    .word 0

3732:lastCharRead:
    .word -2 # -2 => no buffered character
3736:prevHashConstant:
    .word 0x2785173c
3740:gcCount:
