3448#    li $s6,2
3452#    move $s7,$zero
3456#    jal newObject

    # get n from string.
3460#    lw $t1,8($sp)

    # store "String" tag into class field
3464#    la $t0,CLASS_String
3468#    sw $t0,-12($s7)
        
    # mask off hash bits, if needed
3472#    lw $t4,-8($s7) # # data words in source string
