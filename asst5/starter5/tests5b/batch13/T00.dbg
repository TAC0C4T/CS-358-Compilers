4421##...sltu $at,$t0,$s1
4425##...bne $at,$zero,4264

4428:  gcTestIterDone2:
4428#    bltu $t0,$s3,gcHeapCopyLoop
4429##...sltu $at,$t0,$s3
4433##...bne $at,$zero,4148
