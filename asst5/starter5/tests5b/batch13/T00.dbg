3624#    slt $t5,$t4,$t3 # 1 if str2 > str1, else 0
3628#    sll $t5,$t5,1 # 2 if str2 > str1, else 0
3632#    subu $t5,$t5,1 # 1 if str2 > str1, else -1
3636:  cmpHitLimitzz:
3636#    move $t0, $t5 # store return value
3640#    jr $ra # return
