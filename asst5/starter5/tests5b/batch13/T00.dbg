########################################################
# readLogicalChar (millicode)
#  - logically reads a character from standard input
#  - first checks character buffer, consuming it if possible
#  - return-result:
#    - returns character in $v0
#  - side-effects:
#    - reads a character
#    - clobbers $t0
########################################################
3644:readLogicalChar:

    # check if we already have a character
3644#    lw $v0,lastCharRead
3648#    li $t0,-2
3652#    beq $t0,$v0 doReadCh

    # we have our character from the buffer. Wipe out
    # buffer and return
3656#    sw $t0,lastCharRead # store -2 into buffer (i.e. "empty")
3660#    jr $ra # return
    
3664:  doReadCh:
    # we need to actually read a character: read and return
3664#    li $v0,12 # use system call to read a character
3668#    syscall
3672#    jr $ra # return
