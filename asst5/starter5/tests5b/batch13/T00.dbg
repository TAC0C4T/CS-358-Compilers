3993##...ori $at,$at,0xff
3997##...and $t2,$t2,$at
    #### OLD
    #### subu $t2,$zero,$t2 # set to 1 if -1 (number of data words)

4000:  gcSkip2:
4000#    sll $t2,$t2,2
4004#    addu $t2,$t2,8
4008#    subu $t4,$t1,$t2 # address of first word of source
4012#    lw $t3,-4($t1) # number of object words (negative means zero)
