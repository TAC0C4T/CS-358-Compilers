
########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4452:vm_init:

    # mark bottom of stack
4452#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4456#    move $s2,$zero

    #set up the "five" register
4460#    li $s5,5

4464#    la $s3,seg0_start
4468#    la $s4,seg0_end
4469##...lui $s4,16
4473##...addiu $s4,$s4,5300
    
    # return
4476#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4480:divide:
    # get parameters; abort if divisor zero
4480#    lw $t0,($sp)
4484#    lw $t1,8($sp)
4488#    beq $t0,$zero,divByZeroError
    
    # perform division
4492#    div $t1,$t0
4496#    mflo $t0

    # store result, adjust stack and return
4500#    addu $sp,$sp,8 # adjust stack
4504#    sw $t0,($sp) # store result
4508#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4512:remainder:
    # get parameters; abort if divisor zero
4512#    lw $t0,($sp)
4516#    lw $t1,8($sp)
4520#    beq $t0,$zero,divByZeroError
    
    # perform division
4524#    div $t1,$t0
4528#    mfhi $t0

    # store result, adjust stack and return
4532#    addu $sp,$sp,8 # adjust stack
4536#    sw $t0,($sp) # store result
4540#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4544:checkCast:
    # get object, allow immediately if null
4544#    lw $t2,($sp)
4548#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4552#    lw $t2,-12($t2) # vtable address
4556#    bge $t2,$t1,castException
4557##...slt $at,$t2,$t1
4561##...beq $at,$zero,4696
4564#    blt $t2,$t0,castException
4565##...slt $at,$t2,$t0
4569##...bne $at,$zero,4696
    
    # return, leaving object unchanged on stack
4572:  checkCastReturn:    
4572#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4576:instanceOf:
    # get object, go return false if null
4576#    lw $t2,($sp)
4580#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4584#    lw $t2,-12($t2) # vtable address
4588#    sge $t0,$t2,$t0 # are we >= the lower limit?
4589##...slt $t0,$t2,$t0
4593##...xori $t0,$t0,0x1
4596#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4600#    and $t2,$t0,$t1
4604#    sw $t2,($sp)
4608:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4608#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4612:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4612#    li $v0,4 # syscall-code for print-string
4616#    syscall
4620:exit:
    # print termination message
4620#    li $v0,4 # syscall-code for print-string
4624#    la $a0,exitString
4628#    syscall

    # terminate execution
4632#    li $v0,10 #syscall-code for "exit"
4636#    syscall

4640:outOfHeapMemory:
4640#    la $a0,heapMemoryMsg
4644#    j exitError
4648:divByZeroError:
4648#    la $a0,divByZeroMsg
4652#    j exitError
4656:strIndexOutOfBounds:
4656#    la $a0,strIndexOutOfBoundsMsg
4660#    j exitError
4664:arrayIndexOutOfBounds:
4664#    la $a0,arrayIndexOutOfBoundsMsg
4668#    j exitError
4672:arraySizeOutOfBounds:
4672#    la $a0,arraySizeOutOfBoundsMsg
4676#    j exitError
4680:nullPtrException:
4680#    la $a0,nullPtrExceptionMsg
4684#    j exitError
4688:badIntegerFormat:
