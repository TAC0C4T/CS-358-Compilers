3856#    lw $t0,cur_seg
3860#    move $t7,$s4
3864#    la $t6,seg1_start
3865##...lui $t6,16
3869##...addiu $t6,$t6,5300
3872#    la $s3,seg0_start
3876#    la $s4,seg0_end
3877##...lui $s4,16
3881##...addiu $s4,$s4,5300
3884#    sw $zero,cur_seg
3888#    bne $t0,$zero,skipGc1
3892#    la $t6,seg0_start
3896#    la $s3,seg1_start
3897##...lui $s3,16
3901##...addiu $s3,$s3,5300
3904#    la $s4,seg1_end
3905##...lui $s4,32
3909##...addiu $s4,$s4,5300
3912#    sw $s5,cur_seg
3916:  skipGc1:
3916#    li $t5,0x80000000
3920#    lw $t0,stack_bottom
3924#    subu $t0,4
