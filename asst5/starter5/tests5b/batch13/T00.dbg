##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1600:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
1600#    lw $t0,-8($s2) # get word with hash bits from this
1604#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
1608#    addu $t0,$t1

1612#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1616:mth_equals_Object:
1616#    move $t0,$s2 # first pointer (this)
1620#    lw $t1,($sp) # second pointer
1624#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
1625##...subu $at,$t0,$t1
1629##...sltiu $t0,$at,1

1632#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1636:mth_hashCode_String:
1636#    move $t0,$s2 # put this pointer in t0

1640#    li $t2,0 # current hash value
1644#    lw $t1,-4($t0) # negative of number of characters in string
1648#    beq $t1,$zero,done_hashCode_String # if zero length => done
1652#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
1656#    and $t0,0xfffffffc # adjust for padding
1657##...lui $at,65535
1661##...ori $at,$at,0xfffc
1665##...and $t0,$t0,$at
1668#    subu $t1,$t0,$t1 # address at end of string +12
1672:loop_hashCode_String:    
1672#    sll $t4,$t2,5 # multiply by 32
1676#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
1680#    lbu $t3,-12($t0) # current character
1684#    addu $t2,$t3 # add in current character
1688#    addu $t0,1 # go to next character's address
1692#    bne $t0,$t1,loop_hashCode_String # loop back if more
1696:done_hashCode_String:    

    # push int on stack
1696#    move $t0, $t2 # put $t2 in return slot
1700#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1704:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1704#    subu $sp,4
1708#    sw $ra,($sp)
    
    # get hash value
1712#    lw $t2,-12($s2) # vtable address
1716#    lw $t0,($t2) # method address
1720#    jalr $t0
1724#    subu $sp,8 # push result (int in $t0) on stack
1728#    sw $s5,4($sp)
1732#    sw $t0,($sp)

    # compute print-size of hash value
1736#    li $t0, 1
1740#    lw $t1, ($sp)
1744#    srl $t1,$t1,4
1748#    beq $t1,$zero,toString_skip_loop
1752:toString_loop_top:
1752#    addu $t0,1
1756#    srl $t1,$t1,4
1760#    bne $t1,$zero,toString_loop_top
1764:toString_skip_loop:
1764#    subu $sp,8
1768#    sw $s5,4($sp)
1772#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1776#    lw $t2,-12($s2) # vtable address
1780#    move $t0,$t2
1784:toString_checkTagBit:
1784#    subu $t0,1
1788#    lb $t1,($t0)
1792#    and $t1,0x80
1793##...lui $at,0
1797##...ori $at,$at,0x80
1801##...and $t1,$t1,$at
1804#    beq $t1,$zero,toString_checkTagBit
1808#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1812#    subu $sp,8
1816#    sw $t1,($sp)
1820#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1824#    move $s7,$zero # -4 offset header word
1828#    lw $t4,8($sp) # bytes for hash value
1832#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1836#    addu $t4,8
1840#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1844#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1848#    li $t0,CLASS_String # store string vtable address into ...
1852#    sw $t0,-12($s7) # ... -12 offset in object header
1856#    lw $t2,-12($s2) # our object's vtable address
1860#    lw $t5,4($sp) # number characters in prefix
1864#    lw $t1,12($sp) # number of characters in hashcode
1868#    addu $t3,$t1,$t5 # number of characters in string ...
1872#    addu $t3,1 # ... including the '@' character
1876#    subu $t0,$zero,$t3 # store negated length into ...
1880#    sw $t0,-4($s7) # ... -4 offset header word
1884#    lw $t0,-8($s7) # get -8 offset header-word
1888#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1889##...slt $at,$t0,$zero
1893##...beq $at,$zero,1912
1896#    and $t0,0xff # mask off object's hash value ...
1897##...lui $at,0
1901##...ori $at,$at,0xff
1905##...and $t0,$t0,$at
1908#    sw $t0,-8($s7) # ... and store back into -8 header-word
1912:skipMask_toString:
1912#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1916#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1920#    subu $t4,$t2,$t5
1924:toString_copyLoop:    
1924#    lb $t3,($t4)
1928#    and $t3,0x7f # mask off sign bit (in case first word)
1929##...lui $at,0
1933##...ori $at,$at,0x7f
1937##...and $t3,$t3,$at
1940#    sb $t3,-8($t0)
1944#    addu $t4,1
1948#    addu $t0,1
1952#    blt $t4,$t2,toString_copyLoop
1953##...slt $at,$t4,$t2
1957##...bne $at,$zero,1924

    # copy the '@' sign
1960#    li $t3,'@'
1964#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1968#    addu $t2,$t0,$t1 # address of last byte in string to store +8
1972#    lw $t3,20($sp) # hash code to print
1976:toString_hashCopyLoop:
1976#    and $t4,$t3,0xf
1980#    srl $t3,4
1984#    lb $t4,hexChars($t4)
1988#    sb $t4,-8($t2)
1992#    subu $t2,$t2,1
1996#    bgt $t2,$t0,toString_hashCopyLoop
1997##...slt $at,$t0,$t2
2001##...bne $at,$zero,1976

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
2004#    addu $sp,28
2008#    lw $ra,($sp)
2012#    addu $sp,4
2016#    move $t0, $s7 # return string we created
2020#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
2024:mth_equals_String:
    
    # quick test for obvious false
2024#    lw $t0,($sp) # second parameter
2028#    beq $t0,$zero,goEsFalse # go return false if null
2032#    lw $t1,-12($t0) # vtable pointer
2036#    la $t2,CLASS_String # string vtable pointer
2040#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
2044#    subu $sp,12
2048#    sw $ra,8($sp)
2052#    sw $s2,4($sp)
2056#    sw $t0,($sp)
2060#    jal mth_compareTo_String
2064#    lw $s2, 4($sp) #restore this pointer and pop parameters
2068#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
2072#    seq $t0,$t0,$zero
2073##...subu $at,$t0,$zero
2077##...sltiu $t0,$at,1

    # pop return address and return $t0
2080#    lw $ra,($sp)
2084#    addu $sp,4

2088#    jr $ra # return
    
2092:goEsFalse:
    # put 0 in $t0 and return
2092#    li $t0, 0
2096#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
2100:mth_toString_String:
    #we are a string, so return this.
2100#    move $t0, $s2
2104#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
2108:mth_readLine_Lib:
    
2108#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
2112#    sw $ra, 4($sp) # save $ra
2116#    move $t1,$sp # save "original" sp

2120:  doRead:

    # read the character
2120#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
2124#    subu $t2,$v0,13
2128#    bne $t2,$zero,notReturnRL
2132#    jal readLogicalChar
2136#    subu $t2,$v0,10 # check for newline
2140#    beq $t2,$zero,foundNewLine
2144#    sw $v0,lastCharRead # push back character into queue
2148#    j foundNewLine # go process the line

2152:  notReturnRL:

    # at this point, $v0 has our character

2152#    subu $t0,$v0,10
2156#    beq $t0,$zero,foundNewLine
2160#    blt $v0,$zero,foundEof
2161##...slt $at,$v0,$zero
2165##...bne $at,$zero,2180

    # we have a character, so push it onto stack
2168#    subu $sp,$sp,4
2172#    sw $v0,($sp)

    # loop back up to get next character
2176#    j doRead

2180:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
2180#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
2184#    li $s7, 0 # return-value: null
2188#    j rlReturn # return

2192:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
2192#    subu $t0,$t1,$sp # number of chars we read (times 4)
2196#    srl $s6,$t0,2 # number of words on stack with chars
2200#    subu $sp,$sp,4 # push char-count ...
2204#    sw $s6,($sp) # ... onto stack
2208#    addu $t2,$t0,5 # GC tag, incl. for count-word
2212#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
2216#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
2220#    srl $s6,$s6,2  # data words in object
2224#    move $s7,$zero # object words in object
2228#    jal newObject  # allocate space
    
    # store header words
2232#    la $t0,CLASS_String
2236#    sw $t0,-12($s7)# store class tag (String) into object
2240#    lw $t2,4($sp) # char-count
2244#    sll $t1,$t2,2 # 4 times number of chars
2248#    subu $t2,$zero,$t2 # negative of char-count
2252#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
2256#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
2260#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
2261##...slt $at,$t0,$zero
2265##...beq $at,$zero,2284
2268#    and $t0,0xff # mask off object's hash value ...
2269##...lui $at,0
2273##...ori $at,$at,0xff
2277##...and $t0,$t0,$at
2280#    sw $t0,-8($s7) # ... and store back into -8 header-word
2284:  skipMask_readLine:

2284#    sll $t0,$t0,2 # data bytes in object
2288#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
2292#    subu $t0,$t0,$t2 # place to store last character (plus 9)
2296#    addu $sp,$sp,8 # pop redundant object-pointer and count
2300#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

2304#    beq $sp,$t1,rlReturn
2308:  charCopyLoop:
2308#    lw $t2,($sp)
2312#    sb $t2,-9($t0)
2316#    addu $sp,$sp,4
2320#    subu $t0,$t0,1
2324#    bne $sp,$t1,charCopyLoop
2328:  rlReturn:

