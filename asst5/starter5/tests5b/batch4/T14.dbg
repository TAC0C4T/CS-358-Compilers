    # determine if we have enough memory available
2208#    addu $t0,$s6,$s7
2212#    sll $t0,$t0,2
2216#    addu $t0,$t0,8 # amount of memory needed
2220#    addu $t1,$t0,$s3
2224#    bgtu $t1,$s4,doGC
