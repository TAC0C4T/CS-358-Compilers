.data
3404:strLit_1:
.asciiz "It's so true!\n"
.align 2
3420:strLit_6:
.asciiz "It's so false!\n"
.align 2
3436:strLit_13:
.asciiz "True, I say!\n"
.align 2
3452:strLit_18:
.asciiz "False, I say!\n"
.align 2
.text
.globl main
0:main:
0#  jal vm_init
4#  li $v0, 10
8#  syscall
12:mth_main_Main:
12#  subu $sp, $sp, 8
16#  sw $s5, 4($sp)
20#  li $t0, 1
24#  sw $t0, 0($sp)
28#  la $t0, strLit_1
32#  subu $sp, $sp, 4
36#  sw $t0, ($sp)
40#  subu $sp, $sp, 4
44#  sw $s2, ($sp)
48#  la $t0, strLit_6
52#  subu $sp, $sp, 4
56#  sw $t0, ($sp)
60#  subu $sp, $sp, 4
64#  sw $s2, ($sp)
68#  subu $sp, $sp, 4
72#  sw $0, ($sp)
76#  la $t0, strLit_13
80#  subu $sp, $sp, 4
84#  sw $t0, ($sp)
88#  subu $sp, $sp, 4
92#  sw $s2, ($sp)
96#  la $t0, strLit_18
100#  subu $sp, $sp, 4
104#  sw $t0, ($sp)
108#  subu $sp, $sp, 4
112#  sw $s2, ($sp)
116#  jr $ra
##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
120:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
120#    lw $t0,-8($s2) # get word with hash bits from this
124#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
128#    addu $t0,$t1

132#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
136:mth_equals_Object:
136#    move $t0,$s2 # first pointer (this)
140#    lw $t1,($sp) # second pointer
144#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
145##...subu $at,$t0,$t1
149##...sltiu $t0,$at,1

152#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
156:mth_hashCode_String:
156#    move $t0,$s2 # put this pointer in t0

160#    li $t2,0 # current hash value
164#    lw $t1,-4($t0) # negative of number of characters in string
168#    beq $t1,$zero,done_hashCode_String # if zero length => done
172#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
176#    and $t0,0xfffffffc # adjust for padding
177##...lui $at,65535
181##...ori $at,$at,0xfffc
185##...and $t0,$t0,$at
188#    subu $t1,$t0,$t1 # address at end of string +12
192:loop_hashCode_String:    
192#    sll $t4,$t2,5 # multiply by 32
196#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
200#    lbu $t3,-12($t0) # current character
204#    addu $t2,$t3 # add in current character
208#    addu $t0,1 # go to next character's address
212#    bne $t0,$t1,loop_hashCode_String # loop back if more
216:done_hashCode_String:    

    # push int on stack
216#    move $t0, $t2 # put $t2 in return slot
220#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
224:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
224#    subu $sp,4
228#    sw $ra,($sp)
    
    # get hash value
232#    lw $t2,-12($s2) # vtable address
236#    lw $t0,($t2) # method address
240#    jalr $t0
244#    subu $sp,8 # push result (int in $t0) on stack
248#    sw $s5,4($sp)
252#    sw $t0,($sp)

    # compute print-size of hash value
256#    li $t0, 1
260#    lw $t1, ($sp)
264#    srl $t1,$t1,4
268#    beq $t1,$zero,toString_skip_loop
272:toString_loop_top:
272#    addu $t0,1
276#    srl $t1,$t1,4
280#    bne $t1,$zero,toString_loop_top
284:toString_skip_loop:
284#    subu $sp,8
288#    sw $s5,4($sp)
292#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
296#    lw $t2,-12($s2) # vtable address
300#    move $t0,$t2
304:toString_checkTagBit:
304#    subu $t0,1
308#    lb $t1,($t0)
312#    and $t1,0x80
313##...lui $at,0
317##...ori $at,$at,0x80
321##...and $t1,$t1,$at
324#    beq $t1,$zero,toString_checkTagBit
328#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
332#    subu $sp,8
336#    sw $t1,($sp)
340#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
344#    move $s7,$zero # -4 offset header word
348#    lw $t4,8($sp) # bytes for hash value
352#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
356#    addu $t4,8
360#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
364#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

368#    li $t0,CLASS_String # store string vtable address into ...
372#    sw $t0,-12($s7) # ... -12 offset in object header
376#    lw $t2,-12($s2) # our object's vtable address
380#    lw $t5,4($sp) # number characters in prefix
384#    lw $t1,12($sp) # number of characters in hashcode
388#    addu $t3,$t1,$t5 # number of characters in string ...
392#    addu $t3,1 # ... including the '@' character
396#    subu $t0,$zero,$t3 # store negated length into ...
400#    sw $t0,-4($s7) # ... -4 offset header word
404#    lw $t0,-8($s7) # get -8 offset header-word
408#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
409##...slt $at,$t0,$zero
413##...beq $at,$zero,432
416#    and $t0,0xff # mask off object's hash value ...
417##...lui $at,0
421##...ori $at,$at,0xff
425##...and $t0,$t0,$at
428#    sw $t0,-8($s7) # ... and store back into -8 header-word
432:skipMask_toString:
432#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
436#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
440#    subu $t4,$t2,$t5
444:toString_copyLoop:    
444#    lb $t3,($t4)
448#    and $t3,0x7f # mask off sign bit (in case first word)
449##...lui $at,0
453##...ori $at,$at,0x7f
457##...and $t3,$t3,$at
460#    sb $t3,-8($t0)
464#    addu $t4,1
468#    addu $t0,1
472#    blt $t4,$t2,toString_copyLoop
473##...slt $at,$t4,$t2
477##...bne $at,$zero,444

    # copy the '@' sign
480#    li $t3,'@'
484#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
488#    addu $t2,$t0,$t1 # address of last byte in string to store +8
492#    lw $t3,20($sp) # hash code to print
496:toString_hashCopyLoop:
496#    and $t4,$t3,0xf
500#    srl $t3,4
504#    lb $t4,hexChars($t4)
508#    sb $t4,-8($t2)
512#    subu $t2,$t2,1
516#    bgt $t2,$t0,toString_hashCopyLoop
517##...slt $at,$t0,$t2
521##...bne $at,$zero,496

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
524#    addu $sp,28
528#    lw $ra,($sp)
532#    addu $sp,4
536#    move $t0, $s7 # return string we created
540#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
544:mth_equals_String:
    
    # quick test for obvious false
544#    lw $t0,($sp) # second parameter
548#    beq $t0,$zero,goEsFalse # go return false if null
552#    lw $t1,-12($t0) # vtable pointer
556#    la $t2,CLASS_String # string vtable pointer
560#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
564#    subu $sp,12
568#    sw $ra,8($sp)
572#    sw $s2,4($sp)
576#    sw $t0,($sp)
580#    jal mth_compareTo_String
584#    lw $s2, 4($sp) #restore this pointer and pop parameters
588#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
592#    seq $t0,$t0,$zero
593##...subu $at,$t0,$zero
597##...sltiu $t0,$at,1

    # pop return address and return $t0
600#    lw $ra,($sp)
604#    addu $sp,4

608#    jr $ra # return
    
612:goEsFalse:
    # put 0 in $t0 and return
612#    li $t0, 0
616#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
620:mth_toString_String:
    #we are a string, so return this.
620#    move $t0, $s2
624#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
628:mth_readLine_Lib:
    
628#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
632#    sw $ra, 4($sp) # save $ra
636#    move $t1,$sp # save "original" sp

640:  doRead:

    # read the character
640#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
644#    subu $t2,$v0,13
648#    bne $t2,$zero,notReturnRL
652#    jal readLogicalChar
656#    subu $t2,$v0,10 # check for newline
660#    beq $t2,$zero,foundNewLine
664#    sw $v0,lastCharRead # push back character into queue
668#    j foundNewLine # go process the line

672:  notReturnRL:

    # at this point, $v0 has our character

672#    subu $t0,$v0,10
676#    beq $t0,$zero,foundNewLine
680#    blt $v0,$zero,foundEof
681##...slt $at,$v0,$zero
685##...bne $at,$zero,700

    # we have a character, so push it onto stack
688#    subu $sp,$sp,4
692#    sw $v0,($sp)

    # loop back up to get next character
696#    j doRead

700:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
700#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
