712#    subu $t0,$t1,$sp # number of chars we read (times 4)
716#    srl $s6,$t0,2 # number of words on stack with chars
720#    subu $sp,$sp,4 # push char-count ...
724#    sw $s6,($sp) # ... onto stack
728#    addu $t2,$t0,5 # GC tag, incl. for count-word
732#    sw $t2,($t1) # store GC tag
