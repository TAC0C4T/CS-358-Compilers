5332#    sll $t1,$t1,2 # - byte-offset from end of chars
5336#    subu $t1,$t2,$t1 # - address of first char in string, offset by 8
5340#    addu $t0,$t0,$t1 # - address of our char, offset by 8
5344#    lb $t0,-8($t0) # our char

    # return
5348#    jr $ra
