6192#    addu $t2,$s3,$t2 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object (i.e., the address just beyond the object's header)
    # - $t2 contains the pointer to the target object
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0-2
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger" in the target space
6196#    lw $s0,($t4)
6200#    lw $s1,-8($t1)
6204#    sw $s1,($t4)
6208#    sw $s0,-8($t1)
    
    # copy all source bytes to the target
6212:  gCinnerCopy1:
6212#    lw $s0,($t4)
6216#    sw $s0,($s3)
6220#    addu $t4,$t4,4
6224#    addu $s3,$s3,4
6228#    bltu $t4,$t3,gCinnerCopy1
6229##...sltu $at,$t4,$t3
6233##...bne $at,$zero,6212

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
6236#    sw $zero,-8($t1) # 0 in first header-slot
6240#    sw $t2,-4($t1) # forwarding pointer in second header-slot

    # update the stack slot with the address in the target space
6244#    sw $t2,4($t0)
6248#    lw $zero,-8($t2)
6252#    lw $zero,-4($t2)

    # go handle next stack slot (testing if done)
6256#    j gcTestIterDone1

6260:  gcBump:
    #### we have a GC tag.  Bytes to skip: tag value + 3.
6260#    subu $t0,$t0,$t1
6264#    subu $t0,$t0,3

6268:  gcTestIterDone1:
6268#    bgeu $t0,$sp,gcStackCopyLoop
6269##...sltu $at,$t0,$sp
6273##...beq $at,$zero,6084

    ###### end outer loop to copy all stack-direct objects ######

    #############################################################
    # We have finished processing the stack elements.  Now we need
    # to update elements in the heap itself. This may itself involve
    # moving additional objects
    #############################################################

    #########################################################
    # At this point:
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # We want to set things up so that in addition:
    # - $t0 is the "trailing finger", containing the address
    #   of the first slot in target space that we have yet
    #   to process.
    # Then during processing:
    # - $t1 will contain the contents of the heap slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # And when we're actually copying an object:
    # - $t2 will contain pointer to the target object
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - available for use: $s0
    ##########################################################

    # set $t0 to be at the beginning of target-space
6276#    lw $t1,cur_seg
6280#    la $t0,seg0_start
6284#    beq $t1,$zero,gcSkip4
6288#    la $t0,seg1_start
6289##...lui $t0,16
6293##...addiu $t0,$t0,7472


6296:  gcSkip4:

    # if there were no objects put into the heap during stack
    # processing, we're done, so go finish up
6296#    bgeu $t0,$s3,gcFinishUp
6297##...sltu $at,$t0,$s3
6301##...beq $at,$zero,6592

    ###### begin outer loop to copy all non-stack-direct objects ######

6304:  gcHeapCopyLoop:
    # get data count for object; swap header-word with first word
    # of object so that they're back in the right place
6304#    lw $t1,($t0) # (what will be) first header word for current object
6308#    move $t2,$t1 # number data bytes in object (poss. w/hash bits)
6312#    bge $t2,$zero,gcSkip4a # are there hash bits?
6313##...slt $at,$t2,$zero
6317##...beq $at,$zero,6332
6320#    and $t2,0xff # mask off hash bits
6321##...lui $at,0
6325##...ori $at,$at,0xff
6329##...and $t2,$t2,$at
6332:gcSkip4a:    
6332#    sll $t2,$t2,2 # # data bytes
6336#    addu $t2,$t2,8 # to skip header words
6340#    addu $t2,$t0,$t2 # pointer to new object
6344#    lw $t3,-8($t2) # word to swap
6348#    sw $t1,-8($t2) # store header word
6352#    sw $t3,($t0) # restore first word of object

    ################################################
    # at this point:
    # - $t2 contains the pointer to our new object
    ################################################

    # check if we have a data array
6356#    lw $t1,-12($t2) # vtable pointer
6360#    li $t0,dataArrayVTableStart # address of vtable for first data array
6364#    blt $t1,$t0,gcNotDataArray # if data array, no more xforming to do
6365##...slt $at,$t1,$t0
6369##...bne $at,$zero,6388

    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
6372:  skipToNextObj:
6372#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
6376#    sll $t1,$t1,2 # convert to byte-count
6380#    addu $t0,$t2,$t1 # skip over object
6384#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
6388:  gcNotDataArray:
6388#    lw $t3,-4($t2) # # object words (negative treated as zero)
6392#    bge $t3,$zero,gcH2Neg2
6393##...slt $at,$t3,$zero
6397##...beq $at,$zero,6404
6400#    move $t3,$zero
6404:  gcH2Neg2:
6404#    sll $t3,$t3,2 # # object bytes
6408#    move $t0,$t2 # address of first pointer in object
6412#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
6416#    beq $t0,$s1,gcTestIterDone2
    
6420:  gcNextPointerInObject:
    # get pointer from object
6420#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
6424#    bleu $t1,$t6,gcGoNextPointerSlot
6425##...sltu $at,$t6,$t1
6429##...beq $at,$zero,6572
6432#    bgtu $t1,$t7,gcGoNextPointerSlot
6433##...sltu $at,$t7,$t1
6437##...bne $at,$zero,6572

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
6440#    lw $t8,-8($t1) # possible forwarding tag
6444#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
6448#    lw $t8,-4($t1) # forwarding pointer: object's new address
6452#    sw $t8,($t0) # update pointer in object
6456#    j gcGoNextPointerSlot # do next iteration

6460:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
6460#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
6461##...slt $at,$t8,$zero
6465##...beq $at,$zero,6480
6468#    and $t8,0xff # mask off hash bits
6469##...lui $at,0
6473##...ori $at,$at,0xff
6477##...and $t8,$t8,$at

6480:  gcSkip5:
6480#    sll $t8,$t8,2 # bytes in negative-offset portion ...
6484#    addu $t8,$t8,8 # ... add in bytes for header-words
6488#    subu $t4,$t1,$t8 # address of first word of source object
6492#    lw $t3,-4($t1) # # words in positive-offset portion
6496#    bge $t3,$zero,gcNoNeg
6497##...slt $at,$t3,$zero
6501##...beq $at,$zero,6508
6504#    move $t3,$zero # negative treated as zero
6508:  gcNoNeg:
6508#    sll $t3,$t3,2 # bytes in negative-offset portion
6512#    addu $t3,$t3,$t1 # address one word past last word of source

6516#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
6520#    lw $s0,($t4)
6524#    lw $t9,-8($t1)
6528#    sw $t9,($t4)
6532#    sw $s0,-8($t1)

    # copy all source bytes to the target
6536:  gCinnerCopy2:
6536#    lw $s0,($t4)
6540#    sw $s0,($s3)
6544#    addu $t4,$t4,4
6548#    addu $s3,$s3,4
6552#    bltu $t4,$t3,gCinnerCopy2
6553##...sltu $at,$t4,$t3
6557##...bne $at,$zero,6536

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
6560#    sw $zero,-8($t1) # 0 in first header-slot
6564#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
6568#    sw $t8,($t0)

6572:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
6572#    addu $t0,$t0,4
6576#    bltu $t0,$s1,gcNextPointerInObject
6577##...sltu $at,$t0,$s1
6581##...bne $at,$zero,6420

6584:  gcTestIterDone2:
6584#    bltu $t0,$s3,gcHeapCopyLoop
6585##...sltu $at,$t0,$s3
6589##...bne $at,$zero,6304

    ###### end outer loop to copy all non-stack-direct objects ######

6592:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
6592#    lw $s2,($sp)
6596#    addu $sp,$sp,4

    # mark us as having already GC'd
6600#    move $t5,$s5

    # go try and allocate again
6604#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
6608:vm_init:

    # mark bottom of stack
6608#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
6612#    move $s2,$zero

    #set up the "five" register
6616#    li $s5,5

6620#    la $s3,seg0_start
6624#    la $s4,seg0_end
6625##...lui $s4,16
6629##...addiu $s4,$s4,7472
    
    # return
6632#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
6636:divide:
    # get parameters; abort if divisor zero
6636#    lw $t0,($sp)
6640#    lw $t1,8($sp)
6644#    beq $t0,$zero,divByZeroError
    
    # perform division
6648#    div $t1,$t0
6652#    mflo $t0

    # store result, adjust stack and return
6656#    addu $sp,$sp,8 # adjust stack
6660#    sw $t0,($sp) # store result
6664#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
6668:remainder:
    # get parameters; abort if divisor zero
6668#    lw $t0,($sp)
6672#    lw $t1,8($sp)
6676#    beq $t0,$zero,divByZeroError
    
    # perform division
6680#    div $t1,$t0
6684#    mfhi $t0

    # store result, adjust stack and return
6688#    addu $sp,$sp,8 # adjust stack
6692#    sw $t0,($sp) # store result
6696#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
6700:checkCast:
    # get object, allow immediately if null
6700#    lw $t2,($sp)
6704#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
6708#    lw $t2,-12($t2) # vtable address
6712#    bge $t2,$t1,castException
6713##...slt $at,$t2,$t1
6717##...beq $at,$zero,6852
6720#    blt $t2,$t0,castException
6721##...slt $at,$t2,$t0
6725##...bne $at,$zero,6852
    
    # return, leaving object unchanged on stack
6728:  checkCastReturn:    
6728#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
6732:instanceOf:
    # get object, go return false if null
6732#    lw $t2,($sp)
6736#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
6740#    lw $t2,-12($t2) # vtable address
6744#    sge $t0,$t2,$t0 # are we >= the lower limit?
6745##...slt $t0,$t2,$t0
6749##...xori $t0,$t0,0x1
6752#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
6756#    and $t2,$t0,$t1
6760#    sw $t2,($sp)
6764:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
6764#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

6768:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
6768#    li $v0,4 # syscall-code for print-string
6772#    syscall
6776:exit:
    # print termination message
6776#    li $v0,4 # syscall-code for print-string
6780#    la $a0,exitString
6784#    syscall

    # terminate execution
6788#    li $v0,10 #syscall-code for "exit"
6792#    syscall

6796:outOfHeapMemory:
6796#    la $a0,heapMemoryMsg
6800#    j exitError
6804:divByZeroError:
6804#    la $a0,divByZeroMsg
6808#    j exitError
6812:strIndexOutOfBounds:
6812#    la $a0,strIndexOutOfBoundsMsg
6816#    j exitError
6820:arrayIndexOutOfBounds:
6820#    la $a0,arrayIndexOutOfBoundsMsg
6824#    j exitError
6828:arraySizeOutOfBounds:
6828#    la $a0,arraySizeOutOfBoundsMsg
6832#    j exitError
6836:nullPtrException:
6836#    la $a0,nullPtrExceptionMsg
6840#    j exitError
6844:badIntegerFormat:
6844#    la $a0,badIntegerFormatMsg
6848#    j exitError
6852:castException:
6852#    la $a0,castExceptionMsg
6856#    j exitError
############## data section ################
    .data
7108:hexChars:
    .ascii "0123456789abcdef"
    .align 2
7124:cur_seg:
    .word 0

7128:lastCharRead:
