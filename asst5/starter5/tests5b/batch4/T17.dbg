##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
3756:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
3756#    lw $t0,-8($s2) # get word with hash bits from this
3760#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
3764#    addu $t0,$t1

3768#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
3772:mth_equals_Object:
3772#    move $t0,$s2 # first pointer (this)
3776#    lw $t1,($sp) # second pointer
3780#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
3781##...subu $at,$t0,$t1
3785##...sltiu $t0,$at,1

3788#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
3792:mth_hashCode_String:
3792#    move $t0,$s2 # put this pointer in t0

3796#    li $t2,0 # current hash value
3800#    lw $t1,-4($t0) # negative of number of characters in string
3804#    beq $t1,$zero,done_hashCode_String # if zero length => done
3808#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
3812#    and $t0,0xfffffffc # adjust for padding
3813##...lui $at,65535
3817##...ori $at,$at,0xfffc
3821##...and $t0,$t0,$at
3824#    subu $t1,$t0,$t1 # address at end of string +12
3828:loop_hashCode_String:    
3828#    sll $t4,$t2,5 # multiply by 32
3832#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
3836#    lbu $t3,-12($t0) # current character
3840#    addu $t2,$t3 # add in current character
3844#    addu $t0,1 # go to next character's address
3848#    bne $t0,$t1,loop_hashCode_String # loop back if more
3852:done_hashCode_String:    

    # push int on stack
3852#    move $t0, $t2 # put $t2 in return slot
3856#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
3860:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
3860#    subu $sp,4
3864#    sw $ra,($sp)
    
    # get hash value
3868#    lw $t2,-12($s2) # vtable address
3872#    lw $t0,($t2) # method address
3876#    jalr $t0
3880#    subu $sp,8 # push result (int in $t0) on stack
3884#    sw $s5,4($sp)
3888#    sw $t0,($sp)

    # compute print-size of hash value
3892#    li $t0, 1
3896#    lw $t1, ($sp)
3900#    srl $t1,$t1,4
3904#    beq $t1,$zero,toString_skip_loop
3908:toString_loop_top:
3908#    addu $t0,1
3912#    srl $t1,$t1,4
3916#    bne $t1,$zero,toString_loop_top
3920:toString_skip_loop:
3920#    subu $sp,8
3924#    sw $s5,4($sp)
3928#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
3932#    lw $t2,-12($s2) # vtable address
3936#    move $t0,$t2
3940:toString_checkTagBit:
3940#    subu $t0,1
3944#    lb $t1,($t0)
3948#    and $t1,0x80
3949##...lui $at,0
3953##...ori $at,$at,0x80
3957##...and $t1,$t1,$at
3960#    beq $t1,$zero,toString_checkTagBit
3964#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
3968#    subu $sp,8
3972#    sw $t1,($sp)
3976#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
3980#    move $s7,$zero # -4 offset header word
3984#    lw $t4,8($sp) # bytes for hash value
3988#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
3992#    addu $t4,8
3996#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
4000#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

4004#    li $t0,CLASS_String # store string vtable address into ...
4008#    sw $t0,-12($s7) # ... -12 offset in object header
4012#    lw $t2,-12($s2) # our object's vtable address
4016#    lw $t5,4($sp) # number characters in prefix
4020#    lw $t1,12($sp) # number of characters in hashcode
4024#    addu $t3,$t1,$t5 # number of characters in string ...
4028#    addu $t3,1 # ... including the '@' character
4032#    subu $t0,$zero,$t3 # store negated length into ...
4036#    sw $t0,-4($s7) # ... -4 offset header word
4040#    lw $t0,-8($s7) # get -8 offset header-word
4044#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
4045##...slt $at,$t0,$zero
4049##...beq $at,$zero,4068
4052#    and $t0,0xff # mask off object's hash value ...
4053##...lui $at,0
4057##...ori $at,$at,0xff
4061##...and $t0,$t0,$at
4064#    sw $t0,-8($s7) # ... and store back into -8 header-word
4068:skipMask_toString:
4068#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
4072#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
4076#    subu $t4,$t2,$t5
4080:toString_copyLoop:    
4080#    lb $t3,($t4)
4084#    and $t3,0x7f # mask off sign bit (in case first word)
4085##...lui $at,0
4089##...ori $at,$at,0x7f
4093##...and $t3,$t3,$at
4096#    sb $t3,-8($t0)
4100#    addu $t4,1
4104#    addu $t0,1
4108#    blt $t4,$t2,toString_copyLoop
4109##...slt $at,$t4,$t2
4113##...bne $at,$zero,4080

    # copy the '@' sign
4116#    li $t3,'@'
4120#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
4124#    addu $t2,$t0,$t1 # address of last byte in string to store +8
4128#    lw $t3,20($sp) # hash code to print
4132:toString_hashCopyLoop:
4132#    and $t4,$t3,0xf
4136#    srl $t3,4
4140#    lb $t4,hexChars($t4)
4144#    sb $t4,-8($t2)
4148#    subu $t2,$t2,1
4152#    bgt $t2,$t0,toString_hashCopyLoop
4153##...slt $at,$t0,$t2
4157##...bne $at,$zero,4132

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
4160#    addu $sp,28
4164#    lw $ra,($sp)
4168#    addu $sp,4
4172#    move $t0, $s7 # return string we created
4176#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
4180:mth_equals_String:
    
    # quick test for obvious false
4180#    lw $t0,($sp) # second parameter
4184#    beq $t0,$zero,goEsFalse # go return false if null
4188#    lw $t1,-12($t0) # vtable pointer
4192#    la $t2,CLASS_String # string vtable pointer
4196#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
4200#    subu $sp,12
4204#    sw $ra,8($sp)
4208#    sw $s2,4($sp)
4212#    sw $t0,($sp)
4216#    jal mth_compareTo_String
4220#    lw $s2, 4($sp) #restore this pointer and pop parameters
4224#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
4228#    seq $t0,$t0,$zero
4229##...subu $at,$t0,$zero
4233##...sltiu $t0,$at,1

    # pop return address and return $t0
4236#    lw $ra,($sp)
4240#    addu $sp,4

4244#    jr $ra # return
    
4248:goEsFalse:
    # put 0 in $t0 and return
4248#    li $t0, 0
4252#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
4256:mth_toString_String:
    #we are a string, so return this.
4256#    move $t0, $s2
4260#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
4264:mth_readLine_Lib:
    
4264#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
4268#    sw $ra, 4($sp) # save $ra
4272#    move $t1,$sp # save "original" sp

4276:  doRead:

    # read the character
4276#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
4280#    subu $t2,$v0,13
4284#    bne $t2,$zero,notReturnRL
4288#    jal readLogicalChar
4292#    subu $t2,$v0,10 # check for newline
4296#    beq $t2,$zero,foundNewLine
4300#    sw $v0,lastCharRead # push back character into queue
4304#    j foundNewLine # go process the line

4308:  notReturnRL:

    # at this point, $v0 has our character

4308#    subu $t0,$v0,10
4312#    beq $t0,$zero,foundNewLine
4316#    blt $v0,$zero,foundEof
4317##...slt $at,$v0,$zero
4321##...bne $at,$zero,4336

    # we have a character, so push it onto stack
4324#    subu $sp,$sp,4
4328#    sw $v0,($sp)

    # loop back up to get next character
4332#    j doRead

4336:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
4336#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
4340#    li $s7, 0 # return-value: null
4344#    j rlReturn # return

4348:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
4348#    subu $t0,$t1,$sp # number of chars we read (times 4)
4352#    srl $s6,$t0,2 # number of words on stack with chars
4356#    subu $sp,$sp,4 # push char-count ...
4360#    sw $s6,($sp) # ... onto stack
4364#    addu $t2,$t0,5 # GC tag, incl. for count-word
4368#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
4372#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
4376#    srl $s6,$s6,2  # data words in object
4380#    move $s7,$zero # object words in object
4384#    jal newObject  # allocate space
    
    # store header words
4388#    la $t0,CLASS_String
4392#    sw $t0,-12($s7)# store class tag (String) into object
4396#    lw $t2,4($sp) # char-count
4400#    sll $t1,$t2,2 # 4 times number of chars
4404#    subu $t2,$zero,$t2 # negative of char-count
4408#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
4412#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
4416#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
4417##...slt $at,$t0,$zero
4421##...beq $at,$zero,4440
4424#    and $t0,0xff # mask off object's hash value ...
4425##...lui $at,0
4429##...ori $at,$at,0xff
4433##...and $t0,$t0,$at
4436#    sw $t0,-8($s7) # ... and store back into -8 header-word
4440:  skipMask_readLine:

4440#    sll $t0,$t0,2 # data bytes in object
4444#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
4448#    subu $t0,$t0,$t2 # place to store last character (plus 9)
4452#    addu $sp,$sp,8 # pop redundant object-pointer and count
4456#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

4460#    beq $sp,$t1,rlReturn
4464:  charCopyLoop:
4464#    lw $t2,($sp)
4468#    sb $t2,-9($t0)
4472#    addu $sp,$sp,4
4476#    subu $t0,$t0,1
4480#    bne $sp,$t1,charCopyLoop
4484:  rlReturn:

4484#    lw $ra, 4($sp)
4488#    addu $sp, 8   # pop $ra and pointless word off stack
4492#    move $t0, $s7 # return string we allocated in $s7
4496#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
4500:mth_readInt_Lib:

    # save $ra by pushing onto stack
4500#    subu $sp,$sp,4
4504#    sw $ra,($sp)

4508:  riSkipWhiteLoop:
    # read a character
4508#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
4512#    subu $t0,$v0,32
4516#    bgt $t0,$zero,nonWhite
4517##...slt $at,$zero,$t0
4521##...bne $at,$zero,4564
4524#    beq $t0,$zero,riSkipWhiteLoop # start over if space
4528#    subu $t0,$v0,10
4532#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
4536#    subu $t0,$v0,9
4540#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
4544#    subu $t0,$v0,13
4548#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
4552#    subu $t0,$v0,12
4556#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
4560#    j badIntegerFormat # illegal integer char: abort program

4564:  nonWhite:
4564#    subu $t0,$v0,'-'
4568#    li $t4,1 # final multiplier
4572#    bne $t0,$zero,helpReadInt # go read
4576#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
4580#    jal readLogicalChar

4584:  helpReadInt:
4584#    li $t2,10
