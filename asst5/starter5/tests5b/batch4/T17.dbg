5096#    lw $t1,-4($t1) # negative size of first object
5100#    addu $s6,$t0,$t1 # sum of negative sizes
5104#    sra $s6,$s6,2 # negative word-size of char part
5108#    subu $s6,$zero,$s6 # word size of char part
5112#    addu $s6,$s6,1 # data word size, including v-table word
5116#    move $s7,$zero
