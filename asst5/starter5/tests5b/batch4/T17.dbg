    # store String vtable address in vtable address field
5124#    la $t0,CLASS_String
5128#    sw $t0,-12($s7)
        
    # mask off hash bits, if needed
5132#    lw $t4,-8($s7) # # data words in source string
5136#    bge $t4,$zero,skipMask_concat # don't strip hash code if not there
5137##...slt $at,$t4,$zero
5141##...beq $at,$zero,5160
5144#    and $t4,0xff # mask off object's hash value ...
5145##...lui $at,0
5149##...ori $at,$at,0xff
5153##...and $t4,$t4,$at
5156#    sw $t4,-8($s7) # ... and store back into -8 header-word
5160:skipMask_concat:

5160#    move $t9, $s7 # store return string in unused (I hope) t9 register

    #restore $t0, and $t1 after they were potentially blown
    #away by newObject
5164#    move $t1,$s2   # first object
5168#    lw $t0,8($sp) # second object
    
    # get negative sizes; sum and store in new object size-field
5172#    lw $t2,-4($t0) # negative length of second object
5176#    lw $t3,-4($t1) # negative length of first object
5180#    addu $t4,$t2,$t3 # sum of negative lengths
5184#    sw $t4,-4($s7) # store sum as negated target-string length

    #########################################################
    # at this point:
    # - $t0 is pointer to second object
    # - $t1 is pointer to first object
    # - $t2 is negated length of second object
    # - $t3 is negated length of first object
    # - $s7 is pointer to new object
    #########################################################

    # compute addresses for moving data from first string
5188#    lw $t4,-8($t1) # # data words in first string
5192#    sll $t4,$t4,2 # # data bytes in first string
5196#    subu $t1,$t1,$t4 # addr. (+8) of first byte in first string
5200#    lw $t4,-8($s7) # # data words in new string
5204#    sll $t4,$t4,2 # # data bytes in new string
5208#    subu $s7,$s7,$t4 # addr. (+8) of first byte in new string
