4593##...sltu $at,$t1,$t2
4597##...beq $at,$zero,6844
4600#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

4604:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

4604#    jal readLogicalChar # read next character
4608#    subu $t1,$v0,'0' # convert digit to 0-9 value
4612#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
4613##...sltu $at,$t1,$t2
4617##...beq $at,$zero,4636

4620#    mul $t3,$t3,$t2 # multiply old value by 10
4621##...mult $t3,$t2
4625##...mflo $t3
4628#    addu $t3,$t3,$t1 # add in value of new digit
4632#    j digitLoop

4636:  doneDigitLoop:

    # "push back" unused character into queue
