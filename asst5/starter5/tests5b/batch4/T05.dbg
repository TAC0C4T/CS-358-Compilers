772#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
776#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
777##...slt $at,$t0,$zero
781##...beq $at,$zero,800
784#    and $t0,0xff # mask off object's hash value ...
785##...lui $at,0
789##...ori $at,$at,0xff
793##...and $t0,$t0,$at
796#    sw $t0,-8($s7) # ... and store back into -8 header-word
