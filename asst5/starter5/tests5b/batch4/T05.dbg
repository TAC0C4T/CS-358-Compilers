.data
3400:strLit_11:
.asciiz "This should not be printed\n"
.align 2
3428:strLit_18:
.asciiz "This should be printed\n"
.align 2
.text
.globl main
0:main:
0#  jal vm_init
4#  li $v0, 10
8#  syscall
12:mth_main_Main:
12#  li $t0, 6
16#  subu $sp, $sp, 8
20#  sw $s5, 4($sp)
24#  sw $t0, 0($sp)
28#  li $t0, 7
32#  subu $sp, $sp, 8
36#  sw $s5, 4($sp)
40#  sw $t0, 0($sp)
44#  lw $t2, ($sp)
48#  addu $sp, $sp, 4
52#  lw $t1, ($sp)
56#  addu $sp, $sp, 4
60#  sgt $t0, $t1, $t2
64#  subu $sp, $sp, 4
68#  sw $t0, ($sp)
72#  la $t0, strLit_11
76#  subu $sp, $sp, 4
80#  sw $t0, ($sp)
84#  subu $sp, $sp, 4
88#  sw $s2, ($sp)
92#  la $t0, strLit_18
96#  subu $sp, $sp, 4
100#  sw $t0, ($sp)
104#  subu $sp, $sp, 4
108#  sw $s2, ($sp)
112#  jr $ra
##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
116:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
116#    lw $t0,-8($s2) # get word with hash bits from this
120#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
124#    addu $t0,$t1

128#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
132:mth_equals_Object:
132#    move $t0,$s2 # first pointer (this)
136#    lw $t1,($sp) # second pointer
140#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
141##...subu $at,$t0,$t1
145##...sltiu $t0,$at,1

148#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
152:mth_hashCode_String:
152#    move $t0,$s2 # put this pointer in t0

156#    li $t2,0 # current hash value
160#    lw $t1,-4($t0) # negative of number of characters in string
164#    beq $t1,$zero,done_hashCode_String # if zero length => done
168#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
172#    and $t0,0xfffffffc # adjust for padding
173##...lui $at,65535
177##...ori $at,$at,0xfffc
181##...and $t0,$t0,$at
184#    subu $t1,$t0,$t1 # address at end of string +12
188:loop_hashCode_String:    
188#    sll $t4,$t2,5 # multiply by 32
192#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
196#    lbu $t3,-12($t0) # current character
200#    addu $t2,$t3 # add in current character
204#    addu $t0,1 # go to next character's address
208#    bne $t0,$t1,loop_hashCode_String # loop back if more
212:done_hashCode_String:    

    # push int on stack
212#    move $t0, $t2 # put $t2 in return slot
216#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
220:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
220#    subu $sp,4
224#    sw $ra,($sp)
    
    # get hash value
228#    lw $t2,-12($s2) # vtable address
232#    lw $t0,($t2) # method address
236#    jalr $t0
240#    subu $sp,8 # push result (int in $t0) on stack
244#    sw $s5,4($sp)
248#    sw $t0,($sp)

    # compute print-size of hash value
252#    li $t0, 1
256#    lw $t1, ($sp)
260#    srl $t1,$t1,4
264#    beq $t1,$zero,toString_skip_loop
268:toString_loop_top:
268#    addu $t0,1
272#    srl $t1,$t1,4
276#    bne $t1,$zero,toString_loop_top
280:toString_skip_loop:
280#    subu $sp,8
284#    sw $s5,4($sp)
288#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
292#    lw $t2,-12($s2) # vtable address
296#    move $t0,$t2
300:toString_checkTagBit:
300#    subu $t0,1
304#    lb $t1,($t0)
308#    and $t1,0x80
309##...lui $at,0
313##...ori $at,$at,0x80
317##...and $t1,$t1,$at
320#    beq $t1,$zero,toString_checkTagBit
324#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
328#    subu $sp,8
332#    sw $t1,($sp)
336#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
340#    move $s7,$zero # -4 offset header word
344#    lw $t4,8($sp) # bytes for hash value
348#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
352#    addu $t4,8
356#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
360#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

364#    li $t0,CLASS_String # store string vtable address into ...
368#    sw $t0,-12($s7) # ... -12 offset in object header
372#    lw $t2,-12($s2) # our object's vtable address
376#    lw $t5,4($sp) # number characters in prefix
380#    lw $t1,12($sp) # number of characters in hashcode
384#    addu $t3,$t1,$t5 # number of characters in string ...
388#    addu $t3,1 # ... including the '@' character
392#    subu $t0,$zero,$t3 # store negated length into ...
396#    sw $t0,-4($s7) # ... -4 offset header word
400#    lw $t0,-8($s7) # get -8 offset header-word
404#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
405##...slt $at,$t0,$zero
409##...beq $at,$zero,428
412#    and $t0,0xff # mask off object's hash value ...
413##...lui $at,0
417##...ori $at,$at,0xff
421##...and $t0,$t0,$at
424#    sw $t0,-8($s7) # ... and store back into -8 header-word
428:skipMask_toString:
428#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
432#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
436#    subu $t4,$t2,$t5
440:toString_copyLoop:    
440#    lb $t3,($t4)
444#    and $t3,0x7f # mask off sign bit (in case first word)
445##...lui $at,0
449##...ori $at,$at,0x7f
453##...and $t3,$t3,$at
456#    sb $t3,-8($t0)
460#    addu $t4,1
464#    addu $t0,1
468#    blt $t4,$t2,toString_copyLoop
469##...slt $at,$t4,$t2
473##...bne $at,$zero,440

    # copy the '@' sign
476#    li $t3,'@'
480#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
484#    addu $t2,$t0,$t1 # address of last byte in string to store +8
488#    lw $t3,20($sp) # hash code to print
492:toString_hashCopyLoop:
492#    and $t4,$t3,0xf
496#    srl $t3,4
500#    lb $t4,hexChars($t4)
504#    sb $t4,-8($t2)
508#    subu $t2,$t2,1
512#    bgt $t2,$t0,toString_hashCopyLoop
513##...slt $at,$t0,$t2
517##...bne $at,$zero,492

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
520#    addu $sp,28
524#    lw $ra,($sp)
528#    addu $sp,4
532#    move $t0, $s7 # return string we created
536#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
540:mth_equals_String:
    
    # quick test for obvious false
540#    lw $t0,($sp) # second parameter
544#    beq $t0,$zero,goEsFalse # go return false if null
548#    lw $t1,-12($t0) # vtable pointer
552#    la $t2,CLASS_String # string vtable pointer
556#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
560#    subu $sp,12
564#    sw $ra,8($sp)
568#    sw $s2,4($sp)
572#    sw $t0,($sp)
576#    jal mth_compareTo_String
580#    lw $s2, 4($sp) #restore this pointer and pop parameters
584#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
588#    seq $t0,$t0,$zero
589##...subu $at,$t0,$zero
593##...sltiu $t0,$at,1

    # pop return address and return $t0
596#    lw $ra,($sp)
600#    addu $sp,4

604#    jr $ra # return
    
608:goEsFalse:
    # put 0 in $t0 and return
608#    li $t0, 0
612#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
616:mth_toString_String:
    #we are a string, so return this.
616#    move $t0, $s2
620#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
624:mth_readLine_Lib:
    
624#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
628#    sw $ra, 4($sp) # save $ra
632#    move $t1,$sp # save "original" sp

636:  doRead:

    # read the character
636#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
640#    subu $t2,$v0,13
644#    bne $t2,$zero,notReturnRL
648#    jal readLogicalChar
652#    subu $t2,$v0,10 # check for newline
656#    beq $t2,$zero,foundNewLine
660#    sw $v0,lastCharRead # push back character into queue
664#    j foundNewLine # go process the line

668:  notReturnRL:

    # at this point, $v0 has our character

668#    subu $t0,$v0,10
672#    beq $t0,$zero,foundNewLine
676#    blt $v0,$zero,foundEof
677##...slt $at,$v0,$zero
681##...bne $at,$zero,696

    # we have a character, so push it onto stack
684#    subu $sp,$sp,4
688#    sw $v0,($sp)

    # loop back up to get next character
692#    j doRead

696:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
696#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
700#    li $s7, 0 # return-value: null
704#    j rlReturn # return

708:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)
