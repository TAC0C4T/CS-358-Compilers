896#    subu $t0,$v0,9
900#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
904#    subu $t0,$v0,13
908#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
912#    subu $t0,$v0,12
