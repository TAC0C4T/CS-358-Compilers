########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3092:instanceOf:
    # get object, go return false if null
3092#    lw $t2,($sp)
3096#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3100#    lw $t2,-12($t2) # vtable address
3104#    sge $t0,$t2,$t0 # are we >= the lower limit?
3105##...slt $t0,$t2,$t0
3109##...xori $t0,$t0,0x1
3112#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3116#    and $t2,$t0,$t1
3120#    sw $t2,($sp)
3124:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3124#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3128:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3128#    li $v0,4 # syscall-code for print-string
3132#    syscall
3136:exit:
    # print termination message
3136#    li $v0,4 # syscall-code for print-string
3140#    la $a0,exitString
3144#    syscall

    # terminate execution
3148#    li $v0,10 #syscall-code for "exit"
3152#    syscall

3156:outOfHeapMemory:
3156#    la $a0,heapMemoryMsg
3160#    j exitError
3164:divByZeroError:
3164#    la $a0,divByZeroMsg
3168#    j exitError
3172:strIndexOutOfBounds:
3172#    la $a0,strIndexOutOfBoundsMsg
3176#    j exitError
3180:arrayIndexOutOfBounds:
3180#    la $a0,arrayIndexOutOfBoundsMsg
3184#    j exitError
3188:arraySizeOutOfBounds:
3188#    la $a0,arraySizeOutOfBoundsMsg
3192#    j exitError
3196:nullPtrException:
3196#    la $a0,nullPtrExceptionMsg
3200#    j exitError
3204:badIntegerFormat:
3204#    la $a0,badIntegerFormatMsg
3208#    j exitError
3212:castException:
3212#    la $a0,castExceptionMsg
3216#    j exitError
############## data section ################
    .data
3452:hexChars:
    .ascii "0123456789abcdef"
    .align 2
3468:cur_seg:
    .word 0

3472:lastCharRead:
    .word -2 # -2 => no buffered character
3476:prevHashConstant:
    .word 0x2785173c
3480:gcCount:
    .word 0

3484:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
3511:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
3534:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
3569:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
3603:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
3636:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
3667:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
3715:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
3736:gcMsg: 
      .asciiz "\nGC!\n"
3742:gcCountMsg: 
      .asciiz "Number of garbage collections: "

3774:nullStr:
    .asciiz "null"
3779:trueString:
    .asciiz "true"
3784:falseString:
    .asciiz "false"
3790:exitString:
    .ascii "Program terminated."
    #### "falls through" here
3809:newlineString:
    .asciiz "\n"
    
    .align 2
3812:stack_bottom:
    .word 0

