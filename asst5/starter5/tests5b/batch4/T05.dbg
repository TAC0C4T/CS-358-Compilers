800#    sll $t0,$t0,2 # data bytes in object
804#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
808#    subu $t0,$t0,$t2 # place to store last character (plus 9)
812#    addu $sp,$sp,8 # pop redundant object-pointer and count
816#    addu $t1,$t1,$sp # first non-char spot on stack
