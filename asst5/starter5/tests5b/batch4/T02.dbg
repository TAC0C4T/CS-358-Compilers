2412#    sw $s6,-8($t0) # store header-1 value
2416#    lw $zero,-8($t0)

    # store second header-value
2420#    sw $s7,-4($t0)   # second header-word
2424#    lw $zero,-4($t0)
    
    # put return-value into $s7 and also push it onto top of stack
2428#    move $s7,$t0
2432#    subu $sp,$sp,4
2436#    sw $t0,($sp)
