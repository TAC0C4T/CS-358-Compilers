204#  sw $s2, ($sp)
208#  jr $ra
##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
212:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
212#    lw $t0,-8($s2) # get word with hash bits from this
216#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
220#    addu $t0,$t1

224#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
228:mth_equals_Object:
228#    move $t0,$s2 # first pointer (this)
232#    lw $t1,($sp) # second pointer
236#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
237##...subu $at,$t0,$t1
241##...sltiu $t0,$at,1

244#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
248:mth_hashCode_String:
248#    move $t0,$s2 # put this pointer in t0

252#    li $t2,0 # current hash value
256#    lw $t1,-4($t0) # negative of number of characters in string
260#    beq $t1,$zero,done_hashCode_String # if zero length => done
264#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
268#    and $t0,0xfffffffc # adjust for padding
269##...lui $at,65535
273##...ori $at,$at,0xfffc
277##...and $t0,$t0,$at
280#    subu $t1,$t0,$t1 # address at end of string +12
284:loop_hashCode_String:    
284#    sll $t4,$t2,5 # multiply by 32
288#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
292#    lbu $t3,-12($t0) # current character
296#    addu $t2,$t3 # add in current character
300#    addu $t0,1 # go to next character's address
304#    bne $t0,$t1,loop_hashCode_String # loop back if more
308:done_hashCode_String:    

    # push int on stack
308#    move $t0, $t2 # put $t2 in return slot
312#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
316:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
316#    subu $sp,4
320#    sw $ra,($sp)
    
    # get hash value
324#    lw $t2,-12($s2) # vtable address
328#    lw $t0,($t2) # method address
332#    jalr $t0
336#    subu $sp,8 # push result (int in $t0) on stack
340#    sw $s5,4($sp)
344#    sw $t0,($sp)

    # compute print-size of hash value
348#    li $t0, 1
352#    lw $t1, ($sp)
356#    srl $t1,$t1,4
360#    beq $t1,$zero,toString_skip_loop
364:toString_loop_top:
364#    addu $t0,1
368#    srl $t1,$t1,4
372#    bne $t1,$zero,toString_loop_top
376:toString_skip_loop:
376#    subu $sp,8
380#    sw $s5,4($sp)
384#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
388#    lw $t2,-12($s2) # vtable address
392#    move $t0,$t2
396:toString_checkTagBit:
396#    subu $t0,1
400#    lb $t1,($t0)
404#    and $t1,0x80
405##...lui $at,0
409##...ori $at,$at,0x80
413##...and $t1,$t1,$at
416#    beq $t1,$zero,toString_checkTagBit
420#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
424#    subu $sp,8
428#    sw $t1,($sp)
432#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
436#    move $s7,$zero # -4 offset header word
440#    lw $t4,8($sp) # bytes for hash value
444#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
448#    addu $t4,8
452#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
456#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

460#    li $t0,CLASS_String # store string vtable address into ...
464#    sw $t0,-12($s7) # ... -12 offset in object header
468#    lw $t2,-12($s2) # our object's vtable address
472#    lw $t5,4($sp) # number characters in prefix
476#    lw $t1,12($sp) # number of characters in hashcode
480#    addu $t3,$t1,$t5 # number of characters in string ...
484#    addu $t3,1 # ... including the '@' character
488#    subu $t0,$zero,$t3 # store negated length into ...
492#    sw $t0,-4($s7) # ... -4 offset header word
496#    lw $t0,-8($s7) # get -8 offset header-word
500#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
501##...slt $at,$t0,$zero
505##...beq $at,$zero,524
508#    and $t0,0xff # mask off object's hash value ...
509##...lui $at,0
513##...ori $at,$at,0xff
517##...and $t0,$t0,$at
520#    sw $t0,-8($s7) # ... and store back into -8 header-word
524:skipMask_toString:
524#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
528#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
532#    subu $t4,$t2,$t5
536:toString_copyLoop:    
536#    lb $t3,($t4)
540#    and $t3,0x7f # mask off sign bit (in case first word)
541##...lui $at,0
545##...ori $at,$at,0x7f
549##...and $t3,$t3,$at
552#    sb $t3,-8($t0)
556#    addu $t4,1
560#    addu $t0,1
564#    blt $t4,$t2,toString_copyLoop
565##...slt $at,$t4,$t2
569##...bne $at,$zero,536

    # copy the '@' sign
572#    li $t3,'@'
576#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
580#    addu $t2,$t0,$t1 # address of last byte in string to store +8
584#    lw $t3,20($sp) # hash code to print
588:toString_hashCopyLoop:
588#    and $t4,$t3,0xf
592#    srl $t3,4
596#    lb $t4,hexChars($t4)
600#    sb $t4,-8($t2)
604#    subu $t2,$t2,1
608#    bgt $t2,$t0,toString_hashCopyLoop
609##...slt $at,$t0,$t2
613##...bne $at,$zero,588

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
616#    addu $sp,28
620#    lw $ra,($sp)
624#    addu $sp,4
628#    move $t0, $s7 # return string we created
632#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
636:mth_equals_String:
    
    # quick test for obvious false
636#    lw $t0,($sp) # second parameter
640#    beq $t0,$zero,goEsFalse # go return false if null
644#    lw $t1,-12($t0) # vtable pointer
648#    la $t2,CLASS_String # string vtable pointer
652#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
656#    subu $sp,12
660#    sw $ra,8($sp)
664#    sw $s2,4($sp)
668#    sw $t0,($sp)
672#    jal mth_compareTo_String
676#    lw $s2, 4($sp) #restore this pointer and pop parameters
680#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
684#    seq $t0,$t0,$zero
685##...subu $at,$t0,$zero
689##...sltiu $t0,$at,1

    # pop return address and return $t0
692#    lw $ra,($sp)
696#    addu $sp,4

700#    jr $ra # return
    
704:goEsFalse:
    # put 0 in $t0 and return
704#    li $t0, 0
708#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
712:mth_toString_String:
    #we are a string, so return this.
712#    move $t0, $s2
716#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
720:mth_readLine_Lib:
    
720#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
724#    sw $ra, 4($sp) # save $ra
728#    move $t1,$sp # save "original" sp

732:  doRead:

    # read the character
732#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
736#    subu $t2,$v0,13
740#    bne $t2,$zero,notReturnRL
744#    jal readLogicalChar
748#    subu $t2,$v0,10 # check for newline
752#    beq $t2,$zero,foundNewLine
756#    sw $v0,lastCharRead # push back character into queue
760#    j foundNewLine # go process the line

