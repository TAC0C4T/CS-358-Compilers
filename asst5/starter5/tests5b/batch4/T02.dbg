3176#    blt $t2,$t0,castException
3177##...slt $at,$t2,$t0
3181##...bne $at,$zero,3308
    
    # return, leaving object unchanged on stack
3184:  checkCastReturn:    
3184#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3188:instanceOf:
    # get object, go return false if null
3188#    lw $t2,($sp)
3192#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3196#    lw $t2,-12($t2) # vtable address
3200#    sge $t0,$t2,$t0 # are we >= the lower limit?
3201##...slt $t0,$t2,$t0
3205##...xori $t0,$t0,0x1
3208#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3212#    and $t2,$t0,$t1
3216#    sw $t2,($sp)
3220:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3220#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3224:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3224#    li $v0,4 # syscall-code for print-string
3228#    syscall
3232:exit:
    # print termination message
3232#    li $v0,4 # syscall-code for print-string
3236#    la $a0,exitString
3240#    syscall

    # terminate execution
3244#    li $v0,10 #syscall-code for "exit"
3248#    syscall

3252:outOfHeapMemory:
3252#    la $a0,heapMemoryMsg
3256#    j exitError
3260:divByZeroError:
3260#    la $a0,divByZeroMsg
3264#    j exitError
3268:strIndexOutOfBounds:
3268#    la $a0,strIndexOutOfBoundsMsg
3272#    j exitError
3276:arrayIndexOutOfBounds:
3276#    la $a0,arrayIndexOutOfBoundsMsg
3280#    j exitError
3284:arraySizeOutOfBounds:
3284#    la $a0,arraySizeOutOfBoundsMsg
3288#    j exitError
3292:nullPtrException:
3292#    la $a0,nullPtrExceptionMsg
3296#    j exitError
3300:badIntegerFormat:
3300#    la $a0,badIntegerFormatMsg
3304#    j exitError
3308:castException:
3308#    la $a0,castExceptionMsg
3312#    j exitError
############## data section ################
    .data
3504:hexChars:
    .ascii "0123456789abcdef"
    .align 2
3520:cur_seg:
    .word 0

3524:lastCharRead:
    .word -2 # -2 => no buffered character
3528:prevHashConstant:
    .word 0x2785173c
3532:gcCount:
    .word 0

3536:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
3563:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
