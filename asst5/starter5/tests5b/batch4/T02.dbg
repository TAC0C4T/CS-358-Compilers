
    # determine if we have enough memory available
2300#    addu $t0,$s6,$s7
2304#    sll $t0,$t0,2
2308#    addu $t0,$t0,8 # amount of memory needed
2312#    addu $t1,$t0,$s3
2316#    bgtu $t1,$s4,doGC
