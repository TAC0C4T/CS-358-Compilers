3621:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
3655:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
3688:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
3719:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
3767:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
3788:gcMsg: 
      .asciiz "\nGC!\n"
3794:gcCountMsg: 
      .asciiz "Number of garbage collections: "

3826:nullStr:
    .asciiz "null"
3831:trueString:
    .asciiz "true"
3836:falseString:
    .asciiz "false"
3842:exitString:
