0:main:
0#  jal vm_init
4#  li $v0, 10
8#  syscall
12:mth_main_Main:
12#  li $t0, 27
16#  subu $sp, $sp, 8
20#  sw $s5, 4($sp)
24#  sw $t0, 0($sp)
28#  li $t0, 0
32#  subu $sp, $sp, 8
36#  sw $s5, 4($sp)
40#  sw $t0, 0($sp)
44#  li $t0, 0
48#  subu $sp, $sp, 8
52#  sw $s5, 4($sp)
56#  sw $t0, 0($sp)
60#  lw $t2, ($sp)
64#  addu $sp, $sp, 4
68#  lw $t1, ($sp)
72#  addu $sp, $sp, 4
76#  slt $t0, $t1, $t2
80#  subu $sp, $sp, 4
84#  sw $t0, ($sp)
88#  lw $t2, ($sp)
92#  addu $sp, $sp, 4
96#  lw $t1, ($sp)
100#  addu $sp, $sp, 4
104#  subu $t0, $t1, $t2
108#  subu $sp, $sp, 4
112#  sw $t0, ($sp)
116#  li $t0, 1
120#  subu $sp, $sp, 8
124#  sw $s5, 4($sp)
128#  sw $t0, 0($sp)
132#  lw $t2, ($sp)
136#  addu $sp, $sp, 4
140#  lw $t1, ($sp)
144#  addu $sp, $sp, 4
148#  addu $t0, $t1, $t2
152#  subu $sp, $sp, 4
156#  sw $t0, ($sp)
160#  subu $sp, $sp, 4
164#  sw $s2, ($sp)
168#  la $t0, strLit_26
172#  subu $sp, $sp, 4
176#  sw $t0, ($sp)
180#  subu $sp, $sp, 4
184#  sw $s2, ($sp)
188#  la $t0, strLit_32
192#  subu $sp, $sp, 4
196#  sw $t0, ($sp)
