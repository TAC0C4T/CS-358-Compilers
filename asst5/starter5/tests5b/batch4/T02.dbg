2481##...addiu $t6,$t6,3868
2484#    la $s3,seg0_start
2488#    la $s4,seg0_end
2489##...lui $s4,16
2493##...addiu $s4,$s4,3868
2496#    sw $zero,cur_seg
2500#    bne $t0,$zero,skipGc1
2504#    la $t6,seg0_start
2508#    la $s3,seg1_start
2509##...lui $s3,16
2513##...addiu $s3,$s3,3868
2516#    la $s4,seg1_end
