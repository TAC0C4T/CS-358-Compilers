1616#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1620#    subu $t0,$v0,10
1624#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1628#    subu $t0,$v0,9
1632#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1636#    subu $t0,$v0,13
1640#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1644#    subu $t0,$v0,12
1648#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1652#    j badIntegerFormat # illegal integer char: abort program

1656:  nonWhite:
1656#    subu $t0,$v0,'-'
1660#    li $t4,1 # final multiplier
1664#    bne $t0,$zero,helpReadInt # go read
1668#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1672#    jal readLogicalChar

1676:  helpReadInt:
1676#    li $t2,10
1680#    subu $t1,$v0,'0' # convert digit to 0-9 value
