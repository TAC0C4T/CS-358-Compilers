2964#    sw $zero,($s3)
2968#    lw $zero,($s3)

2972#    addu $s3,4
2976#    bltu $s3,$t1,zeroObjLoop
2977##...sltu $at,$s3,$t1
2981##...bne $at,$zero,2964

    # at this point:
    #  $s3 has been updated to point to the next free slot,
    #    which is also the points just past our object
