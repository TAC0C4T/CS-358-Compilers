2997##...sltu $at,$s6,$t2
3001##...beq $at,$zero,3048
3004#    lw $t1,prevHashConstant
3008#    addu $t1,0x12b68fd2
3009##...lui $at,4791
3013##...addiu $at,$at,-28718
3017##...addu $t1,$at,$t1
3020#    sw $t1,prevHashConstant # update hash constant
3024#    or $t1,0x80000000 # set top bit
3025##...lui $at,32768
3029##...or $t1,$at,$t1
3032#    and $t1,0xffffff00 # clear low bit
3033##...lui $at,65535
3037##...ori $at,$at,0xff00
3041##...and $t1,$t1,$at
3044#    or $s6,$t1
3048:firstHeaderLarge:
3048#    sw $s6,-8($t0) # store header-1 value
3052#    lw $zero,-8($t0)
