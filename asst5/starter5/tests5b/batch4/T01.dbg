3129##...addiu $s4,$s4,4500
3132#    sw $zero,cur_seg
3136#    bne $t0,$zero,skipGc1
3140#    la $t6,seg0_start
3144#    la $s3,seg1_start
3145##...lui $s3,16
3149##...addiu $s3,$s3,4500
3152#    la $s4,seg1_end
