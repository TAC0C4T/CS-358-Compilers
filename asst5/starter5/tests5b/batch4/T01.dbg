###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1356:mth_readLine_Lib:
    
1356#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1360#    sw $ra, 4($sp) # save $ra
1364#    move $t1,$sp # save "original" sp

1368:  doRead:

    # read the character
1368#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1372#    subu $t2,$v0,13
1376#    bne $t2,$zero,notReturnRL
1380#    jal readLogicalChar
1384#    subu $t2,$v0,10 # check for newline
1388#    beq $t2,$zero,foundNewLine
1392#    sw $v0,lastCharRead # push back character into queue
1396#    j foundNewLine # go process the line

1400:  notReturnRL:

    # at this point, $v0 has our character

1400#    subu $t0,$v0,10
1404#    beq $t0,$zero,foundNewLine
1408#    blt $v0,$zero,foundEof
1409##...slt $at,$v0,$zero
1413##...bne $at,$zero,1428

    # we have a character, so push it onto stack
1416#    subu $sp,$sp,4
1420#    sw $v0,($sp)

    # loop back up to get next character
1424#    j doRead

1428:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1428#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1432#    li $s7, 0 # return-value: null
1436#    j rlReturn # return

1440:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1440#    subu $t0,$t1,$sp # number of chars we read (times 4)
1444#    srl $s6,$t0,2 # number of words on stack with chars
1448#    subu $sp,$sp,4 # push char-count ...
1452#    sw $s6,($sp) # ... onto stack
1456#    addu $t2,$t0,5 # GC tag, incl. for count-word
1460#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1464#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1468#    srl $s6,$s6,2  # data words in object
1472#    move $s7,$zero # object words in object
1476#    jal newObject  # allocate space
    
    # store header words
1480#    la $t0,CLASS_String
1484#    sw $t0,-12($s7)# store class tag (String) into object
1488#    lw $t2,4($sp) # char-count
1492#    sll $t1,$t2,2 # 4 times number of chars
1496#    subu $t2,$zero,$t2 # negative of char-count
1500#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1504#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1508#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1509##...slt $at,$t0,$zero
1513##...beq $at,$zero,1532
1516#    and $t0,0xff # mask off object's hash value ...
1517##...lui $at,0
1521##...ori $at,$at,0xff
1525##...and $t0,$t0,$at
1528#    sw $t0,-8($s7) # ... and store back into -8 header-word
1532:  skipMask_readLine:

1532#    sll $t0,$t0,2 # data bytes in object
1536#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1540#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1544#    addu $sp,$sp,8 # pop redundant object-pointer and count
1548#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

1552#    beq $sp,$t1,rlReturn
1556:  charCopyLoop:
1556#    lw $t2,($sp)
1560#    sb $t2,-9($t0)
1564#    addu $sp,$sp,4
1568#    subu $t0,$t0,1
1572#    bne $sp,$t1,charCopyLoop
1576:  rlReturn:

1576#    lw $ra, 4($sp)
1580#    addu $sp, 8   # pop $ra and pointless word off stack
1584#    move $t0, $s7 # return string we allocated in $s7
1588#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1592:mth_readInt_Lib:

    # save $ra by pushing onto stack
1592#    subu $sp,$sp,4
1596#    sw $ra,($sp)
