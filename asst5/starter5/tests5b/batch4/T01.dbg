##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
848:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
848#    lw $t0,-8($s2) # get word with hash bits from this
852#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
856#    addu $t0,$t1

860#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
864:mth_equals_Object:
864#    move $t0,$s2 # first pointer (this)
868#    lw $t1,($sp) # second pointer
872#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
873##...subu $at,$t0,$t1
877##...sltiu $t0,$at,1

880#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
884:mth_hashCode_String:
884#    move $t0,$s2 # put this pointer in t0

888#    li $t2,0 # current hash value
892#    lw $t1,-4($t0) # negative of number of characters in string
896#    beq $t1,$zero,done_hashCode_String # if zero length => done
900#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
904#    and $t0,0xfffffffc # adjust for padding
905##...lui $at,65535
909##...ori $at,$at,0xfffc
913##...and $t0,$t0,$at
916#    subu $t1,$t0,$t1 # address at end of string +12
920:loop_hashCode_String:    
920#    sll $t4,$t2,5 # multiply by 32
924#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
928#    lbu $t3,-12($t0) # current character
932#    addu $t2,$t3 # add in current character
936#    addu $t0,1 # go to next character's address
940#    bne $t0,$t1,loop_hashCode_String # loop back if more
944:done_hashCode_String:    

    # push int on stack
944#    move $t0, $t2 # put $t2 in return slot
948#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
952:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
952#    subu $sp,4
956#    sw $ra,($sp)
    
    # get hash value
960#    lw $t2,-12($s2) # vtable address
964#    lw $t0,($t2) # method address
968#    jalr $t0
972#    subu $sp,8 # push result (int in $t0) on stack
976#    sw $s5,4($sp)
980#    sw $t0,($sp)

    # compute print-size of hash value
984#    li $t0, 1
988#    lw $t1, ($sp)
992#    srl $t1,$t1,4
996#    beq $t1,$zero,toString_skip_loop
1000:toString_loop_top:
1000#    addu $t0,1
1004#    srl $t1,$t1,4
1008#    bne $t1,$zero,toString_loop_top
1012:toString_skip_loop:
1012#    subu $sp,8
1016#    sw $s5,4($sp)
1020#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1024#    lw $t2,-12($s2) # vtable address
1028#    move $t0,$t2
1032:toString_checkTagBit:
1032#    subu $t0,1
1036#    lb $t1,($t0)
1040#    and $t1,0x80
1041##...lui $at,0
1045##...ori $at,$at,0x80
1049##...and $t1,$t1,$at
1052#    beq $t1,$zero,toString_checkTagBit
1056#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1060#    subu $sp,8
1064#    sw $t1,($sp)
1068#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1072#    move $s7,$zero # -4 offset header word
1076#    lw $t4,8($sp) # bytes for hash value
1080#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1084#    addu $t4,8
1088#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1092#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1096#    li $t0,CLASS_String # store string vtable address into ...
1100#    sw $t0,-12($s7) # ... -12 offset in object header
1104#    lw $t2,-12($s2) # our object's vtable address
1108#    lw $t5,4($sp) # number characters in prefix
1112#    lw $t1,12($sp) # number of characters in hashcode
1116#    addu $t3,$t1,$t5 # number of characters in string ...
1120#    addu $t3,1 # ... including the '@' character
1124#    subu $t0,$zero,$t3 # store negated length into ...
