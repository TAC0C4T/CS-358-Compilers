1685##...sltu $at,$t1,$t2
1689##...beq $at,$zero,3936
1692#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

1696:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

1696#    jal readLogicalChar # read next character
1700#    subu $t1,$v0,'0' # convert digit to 0-9 value
1704#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
1705##...sltu $at,$t1,$t2
