    ###### end outer loop to copy all stack-direct objects ######

    #############################################################
    # We have finished processing the stack elements.  Now we need
    # to update elements in the heap itself. This may itself involve
    # moving additional objects
    #############################################################

    #########################################################
    # At this point:
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # We want to set things up so that in addition:
    # - $t0 is the "trailing finger", containing the address
    #   of the first slot in target space that we have yet
    #   to process.
    # Then during processing:
    # - $t1 will contain the contents of the heap slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # And when we're actually copying an object:
    # - $t2 will contain pointer to the target object
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - available for use: $s0
    ##########################################################

    # set $t0 to be at the beginning of target-space
3832#    lw $t1,cur_seg
3836#    la $t0,seg0_start
3840#    beq $t1,$zero,gcSkip4
3844#    la $t0,seg1_start
3845##...lui $t0,16
3849##...addiu $t0,$t0,5092


3852:  gcSkip4:

    # if there were no objects put into the heap during stack
    # processing, we're done, so go finish up
3852#    bgeu $t0,$s3,gcFinishUp
3853##...sltu $at,$t0,$s3
3857##...beq $at,$zero,4148

    ###### begin outer loop to copy all non-stack-direct objects ######

3860:  gcHeapCopyLoop:
    # get data count for object; swap header-word with first word
    # of object so that they're back in the right place
3860#    lw $t1,($t0) # (what will be) first header word for current object
3864#    move $t2,$t1 # number data bytes in object (poss. w/hash bits)
3868#    bge $t2,$zero,gcSkip4a # are there hash bits?
3869##...slt $at,$t2,$zero
3873##...beq $at,$zero,3888
3876#    and $t2,0xff # mask off hash bits
3877##...lui $at,0
3881##...ori $at,$at,0xff
3885##...and $t2,$t2,$at
3888:gcSkip4a:    
3888#    sll $t2,$t2,2 # # data bytes
3892#    addu $t2,$t2,8 # to skip header words
3896#    addu $t2,$t0,$t2 # pointer to new object
3900#    lw $t3,-8($t2) # word to swap
3904#    sw $t1,-8($t2) # store header word
3908#    sw $t3,($t0) # restore first word of object

    ################################################
    # at this point:
    # - $t2 contains the pointer to our new object
    ################################################

    # check if we have a data array
3912#    lw $t1,-12($t2) # vtable pointer
3916#    li $t0,dataArrayVTableStart # address of vtable for first data array
3920#    blt $t1,$t0,gcNotDataArray # if data array, no more xforming to do
3921##...slt $at,$t1,$t0
3925##...bne $at,$zero,3944

    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
3928:  skipToNextObj:
3928#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
3932#    sll $t1,$t1,2 # convert to byte-count
3936#    addu $t0,$t2,$t1 # skip over object
3940#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
3944:  gcNotDataArray:
3944#    lw $t3,-4($t2) # # object words (negative treated as zero)
3948#    bge $t3,$zero,gcH2Neg2
3949##...slt $at,$t3,$zero
3953##...beq $at,$zero,3960
3956#    move $t3,$zero
3960:  gcH2Neg2:
3960#    sll $t3,$t3,2 # # object bytes
3964#    move $t0,$t2 # address of first pointer in object
3968#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
3972#    beq $t0,$s1,gcTestIterDone2
    
3976:  gcNextPointerInObject:
    # get pointer from object
3976#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
3980#    bleu $t1,$t6,gcGoNextPointerSlot
3981##...sltu $at,$t6,$t1
3985##...beq $at,$zero,4128
3988#    bgtu $t1,$t7,gcGoNextPointerSlot
3989##...sltu $at,$t7,$t1
3993##...bne $at,$zero,4128

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
3996#    lw $t8,-8($t1) # possible forwarding tag
4000#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
4004#    lw $t8,-4($t1) # forwarding pointer: object's new address
4008#    sw $t8,($t0) # update pointer in object
4012#    j gcGoNextPointerSlot # do next iteration

4016:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
4016#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
4017##...slt $at,$t8,$zero
4021##...beq $at,$zero,4036
4024#    and $t8,0xff # mask off hash bits
4025##...lui $at,0
4029##...ori $at,$at,0xff
4033##...and $t8,$t8,$at

4036:  gcSkip5:
4036#    sll $t8,$t8,2 # bytes in negative-offset portion ...
4040#    addu $t8,$t8,8 # ... add in bytes for header-words
4044#    subu $t4,$t1,$t8 # address of first word of source object
4048#    lw $t3,-4($t1) # # words in positive-offset portion
4052#    bge $t3,$zero,gcNoNeg
4053##...slt $at,$t3,$zero
4057##...beq $at,$zero,4064
4060#    move $t3,$zero # negative treated as zero
4064:  gcNoNeg:
4064#    sll $t3,$t3,2 # bytes in negative-offset portion
4068#    addu $t3,$t3,$t1 # address one word past last word of source

4072#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
4076#    lw $s0,($t4)
4080#    lw $t9,-8($t1)
4084#    sw $t9,($t4)
4088#    sw $s0,-8($t1)

    # copy all source bytes to the target
4092:  gCinnerCopy2:
4092#    lw $s0,($t4)
4096#    sw $s0,($s3)
4100#    addu $t4,$t4,4
4104#    addu $s3,$s3,4
4108#    bltu $t4,$t3,gCinnerCopy2
4109##...sltu $at,$t4,$t3
4113##...bne $at,$zero,4092

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
4116#    sw $zero,-8($t1) # 0 in first header-slot
4120#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
4124#    sw $t8,($t0)

4128:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
4128#    addu $t0,$t0,4
4132#    bltu $t0,$s1,gcNextPointerInObject
4133##...sltu $at,$t0,$s1
4137##...bne $at,$zero,3976

4140:  gcTestIterDone2:
4140#    bltu $t0,$s3,gcHeapCopyLoop
4141##...sltu $at,$t0,$s3
4145##...bne $at,$zero,3860

    ###### end outer loop to copy all non-stack-direct objects ######

4148:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
4148#    lw $s2,($sp)
4152#    addu $sp,$sp,4

    # mark us as having already GC'd
4156#    move $t5,$s5

    # go try and allocate again
4160#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4164:vm_init:

    # mark bottom of stack
4164#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4168#    move $s2,$zero

    #set up the "five" register
4172#    li $s5,5

4176#    la $s3,seg0_start
4180#    la $s4,seg0_end
4181##...lui $s4,16
4185##...addiu $s4,$s4,5092
    
    # return
4188#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4192:divide:
    # get parameters; abort if divisor zero
4192#    lw $t0,($sp)
4196#    lw $t1,8($sp)
4200#    beq $t0,$zero,divByZeroError
    
    # perform division
4204#    div $t1,$t0
4208#    mflo $t0

    # store result, adjust stack and return
4212#    addu $sp,$sp,8 # adjust stack
4216#    sw $t0,($sp) # store result
4220#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4224:remainder:
    # get parameters; abort if divisor zero
4224#    lw $t0,($sp)
4228#    lw $t1,8($sp)
4232#    beq $t0,$zero,divByZeroError
    
    # perform division
4236#    div $t1,$t0
4240#    mfhi $t0

    # store result, adjust stack and return
4244#    addu $sp,$sp,8 # adjust stack
4248#    sw $t0,($sp) # store result
4252#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4256:checkCast:
    # get object, allow immediately if null
4256#    lw $t2,($sp)
4260#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4264#    lw $t2,-12($t2) # vtable address
4268#    bge $t2,$t1,castException
4269##...slt $at,$t2,$t1
4273##...beq $at,$zero,4408
4276#    blt $t2,$t0,castException
4277##...slt $at,$t2,$t0
4281##...bne $at,$zero,4408
    
    # return, leaving object unchanged on stack
4284:  checkCastReturn:    
4284#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4288:instanceOf:
    # get object, go return false if null
4288#    lw $t2,($sp)
4292#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4296#    lw $t2,-12($t2) # vtable address
4300#    sge $t0,$t2,$t0 # are we >= the lower limit?
4301##...slt $t0,$t2,$t0
4305##...xori $t0,$t0,0x1
4308#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4312#    and $t2,$t0,$t1
4316#    sw $t2,($sp)
4320:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4320#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4324:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4324#    li $v0,4 # syscall-code for print-string
4328#    syscall
4332:exit:
    # print termination message
4332#    li $v0,4 # syscall-code for print-string
4336#    la $a0,exitString
4340#    syscall

    # terminate execution
4344#    li $v0,10 #syscall-code for "exit"
4348#    syscall

4352:outOfHeapMemory:
4352#    la $a0,heapMemoryMsg
4356#    j exitError
4360:divByZeroError:
4360#    la $a0,divByZeroMsg
4364#    j exitError
4368:strIndexOutOfBounds:
4368#    la $a0,strIndexOutOfBoundsMsg
4372#    j exitError
4376:arrayIndexOutOfBounds:
4376#    la $a0,arrayIndexOutOfBoundsMsg
4380#    j exitError
4384:arraySizeOutOfBounds:
4384#    la $a0,arraySizeOutOfBoundsMsg
4388#    j exitError
4392:nullPtrException:
4392#    la $a0,nullPtrExceptionMsg
4396#    j exitError
4400:badIntegerFormat:
4400#    la $a0,badIntegerFormatMsg
4404#    j exitError
4408:castException:
4408#    la $a0,castExceptionMsg
4412#    j exitError
############## data section ################
    .data
4728:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4744:cur_seg:
    .word 0

4748:lastCharRead:
    .word -2 # -2 => no buffered character
4752:prevHashConstant:
    .word 0x2785173c
4756:gcCount:
    .word 0

4760:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4787:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4810:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4845:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4879:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4912:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4943:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4991:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
5012:gcMsg: 
      .asciiz "\nGC!\n"
5018:gcCountMsg: 
      .asciiz "Number of garbage collections: "

5050:nullStr:
    .asciiz "null"
5055:trueString:
    .asciiz "true"
5060:falseString:
    .asciiz "false"
5066:exitString:
    .ascii "Program terminated."
    #### "falls through" here
5085:newlineString:
    .asciiz "\n"
    
    .align 2
5088:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

5092:seg0_start:
    .space 0x100000
1053668:seg0_end:
1053668:seg1_start:
    .space 0x100000
2102244:seg1_end:
