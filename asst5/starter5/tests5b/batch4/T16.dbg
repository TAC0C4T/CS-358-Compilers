###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1820:mth_readLine_Lib:
    
1820#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1824#    sw $ra, 4($sp) # save $ra
1828#    move $t1,$sp # save "original" sp

1832:  doRead:

    # read the character
1832#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1836#    subu $t2,$v0,13
1840#    bne $t2,$zero,notReturnRL
1844#    jal readLogicalChar
1848#    subu $t2,$v0,10 # check for newline
1852#    beq $t2,$zero,foundNewLine
1856#    sw $v0,lastCharRead # push back character into queue
1860#    j foundNewLine # go process the line

1864:  notReturnRL:

    # at this point, $v0 has our character

1864#    subu $t0,$v0,10
1868#    beq $t0,$zero,foundNewLine
1872#    blt $v0,$zero,foundEof
1873##...slt $at,$v0,$zero
1877##...bne $at,$zero,1892

    # we have a character, so push it onto stack
1880#    subu $sp,$sp,4
1884#    sw $v0,($sp)

    # loop back up to get next character
1888#    j doRead

1892:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1892#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1896#    li $s7, 0 # return-value: null
1900#    j rlReturn # return

1904:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1904#    subu $t0,$t1,$sp # number of chars we read (times 4)
1908#    srl $s6,$t0,2 # number of words on stack with chars
1912#    subu $sp,$sp,4 # push char-count ...
1916#    sw $s6,($sp) # ... onto stack
1920#    addu $t2,$t0,5 # GC tag, incl. for count-word
1924#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1928#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1932#    srl $s6,$s6,2  # data words in object
1936#    move $s7,$zero # object words in object
1940#    jal newObject  # allocate space
    
    # store header words
1944#    la $t0,CLASS_String
1948#    sw $t0,-12($s7)# store class tag (String) into object
1952#    lw $t2,4($sp) # char-count
1956#    sll $t1,$t2,2 # 4 times number of chars
1960#    subu $t2,$zero,$t2 # negative of char-count
1964#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1968#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1972#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1973##...slt $at,$t0,$zero
1977##...beq $at,$zero,1996
1980#    and $t0,0xff # mask off object's hash value ...
1981##...lui $at,0
1985##...ori $at,$at,0xff
1989##...and $t0,$t0,$at
1992#    sw $t0,-8($s7) # ... and store back into -8 header-word
1996:  skipMask_readLine:

1996#    sll $t0,$t0,2 # data bytes in object
2000#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
2004#    subu $t0,$t0,$t2 # place to store last character (plus 9)
2008#    addu $sp,$sp,8 # pop redundant object-pointer and count
2012#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

2016#    beq $sp,$t1,rlReturn
2020:  charCopyLoop:
2020#    lw $t2,($sp)
2024#    sb $t2,-9($t0)
2028#    addu $sp,$sp,4
2032#    subu $t0,$t0,1
2036#    bne $sp,$t1,charCopyLoop
2040:  rlReturn:

2040#    lw $ra, 4($sp)
2044#    addu $sp, 8   # pop $ra and pointless word off stack
2048#    move $t0, $s7 # return string we allocated in $s7
2052#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
2056:mth_readInt_Lib:

    # save $ra by pushing onto stack
2056#    subu $sp,$sp,4
2060#    sw $ra,($sp)

2064:  riSkipWhiteLoop:
    # read a character
2064#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
2068#    subu $t0,$v0,32
2072#    bgt $t0,$zero,nonWhite
2073##...slt $at,$zero,$t0
2077##...bne $at,$zero,2120
2080#    beq $t0,$zero,riSkipWhiteLoop # start over if space
2084#    subu $t0,$v0,10
2088#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
2092#    subu $t0,$v0,9
2096#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
2100#    subu $t0,$v0,13
2104#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
2108#    subu $t0,$v0,12
2112#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
2116#    j badIntegerFormat # illegal integer char: abort program

2120:  nonWhite:
2120#    subu $t0,$v0,'-'
2124#    li $t4,1 # final multiplier
2128#    bne $t0,$zero,helpReadInt # go read
2132#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
2136#    jal readLogicalChar

2140:  helpReadInt:
2140#    li $t2,10
2144#    subu $t1,$v0,'0' # convert digit to 0-9 value
2148#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
2149##...sltu $at,$t1,$t2
2153##...beq $at,$zero,4400
2156#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

2160:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

2160#    jal readLogicalChar # read next character
2164#    subu $t1,$v0,'0' # convert digit to 0-9 value
2168#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
2169##...sltu $at,$t1,$t2
2173##...beq $at,$zero,2192

2176#    mul $t3,$t3,$t2 # multiply old value by 10
2177##...mult $t3,$t2
2181##...mflo $t3
2184#    addu $t3,$t3,$t1 # add in value of new digit
2188#    j digitLoop

2192:  doneDigitLoop:

    # "push back" unused character into queue
2192#    sw $v0,lastCharRead

    # restore return address
2196#    lw $ra,($sp)
2200#    addu $sp, 4

    # multiply by sign and put return value in $t0
2204#    mult $t3,$t4 # multiply to account for poss. minus sign
2208#    mflo $t3
2212#    move $t0, $t3
    
    # return
2216#    jr $ra

###################################################################
# readChar() - library method (class Lib)
# - reads a single character from standard input
# - returns the integer that is the encoding of the character
# - returns -1 if end of file was encountered
