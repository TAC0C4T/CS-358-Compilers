##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1312:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
1312#    lw $t0,-8($s2) # get word with hash bits from this
1316#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
1320#    addu $t0,$t1

1324#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1328:mth_equals_Object:
1328#    move $t0,$s2 # first pointer (this)
1332#    lw $t1,($sp) # second pointer
1336#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
1337##...subu $at,$t0,$t1
1341##...sltiu $t0,$at,1

1344#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1348:mth_hashCode_String:
1348#    move $t0,$s2 # put this pointer in t0

1352#    li $t2,0 # current hash value
1356#    lw $t1,-4($t0) # negative of number of characters in string
1360#    beq $t1,$zero,done_hashCode_String # if zero length => done
1364#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
1368#    and $t0,0xfffffffc # adjust for padding
1369##...lui $at,65535
1373##...ori $at,$at,0xfffc
1377##...and $t0,$t0,$at
1380#    subu $t1,$t0,$t1 # address at end of string +12
1384:loop_hashCode_String:    
1384#    sll $t4,$t2,5 # multiply by 32
1388#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
1392#    lbu $t3,-12($t0) # current character
1396#    addu $t2,$t3 # add in current character
1400#    addu $t0,1 # go to next character's address
1404#    bne $t0,$t1,loop_hashCode_String # loop back if more
1408:done_hashCode_String:    

    # push int on stack
1408#    move $t0, $t2 # put $t2 in return slot
1412#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1416:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1416#    subu $sp,4
1420#    sw $ra,($sp)
    
    # get hash value
1424#    lw $t2,-12($s2) # vtable address
1428#    lw $t0,($t2) # method address
1432#    jalr $t0
1436#    subu $sp,8 # push result (int in $t0) on stack
1440#    sw $s5,4($sp)
1444#    sw $t0,($sp)

    # compute print-size of hash value
1448#    li $t0, 1
1452#    lw $t1, ($sp)
1456#    srl $t1,$t1,4
1460#    beq $t1,$zero,toString_skip_loop
1464:toString_loop_top:
1464#    addu $t0,1
1468#    srl $t1,$t1,4
1472#    bne $t1,$zero,toString_loop_top
1476:toString_skip_loop:
1476#    subu $sp,8
1480#    sw $s5,4($sp)
1484#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1488#    lw $t2,-12($s2) # vtable address
1492#    move $t0,$t2
1496:toString_checkTagBit:
1496#    subu $t0,1
1500#    lb $t1,($t0)
1504#    and $t1,0x80
1505##...lui $at,0
1509##...ori $at,$at,0x80
1513##...and $t1,$t1,$at
1516#    beq $t1,$zero,toString_checkTagBit
1520#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1524#    subu $sp,8
1528#    sw $t1,($sp)
1532#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1536#    move $s7,$zero # -4 offset header word
1540#    lw $t4,8($sp) # bytes for hash value
1544#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1548#    addu $t4,8
1552#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1556#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1560#    li $t0,CLASS_String # store string vtable address into ...
1564#    sw $t0,-12($s7) # ... -12 offset in object header
1568#    lw $t2,-12($s2) # our object's vtable address
1572#    lw $t5,4($sp) # number characters in prefix
1576#    lw $t1,12($sp) # number of characters in hashcode
1580#    addu $t3,$t1,$t5 # number of characters in string ...
1584#    addu $t3,1 # ... including the '@' character
1588#    subu $t0,$zero,$t3 # store negated length into ...
1592#    sw $t0,-4($s7) # ... -4 offset header word
1596#    lw $t0,-8($s7) # get -8 offset header-word
1600#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1601##...slt $at,$t0,$zero
1605##...beq $at,$zero,1624
1608#    and $t0,0xff # mask off object's hash value ...
1609##...lui $at,0
1613##...ori $at,$at,0xff
1617##...and $t0,$t0,$at
1620#    sw $t0,-8($s7) # ... and store back into -8 header-word
1624:skipMask_toString:
1624#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1628#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1632#    subu $t4,$t2,$t5
1636:toString_copyLoop:    
1636#    lb $t3,($t4)
1640#    and $t3,0x7f # mask off sign bit (in case first word)
1641##...lui $at,0
1645##...ori $at,$at,0x7f
1649##...and $t3,$t3,$at
1652#    sb $t3,-8($t0)
1656#    addu $t4,1
1660#    addu $t0,1
1664#    blt $t4,$t2,toString_copyLoop
1665##...slt $at,$t4,$t2
1669##...bne $at,$zero,1636

    # copy the '@' sign
1672#    li $t3,'@'
1676#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1680#    addu $t2,$t0,$t1 # address of last byte in string to store +8
1684#    lw $t3,20($sp) # hash code to print
1688:toString_hashCopyLoop:
1688#    and $t4,$t3,0xf
1692#    srl $t3,4
1696#    lb $t4,hexChars($t4)
1700#    sb $t4,-8($t2)
1704#    subu $t2,$t2,1
1708#    bgt $t2,$t0,toString_hashCopyLoop
1709##...slt $at,$t0,$t2
1713##...bne $at,$zero,1688

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
1716#    addu $sp,28
1720#    lw $ra,($sp)
1724#    addu $sp,4
1728#    move $t0, $s7 # return string we created
1732#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
1736:mth_equals_String:
    
    # quick test for obvious false
1736#    lw $t0,($sp) # second parameter
1740#    beq $t0,$zero,goEsFalse # go return false if null
1744#    lw $t1,-12($t0) # vtable pointer
1748#    la $t2,CLASS_String # string vtable pointer
1752#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
1756#    subu $sp,12
1760#    sw $ra,8($sp)
1764#    sw $s2,4($sp)
1768#    sw $t0,($sp)
1772#    jal mth_compareTo_String
1776#    lw $s2, 4($sp) #restore this pointer and pop parameters
1780#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
1784#    seq $t0,$t0,$zero
1785##...subu $at,$t0,$zero
1789##...sltiu $t0,$at,1

    # pop return address and return $t0
1792#    lw $ra,($sp)
1796#    addu $sp,4

1800#    jr $ra # return
    
1804:goEsFalse:
    # put 0 in $t0 and return
1804#    li $t0, 0
1808#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
1812:mth_toString_String:
    #we are a string, so return this.
1812#    move $t0, $s2
1816#    jr $ra
