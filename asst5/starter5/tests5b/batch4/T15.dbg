.globl main
0:main:
0#  jal vm_init
4#  li $v0, 10
8#  syscall
12:mth_main_Main:
12#  li $t0, 5
16#  subu $sp, $sp, 8
20#  sw $s5, 4($sp)
24#  sw $t0, 0($sp)
28#  li $t0, 0
32#  subu $sp, $sp, 8
36#  sw $s5, 4($sp)
40#  sw $t0, 0($sp)
44#  lw $t2, ($sp)
48#  addu $sp, $sp, 4
52#  lw $t1, ($sp)
56#  addu $sp, $sp, 4
60#  sgt $t0, $t1, $t2
64#  subu $sp, $sp, 4
68#  sw $t0, ($sp)
72#  la $t0, strLit_7
76#  subu $sp, $sp, 4
80#  sw $t0, ($sp)
84#  subu $sp, $sp, 4
88#  sw $s2, ($sp)
92#  la $t0, strLit_12
96#  subu $sp, $sp, 4
100#  sw $t0, ($sp)
104#  subu $sp, $sp, 4
108#  sw $s2, ($sp)
112#  li $t0, 0
116#  subu $sp, $sp, 8
120#  sw $s5, 4($sp)
124#  sw $t0, 0($sp)
128#  lw $t2, ($sp)
132#  addu $sp, $sp, 4
136#  lw $t1, ($sp)
140#  addu $sp, $sp, 4
144#  sgt $t0, $t1, $t2
148#  subu $sp, $sp, 4
152#  sw $t0, ($sp)
156#  la $t0, strLit_21
160#  subu $sp, $sp, 4
164#  sw $t0, ($sp)
168#  subu $sp, $sp, 4
172#  sw $s2, ($sp)
176#  la $t0, strLit_26
180#  subu $sp, $sp, 4
184#  sw $t0, ($sp)
188#  subu $sp, $sp, 4
192#  sw $s2, ($sp)
196#  jr $ra
##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
200:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
200#    lw $t0,-8($s2) # get word with hash bits from this
204#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
208#    addu $t0,$t1

212#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
216:mth_equals_Object:
216#    move $t0,$s2 # first pointer (this)
220#    lw $t1,($sp) # second pointer
224#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
225##...subu $at,$t0,$t1
229##...sltiu $t0,$at,1

232#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
236:mth_hashCode_String:
236#    move $t0,$s2 # put this pointer in t0

240#    li $t2,0 # current hash value
244#    lw $t1,-4($t0) # negative of number of characters in string
248#    beq $t1,$zero,done_hashCode_String # if zero length => done
252#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
256#    and $t0,0xfffffffc # adjust for padding
257##...lui $at,65535
261##...ori $at,$at,0xfffc
265##...and $t0,$t0,$at
268#    subu $t1,$t0,$t1 # address at end of string +12
272:loop_hashCode_String:    
272#    sll $t4,$t2,5 # multiply by 32
276#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
280#    lbu $t3,-12($t0) # current character
284#    addu $t2,$t3 # add in current character
288#    addu $t0,1 # go to next character's address
292#    bne $t0,$t1,loop_hashCode_String # loop back if more
296:done_hashCode_String:    

    # push int on stack
296#    move $t0, $t2 # put $t2 in return slot
300#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
304:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
304#    subu $sp,4
308#    sw $ra,($sp)
    
    # get hash value
312#    lw $t2,-12($s2) # vtable address
316#    lw $t0,($t2) # method address
320#    jalr $t0
324#    subu $sp,8 # push result (int in $t0) on stack
328#    sw $s5,4($sp)
332#    sw $t0,($sp)

    # compute print-size of hash value
336#    li $t0, 1
340#    lw $t1, ($sp)
344#    srl $t1,$t1,4
348#    beq $t1,$zero,toString_skip_loop
352:toString_loop_top:
352#    addu $t0,1
356#    srl $t1,$t1,4
360#    bne $t1,$zero,toString_loop_top
364:toString_skip_loop:
364#    subu $sp,8
368#    sw $s5,4($sp)
372#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
376#    lw $t2,-12($s2) # vtable address
380#    move $t0,$t2
384:toString_checkTagBit:
384#    subu $t0,1
388#    lb $t1,($t0)
392#    and $t1,0x80
393##...lui $at,0
397##...ori $at,$at,0x80
401##...and $t1,$t1,$at
404#    beq $t1,$zero,toString_checkTagBit
408#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
412#    subu $sp,8
416#    sw $t1,($sp)
420#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
424#    move $s7,$zero # -4 offset header word
428#    lw $t4,8($sp) # bytes for hash value
432#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
436#    addu $t4,8
440#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
444#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

448#    li $t0,CLASS_String # store string vtable address into ...
452#    sw $t0,-12($s7) # ... -12 offset in object header
456#    lw $t2,-12($s2) # our object's vtable address
460#    lw $t5,4($sp) # number characters in prefix
464#    lw $t1,12($sp) # number of characters in hashcode
468#    addu $t3,$t1,$t5 # number of characters in string ...
472#    addu $t3,1 # ... including the '@' character
476#    subu $t0,$zero,$t3 # store negated length into ...
480#    sw $t0,-4($s7) # ... -4 offset header word
484#    lw $t0,-8($s7) # get -8 offset header-word
488#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
489##...slt $at,$t0,$zero
493##...beq $at,$zero,512
496#    and $t0,0xff # mask off object's hash value ...
497##...lui $at,0
501##...ori $at,$at,0xff
505##...and $t0,$t0,$at
508#    sw $t0,-8($s7) # ... and store back into -8 header-word
512:skipMask_toString:
512#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
516#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
520#    subu $t4,$t2,$t5
524:toString_copyLoop:    
524#    lb $t3,($t4)
528#    and $t3,0x7f # mask off sign bit (in case first word)
529##...lui $at,0
533##...ori $at,$at,0x7f
537##...and $t3,$t3,$at
540#    sb $t3,-8($t0)
544#    addu $t4,1
548#    addu $t0,1
552#    blt $t4,$t2,toString_copyLoop
553##...slt $at,$t4,$t2
557##...bne $at,$zero,524

    # copy the '@' sign
560#    li $t3,'@'
564#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
568#    addu $t2,$t0,$t1 # address of last byte in string to store +8
572#    lw $t3,20($sp) # hash code to print
576:toString_hashCopyLoop:
576#    and $t4,$t3,0xf
580#    srl $t3,4
584#    lb $t4,hexChars($t4)
588#    sb $t4,-8($t2)
592#    subu $t2,$t2,1
596#    bgt $t2,$t0,toString_hashCopyLoop
597##...slt $at,$t0,$t2
601##...bne $at,$zero,576

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
604#    addu $sp,28
608#    lw $ra,($sp)
612#    addu $sp,4
616#    move $t0, $s7 # return string we created
620#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
624:mth_equals_String:
    
    # quick test for obvious false
624#    lw $t0,($sp) # second parameter
628#    beq $t0,$zero,goEsFalse # go return false if null
632#    lw $t1,-12($t0) # vtable pointer
636#    la $t2,CLASS_String # string vtable pointer
640#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
644#    subu $sp,12
648#    sw $ra,8($sp)
652#    sw $s2,4($sp)
656#    sw $t0,($sp)
660#    jal mth_compareTo_String
664#    lw $s2, 4($sp) #restore this pointer and pop parameters
668#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
672#    seq $t0,$t0,$zero
673##...subu $at,$t0,$zero
677##...sltiu $t0,$at,1

    # pop return address and return $t0
680#    lw $ra,($sp)
684#    addu $sp,4

688#    jr $ra # return
    
692:goEsFalse:
    # put 0 in $t0 and return
692#    li $t0, 0
696#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
700:mth_toString_String:
    #we are a string, so return this.
700#    move $t0, $s2
704#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
708:mth_readLine_Lib:
    
708#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
712#    sw $ra, 4($sp) # save $ra
716#    move $t1,$sp # save "original" sp

720:  doRead:

    # read the character
720#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
724#    subu $t2,$v0,13
728#    bne $t2,$zero,notReturnRL
732#    jal readLogicalChar
736#    subu $t2,$v0,10 # check for newline
740#    beq $t2,$zero,foundNewLine
