########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3052:vm_init:

    # mark bottom of stack
3052#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3056#    move $s2,$zero

    #set up the "five" register
3060#    li $s5,5

3064#    la $s3,seg0_start
3068#    la $s4,seg0_end
3069##...lui $s4,16
3073##...addiu $s4,$s4,3912
    
    # return
3076#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3080:divide:
    # get parameters; abort if divisor zero
3080#    lw $t0,($sp)
3084#    lw $t1,8($sp)
3088#    beq $t0,$zero,divByZeroError
    
    # perform division
3092#    div $t1,$t0
3096#    mflo $t0

    # store result, adjust stack and return
3100#    addu $sp,$sp,8 # adjust stack
3104#    sw $t0,($sp) # store result
3108#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3112:remainder:
    # get parameters; abort if divisor zero
3112#    lw $t0,($sp)
3116#    lw $t1,8($sp)
3120#    beq $t0,$zero,divByZeroError
    
    # perform division
3124#    div $t1,$t0
3128#    mfhi $t0

    # store result, adjust stack and return
3132#    addu $sp,$sp,8 # adjust stack
3136#    sw $t0,($sp) # store result
3140#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3144:checkCast:
    # get object, allow immediately if null
3144#    lw $t2,($sp)
3148#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3152#    lw $t2,-12($t2) # vtable address
3156#    bge $t2,$t1,castException
3157##...slt $at,$t2,$t1
3161##...beq $at,$zero,3296
3164#    blt $t2,$t0,castException
3165##...slt $at,$t2,$t0
3169##...bne $at,$zero,3296
    
    # return, leaving object unchanged on stack
3172:  checkCastReturn:    
3172#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3176:instanceOf:
    # get object, go return false if null
3176#    lw $t2,($sp)
3180#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3184#    lw $t2,-12($t2) # vtable address
3188#    sge $t0,$t2,$t0 # are we >= the lower limit?
3189##...slt $t0,$t2,$t0
3193##...xori $t0,$t0,0x1
3196#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3200#    and $t2,$t0,$t1
3204#    sw $t2,($sp)
3208:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3208#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3212:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3212#    li $v0,4 # syscall-code for print-string
3216#    syscall
3220:exit:
    # print termination message
3220#    li $v0,4 # syscall-code for print-string
3224#    la $a0,exitString
3228#    syscall

    # terminate execution
3232#    li $v0,10 #syscall-code for "exit"
3236#    syscall

3240:outOfHeapMemory:
3240#    la $a0,heapMemoryMsg
3244#    j exitError
3248:divByZeroError:
3248#    la $a0,divByZeroMsg
3252#    j exitError
3256:strIndexOutOfBounds:
3256#    la $a0,strIndexOutOfBoundsMsg
3260#    j exitError
3264:arrayIndexOutOfBounds:
3264#    la $a0,arrayIndexOutOfBoundsMsg
3268#    j exitError
3272:arraySizeOutOfBounds:
3272#    la $a0,arraySizeOutOfBoundsMsg
3276#    j exitError
3280:nullPtrException:
3280#    la $a0,nullPtrExceptionMsg
3284#    j exitError
3288:badIntegerFormat:
3288#    la $a0,badIntegerFormatMsg
3292#    j exitError
3296:castException:
3296#    la $a0,castExceptionMsg
3300#    j exitError
############## data section ################
    .data
