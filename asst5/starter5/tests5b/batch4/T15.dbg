972#    subu $t0,$v0,10
976#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
980#    subu $t0,$v0,9
984#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
988#    subu $t0,$v0,13
992#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
996#    subu $t0,$v0,12
1000#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1004#    j badIntegerFormat # illegal integer char: abort program
