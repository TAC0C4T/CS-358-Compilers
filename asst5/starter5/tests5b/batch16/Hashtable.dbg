###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
3968:mth_readLine_Lib:
    
3968#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
3972#    sw $ra, 4($sp) # save $ra
3976#    move $t1,$sp # save "original" sp

3980:  doRead:

    # read the character
3980#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
3984#    subu $t2,$v0,13
3988#    bne $t2,$zero,notReturnRL
3992#    jal readLogicalChar
3996#    subu $t2,$v0,10 # check for newline
4000#    beq $t2,$zero,foundNewLine
4004#    sw $v0,lastCharRead # push back character into queue
4008#    j foundNewLine # go process the line

4012:  notReturnRL:

    # at this point, $v0 has our character

4012#    subu $t0,$v0,10
4016#    beq $t0,$zero,foundNewLine
4020#    blt $v0,$zero,foundEof
4021##...slt $at,$v0,$zero
4025##...bne $at,$zero,4040

    # we have a character, so push it onto stack
4028#    subu $sp,$sp,4
4032#    sw $v0,($sp)

    # loop back up to get next character
4036#    j doRead

4040:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
4040#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
4044#    li $s7, 0 # return-value: null
4048#    j rlReturn # return

4052:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
4052#    subu $t0,$t1,$sp # number of chars we read (times 4)
4056#    srl $s6,$t0,2 # number of words on stack with chars
4060#    subu $sp,$sp,4 # push char-count ...
4064#    sw $s6,($sp) # ... onto stack
4068#    addu $t2,$t0,5 # GC tag, incl. for count-word
4072#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
4076#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
4080#    srl $s6,$s6,2  # data words in object
4084#    move $s7,$zero # object words in object
4088#    jal newObject  # allocate space
    
    # store header words
4092#    la $t0,CLASS_String
4096#    sw $t0,-12($s7)# store class tag (String) into object
4100#    lw $t2,4($sp) # char-count
4104#    sll $t1,$t2,2 # 4 times number of chars
4108#    subu $t2,$zero,$t2 # negative of char-count
4112#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
4116#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
4120#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
4121##...slt $at,$t0,$zero
4125##...beq $at,$zero,4144
4128#    and $t0,0xff # mask off object's hash value ...
4129##...lui $at,0
4133##...ori $at,$at,0xff
4137##...and $t0,$t0,$at
4140#    sw $t0,-8($s7) # ... and store back into -8 header-word
4144:  skipMask_readLine:

4144#    sll $t0,$t0,2 # data bytes in object
4148#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
4152#    subu $t0,$t0,$t2 # place to store last character (plus 9)
4156#    addu $sp,$sp,8 # pop redundant object-pointer and count
4160#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack
