4164#    beq $sp,$t1,rlReturn
4168:  charCopyLoop:
4168#    lw $t2,($sp)
4172#    sb $t2,-9($t0)
4176#    addu $sp,$sp,4
4180#    subu $t0,$t0,1
4184#    bne $sp,$t1,charCopyLoop
4188:  rlReturn:

4188#    lw $ra, 4($sp)
4192#    addu $sp, 8   # pop $ra and pointless word off stack
4196#    move $t0, $s7 # return string we allocated in $s7
4200#    jr $ra

