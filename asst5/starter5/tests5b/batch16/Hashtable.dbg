4240#    subu $t0,$v0,9
4244#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
4248#    subu $t0,$v0,13
4252#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
4256#    subu $t0,$v0,12
