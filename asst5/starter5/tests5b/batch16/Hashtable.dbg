##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
3460:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
3460#    lw $t0,-8($s2) # get word with hash bits from this
3464#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
3468#    addu $t0,$t1

3472#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
3476:mth_equals_Object:
3476#    move $t0,$s2 # first pointer (this)
3480#    lw $t1,($sp) # second pointer
3484#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
3485##...subu $at,$t0,$t1
3489##...sltiu $t0,$at,1

3492#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
3496:mth_hashCode_String:
3496#    move $t0,$s2 # put this pointer in t0

3500#    li $t2,0 # current hash value
3504#    lw $t1,-4($t0) # negative of number of characters in string
3508#    beq $t1,$zero,done_hashCode_String # if zero length => done
3512#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
3516#    and $t0,0xfffffffc # adjust for padding
3517##...lui $at,65535
3521##...ori $at,$at,0xfffc
3525##...and $t0,$t0,$at
3528#    subu $t1,$t0,$t1 # address at end of string +12
3532:loop_hashCode_String:    
3532#    sll $t4,$t2,5 # multiply by 32
3536#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
3540#    lbu $t3,-12($t0) # current character
3544#    addu $t2,$t3 # add in current character
3548#    addu $t0,1 # go to next character's address
3552#    bne $t0,$t1,loop_hashCode_String # loop back if more
3556:done_hashCode_String:    

    # push int on stack
3556#    move $t0, $t2 # put $t2 in return slot
3560#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
3564:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
3564#    subu $sp,4
3568#    sw $ra,($sp)
    
    # get hash value
3572#    lw $t2,-12($s2) # vtable address
3576#    lw $t0,($t2) # method address
3580#    jalr $t0
3584#    subu $sp,8 # push result (int in $t0) on stack
3588#    sw $s5,4($sp)
3592#    sw $t0,($sp)

    # compute print-size of hash value
3596#    li $t0, 1
3600#    lw $t1, ($sp)
3604#    srl $t1,$t1,4
3608#    beq $t1,$zero,toString_skip_loop
3612:toString_loop_top:
3612#    addu $t0,1
3616#    srl $t1,$t1,4
3620#    bne $t1,$zero,toString_loop_top
3624:toString_skip_loop:
3624#    subu $sp,8
3628#    sw $s5,4($sp)
3632#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
3636#    lw $t2,-12($s2) # vtable address
3640#    move $t0,$t2
3644:toString_checkTagBit:
3644#    subu $t0,1
3648#    lb $t1,($t0)
3652#    and $t1,0x80
3653##...lui $at,0
3657##...ori $at,$at,0x80
3661##...and $t1,$t1,$at
3664#    beq $t1,$zero,toString_checkTagBit
3668#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
3672#    subu $sp,8
3676#    sw $t1,($sp)
3680#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
3684#    move $s7,$zero # -4 offset header word
3688#    lw $t4,8($sp) # bytes for hash value
3692#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
3696#    addu $t4,8
3700#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
3704#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

3708#    li $t0,CLASS_String # store string vtable address into ...
3712#    sw $t0,-12($s7) # ... -12 offset in object header
3716#    lw $t2,-12($s2) # our object's vtable address
3720#    lw $t5,4($sp) # number characters in prefix
3724#    lw $t1,12($sp) # number of characters in hashcode
3728#    addu $t3,$t1,$t5 # number of characters in string ...
3732#    addu $t3,1 # ... including the '@' character
3736#    subu $t0,$zero,$t3 # store negated length into ...
3740#    sw $t0,-4($s7) # ... -4 offset header word
3744#    lw $t0,-8($s7) # get -8 offset header-word
3748#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
3749##...slt $at,$t0,$zero
3753##...beq $at,$zero,3772
3756#    and $t0,0xff # mask off object's hash value ...
