    # we don't need to swap $s2, 
    # because it's still in the string class.
3904#    subu $sp,12
3908#    sw $ra,8($sp)
3912#    sw $s2,4($sp)
3916#    sw $t0,($sp)
3920#    jal mth_compareTo_String
3924#    lw $s2, 4($sp) #restore this pointer and pop parameters
3928#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
3932#    seq $t0,$t0,$zero
3933##...subu $at,$t0,$zero
3937##...sltiu $t0,$at,1

    # pop return address and return $t0
3940#    lw $ra,($sp)
3944#    addu $sp,4

3948#    jr $ra # return
    
3952:goEsFalse:
    # put 0 in $t0 and return
3952#    li $t0, 0
3956#    jr $ra # return
