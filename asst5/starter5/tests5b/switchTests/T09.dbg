#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2524:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
2524#    lw $t0,-8($s2) # get word with hash bits from this
2528#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
2532#    addu $t0,$t1

2536#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2540:mth_equals_Object:
2540#    move $t0,$s2 # first pointer (this)
2544#    lw $t1,($sp) # second pointer
2548#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
2549##...subu $at,$t0,$t1
2553##...sltiu $t0,$at,1

2556#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2560:mth_hashCode_String:
2560#    move $t0,$s2 # put this pointer in t0

2564#    li $t2,0 # current hash value
2568#    lw $t1,-4($t0) # negative of number of characters in string
2572#    beq $t1,$zero,done_hashCode_String # if zero length => done
2576#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
2580#    and $t0,0xfffffffc # adjust for padding
2581##...lui $at,65535
2585##...ori $at,$at,0xfffc
2589##...and $t0,$t0,$at
2592#    subu $t1,$t0,$t1 # address at end of string +12
2596:loop_hashCode_String:    
2596#    sll $t4,$t2,5 # multiply by 32
2600#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
2604#    lbu $t3,-12($t0) # current character
2608#    addu $t2,$t3 # add in current character
2612#    addu $t0,1 # go to next character's address
2616#    bne $t0,$t1,loop_hashCode_String # loop back if more
2620:done_hashCode_String:    

    # push int on stack
2620#    move $t0, $t2 # put $t2 in return slot
2624#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
2628:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
2628#    subu $sp,4
2632#    sw $ra,($sp)
    
    # get hash value
2636#    lw $t2,-12($s2) # vtable address
2640#    lw $t0,($t2) # method address
2644#    jalr $t0
2648#    subu $sp,8 # push result (int in $t0) on stack
2652#    sw $s5,4($sp)
2656#    sw $t0,($sp)

    # compute print-size of hash value
2660#    li $t0, 1
2664#    lw $t1, ($sp)
2668#    srl $t1,$t1,4
2672#    beq $t1,$zero,toString_skip_loop
2676:toString_loop_top:
2676#    addu $t0,1
2680#    srl $t1,$t1,4
2684#    bne $t1,$zero,toString_loop_top
2688:toString_skip_loop:
2688#    subu $sp,8
2692#    sw $s5,4($sp)
2696#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
2700#    lw $t2,-12($s2) # vtable address
2704#    move $t0,$t2
2708:toString_checkTagBit:
2708#    subu $t0,1
2712#    lb $t1,($t0)
2716#    and $t1,0x80
2717##...lui $at,0
2721##...ori $at,$at,0x80
2725##...and $t1,$t1,$at
2728#    beq $t1,$zero,toString_checkTagBit
2732#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
2736#    subu $sp,8
2740#    sw $t1,($sp)
2744#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
2748#    move $s7,$zero # -4 offset header word
2752#    lw $t4,8($sp) # bytes for hash value
2756#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
2760#    addu $t4,8
2764#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
2768#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

2772#    li $t0,CLASS_String # store string vtable address into ...
2776#    sw $t0,-12($s7) # ... -12 offset in object header
2780#    lw $t2,-12($s2) # our object's vtable address
2784#    lw $t5,4($sp) # number characters in prefix
2788#    lw $t1,12($sp) # number of characters in hashcode
2792#    addu $t3,$t1,$t5 # number of characters in string ...
2796#    addu $t3,1 # ... including the '@' character
2800#    subu $t0,$zero,$t3 # store negated length into ...
2804#    sw $t0,-4($s7) # ... -4 offset header word
2808#    lw $t0,-8($s7) # get -8 offset header-word
2812#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
2813##...slt $at,$t0,$zero
2817##...beq $at,$zero,2836
2820#    and $t0,0xff # mask off object's hash value ...
2821##...lui $at,0
2825##...ori $at,$at,0xff
2829##...and $t0,$t0,$at
2832#    sw $t0,-8($s7) # ... and store back into -8 header-word
2836:skipMask_toString:
2836#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
2840#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
2844#    subu $t4,$t2,$t5
2848:toString_copyLoop:    
2848#    lb $t3,($t4)
2852#    and $t3,0x7f # mask off sign bit (in case first word)
2853##...lui $at,0
2857##...ori $at,$at,0x7f
2861##...and $t3,$t3,$at
2864#    sb $t3,-8($t0)
2868#    addu $t4,1
2872#    addu $t0,1
2876#    blt $t4,$t2,toString_copyLoop
2877##...slt $at,$t4,$t2
2881##...bne $at,$zero,2848

    # copy the '@' sign
2884#    li $t3,'@'
2888#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################
