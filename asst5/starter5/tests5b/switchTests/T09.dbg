3160#    sw $t0,-12($s7)# store class tag (String) into object
3164#    lw $t2,4($sp) # char-count
3168#    sll $t1,$t2,2 # 4 times number of chars
3172#    subu $t2,$zero,$t2 # negative of char-count
3176#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
3180#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
3184#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
