5336#    sw $t8,($t0)

5340:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
5340#    addu $t0,$t0,4
5344#    bltu $t0,$s1,gcNextPointerInObject
5345##...sltu $at,$t0,$s1
5349##...bne $at,$zero,5188

5352:  gcTestIterDone2:
5352#    bltu $t0,$s3,gcHeapCopyLoop
5353##...sltu $at,$t0,$s3
5357##...bne $at,$zero,5072

    ###### end outer loop to copy all non-stack-direct objects ######

5360:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
5360#    lw $s2,($sp)
5364#    addu $sp,$sp,4

    # mark us as having already GC'd
5368#    move $t5,$s5

    # go try and allocate again
5372#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
5376:vm_init:

    # mark bottom of stack
5376#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
5380#    move $s2,$zero

    #set up the "five" register
5384#    li $s5,5

5388#    la $s3,seg0_start
5392#    la $s4,seg0_end
5393##...lui $s4,16
5397##...addiu $s4,$s4,6176
    
    # return
5400#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
5404:divide:
    # get parameters; abort if divisor zero
5404#    lw $t0,($sp)
5408#    lw $t1,8($sp)
5412#    beq $t0,$zero,divByZeroError
    
    # perform division
5416#    div $t1,$t0
5420#    mflo $t0

    # store result, adjust stack and return
5424#    addu $sp,$sp,8 # adjust stack
5428#    sw $t0,($sp) # store result
5432#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
5436:remainder:
    # get parameters; abort if divisor zero
5436#    lw $t0,($sp)
5440#    lw $t1,8($sp)
5444#    beq $t0,$zero,divByZeroError
    
    # perform division
5448#    div $t1,$t0
5452#    mfhi $t0

    # store result, adjust stack and return
5456#    addu $sp,$sp,8 # adjust stack
5460#    sw $t0,($sp) # store result
5464#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
5468:checkCast:
    # get object, allow immediately if null
5468#    lw $t2,($sp)
5472#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
5476#    lw $t2,-12($t2) # vtable address
5480#    bge $t2,$t1,castException
5481##...slt $at,$t2,$t1
5485##...beq $at,$zero,5620
5488#    blt $t2,$t0,castException
5489##...slt $at,$t2,$t0
5493##...bne $at,$zero,5620
    
    # return, leaving object unchanged on stack
5496:  checkCastReturn:    
5496#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
5500:instanceOf:
    # get object, go return false if null
5500#    lw $t2,($sp)
5504#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
5508#    lw $t2,-12($t2) # vtable address
5512#    sge $t0,$t2,$t0 # are we >= the lower limit?
5513##...slt $t0,$t2,$t0
5517##...xori $t0,$t0,0x1
5520#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
5524#    and $t2,$t0,$t1
5528#    sw $t2,($sp)
5532:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
5532#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

5536:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
5536#    li $v0,4 # syscall-code for print-string
5540#    syscall
5544:exit:
    # print termination message
5544#    li $v0,4 # syscall-code for print-string
5548#    la $a0,exitString
5552#    syscall

    # terminate execution
5556#    li $v0,10 #syscall-code for "exit"
5560#    syscall

5564:outOfHeapMemory:
5564#    la $a0,heapMemoryMsg
5568#    j exitError
5572:divByZeroError:
5572#    la $a0,divByZeroMsg
5576#    j exitError
5580:strIndexOutOfBounds:
5580#    la $a0,strIndexOutOfBoundsMsg
5584#    j exitError
5588:arrayIndexOutOfBounds:
5588#    la $a0,arrayIndexOutOfBoundsMsg
5592#    j exitError
5596:arraySizeOutOfBounds:
5596#    la $a0,arraySizeOutOfBoundsMsg
5600#    j exitError
5604:nullPtrException:
5604#    la $a0,nullPtrExceptionMsg
5608#    j exitError
5612:badIntegerFormat:
5612#    la $a0,badIntegerFormatMsg
5616#    j exitError
5620:castException:
5620#    la $a0,castExceptionMsg
5624#    j exitError
############## data section ################
    .data
5812:hexChars:
