########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3368:vm_init:

    # mark bottom of stack
3368#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3372#    move $s2,$zero

    #set up the "five" register
3376#    li $s5,5

3380#    la $s3,seg0_start
3384#    la $s4,seg0_end
3385##...lui $s4,16
3389##...addiu $s4,$s4,4248
    
    # return
3392#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3396:divide:
    # get parameters; abort if divisor zero
3396#    lw $t0,($sp)
3400#    lw $t1,8($sp)
3404#    beq $t0,$zero,divByZeroError
    
    # perform division
3408#    div $t1,$t0
3412#    mflo $t0

    # store result, adjust stack and return
3416#    addu $sp,$sp,8 # adjust stack
3420#    sw $t0,($sp) # store result
3424#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3428:remainder:
    # get parameters; abort if divisor zero
3428#    lw $t0,($sp)
3432#    lw $t1,8($sp)
3436#    beq $t0,$zero,divByZeroError
    
    # perform division
3440#    div $t1,$t0
3444#    mfhi $t0

    # store result, adjust stack and return
3448#    addu $sp,$sp,8 # adjust stack
3452#    sw $t0,($sp) # store result
3456#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3460:checkCast:
    # get object, allow immediately if null
3460#    lw $t2,($sp)
3464#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3468#    lw $t2,-12($t2) # vtable address
3472#    bge $t2,$t1,castException
3473##...slt $at,$t2,$t1
3477##...beq $at,$zero,3612
3480#    blt $t2,$t0,castException
3481##...slt $at,$t2,$t0
3485##...bne $at,$zero,3612
    
    # return, leaving object unchanged on stack
3488:  checkCastReturn:    
3488#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3492:instanceOf:
    # get object, go return false if null
3492#    lw $t2,($sp)
3496#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3500#    lw $t2,-12($t2) # vtable address
3504#    sge $t0,$t2,$t0 # are we >= the lower limit?
3505##...slt $t0,$t2,$t0
3509##...xori $t0,$t0,0x1
3512#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3516#    and $t2,$t0,$t1
3520#    sw $t2,($sp)
3524:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3524#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3528:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3528#    li $v0,4 # syscall-code for print-string
3532#    syscall
3536:exit:
    # print termination message
3536#    li $v0,4 # syscall-code for print-string
3540#    la $a0,exitString
3544#    syscall

    # terminate execution
3548#    li $v0,10 #syscall-code for "exit"
3552#    syscall

3556:outOfHeapMemory:
3556#    la $a0,heapMemoryMsg
3560#    j exitError
3564:divByZeroError:
3564#    la $a0,divByZeroMsg
3568#    j exitError
3572:strIndexOutOfBounds:
3572#    la $a0,strIndexOutOfBoundsMsg
3576#    j exitError
3580:arrayIndexOutOfBounds:
3580#    la $a0,arrayIndexOutOfBoundsMsg
3584#    j exitError
3588:arraySizeOutOfBounds:
3588#    la $a0,arraySizeOutOfBoundsMsg
3592#    j exitError
3596:nullPtrException:
3596#    la $a0,nullPtrExceptionMsg
3600#    j exitError
3604:badIntegerFormat:
3604#    la $a0,badIntegerFormatMsg
3608#    j exitError
3612:castException:
3612#    la $a0,castExceptionMsg
3616#    j exitError
############## data section ################
    .data
3884:hexChars:
    .ascii "0123456789abcdef"
    .align 2
3900:cur_seg:
    .word 0

3904:lastCharRead:
    .word -2 # -2 => no buffered character
3908:prevHashConstant:
    .word 0x2785173c
3912:gcCount:
    .word 0

3916:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
3943:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
3966:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4001:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4035:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4068:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
4099:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
4147:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
4168:gcMsg: 
      .asciiz "\nGC!\n"
4174:gcCountMsg: 
      .asciiz "Number of garbage collections: "

4206:nullStr:
    .asciiz "null"
4211:trueString:
    .asciiz "true"
4216:falseString:
    .asciiz "false"
4222:exitString:
    .ascii "Program terminated."
    #### "falls through" here
4241:newlineString:
    .asciiz "\n"
    
    .align 2
4244:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

4248:seg0_start:
    .space 0x100000
1052824:seg0_end:
1052824:seg1_start:
    .space 0x100000
2101400:seg1_end:
