###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1024:mth_readLine_Lib:
    
1024#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1028#    sw $ra, 4($sp) # save $ra
1032#    move $t1,$sp # save "original" sp

1036:  doRead:

    # read the character
1036#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1040#    subu $t2,$v0,13
1044#    bne $t2,$zero,notReturnRL
1048#    jal readLogicalChar
1052#    subu $t2,$v0,10 # check for newline
1056#    beq $t2,$zero,foundNewLine
1060#    sw $v0,lastCharRead # push back character into queue
1064#    j foundNewLine # go process the line

1068:  notReturnRL:

    # at this point, $v0 has our character

1068#    subu $t0,$v0,10
1072#    beq $t0,$zero,foundNewLine
1076#    blt $v0,$zero,foundEof
1077##...slt $at,$v0,$zero
1081##...bne $at,$zero,1096

    # we have a character, so push it onto stack
1084#    subu $sp,$sp,4
1088#    sw $v0,($sp)

    # loop back up to get next character
1092#    j doRead

1096:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1096#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1100#    li $s7, 0 # return-value: null
1104#    j rlReturn # return

1108:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1108#    subu $t0,$t1,$sp # number of chars we read (times 4)
1112#    srl $s6,$t0,2 # number of words on stack with chars
1116#    subu $sp,$sp,4 # push char-count ...
1120#    sw $s6,($sp) # ... onto stack
1124#    addu $t2,$t0,5 # GC tag, incl. for count-word
1128#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1132#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1136#    srl $s6,$s6,2  # data words in object
1140#    move $s7,$zero # object words in object
1144#    jal newObject  # allocate space
    
    # store header words
1148#    la $t0,CLASS_String
1152#    sw $t0,-12($s7)# store class tag (String) into object
1156#    lw $t2,4($sp) # char-count
1160#    sll $t1,$t2,2 # 4 times number of chars
1164#    subu $t2,$zero,$t2 # negative of char-count
1168#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1172#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1176#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1177##...slt $at,$t0,$zero
1181##...beq $at,$zero,1200
1184#    and $t0,0xff # mask off object's hash value ...
1185##...lui $at,0
1189##...ori $at,$at,0xff
1193##...and $t0,$t0,$at
1196#    sw $t0,-8($s7) # ... and store back into -8 header-word
1200:  skipMask_readLine:

1200#    sll $t0,$t0,2 # data bytes in object
1204#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1208#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1212#    addu $sp,$sp,8 # pop redundant object-pointer and count
1216#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

1220#    beq $sp,$t1,rlReturn
1224:  charCopyLoop:
1224#    lw $t2,($sp)
1228#    sb $t2,-9($t0)
1232#    addu $sp,$sp,4
1236#    subu $t0,$t0,1
1240#    bne $sp,$t1,charCopyLoop
1244:  rlReturn:

1244#    lw $ra, 4($sp)
1248#    addu $sp, 8   # pop $ra and pointless word off stack
1252#    move $t0, $s7 # return string we allocated in $s7
1256#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1260:mth_readInt_Lib:

    # save $ra by pushing onto stack
1260#    subu $sp,$sp,4
1264#    sw $ra,($sp)

1268:  riSkipWhiteLoop:
    # read a character
1268#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
1272#    subu $t0,$v0,32
1276#    bgt $t0,$zero,nonWhite
1277##...slt $at,$zero,$t0
1281##...bne $at,$zero,1324
1284#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1288#    subu $t0,$v0,10
1292#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1296#    subu $t0,$v0,9
1300#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1304#    subu $t0,$v0,13
1308#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1312#    subu $t0,$v0,12
1316#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1320#    j badIntegerFormat # illegal integer char: abort program

1324:  nonWhite:
1324#    subu $t0,$v0,'-'
1328#    li $t4,1 # final multiplier
1332#    bne $t0,$zero,helpReadInt # go read
1336#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1340#    jal readLogicalChar

1344:  helpReadInt:
1344#    li $t2,10
1348#    subu $t1,$v0,'0' # convert digit to 0-9 value
1352#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
1353##...sltu $at,$t1,$t2
1357##...beq $at,$zero,3604
1360#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

1364:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

1364#    jal readLogicalChar # read next character
1368#    subu $t1,$v0,'0' # convert digit to 0-9 value
1372#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
1373##...sltu $at,$t1,$t2
1377##...beq $at,$zero,1396

1380#    mul $t3,$t3,$t2 # multiply old value by 10
1381##...mult $t3,$t2
1385##...mflo $t3
1388#    addu $t3,$t3,$t1 # add in value of new digit
1392#    j digitLoop

1396:  doneDigitLoop:

    # "push back" unused character into queue
1396#    sw $v0,lastCharRead

    # restore return address
1400#    lw $ra,($sp)
1404#    addu $sp, 4

    # multiply by sign and put return value in $t0
1408#    mult $t3,$t4 # multiply to account for poss. minus sign
1412#    mflo $t3
1416#    move $t0, $t3
    
    # return
1420#    jr $ra

