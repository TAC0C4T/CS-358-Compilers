1760#    addu $t3,$t3,$t2 # addr. of first source data byte to be copied (+8)
1764#    subu $t1,$t3,$t0 # addr. beyond last source data byte to be copied (+8)
1768#    lw $t2,-8($s7)   # data words in target string
1772#    sll $t2,$t2,2    # data bytes in target string
