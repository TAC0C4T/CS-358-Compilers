##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
516:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
516#    lw $t0,-8($s2) # get word with hash bits from this
520#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
524#    addu $t0,$t1

528#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
532:mth_equals_Object:
532#    move $t0,$s2 # first pointer (this)
536#    lw $t1,($sp) # second pointer
540#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
541##...subu $at,$t0,$t1
545##...sltiu $t0,$at,1

548#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
552:mth_hashCode_String:
552#    move $t0,$s2 # put this pointer in t0

556#    li $t2,0 # current hash value
560#    lw $t1,-4($t0) # negative of number of characters in string
564#    beq $t1,$zero,done_hashCode_String # if zero length => done
568#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
572#    and $t0,0xfffffffc # adjust for padding
573##...lui $at,65535
577##...ori $at,$at,0xfffc
581##...and $t0,$t0,$at
584#    subu $t1,$t0,$t1 # address at end of string +12
588:loop_hashCode_String:    
588#    sll $t4,$t2,5 # multiply by 32
592#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
596#    lbu $t3,-12($t0) # current character
600#    addu $t2,$t3 # add in current character
604#    addu $t0,1 # go to next character's address
608#    bne $t0,$t1,loop_hashCode_String # loop back if more
612:done_hashCode_String:    

    # push int on stack
612#    move $t0, $t2 # put $t2 in return slot
616#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
620:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
620#    subu $sp,4
624#    sw $ra,($sp)
    
    # get hash value
628#    lw $t2,-12($s2) # vtable address
632#    lw $t0,($t2) # method address
636#    jalr $t0
640#    subu $sp,8 # push result (int in $t0) on stack
644#    sw $s5,4($sp)
648#    sw $t0,($sp)

    # compute print-size of hash value
652#    li $t0, 1
656#    lw $t1, ($sp)
660#    srl $t1,$t1,4
664#    beq $t1,$zero,toString_skip_loop
668:toString_loop_top:
668#    addu $t0,1
672#    srl $t1,$t1,4
676#    bne $t1,$zero,toString_loop_top
680:toString_skip_loop:
680#    subu $sp,8
684#    sw $s5,4($sp)
688#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
692#    lw $t2,-12($s2) # vtable address
696#    move $t0,$t2
700:toString_checkTagBit:
700#    subu $t0,1
704#    lb $t1,($t0)
708#    and $t1,0x80
709##...lui $at,0
713##...ori $at,$at,0x80
717##...and $t1,$t1,$at
720#    beq $t1,$zero,toString_checkTagBit
724#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
728#    subu $sp,8
732#    sw $t1,($sp)
736#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
740#    move $s7,$zero # -4 offset header word
744#    lw $t4,8($sp) # bytes for hash value
748#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
752#    addu $t4,8
756#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
760#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

764#    li $t0,CLASS_String # store string vtable address into ...
768#    sw $t0,-12($s7) # ... -12 offset in object header
772#    lw $t2,-12($s2) # our object's vtable address
776#    lw $t5,4($sp) # number characters in prefix
780#    lw $t1,12($sp) # number of characters in hashcode
784#    addu $t3,$t1,$t5 # number of characters in string ...
788#    addu $t3,1 # ... including the '@' character
792#    subu $t0,$zero,$t3 # store negated length into ...
796#    sw $t0,-4($s7) # ... -4 offset header word
800#    lw $t0,-8($s7) # get -8 offset header-word
804#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
805##...slt $at,$t0,$zero
809##...beq $at,$zero,828
812#    and $t0,0xff # mask off object's hash value ...
813##...lui $at,0
817##...ori $at,$at,0xff
821##...and $t0,$t0,$at
824#    sw $t0,-8($s7) # ... and store back into -8 header-word
828:skipMask_toString:
828#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
832#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
836#    subu $t4,$t2,$t5
840:toString_copyLoop:    
840#    lb $t3,($t4)
844#    and $t3,0x7f # mask off sign bit (in case first word)
845##...lui $at,0
849##...ori $at,$at,0x7f
853##...and $t3,$t3,$at
856#    sb $t3,-8($t0)
860#    addu $t4,1
864#    addu $t0,1
868#    blt $t4,$t2,toString_copyLoop
869##...slt $at,$t4,$t2
873##...bne $at,$zero,840

    # copy the '@' sign
876#    li $t3,'@'
880#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
884#    addu $t2,$t0,$t1 # address of last byte in string to store +8
888#    lw $t3,20($sp) # hash code to print
892:toString_hashCopyLoop:
892#    and $t4,$t3,0xf
896#    srl $t3,4
900#    lb $t4,hexChars($t4)
904#    sb $t4,-8($t2)
908#    subu $t2,$t2,1
912#    bgt $t2,$t0,toString_hashCopyLoop
913##...slt $at,$t0,$t2
917##...bne $at,$zero,892

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
920#    addu $sp,28
924#    lw $ra,($sp)
928#    addu $sp,4
932#    move $t0, $s7 # return string we created
936#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
940:mth_equals_String:
    
    # quick test for obvious false
940#    lw $t0,($sp) # second parameter
944#    beq $t0,$zero,goEsFalse # go return false if null
948#    lw $t1,-12($t0) # vtable pointer
952#    la $t2,CLASS_String # string vtable pointer
956#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
960#    subu $sp,12
964#    sw $ra,8($sp)
968#    sw $s2,4($sp)
972#    sw $t0,($sp)
976#    jal mth_compareTo_String
980#    lw $s2, 4($sp) #restore this pointer and pop parameters
984#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
988#    seq $t0,$t0,$zero
989##...subu $at,$t0,$zero
993##...sltiu $t0,$at,1

    # pop return address and return $t0
996#    lw $ra,($sp)
1000#    addu $sp,4

1004#    jr $ra # return
    
1008:goEsFalse:
    # put 0 in $t0 and return
1008#    li $t0, 0
1012#    jr $ra # return

