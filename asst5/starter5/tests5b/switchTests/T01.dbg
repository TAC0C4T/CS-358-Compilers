########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
3060:vm_init:

    # mark bottom of stack
3060#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
3064#    move $s2,$zero

    #set up the "five" register
3068#    li $s5,5

3072#    la $s3,seg0_start
3076#    la $s4,seg0_end
3077##...lui $s4,16
3081##...addiu $s4,$s4,3896
    
    # return
3084#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3088:divide:
    # get parameters; abort if divisor zero
3088#    lw $t0,($sp)
3092#    lw $t1,8($sp)
3096#    beq $t0,$zero,divByZeroError
    
    # perform division
3100#    div $t1,$t0
3104#    mflo $t0

    # store result, adjust stack and return
3108#    addu $sp,$sp,8 # adjust stack
3112#    sw $t0,($sp) # store result
3116#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3120:remainder:
    # get parameters; abort if divisor zero
3120#    lw $t0,($sp)
3124#    lw $t1,8($sp)
3128#    beq $t0,$zero,divByZeroError
    
    # perform division
3132#    div $t1,$t0
3136#    mfhi $t0

    # store result, adjust stack and return
3140#    addu $sp,$sp,8 # adjust stack
3144#    sw $t0,($sp) # store result
3148#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
