.globl main
0:main:
0#  jal vm_init
4#  li $v0, 10
8#  syscall
12:mth_main_Main:
12#  li $t0, 0
16#  subu $sp, $sp, 8
20#  sw $s5, 4($sp)
24#  sw $t0, 0($sp)
28#  li $t0, 20
32#  subu $sp, $sp, 8
36#  sw $s5, 4($sp)
40#  sw $t0, 0($sp)
44#  lw $t2, ($sp)
48#  addu $sp, $sp, 4
52#  lw $t1, ($sp)
56#  addu $sp, $sp, 4
60#  slt $t0, $t1, $t2
64#  subu $sp, $sp, 4
68#  sw $t0, ($sp)
72#  li $t0, 3
76#  subu $sp, $sp, 8
80#  sw $s5, 4($sp)
84#  sw $t0, 0($sp)
88#  lw $t2, ($sp)
92#  addu $sp, $sp, 4
96#  lw $t1, ($sp)
100#  addu $sp, $sp, 4
104#  mul $t0, $t1, $t2
105##...mult $t1,$t2
109##...mflo $t0
112#  subu $sp, $sp, 4
116#  sw $t0, ($sp)
120#  la $t0, strLit_16
124#  subu $sp, $sp, 4
128#  sw $t0, ($sp)
132#  subu $sp, $sp, 4
136#  sw $s2, ($sp)
140#  li $t0, 1
144#  subu $sp, $sp, 8
148#  sw $s5, 4($sp)
152#  sw $t0, 0($sp)
156#  lw $t2, ($sp)
160#  addu $sp, $sp, 4
164#  lw $t1, ($sp)
168#  addu $sp, $sp, 4
172#  addu $t0, $t1, $t2
176#  subu $sp, $sp, 4
180#  sw $t0, ($sp)
184#  la $t0, strLit_26
188#  subu $sp, $sp, 4
192#  sw $t0, ($sp)
196#  subu $sp, $sp, 4
200#  sw $s2, ($sp)
204#  jr $ra
##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
208:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
208#    lw $t0,-8($s2) # get word with hash bits from this
212#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
216#    addu $t0,$t1

220#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
224:mth_equals_Object:
224#    move $t0,$s2 # first pointer (this)
228#    lw $t1,($sp) # second pointer
232#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
233##...subu $at,$t0,$t1
237##...sltiu $t0,$at,1

240#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
244:mth_hashCode_String:
244#    move $t0,$s2 # put this pointer in t0

248#    li $t2,0 # current hash value
252#    lw $t1,-4($t0) # negative of number of characters in string
256#    beq $t1,$zero,done_hashCode_String # if zero length => done
260#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
264#    and $t0,0xfffffffc # adjust for padding
265##...lui $at,65535
269##...ori $at,$at,0xfffc
273##...and $t0,$t0,$at
276#    subu $t1,$t0,$t1 # address at end of string +12
280:loop_hashCode_String:    
280#    sll $t4,$t2,5 # multiply by 32
284#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
288#    lbu $t3,-12($t0) # current character
292#    addu $t2,$t3 # add in current character
296#    addu $t0,1 # go to next character's address
300#    bne $t0,$t1,loop_hashCode_String # loop back if more
304:done_hashCode_String:    

    # push int on stack
304#    move $t0, $t2 # put $t2 in return slot
308#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
312:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
312#    subu $sp,4
316#    sw $ra,($sp)
    
    # get hash value
320#    lw $t2,-12($s2) # vtable address
324#    lw $t0,($t2) # method address
328#    jalr $t0
332#    subu $sp,8 # push result (int in $t0) on stack
336#    sw $s5,4($sp)
340#    sw $t0,($sp)

    # compute print-size of hash value
344#    li $t0, 1
348#    lw $t1, ($sp)
352#    srl $t1,$t1,4
356#    beq $t1,$zero,toString_skip_loop
360:toString_loop_top:
360#    addu $t0,1
364#    srl $t1,$t1,4
368#    bne $t1,$zero,toString_loop_top
372:toString_skip_loop:
372#    subu $sp,8
376#    sw $s5,4($sp)
380#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
384#    lw $t2,-12($s2) # vtable address
388#    move $t0,$t2
392:toString_checkTagBit:
392#    subu $t0,1
396#    lb $t1,($t0)
400#    and $t1,0x80
401##...lui $at,0
405##...ori $at,$at,0x80
409##...and $t1,$t1,$at
412#    beq $t1,$zero,toString_checkTagBit
416#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
420#    subu $sp,8
424#    sw $t1,($sp)
428#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
432#    move $s7,$zero # -4 offset header word
436#    lw $t4,8($sp) # bytes for hash value
440#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
444#    addu $t4,8
448#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
452#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

456#    li $t0,CLASS_String # store string vtable address into ...
460#    sw $t0,-12($s7) # ... -12 offset in object header
464#    lw $t2,-12($s2) # our object's vtable address
468#    lw $t5,4($sp) # number characters in prefix
472#    lw $t1,12($sp) # number of characters in hashcode
476#    addu $t3,$t1,$t5 # number of characters in string ...
480#    addu $t3,1 # ... including the '@' character
484#    subu $t0,$zero,$t3 # store negated length into ...
488#    sw $t0,-4($s7) # ... -4 offset header word
492#    lw $t0,-8($s7) # get -8 offset header-word
496#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
497##...slt $at,$t0,$zero
501##...beq $at,$zero,520
504#    and $t0,0xff # mask off object's hash value ...
505##...lui $at,0
509##...ori $at,$at,0xff
513##...and $t0,$t0,$at
516#    sw $t0,-8($s7) # ... and store back into -8 header-word
520:skipMask_toString:
520#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
524#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
528#    subu $t4,$t2,$t5
532:toString_copyLoop:    
532#    lb $t3,($t4)
536#    and $t3,0x7f # mask off sign bit (in case first word)
537##...lui $at,0
541##...ori $at,$at,0x7f
545##...and $t3,$t3,$at
548#    sb $t3,-8($t0)
552#    addu $t4,1
556#    addu $t0,1
560#    blt $t4,$t2,toString_copyLoop
561##...slt $at,$t4,$t2
565##...bne $at,$zero,532

    # copy the '@' sign
568#    li $t3,'@'
572#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
576#    addu $t2,$t0,$t1 # address of last byte in string to store +8
580#    lw $t3,20($sp) # hash code to print
584:toString_hashCopyLoop:
584#    and $t4,$t3,0xf
588#    srl $t3,4
592#    lb $t4,hexChars($t4)
596#    sb $t4,-8($t2)
600#    subu $t2,$t2,1
604#    bgt $t2,$t0,toString_hashCopyLoop
605##...slt $at,$t0,$t2
609##...bne $at,$zero,584

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
612#    addu $sp,28
616#    lw $ra,($sp)
620#    addu $sp,4
624#    move $t0, $s7 # return string we created
628#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
632:mth_equals_String:
    
    # quick test for obvious false
632#    lw $t0,($sp) # second parameter
636#    beq $t0,$zero,goEsFalse # go return false if null
640#    lw $t1,-12($t0) # vtable pointer
644#    la $t2,CLASS_String # string vtable pointer
648#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
652#    subu $sp,12
656#    sw $ra,8($sp)
660#    sw $s2,4($sp)
664#    sw $t0,($sp)
668#    jal mth_compareTo_String
672#    lw $s2, 4($sp) #restore this pointer and pop parameters
676#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
680#    seq $t0,$t0,$zero
681##...subu $at,$t0,$zero
685##...sltiu $t0,$at,1

    # pop return address and return $t0
688#    lw $ra,($sp)
692#    addu $sp,4

696#    jr $ra # return
    
700:goEsFalse:
    # put 0 in $t0 and return
700#    li $t0, 0
704#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
708:mth_toString_String:
    #we are a string, so return this.
708#    move $t0, $s2
712#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
716:mth_readLine_Lib:
    
716#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
720#    sw $ra, 4($sp) # save $ra
724#    move $t1,$sp # save "original" sp

728:  doRead:

    # read the character
728#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
732#    subu $t2,$v0,13
736#    bne $t2,$zero,notReturnRL
740#    jal readLogicalChar
744#    subu $t2,$v0,10 # check for newline
748#    beq $t2,$zero,foundNewLine
752#    sw $v0,lastCharRead # push back character into queue
756#    j foundNewLine # go process the line
