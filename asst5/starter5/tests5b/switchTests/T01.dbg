988#    subu $t0,$v0,9
992#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
996#    subu $t0,$v0,13
1000#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1004#    subu $t0,$v0,12
1008#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1012#    j badIntegerFormat # illegal integer char: abort program
