3795:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
3816:gcMsg: 
      .asciiz "\nGC!\n"
3822:gcCountMsg: 
      .asciiz "Number of garbage collections: "

3854:nullStr:
    .asciiz "null"
