
    # determine if we have enough memory available
2164#    addu $t0,$s6,$s7
2168#    sll $t0,$t0,2
2172#    addu $t0,$t0,8 # amount of memory needed
2176#    addu $t1,$t0,$s3
2180#    bgtu $t1,$s4,doGC
2181##...sltu $at,$s4,$t1
2185##...bne $at,$zero,2308

    # at this point:
    #  $s3 points to beginning of segment, and
    #  $t1 points just past the end

    # zero out the memory
