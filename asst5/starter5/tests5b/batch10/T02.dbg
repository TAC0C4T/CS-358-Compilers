
    # set up GC tag and char-count on stack
668#    subu $t0,$t1,$sp # number of chars we read (times 4)
672#    srl $s6,$t0,2 # number of words on stack with chars
676#    subu $sp,$sp,4 # push char-count ...
680#    sw $s6,($sp) # ... onto stack
684#    addu $t2,$t0,5 # GC tag, incl. for count-word
688#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
692#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
696#    srl $s6,$s6,2  # data words in object
700#    move $s7,$zero # object words in object
704#    jal newObject  # allocate space
    
    # store header words
708#    la $t0,CLASS_String
712#    sw $t0,-12($s7)# store class tag (String) into object
716#    lw $t2,4($sp) # char-count
720#    sll $t1,$t2,2 # 4 times number of chars
724#    subu $t2,$zero,$t2 # negative of char-count
728#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
732#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
736#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
737##...slt $at,$t0,$zero
741##...beq $at,$zero,760
744#    and $t0,0xff # mask off object's hash value ...
745##...lui $at,0
749##...ori $at,$at,0xff
753##...and $t0,$t0,$at
756#    sw $t0,-8($s7) # ... and store back into -8 header-word
760:  skipMask_readLine:
