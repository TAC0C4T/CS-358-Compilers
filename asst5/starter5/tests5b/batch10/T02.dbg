2253##...lui $at,32768
2257##...or $t1,$at,$t1
2260#    and $t1,0xffffff00 # clear low bit
2261##...lui $at,65535
2265##...ori $at,$at,0xff00
2269##...and $t1,$t1,$at
2272#    or $s6,$t1
