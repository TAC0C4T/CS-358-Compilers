########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
2928:vm_init:

    # mark bottom of stack
2928#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
2932#    move $s2,$zero

    #set up the "five" register
2936#    li $s5,5

2940#    la $s3,seg0_start
2944#    la $s4,seg0_end
2945##...lui $s4,16
2949##...addiu $s4,$s4,3744
    
    # return
2952#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
2956:divide:
    # get parameters; abort if divisor zero
2956#    lw $t0,($sp)
2960#    lw $t1,8($sp)
2964#    beq $t0,$zero,divByZeroError
    
    # perform division
2968#    div $t1,$t0
2972#    mflo $t0

    # store result, adjust stack and return
2976#    addu $sp,$sp,8 # adjust stack
2980#    sw $t0,($sp) # store result
2984#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
2988:remainder:
    # get parameters; abort if divisor zero
2988#    lw $t0,($sp)
2992#    lw $t1,8($sp)
2996#    beq $t0,$zero,divByZeroError
    
    # perform division
3000#    div $t1,$t0
3004#    mfhi $t0

    # store result, adjust stack and return
3008#    addu $sp,$sp,8 # adjust stack
3012#    sw $t0,($sp) # store result
3016#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3020:checkCast:
    # get object, allow immediately if null
3020#    lw $t2,($sp)
3024#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3028#    lw $t2,-12($t2) # vtable address
3032#    bge $t2,$t1,castException
3033##...slt $at,$t2,$t1
3037##...beq $at,$zero,3172
3040#    blt $t2,$t0,castException
3041##...slt $at,$t2,$t0
3045##...bne $at,$zero,3172
    
    # return, leaving object unchanged on stack
3048:  checkCastReturn:    
3048#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    
