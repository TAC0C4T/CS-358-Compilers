.data
3376:strLit_8:
.asciiz "\n"
.align 2
.text
.globl main
0:main:
0#  jal vm_init
4#  li $v0, 10
8#  syscall
12:mth_main_Main:
12#  li $t0, 5
16#  subu $sp, $sp, 8
20#  sw $s5, 4($sp)
24#  sw $t0, 0($sp)
28#  li $t0, 3
32#  subu $sp, $sp, 8
36#  sw $s5, 4($sp)
40#  sw $t0, 0($sp)
44#  subu $sp, $sp, 4
48#  sw $s2, ($sp)
52#  la $t0, strLit_8
56#  subu $sp, $sp, 4
60#  sw $t0, ($sp)
64#  subu $sp, $sp, 4
68#  sw $s2, ($sp)
72#  jr $ra
##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
76:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
76#    lw $t0,-8($s2) # get word with hash bits from this
80#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
84#    addu $t0,$t1

88#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
92:mth_equals_Object:
92#    move $t0,$s2 # first pointer (this)
96#    lw $t1,($sp) # second pointer
100#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
101##...subu $at,$t0,$t1
105##...sltiu $t0,$at,1

108#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
112:mth_hashCode_String:
112#    move $t0,$s2 # put this pointer in t0

116#    li $t2,0 # current hash value
120#    lw $t1,-4($t0) # negative of number of characters in string
124#    beq $t1,$zero,done_hashCode_String # if zero length => done
128#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
132#    and $t0,0xfffffffc # adjust for padding
133##...lui $at,65535
137##...ori $at,$at,0xfffc
141##...and $t0,$t0,$at
144#    subu $t1,$t0,$t1 # address at end of string +12
148:loop_hashCode_String:    
148#    sll $t4,$t2,5 # multiply by 32
152#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
156#    lbu $t3,-12($t0) # current character
160#    addu $t2,$t3 # add in current character
164#    addu $t0,1 # go to next character's address
168#    bne $t0,$t1,loop_hashCode_String # loop back if more
172:done_hashCode_String:    

    # push int on stack
172#    move $t0, $t2 # put $t2 in return slot
176#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
180:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
180#    subu $sp,4
184#    sw $ra,($sp)
    
    # get hash value
188#    lw $t2,-12($s2) # vtable address
192#    lw $t0,($t2) # method address
196#    jalr $t0
200#    subu $sp,8 # push result (int in $t0) on stack
204#    sw $s5,4($sp)
208#    sw $t0,($sp)

    # compute print-size of hash value
212#    li $t0, 1
216#    lw $t1, ($sp)
220#    srl $t1,$t1,4
224#    beq $t1,$zero,toString_skip_loop
228:toString_loop_top:
228#    addu $t0,1
232#    srl $t1,$t1,4
236#    bne $t1,$zero,toString_loop_top
240:toString_skip_loop:
240#    subu $sp,8
244#    sw $s5,4($sp)
248#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
252#    lw $t2,-12($s2) # vtable address
256#    move $t0,$t2
260:toString_checkTagBit:
260#    subu $t0,1
264#    lb $t1,($t0)
268#    and $t1,0x80
269##...lui $at,0
273##...ori $at,$at,0x80
277##...and $t1,$t1,$at
280#    beq $t1,$zero,toString_checkTagBit
284#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
288#    subu $sp,8
292#    sw $t1,($sp)
296#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
300#    move $s7,$zero # -4 offset header word
304#    lw $t4,8($sp) # bytes for hash value
308#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
312#    addu $t4,8
316#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
320#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

324#    li $t0,CLASS_String # store string vtable address into ...
328#    sw $t0,-12($s7) # ... -12 offset in object header
332#    lw $t2,-12($s2) # our object's vtable address
336#    lw $t5,4($sp) # number characters in prefix
340#    lw $t1,12($sp) # number of characters in hashcode
344#    addu $t3,$t1,$t5 # number of characters in string ...
348#    addu $t3,1 # ... including the '@' character
352#    subu $t0,$zero,$t3 # store negated length into ...
356#    sw $t0,-4($s7) # ... -4 offset header word
360#    lw $t0,-8($s7) # get -8 offset header-word
364#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
365##...slt $at,$t0,$zero
369##...beq $at,$zero,388
372#    and $t0,0xff # mask off object's hash value ...
373##...lui $at,0
377##...ori $at,$at,0xff
381##...and $t0,$t0,$at
384#    sw $t0,-8($s7) # ... and store back into -8 header-word
388:skipMask_toString:
388#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
392#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
396#    subu $t4,$t2,$t5
400:toString_copyLoop:    
400#    lb $t3,($t4)
404#    and $t3,0x7f # mask off sign bit (in case first word)
405##...lui $at,0
409##...ori $at,$at,0x7f
413##...and $t3,$t3,$at
416#    sb $t3,-8($t0)
420#    addu $t4,1
424#    addu $t0,1
428#    blt $t4,$t2,toString_copyLoop
429##...slt $at,$t4,$t2
433##...bne $at,$zero,400

    # copy the '@' sign
436#    li $t3,'@'
440#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
444#    addu $t2,$t0,$t1 # address of last byte in string to store +8
448#    lw $t3,20($sp) # hash code to print
452:toString_hashCopyLoop:
452#    and $t4,$t3,0xf
456#    srl $t3,4
460#    lb $t4,hexChars($t4)
464#    sb $t4,-8($t2)
468#    subu $t2,$t2,1
472#    bgt $t2,$t0,toString_hashCopyLoop
473##...slt $at,$t0,$t2
477##...bne $at,$zero,452

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
480#    addu $sp,28
484#    lw $ra,($sp)
488#    addu $sp,4
492#    move $t0, $s7 # return string we created
496#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
500:mth_equals_String:
    
    # quick test for obvious false
500#    lw $t0,($sp) # second parameter
504#    beq $t0,$zero,goEsFalse # go return false if null
508#    lw $t1,-12($t0) # vtable pointer
512#    la $t2,CLASS_String # string vtable pointer
516#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
520#    subu $sp,12
524#    sw $ra,8($sp)
528#    sw $s2,4($sp)
532#    sw $t0,($sp)
536#    jal mth_compareTo_String
540#    lw $s2, 4($sp) #restore this pointer and pop parameters
544#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
548#    seq $t0,$t0,$zero
549##...subu $at,$t0,$zero
553##...sltiu $t0,$at,1

    # pop return address and return $t0
556#    lw $ra,($sp)
560#    addu $sp,4

564#    jr $ra # return
    
568:goEsFalse:
    # put 0 in $t0 and return
568#    li $t0, 0
572#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
576:mth_toString_String:
    #we are a string, so return this.
576#    move $t0, $s2
580#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
584:mth_readLine_Lib:
    
584#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
588#    sw $ra, 4($sp) # save $ra
592#    move $t1,$sp # save "original" sp

596:  doRead:

    # read the character
596#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
600#    subu $t2,$v0,13
604#    bne $t2,$zero,notReturnRL
608#    jal readLogicalChar
612#    subu $t2,$v0,10 # check for newline
616#    beq $t2,$zero,foundNewLine
620#    sw $v0,lastCharRead # push back character into queue
624#    j foundNewLine # go process the line

628:  notReturnRL:

    # at this point, $v0 has our character

628#    subu $t0,$v0,10
632#    beq $t0,$zero,foundNewLine
636#    blt $v0,$zero,foundEof
637##...slt $at,$v0,$zero
641##...bne $at,$zero,656

    # we have a character, so push it onto stack
644#    subu $sp,$sp,4
648#    sw $v0,($sp)

    # loop back up to get next character
652#    j doRead

656:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
656#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
660#    li $s7, 0 # return-value: null
664#    j rlReturn # return

668:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)
