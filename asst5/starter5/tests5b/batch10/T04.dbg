2740#    subu $t0,$v0,10
2744#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
2748#    subu $t0,$v0,9
2752#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
2756#    subu $t0,$v0,13
2760#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
2764#    subu $t0,$v0,12
