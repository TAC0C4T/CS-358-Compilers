2676#    lw $t2,($sp)
2680#    sb $t2,-9($t0)
2684#    addu $sp,$sp,4
2688#    subu $t0,$t0,1
2692#    bne $sp,$t1,charCopyLoop
2696:  rlReturn:

2696#    lw $ra, 4($sp)
2700#    addu $sp, 8   # pop $ra and pointless word off stack
2704#    move $t0, $s7 # return string we allocated in $s7
2708#    jr $ra

