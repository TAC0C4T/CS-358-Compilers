########################################################
# readLogicalChar (millicode)
#  - logically reads a character from standard input
#  - first checks character buffer, consuming it if possible
#  - return-result:
#    - returns character in $v0
#  - side-effects:
#    - reads a character
#    - clobbers $t0
########################################################
4012:readLogicalChar:

    # check if we already have a character
4012#    lw $v0,lastCharRead
4016#    li $t0,-2
4020#    beq $t0,$v0 doReadCh

    # we have our character from the buffer. Wipe out
    # buffer and return
4024#    sw $t0,lastCharRead # store -2 into buffer (i.e. "empty")
4028#    jr $ra # return
    
4032:  doReadCh:
    # we need to actually read a character: read and return
4032#    li $v0,12 # use system call to read a character
4036#    syscall
