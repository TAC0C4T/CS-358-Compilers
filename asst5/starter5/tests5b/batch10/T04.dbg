    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
4732#    lw $s0,($t4)
4736#    lw $t9,-8($t1)
4740#    sw $t9,($t4)
4744#    sw $s0,-8($t1)

    # copy all source bytes to the target
4748:  gCinnerCopy2:
4748#    lw $s0,($t4)
4752#    sw $s0,($s3)
4756#    addu $t4,$t4,4
4760#    addu $s3,$s3,4
4764#    bltu $t4,$t3,gCinnerCopy2
4765##...sltu $at,$t4,$t3
4769##...bne $at,$zero,4748

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
4772#    sw $zero,-8($t1) # 0 in first header-slot
4776#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
4780#    sw $t8,($t0)

4784:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
4784#    addu $t0,$t0,4
4788#    bltu $t0,$s1,gcNextPointerInObject
4789##...sltu $at,$t0,$s1
4793##...bne $at,$zero,4632

4796:  gcTestIterDone2:
4796#    bltu $t0,$s3,gcHeapCopyLoop
4797##...sltu $at,$t0,$s3
4801##...bne $at,$zero,4516

    ###### end outer loop to copy all non-stack-direct objects ######

4804:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
4804#    lw $s2,($sp)
4808#    addu $sp,$sp,4

    # mark us as having already GC'd
4812#    move $t5,$s5

    # go try and allocate again
4816#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4820:vm_init:

    # mark bottom of stack
4820#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4824#    move $s2,$zero

    #set up the "five" register
4828#    li $s5,5

4832#    la $s3,seg0_start
4836#    la $s4,seg0_end
4837##...lui $s4,16
4841##...addiu $s4,$s4,5932
    
    # return
4844#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4848:divide:
    # get parameters; abort if divisor zero
4848#    lw $t0,($sp)
4852#    lw $t1,8($sp)
4856#    beq $t0,$zero,divByZeroError
    
    # perform division
4860#    div $t1,$t0
4864#    mflo $t0

    # store result, adjust stack and return
4868#    addu $sp,$sp,8 # adjust stack
4872#    sw $t0,($sp) # store result
4876#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4880:remainder:
    # get parameters; abort if divisor zero
4880#    lw $t0,($sp)
4884#    lw $t1,8($sp)
4888#    beq $t0,$zero,divByZeroError
    
    # perform division
4892#    div $t1,$t0
4896#    mfhi $t0

    # store result, adjust stack and return
4900#    addu $sp,$sp,8 # adjust stack
4904#    sw $t0,($sp) # store result
4908#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4912:checkCast:
    # get object, allow immediately if null
4912#    lw $t2,($sp)
4916#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4920#    lw $t2,-12($t2) # vtable address
4924#    bge $t2,$t1,castException
4925##...slt $at,$t2,$t1
4929##...beq $at,$zero,5064
4932#    blt $t2,$t0,castException
4933##...slt $at,$t2,$t0
4937##...bne $at,$zero,5064
    
    # return, leaving object unchanged on stack
4940:  checkCastReturn:    
4940#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4944:instanceOf:
    # get object, go return false if null
4944#    lw $t2,($sp)
4948#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4952#    lw $t2,-12($t2) # vtable address
4956#    sge $t0,$t2,$t0 # are we >= the lower limit?
4957##...slt $t0,$t2,$t0
4961##...xori $t0,$t0,0x1
4964#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4968#    and $t2,$t0,$t1
4972#    sw $t2,($sp)
4976:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4976#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4980:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4980#    li $v0,4 # syscall-code for print-string
4984#    syscall
4988:exit:
    # print termination message
4988#    li $v0,4 # syscall-code for print-string
4992#    la $a0,exitString
4996#    syscall

    # terminate execution
5000#    li $v0,10 #syscall-code for "exit"
5004#    syscall

5008:outOfHeapMemory:
5008#    la $a0,heapMemoryMsg
5012#    j exitError
5016:divByZeroError:
5016#    la $a0,divByZeroMsg
5020#    j exitError
5024:strIndexOutOfBounds:
5024#    la $a0,strIndexOutOfBoundsMsg
5028#    j exitError
5032:arrayIndexOutOfBounds:
5032#    la $a0,arrayIndexOutOfBoundsMsg
5036#    j exitError
5040:arraySizeOutOfBounds:
5040#    la $a0,arraySizeOutOfBoundsMsg
5044#    j exitError
5048:nullPtrException:
5048#    la $a0,nullPtrExceptionMsg
5052#    j exitError
5056:badIntegerFormat:
5056#    la $a0,badIntegerFormatMsg
5060#    j exitError
5064:castException:
5064#    la $a0,castExceptionMsg
5068#    j exitError
############## data section ################
    .data
5568:hexChars:
    .ascii "0123456789abcdef"
    .align 2
5584:cur_seg:
    .word 0

5588:lastCharRead:
    .word -2 # -2 => no buffered character
5592:prevHashConstant:
    .word 0x2785173c
5596:gcCount:
    .word 0

5600:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
5627:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
5650:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
5685:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
5719:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
5752:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
5783:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
5831:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
5852:gcMsg: 
      .asciiz "\nGC!\n"
5858:gcCountMsg: 
      .asciiz "Number of garbage collections: "

5890:nullStr:
    .asciiz "null"
5895:trueString:
    .asciiz "true"
5900:falseString:
    .asciiz "false"
5906:exitString:
    .ascii "Program terminated."
    #### "falls through" here
5925:newlineString:
    .asciiz "\n"
    
    .align 2
5928:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

5932:seg0_start:
    .space 0x100000
1054508:seg0_end:
1054508:seg1_start:
    .space 0x100000
2103084:seg1_end:
