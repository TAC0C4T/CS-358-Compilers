3829##...lui $at,0
3833##...ori $at,$at,0xff
3837##...and $t2,$t2,$at
    #### OLD
    #### subu $t2,$zero,$t2 # set to 1 if -1 (number of data words)

3840:  gcSkip2:
3840#    sll $t2,$t2,2
3844#    addu $t2,$t2,8
3848#    subu $t4,$t1,$t2 # address of first word of source
3852#    lw $t3,-4($t1) # number of object words (negative means zero)
