3721##...addiu $s4,$s4,5160
3724#    sw $zero,cur_seg
3728#    bne $t0,$zero,skipGc1
3732#    la $t6,seg0_start
3736#    la $s3,seg1_start
3737##...lui $s3,16
3741##...addiu $s3,$s3,5160
3744#    la $s4,seg1_end
3745##...lui $s4,32
3749##...addiu $s4,$s4,5160
3752#    sw $s5,cur_seg
