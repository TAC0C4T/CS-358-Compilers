##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1440:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
1440#    lw $t0,-8($s2) # get word with hash bits from this
1444#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
1448#    addu $t0,$t1

1452#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1456:mth_equals_Object:
1456#    move $t0,$s2 # first pointer (this)
1460#    lw $t1,($sp) # second pointer
1464#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
1465##...subu $at,$t0,$t1
1469##...sltiu $t0,$at,1

1472#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
1476:mth_hashCode_String:
1476#    move $t0,$s2 # put this pointer in t0

1480#    li $t2,0 # current hash value
1484#    lw $t1,-4($t0) # negative of number of characters in string
1488#    beq $t1,$zero,done_hashCode_String # if zero length => done
1492#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
1496#    and $t0,0xfffffffc # adjust for padding
1497##...lui $at,65535
1501##...ori $at,$at,0xfffc
1505##...and $t0,$t0,$at
1508#    subu $t1,$t0,$t1 # address at end of string +12
1512:loop_hashCode_String:    
1512#    sll $t4,$t2,5 # multiply by 32
1516#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
1520#    lbu $t3,-12($t0) # current character
1524#    addu $t2,$t3 # add in current character
1528#    addu $t0,1 # go to next character's address
1532#    bne $t0,$t1,loop_hashCode_String # loop back if more
1536:done_hashCode_String:    

    # push int on stack
1536#    move $t0, $t2 # put $t2 in return slot
1540#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
1544:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
1544#    subu $sp,4
1548#    sw $ra,($sp)
    
    # get hash value
1552#    lw $t2,-12($s2) # vtable address
1556#    lw $t0,($t2) # method address
1560#    jalr $t0
1564#    subu $sp,8 # push result (int in $t0) on stack
1568#    sw $s5,4($sp)
1572#    sw $t0,($sp)

    # compute print-size of hash value
1576#    li $t0, 1
1580#    lw $t1, ($sp)
1584#    srl $t1,$t1,4
1588#    beq $t1,$zero,toString_skip_loop
1592:toString_loop_top:
1592#    addu $t0,1
1596#    srl $t1,$t1,4
1600#    bne $t1,$zero,toString_loop_top
1604:toString_skip_loop:
1604#    subu $sp,8
1608#    sw $s5,4($sp)
1612#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
1616#    lw $t2,-12($s2) # vtable address
1620#    move $t0,$t2
1624:toString_checkTagBit:
1624#    subu $t0,1
1628#    lb $t1,($t0)
1632#    and $t1,0x80
1633##...lui $at,0
1637##...ori $at,$at,0x80
1641##...and $t1,$t1,$at
1644#    beq $t1,$zero,toString_checkTagBit
1648#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
1652#    subu $sp,8
1656#    sw $t1,($sp)
1660#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
1664#    move $s7,$zero # -4 offset header word
1668#    lw $t4,8($sp) # bytes for hash value
1672#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
1676#    addu $t4,8
1680#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
1684#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

1688#    li $t0,CLASS_String # store string vtable address into ...
1692#    sw $t0,-12($s7) # ... -12 offset in object header
1696#    lw $t2,-12($s2) # our object's vtable address
1700#    lw $t5,4($sp) # number characters in prefix
1704#    lw $t1,12($sp) # number of characters in hashcode
1708#    addu $t3,$t1,$t5 # number of characters in string ...
1712#    addu $t3,1 # ... including the '@' character
1716#    subu $t0,$zero,$t3 # store negated length into ...
1720#    sw $t0,-4($s7) # ... -4 offset header word
1724#    lw $t0,-8($s7) # get -8 offset header-word
1728#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
1729##...slt $at,$t0,$zero
1733##...beq $at,$zero,1752
1736#    and $t0,0xff # mask off object's hash value ...
1737##...lui $at,0
1741##...ori $at,$at,0xff
1745##...and $t0,$t0,$at
1748#    sw $t0,-8($s7) # ... and store back into -8 header-word
1752:skipMask_toString:
1752#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
1756#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
1760#    subu $t4,$t2,$t5
1764:toString_copyLoop:    
1764#    lb $t3,($t4)
1768#    and $t3,0x7f # mask off sign bit (in case first word)
1769##...lui $at,0
1773##...ori $at,$at,0x7f
1777##...and $t3,$t3,$at
1780#    sb $t3,-8($t0)
1784#    addu $t4,1
1788#    addu $t0,1
1792#    blt $t4,$t2,toString_copyLoop
1793##...slt $at,$t4,$t2
1797##...bne $at,$zero,1764

    # copy the '@' sign
1800#    li $t3,'@'
1804#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1808#    addu $t2,$t0,$t1 # address of last byte in string to store +8
1812#    lw $t3,20($sp) # hash code to print
1816:toString_hashCopyLoop:
1816#    and $t4,$t3,0xf
1820#    srl $t3,4
1824#    lb $t4,hexChars($t4)
1828#    sb $t4,-8($t2)
1832#    subu $t2,$t2,1
1836#    bgt $t2,$t0,toString_hashCopyLoop
1837##...slt $at,$t0,$t2
1841##...bne $at,$zero,1816

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
1844#    addu $sp,28
1848#    lw $ra,($sp)
1852#    addu $sp,4
1856#    move $t0, $s7 # return string we created
1860#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
1864:mth_equals_String:
    
    # quick test for obvious false
1864#    lw $t0,($sp) # second parameter
1868#    beq $t0,$zero,goEsFalse # go return false if null
1872#    lw $t1,-12($t0) # vtable pointer
1876#    la $t2,CLASS_String # string vtable pointer
1880#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
1884#    subu $sp,12
1888#    sw $ra,8($sp)
1892#    sw $s2,4($sp)
1896#    sw $t0,($sp)
1900#    jal mth_compareTo_String
1904#    lw $s2, 4($sp) #restore this pointer and pop parameters
1908#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
1912#    seq $t0,$t0,$zero
1913##...subu $at,$t0,$zero
1917##...sltiu $t0,$at,1

    # pop return address and return $t0
1920#    lw $ra,($sp)
1924#    addu $sp,4

1928#    jr $ra # return
    
1932:goEsFalse:
    # put 0 in $t0 and return
1932#    li $t0, 0
1936#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
1940:mth_toString_String:
    #we are a string, so return this.
1940#    move $t0, $s2
1944#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1948:mth_readLine_Lib:
    
1948#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1952#    sw $ra, 4($sp) # save $ra
1956#    move $t1,$sp # save "original" sp

1960:  doRead:

    # read the character
1960#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1964#    subu $t2,$v0,13
1968#    bne $t2,$zero,notReturnRL
1972#    jal readLogicalChar
1976#    subu $t2,$v0,10 # check for newline
1980#    beq $t2,$zero,foundNewLine
1984#    sw $v0,lastCharRead # push back character into queue
1988#    j foundNewLine # go process the line

1992:  notReturnRL:

    # at this point, $v0 has our character

1992#    subu $t0,$v0,10
1996#    beq $t0,$zero,foundNewLine
2000#    blt $v0,$zero,foundEof
2001##...slt $at,$v0,$zero
2005##...bne $at,$zero,2020

    # we have a character, so push it onto stack
2008#    subu $sp,$sp,4
2012#    sw $v0,($sp)

    # loop back up to get next character
2016#    j doRead

2020:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
2020#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
2024#    li $s7, 0 # return-value: null
2028#    j rlReturn # return

2032:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
2032#    subu $t0,$t1,$sp # number of chars we read (times 4)
2036#    srl $s6,$t0,2 # number of words on stack with chars
2040#    subu $sp,$sp,4 # push char-count ...
2044#    sw $s6,($sp) # ... onto stack
2048#    addu $t2,$t0,5 # GC tag, incl. for count-word
2052#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
2056#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
2060#    srl $s6,$s6,2  # data words in object
2064#    move $s7,$zero # object words in object
2068#    jal newObject  # allocate space
    
    # store header words
2072#    la $t0,CLASS_String
2076#    sw $t0,-12($s7)# store class tag (String) into object
2080#    lw $t2,4($sp) # char-count
2084#    sll $t1,$t2,2 # 4 times number of chars
2088#    subu $t2,$zero,$t2 # negative of char-count
2092#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
2096#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
2100#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
2101##...slt $at,$t0,$zero
2105##...beq $at,$zero,2124
2108#    and $t0,0xff # mask off object's hash value ...
2109##...lui $at,0
2113##...ori $at,$at,0xff
2117##...and $t0,$t0,$at
2120#    sw $t0,-8($s7) # ... and store back into -8 header-word
2124:  skipMask_readLine:

2124#    sll $t0,$t0,2 # data bytes in object
2128#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
2132#    subu $t0,$t0,$t2 # place to store last character (plus 9)
2136#    addu $sp,$sp,8 # pop redundant object-pointer and count
2140#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

2144#    beq $sp,$t1,rlReturn
2148:  charCopyLoop:
2148#    lw $t2,($sp)
2152#    sb $t2,-9($t0)
2156#    addu $sp,$sp,4
2160#    subu $t0,$t0,1
2164#    bne $sp,$t1,charCopyLoop
2168:  rlReturn:

2168#    lw $ra, 4($sp)
2172#    addu $sp, 8   # pop $ra and pointless word off stack
2176#    move $t0, $s7 # return string we allocated in $s7
2180#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
2184:mth_readInt_Lib:

    # save $ra by pushing onto stack
2184#    subu $sp,$sp,4
2188#    sw $ra,($sp)

2192:  riSkipWhiteLoop:
    # read a character
2192#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
2196#    subu $t0,$v0,32
2200#    bgt $t0,$zero,nonWhite
2201##...slt $at,$zero,$t0
2205##...bne $at,$zero,2248
2208#    beq $t0,$zero,riSkipWhiteLoop # start over if space
2212#    subu $t0,$v0,10
2216#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
2220#    subu $t0,$v0,9
2224#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
2228#    subu $t0,$v0,13
2232#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
2236#    subu $t0,$v0,12
2240#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
2244#    j badIntegerFormat # illegal integer char: abort program

2248:  nonWhite:
2248#    subu $t0,$v0,'-'
2252#    li $t4,1 # final multiplier
2256#    bne $t0,$zero,helpReadInt # go read
2260#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
2264#    jal readLogicalChar
