1388#  subu $sp, $sp, 4
1392#  sw $s2, ($sp)
1396#  lw $t0, -16($t0)
1400#  subu $sp, $sp, 4
1404#  sw $t0, ($sp)
1408#  subu $sp, $sp, 4
1412#  sw $s2, ($sp)
1416#  lw $t0, 0($t0)
1420#  subu $sp, $sp, 4
1424#  sw $t0, ($sp)
1428#  jr $ra
