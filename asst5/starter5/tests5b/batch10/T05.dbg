    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
3800#    lw $t2,-8($t1) # possible forwarding tag
3804#    bne $t2,$zero,gcNoForward1 # if not forwarding tag, go copy
3808#    lw $t2,-4($t1) # forwarding pointer: object's new address
