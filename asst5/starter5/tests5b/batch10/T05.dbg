3913##...sltu $at,$t4,$t3
3917##...bne $at,$zero,3896

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
3920#    sw $zero,-8($t1) # 0 in first header-slot
3924#    sw $t2,-4($t1) # forwarding pointer in second header-slot

    # update the stack slot with the address in the target space
3928#    sw $t2,4($t0)
3932#    lw $zero,-8($t2)
3936#    lw $zero,-4($t2)

    # go handle next stack slot (testing if done)
3940#    j gcTestIterDone1

3944:  gcBump:
    #### we have a GC tag.  Bytes to skip: tag value + 3.
3944#    subu $t0,$t0,$t1
3948#    subu $t0,$t0,3

3952:  gcTestIterDone1:
3952#    bgeu $t0,$sp,gcStackCopyLoop
3953##...sltu $at,$t0,$sp
3957##...beq $at,$zero,3768

    ###### end outer loop to copy all stack-direct objects ######

    #############################################################
    # We have finished processing the stack elements.  Now we need
    # to update elements in the heap itself. This may itself involve
    # moving additional objects
    #############################################################

    #########################################################
    # At this point:
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # We want to set things up so that in addition:
    # - $t0 is the "trailing finger", containing the address
    #   of the first slot in target space that we have yet
    #   to process.
    # Then during processing:
    # - $t1 will contain the contents of the heap slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # And when we're actually copying an object:
    # - $t2 will contain pointer to the target object
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - available for use: $s0
    ##########################################################

    # set $t0 to be at the beginning of target-space
3960#    lw $t1,cur_seg
3964#    la $t0,seg0_start
3968#    beq $t1,$zero,gcSkip4
3972#    la $t0,seg1_start
3973##...lui $t0,16
3977##...addiu $t0,$t0,5160


3980:  gcSkip4:

    # if there were no objects put into the heap during stack
    # processing, we're done, so go finish up
3980#    bgeu $t0,$s3,gcFinishUp
3981##...sltu $at,$t0,$s3
3985##...beq $at,$zero,4276

    ###### begin outer loop to copy all non-stack-direct objects ######

3988:  gcHeapCopyLoop:
    # get data count for object; swap header-word with first word
    # of object so that they're back in the right place
3988#    lw $t1,($t0) # (what will be) first header word for current object
3992#    move $t2,$t1 # number data bytes in object (poss. w/hash bits)
3996#    bge $t2,$zero,gcSkip4a # are there hash bits?
3997##...slt $at,$t2,$zero
4001##...beq $at,$zero,4016
4004#    and $t2,0xff # mask off hash bits
4005##...lui $at,0
4009##...ori $at,$at,0xff
4013##...and $t2,$t2,$at
4016:gcSkip4a:    
4016#    sll $t2,$t2,2 # # data bytes
4020#    addu $t2,$t2,8 # to skip header words
4024#    addu $t2,$t0,$t2 # pointer to new object
4028#    lw $t3,-8($t2) # word to swap
4032#    sw $t1,-8($t2) # store header word
4036#    sw $t3,($t0) # restore first word of object

    ################################################
    # at this point:
    # - $t2 contains the pointer to our new object
    ################################################

    # check if we have a data array
4040#    lw $t1,-12($t2) # vtable pointer
4044#    li $t0,dataArrayVTableStart # address of vtable for first data array
4048#    blt $t1,$t0,gcNotDataArray # if data array, no more xforming to do
4049##...slt $at,$t1,$t0
4053##...bne $at,$zero,4072

    # We have a vtable address that is a data array.
    # we need skip over it then loop back to do next object.
4056:  skipToNextObj:
4056#    lw $t1,-4($t2) # data words in (object position of) array
    #### note: we know that it's not a string, so the value will
    #### not be artificially negative
4060#    sll $t1,$t1,2 # convert to byte-count
4064#    addu $t0,$t2,$t1 # skip over object
4068#    j gcTestIterDone2 # go do next object, if any

    ###################################################
    # at this point:
    # - the object has been restored to normal status--that is, the
    #   word-swap has been done
    # - $t2 contains a pointer to the object
    ###################################################
    
4072:  gcNotDataArray:
4072#    lw $t3,-4($t2) # # object words (negative treated as zero)
4076#    bge $t3,$zero,gcH2Neg2
4077##...slt $at,$t3,$zero
4081##...beq $at,$zero,4088
4084#    move $t3,$zero
4088:  gcH2Neg2:
4088#    sll $t3,$t3,2 # # object bytes
4092#    move $t0,$t2 # address of first pointer in object
4096#    add $s1,$t2,$t3 # limit address for this object

    #####################################################
    # At this point, we have to "translate" all pointers,
    # starting at $t0 to (but not including) $s1
    #####################################################

    # if there are no pointer-slots (i.e., $t0=$s1), skip this
    # part
4100#    beq $t0,$s1,gcTestIterDone2
    
4104:  gcNextPointerInObject:
    # get pointer from object
4104#    lw $t1,($t0)

    # if value is out of range, and is therefore does not refer
    # to an object, just go loop back and do the next one
4108#    bleu $t1,$t6,gcGoNextPointerSlot
4109##...sltu $at,$t6,$t1
4113##...beq $at,$zero,4256
4116#    bgtu $t1,$t7,gcGoNextPointerSlot
4117##...sltu $at,$t7,$t1
4121##...bne $at,$zero,4256

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
4124#    lw $t8,-8($t1) # possible forwarding tag
4128#    bne $t8,$zero,gcNoForward2 # if not forwarding tag, go copy
4132#    lw $t8,-4($t1) # forwarding pointer: object's new address
4136#    sw $t8,($t0) # update pointer in object
4140#    j gcGoNextPointerSlot # do next iteration

4144:  gcNoForward2:
    #########################################################
    # we actually need to copy the object into the new space
    #########################################################

    #########################################################
    # At this point:
    # - $t0 contains the address of the heap-slot we're translating
    # - $t1 will contain the contents of the heap-slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first unallocated address of the
    #   target space, which will also be the first address
    #   of the target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # Then during processing:
    # And when we're actually copying an object:
    # - $t3 will contain the limit address of the source object
    # - $t4 will contain the first address of the source object
    # - $s1 will contain the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $t8 will contain a pointer to the target object
    # - available for use: $s0, $t8, $t9
    ##########################################################

    # compute the amount of space that is needed
4144#    bge $t8,$zero,gcSkip5 # # words in negative-offset portion
4145##...slt $at,$t8,$zero
4149##...beq $at,$zero,4164
4152#    and $t8,0xff # mask off hash bits
4153##...lui $at,0
4157##...ori $at,$at,0xff
4161##...and $t8,$t8,$at

4164:  gcSkip5:
4164#    sll $t8,$t8,2 # bytes in negative-offset portion ...
4168#    addu $t8,$t8,8 # ... add in bytes for header-words
4172#    subu $t4,$t1,$t8 # address of first word of source object
4176#    lw $t3,-4($t1) # # words in positive-offset portion
4180#    bge $t3,$zero,gcNoNeg
4181##...slt $at,$t3,$zero
4185##...beq $at,$zero,4192
4188#    move $t3,$zero # negative treated as zero
4192:  gcNoNeg:
4192#    sll $t3,$t3,2 # bytes in negative-offset portion
4196#    addu $t3,$t3,$t1 # address one word past last word of source

4200#    addu $t8,$s3,$t8 # pointer to target object

    #########################################################
    # At this point:
    # - $t0 contains the address of the stack slot we'll
    #   process next
    # - $t1 contains the contents of the stack slot we're
    #   currently working on, which is a pointer to the source
    #   object
    # - $t2 will contains pointer to the object we're in the
    #   middle of translating
    # - $t3 contains the limit address of the source object
    # - $t4 contains the first address of the source object
    # - $t5 contains the value 0x80000000
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $t8 contains the pointer to the target object
    # - $s1 contains the the limit address for the current
    #   object that tells where the pointers in the object end
    # - $s3 contains the first unallocated address of the
    #   target space, which is also the first address of the
    #   target object
    # - $s4 contains the limit address of the target space
    # - $s5 contains the value 5
    # - $s6-7 contain the original parameters to the call to
    #   'newObject'
    # - $sp contains the address of the top stack element
    # - available for use: $s0, $t9
    #########################################################

    # swap first header word and first data word so that header
        # can be found by "trailing finger"
4204#    lw $s0,($t4)
4208#    lw $t9,-8($t1)
4212#    sw $t9,($t4)
4216#    sw $s0,-8($t1)

    # copy all source bytes to the target
4220:  gCinnerCopy2:
4220#    lw $s0,($t4)
4224#    sw $s0,($s3)
4228#    addu $t4,$t4,4
4232#    addu $s3,$s3,4
4236#    bltu $t4,$t3,gCinnerCopy2
4237##...sltu $at,$t4,$t3
4241##...bne $at,$zero,4220

    ###########################################################
    # All bytes have been copied to the target space.  We still
    # need to:
    # - set up forwarding pointer in source object
    # - update the pointer in the current stack slot
    ###########################################################

    # set up the forwarding pointer
4244#    sw $zero,-8($t1) # 0 in first header-slot
4248#    sw $t8,-4($t1) # forwarding pointer in second header-slot

    # update the heap-slot with the address in the target space
4252#    sw $t8,($t0)

4256:  gcGoNextPointerSlot:
    # bump $t0 to next slot in object; if not done, loop back
4256#    addu $t0,$t0,4
4260#    bltu $t0,$s1,gcNextPointerInObject
4261##...sltu $at,$t0,$s1
4265##...bne $at,$zero,4104

4268:  gcTestIterDone2:
4268#    bltu $t0,$s3,gcHeapCopyLoop
4269##...sltu $at,$t0,$s3
4273##...bne $at,$zero,3988

    ###### end outer loop to copy all non-stack-direct objects ######

4276:  gcFinishUp:
    # restore $s2 to its updated value by popping off stack
4276#    lw $s2,($sp)
4280#    addu $sp,$sp,4

    # mark us as having already GC'd
4284#    move $t5,$s5

    # go try and allocate again
4288#    j gcJoin
        

########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
4292:vm_init:

    # mark bottom of stack
4292#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
4296#    move $s2,$zero

    #set up the "five" register
4300#    li $s5,5

4304#    la $s3,seg0_start
4308#    la $s4,seg0_end
4309##...lui $s4,16
4313##...addiu $s4,$s4,5160
    
    # return
4316#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4320:divide:
    # get parameters; abort if divisor zero
4320#    lw $t0,($sp)
4324#    lw $t1,8($sp)
4328#    beq $t0,$zero,divByZeroError
    
    # perform division
4332#    div $t1,$t0
4336#    mflo $t0

    # store result, adjust stack and return
4340#    addu $sp,$sp,8 # adjust stack
4344#    sw $t0,($sp) # store result
4348#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
4352:remainder:
    # get parameters; abort if divisor zero
4352#    lw $t0,($sp)
4356#    lw $t1,8($sp)
4360#    beq $t0,$zero,divByZeroError
    
    # perform division
4364#    div $t1,$t0
4368#    mfhi $t0

    # store result, adjust stack and return
4372#    addu $sp,$sp,8 # adjust stack
4376#    sw $t0,($sp) # store result
4380#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
4384:checkCast:
    # get object, allow immediately if null
4384#    lw $t2,($sp)
4388#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
4392#    lw $t2,-12($t2) # vtable address
4396#    bge $t2,$t1,castException
4397##...slt $at,$t2,$t1
4401##...beq $at,$zero,4536
4404#    blt $t2,$t0,castException
4405##...slt $at,$t2,$t0
4409##...bne $at,$zero,4536
    
    # return, leaving object unchanged on stack
4412:  checkCastReturn:    
4412#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
4416:instanceOf:
    # get object, go return false if null
4416#    lw $t2,($sp)
4420#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
4424#    lw $t2,-12($t2) # vtable address
4428#    sge $t0,$t2,$t0 # are we >= the lower limit?
4429##...slt $t0,$t2,$t0
4433##...xori $t0,$t0,0x1
4436#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
4440#    and $t2,$t0,$t1
4444#    sw $t2,($sp)
4448:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
4448#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

4452:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
4452#    li $v0,4 # syscall-code for print-string
4456#    syscall
4460:exit:
    # print termination message
4460#    li $v0,4 # syscall-code for print-string
4464#    la $a0,exitString
4468#    syscall

    # terminate execution
4472#    li $v0,10 #syscall-code for "exit"
4476#    syscall

4480:outOfHeapMemory:
4480#    la $a0,heapMemoryMsg
4484#    j exitError
4488:divByZeroError:
4488#    la $a0,divByZeroMsg
4492#    j exitError
4496:strIndexOutOfBounds:
4496#    la $a0,strIndexOutOfBoundsMsg
4500#    j exitError
4504:arrayIndexOutOfBounds:
4504#    la $a0,arrayIndexOutOfBoundsMsg
4508#    j exitError
4512:arraySizeOutOfBounds:
4512#    la $a0,arraySizeOutOfBoundsMsg
4516#    j exitError
4520:nullPtrException:
4520#    la $a0,nullPtrExceptionMsg
4524#    j exitError
4528:badIntegerFormat:
4528#    la $a0,badIntegerFormatMsg
4532#    j exitError
4536:castException:
4536#    la $a0,castExceptionMsg
4540#    j exitError
############## data section ################
    .data
4796:hexChars:
    .ascii "0123456789abcdef"
    .align 2
4812:cur_seg:
    .word 0

4816:lastCharRead:
    .word -2 # -2 => no buffered character
4820:prevHashConstant:
    .word 0x2785173c
4824:gcCount:
    .word 0

4828:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
4855:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
4878:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
4913:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
4947:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
4980:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
5011:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
5059:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
5080:gcMsg: 
      .asciiz "\nGC!\n"
5086:gcCountMsg: 
      .asciiz "Number of garbage collections: "

5118:nullStr:
    .asciiz "null"
5123:trueString:
    .asciiz "true"
5128:falseString:
    .asciiz "false"
5134:exitString:
    .ascii "Program terminated."
    #### "falls through" here
5153:newlineString:
    .asciiz "\n"
    
    .align 2
5156:stack_bottom:
    .word 0

# heapFudge: # temporary fudge amount to exercise GC
#     .word 0

5160:seg0_start:
    .space 0x100000
1053736:seg0_end:
1053736:seg1_start:
    .space 0x100000
2102312:seg1_end:
