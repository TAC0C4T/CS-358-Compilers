
    # determine if we have enough memory available
2176#    addu $t0,$s6,$s7
2180#    sll $t0,$t0,2
2184#    addu $t0,$t0,8 # amount of memory needed
2188#    addu $t1,$t0,$s3
2192#    bgtu $t1,$s4,doGC
