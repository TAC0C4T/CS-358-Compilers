########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
3064:instanceOf:
    # get object, go return false if null
3064#    lw $t2,($sp)
3068#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
3072#    lw $t2,-12($t2) # vtable address
3076#    sge $t0,$t2,$t0 # are we >= the lower limit?
3077##...slt $t0,$t2,$t0
3081##...xori $t0,$t0,0x1
3084#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3088#    and $t2,$t0,$t1
3092#    sw $t2,($sp)
3096:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3096#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3100:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3100#    li $v0,4 # syscall-code for print-string
3104#    syscall
3108:exit:
    # print termination message
3108#    li $v0,4 # syscall-code for print-string
3112#    la $a0,exitString
3116#    syscall

    # terminate execution
3120#    li $v0,10 #syscall-code for "exit"
3124#    syscall

3128:outOfHeapMemory:
3128#    la $a0,heapMemoryMsg
3132#    j exitError
3136:divByZeroError:
3136#    la $a0,divByZeroMsg
3140#    j exitError
3144:strIndexOutOfBounds:
3144#    la $a0,strIndexOutOfBoundsMsg
3148#    j exitError
3152:arrayIndexOutOfBounds:
3152#    la $a0,arrayIndexOutOfBoundsMsg
3156#    j exitError
3160:arraySizeOutOfBounds:
3160#    la $a0,arraySizeOutOfBoundsMsg
3164#    j exitError
3168:nullPtrException:
3168#    la $a0,nullPtrExceptionMsg
3172#    j exitError
3176:badIntegerFormat:
3176#    la $a0,badIntegerFormatMsg
3180#    j exitError
3184:castException:
3184#    la $a0,castExceptionMsg
3188#    j exitError
############## data section ################
    .data
3372:hexChars:
    .ascii "0123456789abcdef"
    .align 2
3388:cur_seg:
    .word 0

3392:lastCharRead:
    .word -2 # -2 => no buffered character
3396:prevHashConstant:
    .word 0x2785173c
3400:gcCount:
    .word 0

3404:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
3431:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
3454:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
3489:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
3523:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
3556:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
3587:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
3635:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
3656:gcMsg: 
      .asciiz "\nGC!\n"
3662:gcCountMsg: 
      .asciiz "Number of garbage collections: "

3694:nullStr:
    .asciiz "null"
3699:trueString:
    .asciiz "true"
3704:falseString:
    .asciiz "false"
3710:exitString:
    .ascii "Program terminated."
    #### "falls through" here
3729:newlineString:
    .asciiz "\n"
    
    .align 2
3732:stack_bottom:
    .word 0

