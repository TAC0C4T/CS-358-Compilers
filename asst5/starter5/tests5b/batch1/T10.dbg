.globl main
0:main:
0#  jal vm_init
4#  li $v0, 10
8#  syscall
12:mth_main_Main:
12#  li $t0, 3
16#  subu $sp, $sp, 8
20#  sw $s5, 4($sp)
24#  sw $t0, 0($sp)
28#  li $t0, 52
32#  subu $sp, $sp, 8
36#  sw $s5, 4($sp)
40#  sw $t0, 0($sp)
44#  lw $t2, ($sp)
48#  addu $sp, $sp, 4
52#  lw $t1, ($sp)
56#  addu $sp, $sp, 4
60#  seq $t0, $t1, $t2
61##...subu $at,$t1,$t2
65##...sltiu $t0,$at,1
68#  subu $sp, $sp, 4
72#  sw $t0, ($sp)
76#  subu $sp, $sp, 4
80#  sw $s2, ($sp)
84#  jr $ra
##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
88:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
88#    lw $t0,-8($s2) # get word with hash bits from this
92#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
96#    addu $t0,$t1

100#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
104:mth_equals_Object:
104#    move $t0,$s2 # first pointer (this)
108#    lw $t1,($sp) # second pointer
112#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
113##...subu $at,$t0,$t1
117##...sltiu $t0,$at,1

120#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
124:mth_hashCode_String:
124#    move $t0,$s2 # put this pointer in t0

128#    li $t2,0 # current hash value
132#    lw $t1,-4($t0) # negative of number of characters in string
136#    beq $t1,$zero,done_hashCode_String # if zero length => done
140#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
144#    and $t0,0xfffffffc # adjust for padding
145##...lui $at,65535
149##...ori $at,$at,0xfffc
153##...and $t0,$t0,$at
156#    subu $t1,$t0,$t1 # address at end of string +12
160:loop_hashCode_String:    
160#    sll $t4,$t2,5 # multiply by 32
164#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
168#    lbu $t3,-12($t0) # current character
172#    addu $t2,$t3 # add in current character
176#    addu $t0,1 # go to next character's address
180#    bne $t0,$t1,loop_hashCode_String # loop back if more
184:done_hashCode_String:    

    # push int on stack
184#    move $t0, $t2 # put $t2 in return slot
188#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
192:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
192#    subu $sp,4
196#    sw $ra,($sp)
    
    # get hash value
200#    lw $t2,-12($s2) # vtable address
204#    lw $t0,($t2) # method address
208#    jalr $t0
212#    subu $sp,8 # push result (int in $t0) on stack
216#    sw $s5,4($sp)
220#    sw $t0,($sp)

    # compute print-size of hash value
224#    li $t0, 1
228#    lw $t1, ($sp)
232#    srl $t1,$t1,4
236#    beq $t1,$zero,toString_skip_loop
240:toString_loop_top:
240#    addu $t0,1
244#    srl $t1,$t1,4
248#    bne $t1,$zero,toString_loop_top
252:toString_skip_loop:
252#    subu $sp,8
256#    sw $s5,4($sp)
260#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
264#    lw $t2,-12($s2) # vtable address
268#    move $t0,$t2
272:toString_checkTagBit:
272#    subu $t0,1
276#    lb $t1,($t0)
280#    and $t1,0x80
281##...lui $at,0
285##...ori $at,$at,0x80
289##...and $t1,$t1,$at
292#    beq $t1,$zero,toString_checkTagBit
296#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
300#    subu $sp,8
304#    sw $t1,($sp)
308#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
312#    move $s7,$zero # -4 offset header word
316#    lw $t4,8($sp) # bytes for hash value
320#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
324#    addu $t4,8
328#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
332#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

336#    li $t0,CLASS_String # store string vtable address into ...
340#    sw $t0,-12($s7) # ... -12 offset in object header
344#    lw $t2,-12($s2) # our object's vtable address
348#    lw $t5,4($sp) # number characters in prefix
352#    lw $t1,12($sp) # number of characters in hashcode
356#    addu $t3,$t1,$t5 # number of characters in string ...
360#    addu $t3,1 # ... including the '@' character
364#    subu $t0,$zero,$t3 # store negated length into ...
368#    sw $t0,-4($s7) # ... -4 offset header word
372#    lw $t0,-8($s7) # get -8 offset header-word
376#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
377##...slt $at,$t0,$zero
381##...beq $at,$zero,400
384#    and $t0,0xff # mask off object's hash value ...
385##...lui $at,0
389##...ori $at,$at,0xff
393##...and $t0,$t0,$at
396#    sw $t0,-8($s7) # ... and store back into -8 header-word
400:skipMask_toString:
400#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
404#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
408#    subu $t4,$t2,$t5
412:toString_copyLoop:    
412#    lb $t3,($t4)
416#    and $t3,0x7f # mask off sign bit (in case first word)
417##...lui $at,0
421##...ori $at,$at,0x7f
425##...and $t3,$t3,$at
428#    sb $t3,-8($t0)
432#    addu $t4,1
436#    addu $t0,1
440#    blt $t4,$t2,toString_copyLoop
441##...slt $at,$t4,$t2
445##...bne $at,$zero,412

    # copy the '@' sign
448#    li $t3,'@'
452#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
456#    addu $t2,$t0,$t1 # address of last byte in string to store +8
460#    lw $t3,20($sp) # hash code to print
464:toString_hashCopyLoop:
464#    and $t4,$t3,0xf
468#    srl $t3,4
472#    lb $t4,hexChars($t4)
476#    sb $t4,-8($t2)
480#    subu $t2,$t2,1
484#    bgt $t2,$t0,toString_hashCopyLoop
485##...slt $at,$t0,$t2
489##...bne $at,$zero,464

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
492#    addu $sp,28
496#    lw $ra,($sp)
500#    addu $sp,4
504#    move $t0, $s7 # return string we created
508#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
512:mth_equals_String:
    
    # quick test for obvious false
512#    lw $t0,($sp) # second parameter
516#    beq $t0,$zero,goEsFalse # go return false if null
520#    lw $t1,-12($t0) # vtable pointer
524#    la $t2,CLASS_String # string vtable pointer
528#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
532#    subu $sp,12
536#    sw $ra,8($sp)
540#    sw $s2,4($sp)
544#    sw $t0,($sp)
548#    jal mth_compareTo_String
552#    lw $s2, 4($sp) #restore this pointer and pop parameters
556#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
560#    seq $t0,$t0,$zero
561##...subu $at,$t0,$zero
565##...sltiu $t0,$at,1

    # pop return address and return $t0
568#    lw $ra,($sp)
572#    addu $sp,4

576#    jr $ra # return
    
580:goEsFalse:
    # put 0 in $t0 and return
580#    li $t0, 0
584#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
588:mth_toString_String:
    #we are a string, so return this.
588#    move $t0, $s2
592#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
596:mth_readLine_Lib:
    
596#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
600#    sw $ra, 4($sp) # save $ra
604#    move $t1,$sp # save "original" sp

608:  doRead:

    # read the character
608#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
612#    subu $t2,$v0,13
616#    bne $t2,$zero,notReturnRL
620#    jal readLogicalChar
624#    subu $t2,$v0,10 # check for newline
628#    beq $t2,$zero,foundNewLine
632#    sw $v0,lastCharRead # push back character into queue
636#    j foundNewLine # go process the line

640:  notReturnRL:

    # at this point, $v0 has our character

640#    subu $t0,$v0,10
644#    beq $t0,$zero,foundNewLine
648#    blt $v0,$zero,foundEof
649##...slt $at,$v0,$zero
653##...bne $at,$zero,668

    # we have a character, so push it onto stack
656#    subu $sp,$sp,4
660#    sw $v0,($sp)

    # loop back up to get next character
664#    j doRead

668:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
668#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
672#    li $s7, 0 # return-value: null
676#    j rlReturn # return

680:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
680#    subu $t0,$t1,$sp # number of chars we read (times 4)
684#    srl $s6,$t0,2 # number of words on stack with chars
688#    subu $sp,$sp,4 # push char-count ...
692#    sw $s6,($sp) # ... onto stack
