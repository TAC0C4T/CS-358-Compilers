########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
2940:vm_init:

    # mark bottom of stack
2940#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
2944#    move $s2,$zero

    #set up the "five" register
2948#    li $s5,5

2952#    la $s3,seg0_start
2956#    la $s4,seg0_end
2957##...lui $s4,16
2961##...addiu $s4,$s4,3736
    
    # return
2964#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
2968:divide:
    # get parameters; abort if divisor zero
2968#    lw $t0,($sp)
2972#    lw $t1,8($sp)
2976#    beq $t0,$zero,divByZeroError
    
    # perform division
2980#    div $t1,$t0
2984#    mflo $t0

    # store result, adjust stack and return
2988#    addu $sp,$sp,8 # adjust stack
2992#    sw $t0,($sp) # store result
2996#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
3000:remainder:
    # get parameters; abort if divisor zero
3000#    lw $t0,($sp)
3004#    lw $t1,8($sp)
3008#    beq $t0,$zero,divByZeroError
    
    # perform division
3012#    div $t1,$t0
3016#    mfhi $t0

    # store result, adjust stack and return
3020#    addu $sp,$sp,8 # adjust stack
3024#    sw $t0,($sp) # store result
3028#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
3032:checkCast:
    # get object, allow immediately if null
3032#    lw $t2,($sp)
3036#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
3040#    lw $t2,-12($t2) # vtable address
3044#    bge $t2,$t1,castException
3045##...slt $at,$t2,$t1
3049##...beq $at,$zero,3184
3052#    blt $t2,$t0,castException
3053##...slt $at,$t2,$t0
3057##...bne $at,$zero,3184
    
    # return, leaving object unchanged on stack
3060:  checkCastReturn:    
3060#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    
