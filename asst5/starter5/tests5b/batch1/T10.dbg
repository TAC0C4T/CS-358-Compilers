2260#    sw $t1,prevHashConstant # update hash constant
2264#    or $t1,0x80000000 # set top bit
2265##...lui $at,32768
2269##...or $t1,$at,$t1
2272#    and $t1,0xffffff00 # clear low bit
2273##...lui $at,65535
2277##...ori $at,$at,0xff00
2281##...and $t1,$t1,$at
2284#    or $s6,$t1
2288:firstHeaderLarge:
2288#    sw $s6,-8($t0) # store header-1 value
2292#    lw $zero,-8($t0)

    # store second header-value
2296#    sw $s7,-4($t0)   # second header-word
2300#    lw $zero,-4($t0)
    
    # put return-value into $s7 and also push it onto top of stack
2304#    move $s7,$t0
2308#    subu $sp,$sp,4
2312#    sw $t0,($sp)
