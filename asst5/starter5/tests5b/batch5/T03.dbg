##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
496:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
496#    lw $t0,-8($s2) # get word with hash bits from this
500#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
504#    addu $t0,$t1

508#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
512:mth_equals_Object:
512#    move $t0,$s2 # first pointer (this)
516#    lw $t1,($sp) # second pointer
520#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
521##...subu $at,$t0,$t1
525##...sltiu $t0,$at,1

528#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
532:mth_hashCode_String:
532#    move $t0,$s2 # put this pointer in t0

536#    li $t2,0 # current hash value
540#    lw $t1,-4($t0) # negative of number of characters in string
544#    beq $t1,$zero,done_hashCode_String # if zero length => done
548#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
552#    and $t0,0xfffffffc # adjust for padding
553##...lui $at,65535
557##...ori $at,$at,0xfffc
561##...and $t0,$t0,$at
564#    subu $t1,$t0,$t1 # address at end of string +12
568:loop_hashCode_String:    
568#    sll $t4,$t2,5 # multiply by 32
572#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
576#    lbu $t3,-12($t0) # current character
580#    addu $t2,$t3 # add in current character
584#    addu $t0,1 # go to next character's address
588#    bne $t0,$t1,loop_hashCode_String # loop back if more
592:done_hashCode_String:    

    # push int on stack
592#    move $t0, $t2 # put $t2 in return slot
596#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
600:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
600#    subu $sp,4
604#    sw $ra,($sp)
    
    # get hash value
608#    lw $t2,-12($s2) # vtable address
612#    lw $t0,($t2) # method address
616#    jalr $t0
620#    subu $sp,8 # push result (int in $t0) on stack
624#    sw $s5,4($sp)
628#    sw $t0,($sp)

    # compute print-size of hash value
632#    li $t0, 1
636#    lw $t1, ($sp)
640#    srl $t1,$t1,4
644#    beq $t1,$zero,toString_skip_loop
648:toString_loop_top:
648#    addu $t0,1
652#    srl $t1,$t1,4
656#    bne $t1,$zero,toString_loop_top
660:toString_skip_loop:
660#    subu $sp,8
664#    sw $s5,4($sp)
668#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
672#    lw $t2,-12($s2) # vtable address
676#    move $t0,$t2
680:toString_checkTagBit:
680#    subu $t0,1
684#    lb $t1,($t0)
688#    and $t1,0x80
689##...lui $at,0
693##...ori $at,$at,0x80
697##...and $t1,$t1,$at
700#    beq $t1,$zero,toString_checkTagBit
704#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
708#    subu $sp,8
712#    sw $t1,($sp)
716#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
720#    move $s7,$zero # -4 offset header word
724#    lw $t4,8($sp) # bytes for hash value
728#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
732#    addu $t4,8
736#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
740#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

744#    li $t0,CLASS_String # store string vtable address into ...
748#    sw $t0,-12($s7) # ... -12 offset in object header
752#    lw $t2,-12($s2) # our object's vtable address
756#    lw $t5,4($sp) # number characters in prefix
760#    lw $t1,12($sp) # number of characters in hashcode
764#    addu $t3,$t1,$t5 # number of characters in string ...
768#    addu $t3,1 # ... including the '@' character
772#    subu $t0,$zero,$t3 # store negated length into ...
776#    sw $t0,-4($s7) # ... -4 offset header word
780#    lw $t0,-8($s7) # get -8 offset header-word
784#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
785##...slt $at,$t0,$zero
789##...beq $at,$zero,808
792#    and $t0,0xff # mask off object's hash value ...
793##...lui $at,0
797##...ori $at,$at,0xff
801##...and $t0,$t0,$at
804#    sw $t0,-8($s7) # ... and store back into -8 header-word
808:skipMask_toString:
808#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
812#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
816#    subu $t4,$t2,$t5
820:toString_copyLoop:    
820#    lb $t3,($t4)
824#    and $t3,0x7f # mask off sign bit (in case first word)
825##...lui $at,0
829##...ori $at,$at,0x7f
833##...and $t3,$t3,$at
836#    sb $t3,-8($t0)
840#    addu $t4,1
844#    addu $t0,1
848#    blt $t4,$t2,toString_copyLoop
849##...slt $at,$t4,$t2
853##...bne $at,$zero,820

    # copy the '@' sign
856#    li $t3,'@'
860#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
864#    addu $t2,$t0,$t1 # address of last byte in string to store +8
868#    lw $t3,20($sp) # hash code to print
872:toString_hashCopyLoop:
872#    and $t4,$t3,0xf
876#    srl $t3,4
880#    lb $t4,hexChars($t4)
884#    sb $t4,-8($t2)
888#    subu $t2,$t2,1
892#    bgt $t2,$t0,toString_hashCopyLoop
893##...slt $at,$t0,$t2
897##...bne $at,$zero,872

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
900#    addu $sp,28
904#    lw $ra,($sp)
908#    addu $sp,4
912#    move $t0, $s7 # return string we created
916#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
920:mth_equals_String:
    
    # quick test for obvious false
920#    lw $t0,($sp) # second parameter
924#    beq $t0,$zero,goEsFalse # go return false if null
928#    lw $t1,-12($t0) # vtable pointer
932#    la $t2,CLASS_String # string vtable pointer
