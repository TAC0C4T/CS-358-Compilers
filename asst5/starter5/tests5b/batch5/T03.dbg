###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1004:mth_readLine_Lib:
    
1004#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1008#    sw $ra, 4($sp) # save $ra
1012#    move $t1,$sp # save "original" sp

1016:  doRead:

    # read the character
1016#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1020#    subu $t2,$v0,13
1024#    bne $t2,$zero,notReturnRL
1028#    jal readLogicalChar
1032#    subu $t2,$v0,10 # check for newline
1036#    beq $t2,$zero,foundNewLine
1040#    sw $v0,lastCharRead # push back character into queue
1044#    j foundNewLine # go process the line

1048:  notReturnRL:

    # at this point, $v0 has our character

1048#    subu $t0,$v0,10
1052#    beq $t0,$zero,foundNewLine
1056#    blt $v0,$zero,foundEof
1057##...slt $at,$v0,$zero
1061##...bne $at,$zero,1076

    # we have a character, so push it onto stack
1064#    subu $sp,$sp,4
1068#    sw $v0,($sp)

    # loop back up to get next character
1072#    j doRead

1076:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1076#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1080#    li $s7, 0 # return-value: null
1084#    j rlReturn # return

1088:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1088#    subu $t0,$t1,$sp # number of chars we read (times 4)
1092#    srl $s6,$t0,2 # number of words on stack with chars
1096#    subu $sp,$sp,4 # push char-count ...
1100#    sw $s6,($sp) # ... onto stack
1104#    addu $t2,$t0,5 # GC tag, incl. for count-word
1108#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1112#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1116#    srl $s6,$s6,2  # data words in object
1120#    move $s7,$zero # object words in object
1124#    jal newObject  # allocate space
    
    # store header words
1128#    la $t0,CLASS_String
1132#    sw $t0,-12($s7)# store class tag (String) into object
1136#    lw $t2,4($sp) # char-count
1140#    sll $t1,$t2,2 # 4 times number of chars
1144#    subu $t2,$zero,$t2 # negative of char-count
1148#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1152#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1156#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1157##...slt $at,$t0,$zero
1161##...beq $at,$zero,1180
1164#    and $t0,0xff # mask off object's hash value ...
1165##...lui $at,0
1169##...ori $at,$at,0xff
1173##...and $t0,$t0,$at
1176#    sw $t0,-8($s7) # ... and store back into -8 header-word
1180:  skipMask_readLine:

1180#    sll $t0,$t0,2 # data bytes in object
1184#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1188#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1192#    addu $sp,$sp,8 # pop redundant object-pointer and count
1196#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

1200#    beq $sp,$t1,rlReturn
1204:  charCopyLoop:
1204#    lw $t2,($sp)
1208#    sb $t2,-9($t0)
1212#    addu $sp,$sp,4
1216#    subu $t0,$t0,1
1220#    bne $sp,$t1,charCopyLoop
1224:  rlReturn:

1224#    lw $ra, 4($sp)
1228#    addu $sp, 8   # pop $ra and pointless word off stack
1232#    move $t0, $s7 # return string we allocated in $s7
1236#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1240:mth_readInt_Lib:

    # save $ra by pushing onto stack
1240#    subu $sp,$sp,4
1244#    sw $ra,($sp)

1248:  riSkipWhiteLoop:
    # read a character
1248#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
1252#    subu $t0,$v0,32
1256#    bgt $t0,$zero,nonWhite
1257##...slt $at,$zero,$t0
1261##...bne $at,$zero,1304
1264#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1268#    subu $t0,$v0,10
1272#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1276#    subu $t0,$v0,9
1280#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1284#    subu $t0,$v0,13
1288#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1292#    subu $t0,$v0,12
1296#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1300#    j badIntegerFormat # illegal integer char: abort program

1304:  nonWhite:
1304#    subu $t0,$v0,'-'
1308#    li $t4,1 # final multiplier
1312#    bne $t0,$zero,helpReadInt # go read
1316#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1320#    jal readLogicalChar

1324:  helpReadInt:
1324#    li $t2,10
1328#    subu $t1,$v0,'0' # convert digit to 0-9 value
1332#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
1333##...sltu $at,$t1,$t2
1337##...beq $at,$zero,3584
1340#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

1344:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

1344#    jal readLogicalChar # read next character
1348#    subu $t1,$v0,'0' # convert digit to 0-9 value
1352#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
1353##...sltu $at,$t1,$t2
1357##...beq $at,$zero,1376

1360#    mul $t3,$t3,$t2 # multiply old value by 10
1361##...mult $t3,$t2
1365##...mflo $t3
1368#    addu $t3,$t3,$t1 # add in value of new digit
1372#    j digitLoop

1376:  doneDigitLoop:

    # "push back" unused character into queue
1376#    sw $v0,lastCharRead

    # restore return address
1380#    lw $ra,($sp)
1384#    addu $sp, 4
