###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
800:mth_readInt_Lib:

    # save $ra by pushing onto stack
800#    subu $sp,$sp,4
804#    sw $ra,($sp)

808:  riSkipWhiteLoop:
    # read a character
808#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
812#    subu $t0,$v0,32
816#    bgt $t0,$zero,nonWhite
817##...slt $at,$zero,$t0
821##...bne $at,$zero,864
824#    beq $t0,$zero,riSkipWhiteLoop # start over if space
828#    subu $t0,$v0,10
832#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
836#    subu $t0,$v0,9
840#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
844#    subu $t0,$v0,13
848#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
852#    subu $t0,$v0,12
856#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
860#    j badIntegerFormat # illegal integer char: abort program

864:  nonWhite:
864#    subu $t0,$v0,'-'
868#    li $t4,1 # final multiplier
872#    bne $t0,$zero,helpReadInt # go read
876#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
880#    jal readLogicalChar

884:  helpReadInt:
884#    li $t2,10
888#    subu $t1,$v0,'0' # convert digit to 0-9 value
892#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
893##...sltu $at,$t1,$t2
897##...beq $at,$zero,3144
900#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

904:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

904#    jal readLogicalChar # read next character
908#    subu $t1,$v0,'0' # convert digit to 0-9 value
912#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
913##...sltu $at,$t1,$t2
917##...beq $at,$zero,936

920#    mul $t3,$t3,$t2 # multiply old value by 10
921##...mult $t3,$t2
925##...mflo $t3
928#    addu $t3,$t3,$t1 # add in value of new digit
932#    j digitLoop

936:  doneDigitLoop:

    # "push back" unused character into queue
936#    sw $v0,lastCharRead

    # restore return address
940#    lw $ra,($sp)
944#    addu $sp, 4

