    # lower limit, and if we're < the higher limit
3040#    lw $t2,-12($t2) # vtable address
3044#    sge $t0,$t2,$t0 # are we >= the lower limit?
3045##...slt $t0,$t2,$t0
3049##...xori $t0,$t0,0x1
3052#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
3056#    and $t2,$t0,$t1
3060#    sw $t2,($sp)
3064:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
3064#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

3068:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
3068#    li $v0,4 # syscall-code for print-string
3072#    syscall
3076:exit:
    # print termination message
3076#    li $v0,4 # syscall-code for print-string
3080#    la $a0,exitString
3084#    syscall

    # terminate execution
3088#    li $v0,10 #syscall-code for "exit"
3092#    syscall

3096:outOfHeapMemory:
3096#    la $a0,heapMemoryMsg
3100#    j exitError
3104:divByZeroError:
3104#    la $a0,divByZeroMsg
3108#    j exitError
3112:strIndexOutOfBounds:
3112#    la $a0,strIndexOutOfBoundsMsg
3116#    j exitError
3120:arrayIndexOutOfBounds:
3120#    la $a0,arrayIndexOutOfBoundsMsg
3124#    j exitError
3128:arraySizeOutOfBounds:
3128#    la $a0,arraySizeOutOfBoundsMsg
3132#    j exitError
3136:nullPtrException:
3136#    la $a0,nullPtrExceptionMsg
3140#    j exitError
3144:badIntegerFormat:
3144#    la $a0,badIntegerFormatMsg
3148#    j exitError
3152:castException:
3152#    la $a0,castExceptionMsg
3156#    j exitError
############## data section ################
    .data
3400:hexChars:
    .ascii "0123456789abcdef"
    .align 2
3416:cur_seg:
    .word 0

3420:lastCharRead:
    .word -2 # -2 => no buffered character
3424:prevHashConstant:
    .word 0x2785173c
3428:gcCount:
    .word 0

3432:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
3459:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
