########################################################
# str.charAt(n) - library method (class String)
# accesses a character in a string, as in Java
# - parameters:
#   - ($sp) - the index, n
#   - 4($sp) - GC tag
#   - 8($sp) - old this pointer
#   - $s2    - this pointer
# - returns:
#   - $t0 - the character found.
########################################################
1604:mth_charAt_String:
    # get string
1604#    move $t0,$s2

    # check that index is in bounds
1608#    lw $t1,-4($t0) # negative of # data words in string
1612#    subu $t3,$zero,$t1 # # chars in string
1616#    lw $t2,($sp) # index
1620#    bgeu $t2,$t3,strIndexOutOfBounds
1621##...sltu $at,$t2,$t3
1625##...beq $at,$zero,3112

    # access element
1628#    lw $t1,-8($t0) # # data words in object
1632#    sll $t1,$t1,2 # - byte-offset from end of chars
1636#    subu $t1,$t2,$t1 # - address of first char in string, offset by 8
1640#    addu $t0,$t0,$t1 # - address of our char, offset by 8
1644#    lb $t0,-8($t0) # our char

    # return
1648#    jr $ra

########################################################
# intToString(n) - library method (class Lib)
# converts int to string: Java: ""+n
# - parameters:
#   - ($sp) - the value to convert, n
#   - 4($sp) - GC tag
#   - 8($sp) - old-this-pointer
#   - $s2 - this-pointer
# - returns:
#   - $t0 - the string, which is the string representation of
#     the integer
########################################################
1652:mth_intToString_Lib:

    # save return address on stack; allocate space for dummy GC tag
1652#    subu $sp,$sp,8
1656#    sw $ra,4($sp)

    # save current sp
1660#    move $t0,$sp

    # move constant 10 into $t3 
    # (Good, I didn't know what li did, I'm glad this comment was here)
    # * slams head through wall *
1664#    li $t3,10

    # get argument, negate if negative
1668#    lw $t1,8($sp)
1672#    bge $t1,$zero,itsNonNegLoop
1673##...slt $at,$t1,$zero
1677##...beq $at,$zero,1684
1680#    subu $t1,$zero,$t1

    # loop through, computing unsigned remainder by 10, and
    # storing digits on stack until we reach 0
1684:  itsNonNegLoop:
1684#    divu $t1,$t3
1688#    mflo $t1 # quotient
1692#    mfhi $t4 # remainder
1696#    addu $t4,$t4,'0' # turn remainder into digit
1700#    subu $sp,$sp,4
1704#    sw $t4,($sp) # push digit onto stack
1708#    bne $t1,$zero,itsNonNegLoop

    # push '-' if negative
1712#    lw $t4,8($t0)
1716#    bge $t4,$zero,itsSkipNeg
1717##...slt $at,$t4,$zero
1721##...beq $at,$zero,1736
1724#    li $t4,'-'
1728#    subu $sp,$sp,4
1732#    sw $t4,($sp)
1736:  itsSkipNeg:

    ################################################
    # At this point, all of our digits have been pushed
    # onto the stack.  $sp points to the first one;
    # $t0 contains the limit-pointer (into which we need to
    # write a GC tag).
    ################################################

    # compute number of characters on stack (one word per character);
    # write GC tag onto stack; push char-count onto stack
1736#    subu $s6,$t0,$sp
1740#    addu $t3,$s6,5 # GC tag (including for count-word, about to be pushed)
1744#    sw $t3,($t0)
1748#    srl $s6,$s6,2
1752#    subu $sp,$sp,4
1756#    sw $s6,($sp)
    
    # allocate memory
1760#    addu $s6,$s6,7 # 3 to round up, plus 4 for vtable word
1764#    srl $s6,$s6,2
1768#    move $s7,$zero # no "object" words in object
1772#    jal newObject

    # restore char-count; pop it and return value from 'newObject'
1776#    lw $t0,4($sp)
1780#    addu $sp,$sp,8

    # store "String" tag into class field
1784#    subu $s7,$s7,8 # address of header-1 word
1788#    la $t1,CLASS_String
1792#    sw $t1,-4($s7)
        
    # mask off hash bits, if needed
1796#    lw $t4,($s7) # # data words in source string
1800#    bge $t4,$zero,skipMask_intToString # don't strip hash code if not there
1801##...slt $at,$t4,$zero
1805##...beq $at,$zero,1824
1808#    and $t4,0xff # mask off object's hash value ...
1809##...lui $at,0
1813##...ori $at,$at,0xff
1817##...and $t4,$t4,$at
1820#    sw $t4,($s7) # ... and store back into -8 header-word
1824:skipMask_intToString:
    
    # store negative of char-count into header-2 word
1824#    subu $t0,$zero,$t0
1828#    sw $t0,4($s7)

1832#    lw $t1,($s7) # number of data words in string
1836#    sll $t1,$t1,2 # number data bytes in string
1840#    subu $t1,$s7,$t1 # first location to store chars in string
1844#    subu $t0,$t1,$t0 # limit address for chars in string

    ####################################################
    # at this point:
    # - $sp contains first source character address
    # - $t1 contains first target character address
    # - $t0 contains target-limit address
    ####################################################

    # loop through and copy all elements as we pop them off the stack.
    # (In this case, we know that there is it least one.)
1848:  itsLoop:
1848#    lw $t2,($sp)
1852#    addu $sp,$sp,4
1856#    sb $t2,($t1)
1860#    addu $t1,$t1,1
1864#    bne $t1,$t0,itsLoop

    ####################################################
    # At this point
    # - ($t0+15)&0xfffffffe is our return value
    # - ($sp) contains garbage (old GC tag)
    # - 4($sp) contains return address
    ####################################################

    # adjust stack, restore return address; return
1868#    lw $ra,4($sp)
1872#    addu $sp,$sp,8
1876#    addu $t0,$t0,15
1880#    and $t0,$t0,0xfffffffc
1881##...lui $at,65535
1885##...ori $at,$at,0xfffc
1889##...and $t0,$t0,$at
1892#    jr $ra

########################################################
# intToChar(n) - library method (class Lib)
# converts int to a one-character string: Java: ""+(char)(n&0xff)
# - parameters:
#   - ($sp) - the value to convert, n
#   - 4($sp) - GC tag
#   - 8($sp) - old-this-pointer
# - returns:
#   - $t0 - the string, which is the converted character
# - note: only the low 8 bits of the value n are used
########################################################
1896:mth_intToChar_Lib:
    # save return address
1896#    subu $sp,$sp,4
1900#    sw $ra,($sp)

    # allocate object
1904#    li $s6,2
1908#    move $s7,$zero
1912#    jal newObject

    # get n from string.
1916#    lw $t1,8($sp)

    # store "String" tag into class field
1920#    la $t0,CLASS_String
1924#    sw $t0,-12($s7)
        
    # mask off hash bits, if needed
1928#    lw $t4,-8($s7) # # data words in source string
1932#    bge $t4,$zero,skipMask_intToChar # don't strip hash code if not there
1933##...slt $at,$t4,$zero
1937##...beq $at,$zero,1956
1940#    and $t4,0xff # mask off object's hash value ...
1941##...lui $at,0
1945##...ori $at,$at,0xff
1949##...and $t4,$t4,$at
1952#    sw $t4,-8($s7) # ... and store back into -8 header-word
1956:  skipMask_intToChar:

    # store data in string
1956#    sb $t1,-16($s7)
    
    # store negative of size in header-word 2
1960#    li $t0,-1
1964#    sw $t0,-4($s7)

    # we're returning $s7
1968#    move $t0, $s7

    # restore $ra, and pop return address and return string off stack
1972#    lw $ra,4($sp)
1976#    addu $sp,$sp,8

    # return
1980#    jr $ra

########################################################
# str1.compareTo(str2) - library method (class String)
# compares two strings as in Java
# - parameters:
#   - ($sp) - second string
#   - 4($sp) - old this pointer
#   - $s2 - first string (this)
# - returns:
#   - $t0 - -1, 0, or 1 depending on whether str1 is
#       lexographically less than, equal to or greater than str2
########################################################
1984:mth_compareTo_String:
    # get string pointers and check parameter for null
1984#    lw $t0,($sp) # second string
1988#    beq $t0,$zero,nullPtrException
1992#    move $t1,$s2 # first string
    
    # get (negatives of) respective byte-lengths
1996#    lw $t2,-4($t0) # negative length of second string
2000#    lw $t3,-4($t1) # negative length of first string

    # put tentative return value in $t5.
    # The tentative return value is the one that we will use if we get
    # to the end of the shorter string during our comparison-loop.
2004#    slt $t4,$t3,$t2
2008#    slt $t5,$t2,$t3
2012#    subu $t5,$t5,$t4
    
    # at this point:
    # - $t0 contains the pointer to the second string object
    # - $t1 contains the pointer to the first string object
    # - $t5 contains the value to return if the strings compare equal up
    #   to the length of the shortest word

    # get begin-of-string addresses
2016#    lw $t2,-8($t0) # # data words in second string
2020#    lw $t3,-8($t1) # # data words in first string
2024#    sll $t2,$t2,2 # byte-offset to beginning of str2 (+8)
2028#    sll $t3,$t3,2 # byte-offset to beginning of str1 (+8)
2032#    subu $t0,$t0,$t2 # beginning of str1 address (+8)
2036#    subu $t1,$t1,$t3 # beginning of str2 address (+8)
    
    # put $t1-limit into $t2
2040#    beq $zero,$t5,skipStrCmpLenzz
2044#    move $t2,$t3
2048:  skipStrCmpLenzz:
2048#    add $t2,$t1,$t2
    
    # at this point:
    # - $t0 contains 8 plus the address of the first data-byte of str2
    # - $t1 contains 8 plus the address of the first data-byte of str1
    # - $t2 contains 8 plus the address of the last data-type of str1
    # - $t5 contains the value to return if the strings compare equal up
    #   to the length of the shortest word

    #######################################################
    # at this point, we have
    # - $t5 containing the tentative return-value
    # - $t1 containing address of first char in str2
    # - $t2 containing limit for $t1
    # - $t0 containing address of first char in str1
    #######################################################

    # loop through, until we find unequal words or we hit
    # our limit    
2052:  cmpLoopzz:
2052#    lw $t3,-8($t1) # word from str2
2056#    lw $t4,-8($t0) # word from str1
2060#    bne $t3,$t4,cmpNotEqualzz
2064#    addu $t1,$t1,4
2068#    addu $t0,$t0,4
2072#    bne $t1,$t2,cmpLoopzz

    # # got to the end of one string: go set up return
2076#    j cmpHitLimitzz

2080:  cmpNotEqualzz:
    # found unequal characters: return -1 or 1, depending on which is
    # greater
2080#    slt $t5,$t4,$t3 # 1 if str2 > str1, else 0
2084#    sll $t5,$t5,1 # 2 if str2 > str1, else 0
2088#    subu $t5,$t5,1 # 1 if str2 > str1, else -1
2092:  cmpHitLimitzz:
2092#    move $t0, $t5 # store return value
2096#    jr $ra # return

########################################################
# readLogicalChar (millicode)
#  - logically reads a character from standard input
#  - first checks character buffer, consuming it if possible
#  - return-result:
#    - returns character in $v0
#  - side-effects:
#    - reads a character
#    - clobbers $t0
########################################################
2100:readLogicalChar:

    # check if we already have a character
2100#    lw $v0,lastCharRead
2104#    li $t0,-2
2108#    beq $t0,$v0 doReadCh

    # we have our character from the buffer. Wipe out
    # buffer and return
2112#    sw $t0,lastCharRead # store -2 into buffer (i.e. "empty")
2116#    jr $ra # return
    
2120:  doReadCh:
    # we need to actually read a character: read and return
2120#    li $v0,12 # use system call to read a character
2124#    syscall
2128#    jr $ra # return

########################################################
# newObject (millicode)
#  - allocates a new object on the heap
#  - two-word header is set up properly
#  - all non-header words in object are set to zero
#  - parameters:
#    - $s6 = the number of data words in the negative-offset portion of
#      the object (including the vtable pointer); this value is 1 if the
#      object is an array; this should always be at least 1
#    - $s7 - second header-word, which is the number of object
#      words in the object
#      - $s7 may not be negative (this is checked); if so, the program is
#        aborted with an "array size of out bounds" error message
#      is treated as if it were zero
#  - return-result:
#    - returned in $s7
#    - and pushed on the stack
#  - side-effects:
#  - may trash all $tx registers and all $sx registers, except the
#    "permanent" ones, which get updated with values that are
#    consistent with the new space
########################################################
2132:newObject:
    # $s6 = # data words
    # $s7 = # object words (# data words if data-array allocation,
    # where a negative number is treated as 0)
    # $ra = return address
    # on return, pointer to new memory in two places:
    # - pushed onto top of stack
    # - in $s7
    
    # if the object-portion size is negative, abort with error
2132#    blt $s7,$zero arraySizeOutOfBounds
2133##...slt $at,$s7,$zero
2137##...bne $at,$zero,3128

    # mark the fact that we have not yet GC'd for this allocation
2140#    move $t5,$zero

    ###### TEMPORARY #######
    # for now, go a GC unconditionally, so that a full GC occurs
    # every time we allocate an object
    ### let's not do that for now
    # j doGC

2144:  gcJoin:

    # at this point:
    #  $s6 contains the before-header word count
    #  $s7 contains the second header word, which is also the
    #    after-header word count
    #  $t5 is zero iff we have not GC'd for this allocation

    # determine if we have enough memory available
2144#    addu $t0,$s6,$s7
2148#    sll $t0,$t0,2
2152#    addu $t0,$t0,8 # amount of memory needed
2156#    addu $t1,$t0,$s3
2160#    bgtu $t1,$s4,doGC
2161##...sltu $at,$s4,$t1
2165##...bne $at,$zero,2288

    # at this point:
    #  $s3 points to beginning of segment, and
    #  $t1 points just past the end

    # zero out the memory
2168#    move $t2,$s3
2172:  zeroObjLoop:
2172#    sw $zero,($s3)
2176#    lw $zero,($s3)

2180#    addu $s3,4
2184#    bltu $s3,$t1,zeroObjLoop
2185##...sltu $at,$s3,$t1
2189##...bne $at,$zero,2172

    # at this point:
    #  $s3 has been updated to point to the next free slot,
    #    which is also the points just past our object

    # compute pointer value and set up header-words
2192#    sll $t0,$s7,2    # number of post-header bytes
2196#    subu $t0,$s3,$t0 # pointer that we will return

    # determine the value to store in the first header-word:
    # if <= 255 (unsigned):
    #  - it goes into low byte
    #  - hash bits go into high three bytes, with top bit being 1
    # if >255 (unsigned)
    #  - it goes into full word (with a 0 in the high bit)
    
2200#    li $t2,255
2204#    bgeu $s6,$t2 firstHeaderLarge
2205##...sltu $at,$s6,$t2
2209##...beq $at,$zero,2256
2212#    lw $t1,prevHashConstant
2216#    addu $t1,0x12b68fd2
2217##...lui $at,4791
2221##...addiu $at,$at,-28718
2225##...addu $t1,$at,$t1
2228#    sw $t1,prevHashConstant # update hash constant
2232#    or $t1,0x80000000 # set top bit
2233##...lui $at,32768
2237##...or $t1,$at,$t1
2240#    and $t1,0xffffff00 # clear low bit
2241##...lui $at,65535
2245##...ori $at,$at,0xff00
2249##...and $t1,$t1,$at
2252#    or $s6,$t1
2256:firstHeaderLarge:
2256#    sw $s6,-8($t0) # store header-1 value
2260#    lw $zero,-8($t0)

    # store second header-value
2264#    sw $s7,-4($t0)   # second header-word
2268#    lw $zero,-4($t0)
    
    # put return-value into $s7 and also push it onto top of stack
2272#    move $s7,$t0
2276#    subu $sp,$sp,4
2280#    sw $t0,($sp)

2284#    jr $ra
    
2288:  doGC:
    #####################################################
    # We need to do a garbage-collect
    #####################################################
 
     ####### print that we are doing a GC ########
     ####### THESE THREE LINES WILL NORMALLY BE COMMENTED OUT #######
#         la $a0,gcMsg # prints message: "GC!" 
#         li $v0,4 # syscall-code for print-string 
#         syscall 
       

    # if we've already done a GC for this allocation, then
    # we are actually out heap-memory: abort program
2288#    bne $t5,$zero,outOfHeapMemory
      
    # increment the number of times we've done a GC, for later reporting
2292#    lw $t5,gcCount
2296#    addu $t5,1
2300#    sw $t5,gcCount

    # save $s2 (our only rooted register) on the stack
    # so that the garbage collector processes it
2304#    subu $sp,$sp,4
2308#    sw $s2,($sp)

    # set $s3 to the address of the new segment and the
    # end-limit of the new segment, respectively,
    # Also, update cur_seg to refer to the other segment
2312#    lw $t0,cur_seg
2316#    move $t7,$s4
2320#    la $t6,seg1_start
2321##...lui $t6,16
2325##...addiu $t6,$t6,3764
2328#    la $s3,seg0_start
2332#    la $s4,seg0_end
2333##...lui $s4,16
2337##...addiu $s4,$s4,3764
2340#    sw $zero,cur_seg
2344#    bne $t0,$zero,skipGc1
2348#    la $t6,seg0_start
2352#    la $s3,seg1_start
2353##...lui $s3,16
2357##...addiu $s3,$s3,3764
2360#    la $s4,seg1_end
2361##...lui $s4,32
2365##...addiu $s4,$s4,3764
2368#    sw $s5,cur_seg
2372:  skipGc1:
2372#    li $t5,0x80000000
2376#    lw $t0,stack_bottom
2380#    subu $t0,4


    ###############################################################
    # at this point:
    # - $t6 contains the first address of the source space
    # - $t7 contains the limit address of the source space
    # - $s3 contains the first address of the target space
    # - $s4 contains the limit address of the target space
    # - cur_seg has been updated to refer to the target space
    # - $t0 contains the address of the deepest stack element
    # - $sp contains the address of the top stack element
    # - $s2 is available for use, having been pushed onto the stack
    # - $t5 contains the value 0x80000000
    ###############################################################

    ###### begin outer loop to copy all stack-direct objects ######

2384:  gcStackCopyLoop:
2384#    lw $t1,($t0) # current stack element

    # test if we have a GC tag
2388#    sll $t2,$t1,31 # zero iff low bit was zero
2392#    bne $t2,$zero,gcBump # go skip data values if low bit not zero

    # bump stack-address pointer
2396#    subu $t0,$t0,4

    # if value is out of range (which includes null=0), and is
    # therefore does not refer to an object on the heap, just go
    # loop back and do the next one
2400#    bleu $t1,$t6,gcTestIterDone1
2401##...sltu $at,$t6,$t1
2405##...beq $at,$zero,2568
2408#    bgtu $t1,$t7,gcTestIterDone1
2409##...sltu $at,$t7,$t1
2413##...bne $at,$zero,2568

    # if the object has already been moved, update the stack-value
    # via the forwarding pointer
2416#    lw $t2,-8($t1) # possible forwarding tag
