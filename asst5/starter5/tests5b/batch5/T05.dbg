    .asciiz "ERROR: string index out of bounds\n"
3517:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
3551:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
3584:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
3615:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
3663:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
3684:gcMsg: 
      .asciiz "\nGC!\n"
3690:gcCountMsg: 
      .asciiz "Number of garbage collections: "

3722:nullStr:
    .asciiz "null"
3727:trueString:
    .asciiz "true"
3732:falseString:
    .asciiz "false"
3738:exitString:
    .ascii "Program terminated."
    #### "falls through" here
3757:newlineString:
    .asciiz "\n"
    
    .align 2
3760:stack_bottom:
