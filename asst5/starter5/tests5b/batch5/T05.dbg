.data
3340:strLit_0:
.asciiz "Now is the time for all good men to come to McDonald's"
.align 2
3396:strLit_5:
.asciiz "\n"
.align 2
.text
.globl main
0:main:
0#  jal vm_init
4#  li $v0, 10
8#  syscall
12:mth_main_Main:
12#  la $t0, strLit_0
16#  subu $sp, $sp, 4
20#  sw $t0, ($sp)
24#  subu $sp, $sp, 4
28#  sw $s2, ($sp)
32#  la $t0, strLit_5
36#  subu $sp, $sp, 4
40#  sw $t0, ($sp)
44#  subu $sp, $sp, 4
48#  sw $s2, ($sp)
52#  jr $ra
##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
56:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
56#    lw $t0,-8($s2) # get word with hash bits from this
60#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
64#    addu $t0,$t1

68#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
72:mth_equals_Object:
72#    move $t0,$s2 # first pointer (this)
76#    lw $t1,($sp) # second pointer
80#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
81##...subu $at,$t0,$t1
85##...sltiu $t0,$at,1

88#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
92:mth_hashCode_String:
92#    move $t0,$s2 # put this pointer in t0

96#    li $t2,0 # current hash value
100#    lw $t1,-4($t0) # negative of number of characters in string
104#    beq $t1,$zero,done_hashCode_String # if zero length => done
108#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
112#    and $t0,0xfffffffc # adjust for padding
113##...lui $at,65535
117##...ori $at,$at,0xfffc
121##...and $t0,$t0,$at
124#    subu $t1,$t0,$t1 # address at end of string +12
128:loop_hashCode_String:    
128#    sll $t4,$t2,5 # multiply by 32
132#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
136#    lbu $t3,-12($t0) # current character
140#    addu $t2,$t3 # add in current character
144#    addu $t0,1 # go to next character's address
148#    bne $t0,$t1,loop_hashCode_String # loop back if more
152:done_hashCode_String:    

    # push int on stack
152#    move $t0, $t2 # put $t2 in return slot
156#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
160:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
160#    subu $sp,4
164#    sw $ra,($sp)
    
    # get hash value
168#    lw $t2,-12($s2) # vtable address
172#    lw $t0,($t2) # method address
176#    jalr $t0
180#    subu $sp,8 # push result (int in $t0) on stack
184#    sw $s5,4($sp)
188#    sw $t0,($sp)

    # compute print-size of hash value
192#    li $t0, 1
196#    lw $t1, ($sp)
200#    srl $t1,$t1,4
204#    beq $t1,$zero,toString_skip_loop
208:toString_loop_top:
208#    addu $t0,1
212#    srl $t1,$t1,4
216#    bne $t1,$zero,toString_loop_top
220:toString_skip_loop:
220#    subu $sp,8
224#    sw $s5,4($sp)
228#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
232#    lw $t2,-12($s2) # vtable address
236#    move $t0,$t2
240:toString_checkTagBit:
240#    subu $t0,1
244#    lb $t1,($t0)
248#    and $t1,0x80
249##...lui $at,0
253##...ori $at,$at,0x80
257##...and $t1,$t1,$at
260#    beq $t1,$zero,toString_checkTagBit
264#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
268#    subu $sp,8
272#    sw $t1,($sp)
276#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
280#    move $s7,$zero # -4 offset header word
284#    lw $t4,8($sp) # bytes for hash value
288#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
292#    addu $t4,8
296#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
300#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

304#    li $t0,CLASS_String # store string vtable address into ...
308#    sw $t0,-12($s7) # ... -12 offset in object header
312#    lw $t2,-12($s2) # our object's vtable address
316#    lw $t5,4($sp) # number characters in prefix
320#    lw $t1,12($sp) # number of characters in hashcode
324#    addu $t3,$t1,$t5 # number of characters in string ...
328#    addu $t3,1 # ... including the '@' character
332#    subu $t0,$zero,$t3 # store negated length into ...
336#    sw $t0,-4($s7) # ... -4 offset header word
340#    lw $t0,-8($s7) # get -8 offset header-word
344#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
345##...slt $at,$t0,$zero
349##...beq $at,$zero,368
352#    and $t0,0xff # mask off object's hash value ...
353##...lui $at,0
357##...ori $at,$at,0xff
361##...and $t0,$t0,$at
364#    sw $t0,-8($s7) # ... and store back into -8 header-word
368:skipMask_toString:
368#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
372#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
376#    subu $t4,$t2,$t5
380:toString_copyLoop:    
380#    lb $t3,($t4)
384#    and $t3,0x7f # mask off sign bit (in case first word)
385##...lui $at,0
389##...ori $at,$at,0x7f
393##...and $t3,$t3,$at
396#    sb $t3,-8($t0)
400#    addu $t4,1
404#    addu $t0,1
408#    blt $t4,$t2,toString_copyLoop
409##...slt $at,$t4,$t2
413##...bne $at,$zero,380

    # copy the '@' sign
416#    li $t3,'@'
420#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
424#    addu $t2,$t0,$t1 # address of last byte in string to store +8
428#    lw $t3,20($sp) # hash code to print
432:toString_hashCopyLoop:
432#    and $t4,$t3,0xf
436#    srl $t3,4
440#    lb $t4,hexChars($t4)
444#    sb $t4,-8($t2)
448#    subu $t2,$t2,1
452#    bgt $t2,$t0,toString_hashCopyLoop
453##...slt $at,$t0,$t2
457##...bne $at,$zero,432

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
460#    addu $sp,28
464#    lw $ra,($sp)
468#    addu $sp,4
472#    move $t0, $s7 # return string we created
476#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
480:mth_equals_String:
    
    # quick test for obvious false
480#    lw $t0,($sp) # second parameter
484#    beq $t0,$zero,goEsFalse # go return false if null
488#    lw $t1,-12($t0) # vtable pointer
492#    la $t2,CLASS_String # string vtable pointer
496#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
500#    subu $sp,12
504#    sw $ra,8($sp)
508#    sw $s2,4($sp)
512#    sw $t0,($sp)
516#    jal mth_compareTo_String
520#    lw $s2, 4($sp) #restore this pointer and pop parameters
524#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
528#    seq $t0,$t0,$zero
529##...subu $at,$t0,$zero
533##...sltiu $t0,$at,1

    # pop return address and return $t0
536#    lw $ra,($sp)
540#    addu $sp,4

544#    jr $ra # return
    
548:goEsFalse:
    # put 0 in $t0 and return
548#    li $t0, 0
552#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
556:mth_toString_String:
    #we are a string, so return this.
556#    move $t0, $s2
560#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
564:mth_readLine_Lib:
    
564#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
568#    sw $ra, 4($sp) # save $ra
572#    move $t1,$sp # save "original" sp

576:  doRead:

    # read the character
576#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
580#    subu $t2,$v0,13
584#    bne $t2,$zero,notReturnRL
588#    jal readLogicalChar
592#    subu $t2,$v0,10 # check for newline
596#    beq $t2,$zero,foundNewLine
600#    sw $v0,lastCharRead # push back character into queue
604#    j foundNewLine # go process the line

608:  notReturnRL:

    # at this point, $v0 has our character

608#    subu $t0,$v0,10
612#    beq $t0,$zero,foundNewLine
616#    blt $v0,$zero,foundEof
617##...slt $at,$v0,$zero
621##...bne $at,$zero,636

    # we have a character, so push it onto stack
624#    subu $sp,$sp,4
628#    sw $v0,($sp)

    # loop back up to get next character
632#    j doRead

636:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
636#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
640#    li $s7, 0 # return-value: null
644#    j rlReturn # return

648:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
648#    subu $t0,$t1,$sp # number of chars we read (times 4)
652#    srl $s6,$t0,2 # number of words on stack with chars
656#    subu $sp,$sp,4 # push char-count ...
660#    sw $s6,($sp) # ... onto stack
664#    addu $t2,$t0,5 # GC tag, incl. for count-word
668#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
672#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
676#    srl $s6,$s6,2  # data words in object
680#    move $s7,$zero # object words in object
684#    jal newObject  # allocate space
    
    # store header words
688#    la $t0,CLASS_String
