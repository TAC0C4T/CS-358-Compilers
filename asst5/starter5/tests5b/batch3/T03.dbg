########################################################
# vm_init (millicode)
#  - initialzes the virtual machine
#  - values 5 stored in $s5
#  - zero ("this pointer") stored in $s2
#  - heap and heap-limit pointers stored respectively in $s3 and $s4
#  - address of bottom of stack stored in 'stack_bottom' memory
#    location
#  - (note: 'cur_seg' memory location is already set to 0)
########################################################
5048:vm_init:

    # mark bottom of stack
5048#    sw $sp,stack_bottom
    
    # set "this" pointer to be null, for now
5052#    move $s2,$zero

    #set up the "five" register
5056#    li $s5,5

5060#    la $s3,seg0_start
5064#    la $s4,seg0_end
5065##...lui $s4,16
5069##...addiu $s4,$s4,5884
    
    # return
5072#    jr $ra

########################################################
# divide (millicode)
#  - divides first arg by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
5076:divide:
    # get parameters; abort if divisor zero
5076#    lw $t0,($sp)
5080#    lw $t1,8($sp)
5084#    beq $t0,$zero,divByZeroError
    
    # perform division
5088#    div $t1,$t0
5092#    mflo $t0

    # store result, adjust stack and return
5096#    addu $sp,$sp,8 # adjust stack
5100#    sw $t0,($sp) # store result
5104#    jr $ra

########################################################
# remainder (millicode)
#  - takes remainder first arg divided by second (signed divide)
#  - aborts if divisor is zero
#  - follows calling conventions for library methods
#  - parameters:
#    - ($sp) divisor
#    - 4($sp) (dummy) GC tag
#    - 8($sp) dividend
#    - 12($sp) (dummy) GC tag
#  - return value:
#    - ($sp) result
#    - 4($sp) (dummy) GC tag
########################################################
5108:remainder:
    # get parameters; abort if divisor zero
5108#    lw $t0,($sp)
5112#    lw $t1,8($sp)
5116#    beq $t0,$zero,divByZeroError
    
    # perform division
5120#    div $t1,$t0
5124#    mfhi $t0

    # store result, adjust stack and return
5128#    addu $sp,$sp,8 # adjust stack
5132#    sw $t0,($sp) # store result
5136#    jr $ra
    
########################################################
# checkCast (millicode) - checks that a cast is legal
#  - aborts if null
#  - aborts if cast is illegal cast
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) object to check (now checked)
#  - side-effects: clobbers $t2 and $t3
########################################################
5140:checkCast:
    # get object, allow immediately if null
5140#    lw $t2,($sp)
5144#    beq $t2,$zero,checkCastReturn
    
    # get vtable address of object, abort if less than
    # lower limit or greater then or equal to higher
    # limit
5148#    lw $t2,-12($t2) # vtable address
5152#    bge $t2,$t1,castException
5153##...slt $at,$t2,$t1
5157##...beq $at,$zero,5292
5160#    blt $t2,$t0,castException
5161##...slt $at,$t2,$t0
5165##...bne $at,$zero,5292
    
    # return, leaving object unchanged on stack
5168:  checkCastReturn:    
5168#    jr $ra    

# checkCast:
#     # get object, allow immediately if null
#     lw $t2,($sp)
#     beq $t2,$zero,checkCastReturn
#     
#     # get vtable address of object (using Object vtable
#     # address for arrays)
#     lw $t3,-8($t2) # <= 0 if array
#     lw $t2,-12($t2) # vtable address (unless array)
#     bgt $t3,$zero,skipArrayCast
#     la $t2,CLASS_Object
#     
#     # get vtable address of object, abort if less than
#     # lower limit or greater then or equal to higher
#     # limit
#   skipArrayCast:
#     bge $t2,$t1,castException
#     blt $t2,$t0,castException
#     
#     # return, leaving object unchanged on stack
#   checkCastReturn:    
#     jr $ra    

########################################################
# instanceOf (millicode) - tests whether an object is
#   a member of a given class (or subclass)
#  - returns false if object is null
#  - parameters:
#    - ($sp) object to check
#    - $t0 address of vtable for target-class
#    - $t1 address one past vtable address of last
#      subclass of target-class
#  - return value:
#    - ($sp) true (1) or false (0), depending on whether
#      object is a member
#  - side-effects: clobbers $t2 and $t3
########################################################
5172:instanceOf:
    # get object, go return false if null
5172#    lw $t2,($sp)
5176#    beq $t2,$zero,doneInstanceOf
    
    # get vtable address of object, determine if we're >= the
    # lower limit, and if we're < the higher limit
5180#    lw $t2,-12($t2) # vtable address
5184#    sge $t0,$t2,$t0 # are we >= the lower limit?
5185##...slt $t0,$t2,$t0
5189##...xori $t0,$t0,0x1
5192#    slt $t1,$t2,$t1 # are we < the higher limit?
    
    # store the AND of the two conditions onto the stack; return
5196#    and $t2,$t0,$t1
5200#    sw $t2,($sp)
5204:doneInstanceOf: # if we reach here via branch, stack-top is zero,
            # which will now represent false
5204#    jr $ra


###########################################################
# jump-targets to terminate program:
# - exit: returns normally
# - outOfHeapMemory: prints "out of memory" error and returns
###########################################################

5208:exitError:
    # assumes $a0 has pointer to null-terminated string

    # print the string
5208#    li $v0,4 # syscall-code for print-string
5212#    syscall
5216:exit:
    # print termination message
5216#    li $v0,4 # syscall-code for print-string
5220#    la $a0,exitString
5224#    syscall

    # terminate execution
5228#    li $v0,10 #syscall-code for "exit"
5232#    syscall

5236:outOfHeapMemory:
5236#    la $a0,heapMemoryMsg
5240#    j exitError
5244:divByZeroError:
5244#    la $a0,divByZeroMsg
5248#    j exitError
5252:strIndexOutOfBounds:
5252#    la $a0,strIndexOutOfBoundsMsg
5256#    j exitError
5260:arrayIndexOutOfBounds:
5260#    la $a0,arrayIndexOutOfBoundsMsg
5264#    j exitError
5268:arraySizeOutOfBounds:
5268#    la $a0,arraySizeOutOfBoundsMsg
5272#    j exitError
5276:nullPtrException:
5276#    la $a0,nullPtrExceptionMsg
5280#    j exitError
5284:badIntegerFormat:
5284#    la $a0,badIntegerFormatMsg
5288#    j exitError
5292:castException:
5292#    la $a0,castExceptionMsg
5296#    j exitError
############## data section ################
    .data
5520:hexChars:
    .ascii "0123456789abcdef"
    .align 2
5536:cur_seg:
    .word 0

5540:lastCharRead:
    .word -2 # -2 => no buffered character
5544:prevHashConstant:
    .word 0x2785173c
5548:gcCount:
    .word 0

5552:heapMemoryMsg:
    .asciiz "ERROR: out of heap memory\n"
5579:divByZeroMsg:
    .asciiz "ERROR: divide by zero\n"
5602:strIndexOutOfBoundsMsg:
    .asciiz "ERROR: string index out of bounds\n"
5637:arrayIndexOutOfBoundsMsg:
    .asciiz "ERROR: array index out of bounds\n"
5671:arraySizeOutOfBoundsMsg:
    .asciiz "ERROR: array size out of bounds\n"
5704:nullPtrExceptionMsg:
    .asciiz "ERROR: null-pointer exception\n"
5735:badIntegerFormatMsg:
    .asciiz "ERROR: attempt to read badly formatted integer\n"
5783:castExceptionMsg:
    .asciiz "ERROR: illegal cast\n"
5804:gcMsg: 
      .asciiz "\nGC!\n"
5810:gcCountMsg: 
      .asciiz "Number of garbage collections: "

5842:nullStr:
    .asciiz "null"
5847:trueString:
    .asciiz "true"
5852:falseString:
    .asciiz "false"
5858:exitString:
    .ascii "Program terminated."
    #### "falls through" here
5877:newlineString:
    .asciiz "\n"
    
    .align 2
5880:stack_bottom:
    .word 0

