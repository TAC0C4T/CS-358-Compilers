2968#    subu $t0,$v0,10
2972#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
2976#    subu $t0,$v0,9
2980#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
2984#    subu $t0,$v0,13
2988#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
2992#    subu $t0,$v0,12
2996#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
3000#    j badIntegerFormat # illegal integer char: abort program

3004:  nonWhite:
