##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2196:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
2196#    lw $t0,-8($s2) # get word with hash bits from this
2200#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
2204#    addu $t0,$t1

2208#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2212:mth_equals_Object:
2212#    move $t0,$s2 # first pointer (this)
2216#    lw $t1,($sp) # second pointer
2220#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
2221##...subu $at,$t0,$t1
2225##...sltiu $t0,$at,1

2228#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
2232:mth_hashCode_String:
2232#    move $t0,$s2 # put this pointer in t0

2236#    li $t2,0 # current hash value
2240#    lw $t1,-4($t0) # negative of number of characters in string
2244#    beq $t1,$zero,done_hashCode_String # if zero length => done
2248#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
2252#    and $t0,0xfffffffc # adjust for padding
2253##...lui $at,65535
2257##...ori $at,$at,0xfffc
2261##...and $t0,$t0,$at
2264#    subu $t1,$t0,$t1 # address at end of string +12
2268:loop_hashCode_String:    
2268#    sll $t4,$t2,5 # multiply by 32
2272#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
2276#    lbu $t3,-12($t0) # current character
2280#    addu $t2,$t3 # add in current character
2284#    addu $t0,1 # go to next character's address
2288#    bne $t0,$t1,loop_hashCode_String # loop back if more
2292:done_hashCode_String:    

    # push int on stack
2292#    move $t0, $t2 # put $t2 in return slot
2296#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
2300:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
2300#    subu $sp,4
2304#    sw $ra,($sp)
    
    # get hash value
2308#    lw $t2,-12($s2) # vtable address
2312#    lw $t0,($t2) # method address
2316#    jalr $t0
2320#    subu $sp,8 # push result (int in $t0) on stack
2324#    sw $s5,4($sp)
2328#    sw $t0,($sp)

    # compute print-size of hash value
2332#    li $t0, 1
2336#    lw $t1, ($sp)
2340#    srl $t1,$t1,4
2344#    beq $t1,$zero,toString_skip_loop
2348:toString_loop_top:
2348#    addu $t0,1
2352#    srl $t1,$t1,4
2356#    bne $t1,$zero,toString_loop_top
2360:toString_skip_loop:
2360#    subu $sp,8
2364#    sw $s5,4($sp)
2368#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
2372#    lw $t2,-12($s2) # vtable address
2376#    move $t0,$t2
2380:toString_checkTagBit:
2380#    subu $t0,1
2384#    lb $t1,($t0)
2388#    and $t1,0x80
2389##...lui $at,0
2393##...ori $at,$at,0x80
2397##...and $t1,$t1,$at
2400#    beq $t1,$zero,toString_checkTagBit
2404#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
2408#    subu $sp,8
2412#    sw $t1,($sp)
2416#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
2420#    move $s7,$zero # -4 offset header word
2424#    lw $t4,8($sp) # bytes for hash value
2428#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
2432#    addu $t4,8
2436#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
2440#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

2444#    li $t0,CLASS_String # store string vtable address into ...
2448#    sw $t0,-12($s7) # ... -12 offset in object header
2452#    lw $t2,-12($s2) # our object's vtable address
2456#    lw $t5,4($sp) # number characters in prefix
2460#    lw $t1,12($sp) # number of characters in hashcode
2464#    addu $t3,$t1,$t5 # number of characters in string ...
2468#    addu $t3,1 # ... including the '@' character
2472#    subu $t0,$zero,$t3 # store negated length into ...
2476#    sw $t0,-4($s7) # ... -4 offset header word
2480#    lw $t0,-8($s7) # get -8 offset header-word
2484#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
2485##...slt $at,$t0,$zero
2489##...beq $at,$zero,2508
2492#    and $t0,0xff # mask off object's hash value ...
2493##...lui $at,0
2497##...ori $at,$at,0xff
2501##...and $t0,$t0,$at
2504#    sw $t0,-8($s7) # ... and store back into -8 header-word
2508:skipMask_toString:
2508#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
2512#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
2516#    subu $t4,$t2,$t5
2520:toString_copyLoop:    
2520#    lb $t3,($t4)
2524#    and $t3,0x7f # mask off sign bit (in case first word)
2525##...lui $at,0
2529##...ori $at,$at,0x7f
2533##...and $t3,$t3,$at
2536#    sb $t3,-8($t0)
2540#    addu $t4,1
2544#    addu $t0,1
2548#    blt $t4,$t2,toString_copyLoop
2549##...slt $at,$t4,$t2
2553##...bne $at,$zero,2520

    # copy the '@' sign
2556#    li $t3,'@'
2560#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
2564#    addu $t2,$t0,$t1 # address of last byte in string to store +8
2568#    lw $t3,20($sp) # hash code to print
2572:toString_hashCopyLoop:
2572#    and $t4,$t3,0xf
2576#    srl $t3,4
2580#    lb $t4,hexChars($t4)
2584#    sb $t4,-8($t2)
2588#    subu $t2,$t2,1
2592#    bgt $t2,$t0,toString_hashCopyLoop
2593##...slt $at,$t0,$t2
2597##...bne $at,$zero,2572

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
2600#    addu $sp,28
2604#    lw $ra,($sp)
2608#    addu $sp,4
2612#    move $t0, $s7 # return string we created
2616#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
2620:mth_equals_String:
    
    # quick test for obvious false
2620#    lw $t0,($sp) # second parameter
2624#    beq $t0,$zero,goEsFalse # go return false if null
2628#    lw $t1,-12($t0) # vtable pointer
2632#    la $t2,CLASS_String # string vtable pointer
2636#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
2640#    subu $sp,12
2644#    sw $ra,8($sp)
2648#    sw $s2,4($sp)
2652#    sw $t0,($sp)
2656#    jal mth_compareTo_String
2660#    lw $s2, 4($sp) #restore this pointer and pop parameters
2664#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
2668#    seq $t0,$t0,$zero
2669##...subu $at,$t0,$zero
2673##...sltiu $t0,$at,1

    # pop return address and return $t0
2676#    lw $ra,($sp)
2680#    addu $sp,4

2684#    jr $ra # return
    
2688:goEsFalse:
    # put 0 in $t0 and return
2688#    li $t0, 0
2692#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
###############################################################
2696:mth_toString_String:
    #we are a string, so return this.
2696#    move $t0, $s2
2700#    jr $ra

###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
2704:mth_readLine_Lib:
    
2704#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
2708#    sw $ra, 4($sp) # save $ra
2712#    move $t1,$sp # save "original" sp

2716:  doRead:

    # read the character
2716#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
2720#    subu $t2,$v0,13
2724#    bne $t2,$zero,notReturnRL
2728#    jal readLogicalChar
2732#    subu $t2,$v0,10 # check for newline
2736#    beq $t2,$zero,foundNewLine
2740#    sw $v0,lastCharRead # push back character into queue
2744#    j foundNewLine # go process the line

2748:  notReturnRL:

    # at this point, $v0 has our character

2748#    subu $t0,$v0,10
2752#    beq $t0,$zero,foundNewLine
2756#    blt $v0,$zero,foundEof
2757##...slt $at,$v0,$zero
2761##...bne $at,$zero,2776

    # we have a character, so push it onto stack
2764#    subu $sp,$sp,4
2768#    sw $v0,($sp)

    # loop back up to get next character
2772#    j doRead

2776:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
2776#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
2780#    li $s7, 0 # return-value: null
2784#    j rlReturn # return

2788:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
2788#    subu $t0,$t1,$sp # number of chars we read (times 4)
2792#    srl $s6,$t0,2 # number of words on stack with chars
2796#    subu $sp,$sp,4 # push char-count ...
2800#    sw $s6,($sp) # ... onto stack
2804#    addu $t2,$t0,5 # GC tag, incl. for count-word
2808#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
2812#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
2816#    srl $s6,$s6,2  # data words in object
2820#    move $s7,$zero # object words in object
2824#    jal newObject  # allocate space
    
    # store header words
2828#    la $t0,CLASS_String
2832#    sw $t0,-12($s7)# store class tag (String) into object
2836#    lw $t2,4($sp) # char-count
2840#    sll $t1,$t2,2 # 4 times number of chars
2844#    subu $t2,$zero,$t2 # negative of char-count
2848#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
2852#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
2856#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
2857##...slt $at,$t0,$zero
2861##...beq $at,$zero,2880
2864#    and $t0,0xff # mask off object's hash value ...
2865##...lui $at,0
2869##...ori $at,$at,0xff
2873##...and $t0,$t0,$at
2876#    sw $t0,-8($s7) # ... and store back into -8 header-word
2880:  skipMask_readLine:

2880#    sll $t0,$t0,2 # data bytes in object
2884#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
2888#    subu $t0,$t0,$t2 # place to store last character (plus 9)
2892#    addu $sp,$sp,8 # pop redundant object-pointer and count
2896#    addu $t1,$t1,$sp # first non-char spot on stack
