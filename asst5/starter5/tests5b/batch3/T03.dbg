4312#    sw $zero,($s3)
4316#    lw $zero,($s3)

4320#    addu $s3,4
4324#    bltu $s3,$t1,zeroObjLoop
4325##...sltu $at,$s3,$t1
4329##...bne $at,$zero,4312

    # at this point:
    #  $s3 has been updated to point to the next free slot,
    #    which is also the points just past our object

    # compute pointer value and set up header-words
4332#    sll $t0,$s7,2    # number of post-header bytes
4336#    subu $t0,$s3,$t0 # pointer that we will return

    # determine the value to store in the first header-word:
    # if <= 255 (unsigned):
    #  - it goes into low byte
    #  - hash bits go into high three bytes, with top bit being 1
    # if >255 (unsigned)
    #  - it goes into full word (with a 0 in the high bit)
    
4340#    li $t2,255
4344#    bgeu $s6,$t2 firstHeaderLarge
4345##...sltu $at,$s6,$t2
4349##...beq $at,$zero,4396
4352#    lw $t1,prevHashConstant
4356#    addu $t1,0x12b68fd2
4357##...lui $at,4791
4361##...addiu $at,$at,-28718
4365##...addu $t1,$at,$t1
4368#    sw $t1,prevHashConstant # update hash constant
4372#    or $t1,0x80000000 # set top bit
4373##...lui $at,32768
4377##...or $t1,$at,$t1
4380#    and $t1,0xffffff00 # clear low bit
4381##...lui $at,65535
4385##...ori $at,$at,0xff00
4389##...and $t1,$t1,$at
4392#    or $s6,$t1
4396:firstHeaderLarge:
4396#    sw $s6,-8($t0) # store header-1 value
4400#    lw $zero,-8($t0)

    # store second header-value
4404#    sw $s7,-4($t0)   # second header-word
4408#    lw $zero,-4($t0)
    
    # put return-value into $s7 and also push it onto top of stack
4412#    move $s7,$t0
4416#    subu $sp,$sp,4
4420#    sw $t0,($sp)

4424#    jr $ra
