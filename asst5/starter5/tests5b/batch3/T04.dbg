1664#    subu $t1,$t0,$t1 # first word in string
1668#    lw $t0,4($t0) # negative of string-length
1672#    subu $t0,$t1,$t0 # byte just beyond last char in string

    # print the chars in the string
1676#    beq $t0,$t1,donePrintStr
