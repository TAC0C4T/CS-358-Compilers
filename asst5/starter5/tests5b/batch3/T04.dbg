###############################################################
# readLine() - library method (class Lib)
# - reads line from standard input
# - produces String that contains the line read, except that it
#   does not include the end-of-line character-sequence. An
#   end-of-line character-sequence is one of the following:
#   - a return character followed by a newline character
#   - a newline character not preceded by a return character
#   - a return character not followed by a newline character
#   - an end-of-file character that follows at least one data
#     character
# - returns null on end-of-file
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - pointer to string containing line that was read
# - anomalies:
#   - with bare "return", looks ahead one character to check for
#     newline.  This could cause non-intuitive behavior when
#     run interactively.
###############################################################
1164:mth_readLine_Lib:
    
1164#    subu $sp,$sp,8 # allocate space for data tag, saving $ra
1168#    sw $ra, 4($sp) # save $ra
1172#    move $t1,$sp # save "original" sp

1176:  doRead:

    # read the character
1176#    jal readLogicalChar

    # if we have a 'return', read another character to check for
    # newline
1180#    subu $t2,$v0,13
1184#    bne $t2,$zero,notReturnRL
1188#    jal readLogicalChar
1192#    subu $t2,$v0,10 # check for newline
1196#    beq $t2,$zero,foundNewLine
1200#    sw $v0,lastCharRead # push back character into queue
1204#    j foundNewLine # go process the line

1208:  notReturnRL:

    # at this point, $v0 has our character

1208#    subu $t0,$v0,10
1212#    beq $t0,$zero,foundNewLine
1216#    blt $v0,$zero,foundEof
1217##...slt $at,$v0,$zero
1221##...bne $at,$zero,1236

    # we have a character, so push it onto stack
1224#    subu $sp,$sp,4
1228#    sw $v0,($sp)

    # loop back up to get next character
1232#    j doRead

1236:  foundEof:
    # if we had actually read some characters before hitting
        # the eof, go return them as if a newline had been read
1236#    bne $t1,$sp foundNewLine

    # otherwise, we got end of file without having read any
    # new characters, so return null
1240#    li $s7, 0 # return-value: null
1244#    j rlReturn # return

1248:  foundNewLine:

    # at this point, we have our newline (or end-of-file), and all space
    # on the stack above $t1 are characters to be put into the string.
    # That is therefore the number of data words to allocate (plus 1
    # more for the class-pointer)


    # set up GC tag and char-count on stack
1248#    subu $t0,$t1,$sp # number of chars we read (times 4)
1252#    srl $s6,$t0,2 # number of words on stack with chars
1256#    subu $sp,$sp,4 # push char-count ...
1260#    sw $s6,($sp) # ... onto stack
1264#    addu $t2,$t0,5 # GC tag, incl. for count-word
1268#    sw $t2,($t1) # store GC tag
    
    # allocate the appropriate Object
1272#    addu $s6,$s6,7 # 3 to round up, plus 1 for v-table pointer word
1276#    srl $s6,$s6,2  # data words in object
1280#    move $s7,$zero # object words in object
1284#    jal newObject  # allocate space
    
    # store header words
1288#    la $t0,CLASS_String
1292#    sw $t0,-12($s7)# store class tag (String) into object
1296#    lw $t2,4($sp) # char-count
1300#    sll $t1,$t2,2 # 4 times number of chars
1304#    subu $t2,$zero,$t2 # negative of char-count
1308#    sw $t2,-4($s7) # store negative char-count as header-word 2

    # set up pointers to various parts of stack and object
1312#    lw $t0,-8($s7) # data words in object, possibly must mask off hash
1316#    bge $t0,$zero,skipMask_readLine # don't strip hash code if not there
1317##...slt $at,$t0,$zero
1321##...beq $at,$zero,1340
1324#    and $t0,0xff # mask off object's hash value ...
1325##...lui $at,0
1329##...ori $at,$at,0xff
1333##...and $t0,$t0,$at
1336#    sw $t0,-8($s7) # ... and store back into -8 header-word
1340:  skipMask_readLine:

1340#    sll $t0,$t0,2 # data bytes in object
1344#    subu $t0,$s7,$t0 # place to store first character (plus 8)    
1348#    subu $t0,$t0,$t2 # place to store last character (plus 9)
1352#    addu $sp,$sp,8 # pop redundant object-pointer and count
1356#    addu $t1,$t1,$sp # first non-char spot on stack

    # at this point:
    #  $t0 points to the target-spot for the last character (plus 9)
    #  $t1 contains top spot on the stack not containing a char
    #  $sp points to the word with the last source character

    # copy the characters, popping each off the stack

1360#    beq $sp,$t1,rlReturn
1364:  charCopyLoop:
1364#    lw $t2,($sp)
1368#    sb $t2,-9($t0)
1372#    addu $sp,$sp,4
1376#    subu $t0,$t0,1
1380#    bne $sp,$t1,charCopyLoop
1384:  rlReturn:

1384#    lw $ra, 4($sp)
1388#    addu $sp, 8   # pop $ra and pointless word off stack
1392#    move $t0, $s7 # return string we allocated in $s7
1396#    jr $ra

###################################################################
# readInt() - library method (class Lib)
# - skips whitespace
# - then attempts to read a base-10 integer from standard input
# - aborts program if a valid integer is not found
# - returns the integer that is read
# - truncates on overflow
# - parameter:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1400:mth_readInt_Lib:

    # save $ra by pushing onto stack
1400#    subu $sp,$sp,4
1404#    sw $ra,($sp)

1408:  riSkipWhiteLoop:
    # read a character
1408#    jal readLogicalChar

    # if character <= 32 ascii, check for whitespace; if not
    # whitespace, abort 
1412#    subu $t0,$v0,32
1416#    bgt $t0,$zero,nonWhite
1417##...slt $at,$zero,$t0
1421##...bne $at,$zero,1464
1424#    beq $t0,$zero,riSkipWhiteLoop # start over if space
1428#    subu $t0,$v0,10
1432#    beq $t0,$zero,riSkipWhiteLoop # start over if newline
1436#    subu $t0,$v0,9
1440#    beq $t0,$zero,riSkipWhiteLoop # start over if tab
1444#    subu $t0,$v0,13
1448#    beq $t0,$zero,riSkipWhiteLoop # start over if carriage return
1452#    subu $t0,$v0,12
1456#    beq $t0,$zero,riSkipWhiteLoop # start over if form-feed
1460#    j badIntegerFormat # illegal integer char: abort program

1464:  nonWhite:
1464#    subu $t0,$v0,'-'
1468#    li $t4,1 # final multiplier
1472#    bne $t0,$zero,helpReadInt # go read
1476#    li $t4,-1 # -1 in final multiplier

    # read another character to make up for the '-'
1480#    jal readLogicalChar

1484:  helpReadInt:
1484#    li $t2,10
1488#    subu $t1,$v0,'0' # convert digit to 0-9 value
1492#    bgeu $t1,$t2,badIntegerFormat # abort if not digit
1493##...sltu $at,$t1,$t2
1497##...beq $at,$zero,3744
1500#    move $t3,$t1 #

    #### at this point, $t3 contains value of the first digit read,
    #### and $t2 contains the value 10

1504:  digitLoop:
    # loop invariants:
    # - $t3 contains the value of the number we've read so far
    # - $t2 contains the value 10

1504#    jal readLogicalChar # read next character
1508#    subu $t1,$v0,'0' # convert digit to 0-9 value
1512#    bgeu $t1,$t2,doneDigitLoop # abort if not digit
1513##...sltu $at,$t1,$t2
1517##...beq $at,$zero,1536

1520#    mul $t3,$t3,$t2 # multiply old value by 10
1521##...mult $t3,$t2
1525##...mflo $t3
1528#    addu $t3,$t3,$t1 # add in value of new digit
1532#    j digitLoop

1536:  doneDigitLoop:

    # "push back" unused character into queue
1536#    sw $v0,lastCharRead

    # restore return address
1540#    lw $ra,($sp)
1544#    addu $sp, 4

    # multiply by sign and put return value in $t0
1548#    mult $t3,$t4 # multiply to account for poss. minus sign
1552#    mflo $t3
1556#    move $t0, $t3
    
    # return
1560#    jr $ra

###################################################################
# readChar() - library method (class Lib)
# - reads a single character from standard input
# - returns the integer that is the encoding of the character
# - returns -1 if end of file was encountered
# - parameter:
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - value that was read
###################################################################
1564:mth_readChar_Lib:
