1792#    bgt $t2,$t1,strIndexOutOfBounds
1793##...slt $at,$t1,$t2
1797##...bne $at,$zero,3712
1800#    bgt $t1,$t0,strIndexOutOfBounds
1801##...slt $at,$t0,$t1
1805##...bne $at,$zero,3712

    # allocate memory
1808#    subu $s6,$t1,$t2 # # chars in target-string
1812#    addu $s6,$s6,7 # account for extra "class" (4) word + 3 to round up
1816#    srl $s6,$s6,2 # convert bytes-count to word-count
1820#    move $s7,$zero # (no object-bytes in string)
