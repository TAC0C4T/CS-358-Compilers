##############################################################
# MiniJava/UP library for MIPS/Spim -- version that assumes
#    one-word boolean on stack
# author: Steven R. Vegdahl
# date: 7-13 July 2004
# modified 12-17 March 2007
# modified 3-25 May 2007
# modified 2 May 2015
# modified 7 March 2016
# modified 11 May - 31 June 2017
# modified 2024 Steven Libby changed calling conventions
#               This is now passed in s2, 
#               and methods don't pop parameters
# status: Seems to work on all test cases.
###############################################################




###############################################################
# hashCode() - library method (class Object)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer (for Object)
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
656:mth_hashCode_Object:
    # for now, we'll return the -8 offset word, shifted/added to
    # itself, then XORed with a fixed "random" value
656#    lw $t0,-8($s2) # get word with hash bits from this
660#    srl $t1,$t0,11 # shift/add to introduce more "randomness"
664#    addu $t0,$t1

668#    jr $ra # return, no change to the stack

###############################################################
# equals() - library method (class Object)
# - tests whether two objects are equal
# - produces boolean that tells whether two objects are equal--
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
672:mth_equals_Object:
672#    move $t0,$s2 # first pointer (this)
676#    lw $t1,($sp) # second pointer
680#    seq $t0,$t0,$t1 # produce boolean telling if they are equal
681##...subu $at,$t0,$t1
685##...sltiu $t0,$at,1

688#    jr $ra # return

###############################################################
# hashCode() - library method (class String)
# - returns a hash code for an object
# - produces int that is the object's hash code
#   meaning that they are the same physical object
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - 1 if the objects were the same; 0 otherwise
###############################################################
692:mth_hashCode_String:
692#    move $t0,$s2 # put this pointer in t0

696#    li $t2,0 # current hash value
700#    lw $t1,-4($t0) # negative of number of characters in string
704#    beq $t1,$zero,done_hashCode_String # if zero length => done
708#    addu $t0,$t1 # address of first character in string +12,
                 # not accounting for padding and header words
712#    and $t0,0xfffffffc # adjust for padding
713##...lui $at,65535
717##...ori $at,$at,0xfffc
721##...and $t0,$t0,$at
724#    subu $t1,$t0,$t1 # address at end of string +12
728:loop_hashCode_String:    
728#    sll $t4,$t2,5 # multiply by 32
732#    subu $t2,$t4,$t2 # subtract original, so that it's now multiply by 31
736#    lbu $t3,-12($t0) # current character
740#    addu $t2,$t3 # add in current character
744#    addu $t0,1 # go to next character's address
748#    bne $t0,$t1,loop_hashCode_String # loop back if more
752:done_hashCode_String:    

    # push int on stack
752#    move $t0, $t2 # put $t2 in return slot
756#    jr $ra # return

###############################################################
# toString() - library method (class Object)
# - returns a String version of the object
#   - $s2 - this-pointer
#   - ($sp) - old-this-pointer
# - return-value:
#   - $t0 - the string version of the object
# ****NOTE: this method counts on the fact that the hashCode method
# ****is in slot 0 of the vtable    
###############################################################
760:mth_toString_Object:
    # we need to append:
    # - a string created from the object name in the negative portion of
    #   the vtable
    # - an at-sign "@"
    # - the hex version of the hashcode for the object, with no leading
    #   zeros

    # save return address. Get new this pointer
760#    subu $sp,4
764#    sw $ra,($sp)
    
    # get hash value
768#    lw $t2,-12($s2) # vtable address
772#    lw $t0,($t2) # method address
776#    jalr $t0
780#    subu $sp,8 # push result (int in $t0) on stack
784#    sw $s5,4($sp)
788#    sw $t0,($sp)

    # compute print-size of hash value
792#    li $t0, 1
796#    lw $t1, ($sp)
800#    srl $t1,$t1,4
804#    beq $t1,$zero,toString_skip_loop
808:toString_loop_top:
808#    addu $t0,1
812#    srl $t1,$t1,4
816#    bne $t1,$zero,toString_loop_top
820:toString_skip_loop:
820#    subu $sp,8
824#    sw $s5,4($sp)
828#    sw $t0,($sp)
    
    ################################################################
    # at this point, the stack looks like (from top):
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    ################################################################

    # determine the size of the "prefix string"
832#    lw $t2,-12($s2) # vtable address
836#    move $t0,$t2
840:toString_checkTagBit:
840#    subu $t0,1
844#    lb $t1,($t0)
848#    and $t1,0x80
849##...lui $at,0
853##...ori $at,$at,0x80
857##...and $t1,$t1,$at
860#    beq $t1,$zero,toString_checkTagBit
864#    subu $t1,$t2,$t0 # size of the prefix string, in bytes
868#    subu $sp,8
872#    sw $t1,($sp)
876#    sw $s5,4($sp) # push size onto stack

    # determine the header words for the string object's header
880#    move $s7,$zero # -4 offset header word
884#    lw $t4,8($sp) # bytes for hash value
888#    addu $t4,$t1 # bytes for prefix
    # add 8, to account for:
    #  - +1 for the '@' character
    #  - +4 for the vtable word
    #  - +3 to get the effect of rounding up rather than down
892#    addu $t4,8
896#    srl $s6,$t4,2 # divide by 4
    
    # allocate the object
900#    jal newObject
        
    ################################################################
    # at this point, the stack looks like (from top):
    # - new object, allocated to be our string
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $s7 also contains the address of the new object
    ################################################################

904#    li $t0,CLASS_String # store string vtable address into ...
908#    sw $t0,-12($s7) # ... -12 offset in object header
912#    lw $t2,-12($s2) # our object's vtable address
916#    lw $t5,4($sp) # number characters in prefix
920#    lw $t1,12($sp) # number of characters in hashcode
924#    addu $t3,$t1,$t5 # number of characters in string ...
928#    addu $t3,1 # ... including the '@' character
932#    subu $t0,$zero,$t3 # store negated length into ...
936#    sw $t0,-4($s7) # ... -4 offset header word
940#    lw $t0,-8($s7) # get -8 offset header-word
944#    bge $t0,$zero,skipMask_toString # don't strip hash code if not there
945##...slt $at,$t0,$zero
949##...beq $at,$zero,968
952#    and $t0,0xff # mask off object's hash value ...
953##...lui $at,0
957##...ori $at,$at,0xff
961##...and $t0,$t0,$at
964#    sw $t0,-8($s7) # ... and store back into -8 header-word
968:skipMask_toString:
968#    sll $t0,2 # convert to byte-offset (and shift off top bit, if there)
972#    subu $t0,$s7,$t0 # address first byte of string +8
#    addu $t1,$t0,$t3 # address of one past last byte of string +8
    
    # copy the prefix into the string
976#    subu $t4,$t2,$t5
980:toString_copyLoop:    
980#    lb $t3,($t4)
984#    and $t3,0x7f # mask off sign bit (in case first word)
985##...lui $at,0
989##...ori $at,$at,0x7f
993##...and $t3,$t3,$at
996#    sb $t3,-8($t0)
1000#    addu $t4,1
1004#    addu $t0,1
1008#    blt $t4,$t2,toString_copyLoop
1009##...slt $at,$t4,$t2
1013##...bne $at,$zero,980

    # copy the '@' sign
1016#    li $t3,'@'
1020#    sb $t3,-8($t0)
                
    ################################################################
    # at this point, the stack looks like (from top):
    # - the new string object that we are building
    # - number of characters in the prefix
    # - GC tag (5)
    # - print-size (in bytes) of the hash value
    # - GC tag (5)
    # - hash value
    # - GC tag (5)
    # - return address
    # - old this pointer
    # - ... rest of stack
    # $t0 contains the address of next byte to store, +8
    # $t1 the number of characters in the hashcode
    # $s2 contains the object on which toString() has been called
    # $s7 also contains the address of the new object
    ################################################################

    # store the hex version of the hash value
1024#    addu $t2,$t0,$t1 # address of last byte in string to store +8
1028#    lw $t3,20($sp) # hash code to print
1032:toString_hashCopyLoop:
1032#    and $t4,$t3,0xf
1036#    srl $t3,4
1040#    lb $t4,hexChars($t4)
1044#    sb $t4,-8($t2)
1048#    subu $t2,$t2,1
1052#    bgt $t2,$t0,toString_hashCopyLoop
1053##...slt $at,$t0,$t2
1057##...bne $at,$zero,1032

    # blow away stack until return address
    # put return address in $ra, 
    # and put return string on top of stack
1060#    addu $sp,28
1064#    lw $ra,($sp)
1068#    addu $sp,4
1072#    move $t0, $s7 # return string we created
1076#    jr $ra

###############################################################
# equals() - library method (class String)
# - the String version of the .equals method
# - produces false if the second object is null or is not a String ;
#   otherwise produces true iff the two strings have the same contents
# - parameters:
#   - $s2 - this-pointer
#   - ($sp) - object to compare to
#   - 4($sp) - old-this-pointer
# - return-value:
#   - ($sp) - 1 if the objects were the same; 0 otherwise
###############################################################
1080:mth_equals_String:
    
    # quick test for obvious false
1080#    lw $t0,($sp) # second parameter
1084#    beq $t0,$zero,goEsFalse # go return false if null
1088#    lw $t1,-12($t0) # vtable pointer
1092#    la $t2,CLASS_String # string vtable pointer
1096#    bne $t1,$t2,goEsFalse # go return false if not a string

    # save $ra, $s2, second parameter
    # we don't need to swap $s2, 
    # because it's still in the string class.
1100#    subu $sp,12
1104#    sw $ra,8($sp)
1108#    sw $s2,4($sp)
1112#    sw $t0,($sp)
1116#    jal mth_compareTo_String
1120#    lw $s2, 4($sp) #restore this pointer and pop parameters
1124#    addu $sp, 8 # pop parameters

    # return value is 1 iff result is 0; else 0
1128#    seq $t0,$t0,$zero
1129##...subu $at,$t0,$zero
1133##...sltiu $t0,$at,1

    # pop return address and return $t0
1136#    lw $ra,($sp)
1140#    addu $sp,4

1144#    jr $ra # return
    
1148:goEsFalse:
    # put 0 in $t0 and return
1148#    li $t0, 0
1152#    jr $ra # return

###############################################################
# toString() - library method (class String)
# - returns a String version of the object
