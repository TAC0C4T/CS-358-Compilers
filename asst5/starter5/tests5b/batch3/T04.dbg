1760#    move $t0,$s2
1764#    beq $t0,$zero,nullPtrException

    # get both indices and string length, and ensure that
    #   0 <= n <= k <= length
1768#    lw $t0,-4($t0) # negative of string length
1772#    subu $t0,$zero,$t0 # string length
1776#    lw $t1,4($sp) # k
