1629##...bne $at,$zero,1648
1632#    and $t1,0xff # mask out all but low byte
1633##...lui $at,0
1637##...ori $at,$at,0xff
1641##...and $t1,$t1,$at
1644#    b skipPrintStr2
1648:skipPrintStr1:
1648#    and $t1,0x7ffffff
