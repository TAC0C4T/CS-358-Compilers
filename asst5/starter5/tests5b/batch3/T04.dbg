1688#        syscall # print the char
1692#    addu $t1,$t1,1 # go to next char
1696#    blt $t1,$t0,psLoop
1697##...slt $at,$t1,$t0
1701##...bne $at,$zero,1680

1704:  donePrintStr:
1704#    jr $ra

########################################################
# printInt(n) - library method (class Lib)
# - prints integer in decimal format to standard output
